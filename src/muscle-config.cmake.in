# CMake package of MUSCLE (installed in <prefix>/lib/cmake/muscle):
#   find_package(muscle REQUIRED)                  (with CMAKE_PREFIX_PATH=<prefix>)
#   target_link_libraries(<your target> PRIVATE muscle)
# The target `muscle` brings the library, its Fortran modules (<prefix>/include), BLAS/LAPACK and OpenMP. The modules
# are those of the compiler that built MUSCLE: the program that uses them is compiled with the same compiler.
include(CMakeFindDependencyMacro)
find_dependency(OpenMP COMPONENTS Fortran)

include("${CMAKE_CURRENT_LIST_DIR}/muscle-targets.cmake")

get_filename_component(muscle_INCLUDE_DIRS "${CMAKE_CURRENT_LIST_DIR}/../../../include" ABSOLUTE)
# Real kinds of the installed build (sp;dp, sp or dp): without dp there are no historical names such as ten_3D2Osym
set(muscle_REAL_KINDS "@MUSCLE_REAL_KINDS@")
