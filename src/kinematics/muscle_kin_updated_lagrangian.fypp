#:include "muscle_models_common.fypp"
#! Model contract of the kinematics family (D-017.14): include/muscle_models_common.fypp. No
#! parameters: the parameter type is empty and only selects the kinematics.
#:set S2 = lambda k: tname('3D2Osym', k)
#:set C4 = lambda k: tname('3D4O2sym', k)

module muscle_kin_updated_lagrangian
    !! Module muscle_kin_updated_lagrangian
    !! ====================================
    !! Updated Lagrangian kinematics: the strain is the Euler-Almansi strain
    !! \( \mathbf{e} = \tfrac{1}{2}(\mathbf{I} - \mathbf{b}^{-1}) \) and the constitutive stress and
    !! tangent are the spatial (Cauchy) ones: `kin_to_cauchy` is the identity. With
    !! \( \delta\mathbf{F} = \delta\boldsymbol\varepsilon\,\mathbf{F} \) the strain changes by
    !! \( \delta\mathbf{e} = \tfrac{1}{2}(\delta\boldsymbol\varepsilon\,\mathbf{b}^{-1} + \mathbf{b}^{-1}\delta\boldsymbol\varepsilon) \):
    !! `kin_to_spatial_tangent` is \( \mathbb{A} : \delta\mathbf{e} \) (`kin_almansi_tangent`; it was the
    !! identity before D-018.15f) and the geometric term of the Kirchhoff stress \( J\boldsymbol\sigma \) is
    !! \( \boldsymbol\sigma\otimes\mathbf{I} \) (`kin_volumetric_tangent`).
    !!
    !! Kernel API (D-017.14): the (empty) parameter type `kin_updated_lagrangian_<k>` and the `pure`
    !! procedures `kin_update_updated_lagrangian_<k>(prm, F, state, status)` (status:
    !! `STATUS_INVALID_DEFORMATION` for det F <= 0, a singular F or a vanishing eigenvalue of C,
    !! D-017.14a), `kin_to_cauchy_updated_lagrangian_<k>(prm, state, stress)`,
    !! `kin_to_spatial_tangent_updated_lagrangian_<k>(prm, state, tangent)`,
    !! `kin_geometric_tangent_updated_lagrangian_<k>(prm, state, stress)` and
    !! `kin_is_finite_strain_updated_lagrangian_<k>(prm)`, also through the generics `kin_*` of
    !! muscle_kin_laws.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_tensors, only : ${', '.join(tname('3D2O', k) + ', ' + S2(k) + ', ' + C4(k) for k in REAL_KINDS)}$
    use muscle_kin_finite, only : ${', '.join('kin_state_' + k for k in REAL_KINDS)}$, kin_finite_update, kin_finite_update_norot, kin_euler_almansi, &
        kin_almansi_tangent, kin_volumetric_tangent
    implicit none
    private

    $:MODEL_PUBLIC('kin', 'updated_lagrangian')
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('kin', 'updated_lagrangian', k, model_param_list('kin', 'updated_lagrangian'))
#:endfor

contains
#:for k in REAL_KINDS

    $:MODEL_FUNCTION('kin', 'updated_lagrangian', 'update', k, doc=r'Strain: Euler-Almansi \( \mathbf{e} \).')

        call kin_finite_update(F, state, status)
        state%strain = kin_euler_almansi(state)
    end subroutine kin_update_updated_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'updated_lagrangian', 'update_norot', k, doc=r'`kin_update` with `kin_finite_update_norot` (R not computed).')

        call kin_finite_update_norot(F, state, status)
        state%strain = kin_euler_almansi(state)
    end subroutine kin_update_norot_updated_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'updated_lagrangian', 'to_cauchy', k, doc=r'The identity: the constitutive stress is the Cauchy stress.')

        res = stress
    end function kin_to_cauchy_updated_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'updated_lagrangian', 'to_spatial_tangent', k, doc=r'The constitutive tangent through the derivative of the Euler-Almansi strain (`kin_almansi_tangent`).')

        res = kin_almansi_tangent(state, tangent)
    end function kin_to_spatial_tangent_updated_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'updated_lagrangian', 'geometric_tangent', k, doc=r'The volume change of the Kirchhoff stress, \( \boldsymbol\sigma\otimes\mathbf{I} \) (`kin_volumetric_tangent`).')

        res = kin_volumetric_tangent(stress)
    end function kin_geometric_tangent_updated_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'updated_lagrangian', 'is_finite_strain', k)

        res = .true.
    end function kin_is_finite_strain_updated_lagrangian_${k}$
#:endfor

end module muscle_kin_updated_lagrangian
