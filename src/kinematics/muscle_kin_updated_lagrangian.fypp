#:include "muscle_models_common.fypp"
#:include "muscle_kin_adapters.fypp"
#! Model contract of the kinematics family (D-017.14): include/muscle_models_common.fypp. No
#! parameters: the parameter type is empty and only selects the kinematics.
#:set S2 = lambda k: tname('3D2Osym', k)
#:set C4 = lambda k: tname('3D4O2sym', k)

module muscle_kin_updated_lagrangian
    !! Module muscle_kin_updated_lagrangian
    !! ====================================
    !! Updated Lagrangian kinematics: the strain is the Euler-Almansi strain
    !! \( \mathbf{e} = \tfrac{1}{2}(\mathbf{I} - \mathbf{b}^{-1}) \) and the constitutive stress and
    !! tangent are already the spatial (Cauchy) ones: `kin_to_cauchy` and `kin_to_spatial_tangent`
    !! are the identity (no geometric term, D-017.14b).
    !!
    !! Kernel API (D-017.14): the (empty) parameter type `kin_updated_lagrangian_<k>` and the `pure`
    !! procedures `kin_update_updated_lagrangian_<k>(prm, F, state, status)` (status:
    !! `STATUS_INVALID_DEFORMATION` for det F <= 0, a singular F or a vanishing eigenvalue of C,
    !! D-017.14a), `kin_to_cauchy_updated_lagrangian_<k>(prm, state, stress)`,
    !! `kin_to_spatial_tangent_updated_lagrangian_<k>(prm, state, tangent)` and
    !! `kin_is_finite_strain_updated_lagrangian_<k>(prm)`, also through the generics `kin_*` of
    !! muscle_kin_laws.
    !!
    !! `Updated_lagrangian_kinematics` is the historical OO type (host only, removed in Phase 7),
    !! extending `Base_F_kinematics`: its bindings call the dp kernel procedures and ignore the
    !! status (same results as before, D-017.14a).
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_tensors, only : ${', '.join(tname('3D2O', k) + ', ' + S2(k) + ', ' + C4(k) for k in REAL_KINDS)}$
    use muscle_kin_finite, only : ${', '.join('kin_state_' + k for k in REAL_KINDS)}$, kin_finite_update, kin_euler_almansi
    use muscle_kin_finite_base, only : Base_F_kinematics, finite_state_of, finite_set_state
    implicit none
    private

    $:MODEL_PUBLIC('kin', 'updated_lagrangian')
    public :: Updated_lagrangian_kinematics
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('kin', 'updated_lagrangian', k, [])
#:endfor
    $:KIN_F_OO_TYPE('updated_lagrangian', 'Updated_lagrangian_kinematics', 'Cached Euler-Almansi strain e')

contains
#:for k in REAL_KINDS

    $:MODEL_FUNCTION('kin', 'updated_lagrangian', 'update', k, doc=r'Strain: Euler-Almansi \( \mathbf{e} \).')

        call kin_finite_update(F, state, status)
        state%strain = kin_euler_almansi(state)
    end subroutine kin_update_updated_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'updated_lagrangian', 'to_cauchy', k, doc=r'The identity: the constitutive stress is the Cauchy stress.')

        res = stress
    end function kin_to_cauchy_updated_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'updated_lagrangian', 'to_spatial_tangent', k, doc=r'The identity: the constitutive tangent is spatial.')

        res = tangent
    end function kin_to_spatial_tangent_updated_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'updated_lagrangian', 'is_finite_strain', k)

        res = .true.
    end function kin_is_finite_strain_updated_lagrangian_${k}$
#:endfor
    $:KIN_F_OO_PROCS('updated_lagrangian', 'Updated_lagrangian_kinematics')

end module muscle_kin_updated_lagrangian
