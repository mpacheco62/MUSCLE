#:include "muscle_models_common.fypp"
#! Model contract of the kinematics family (D-017.14): include/muscle_models_common.fypp. No
#! parameters: the parameter type is empty and only selects the kinematics.
#:set S2 = lambda k: tname('3D2Osym', k)
#:set C4 = lambda k: tname('3D4O2sym', k)

module muscle_kin_material_logarithmic
    !! Module muscle_kin_material_logarithmic
    !! ======================================
    !! Kinematic strategy using Material Hencky strain H = ln(U) = 0.5*ln(C).
    !! Conjugate stress is Rotated Kirchhoff stress tau_R.
    !!
    !! The rotated Kirchhoff stress is converted to Cauchy with the rotation of the polar
    !! decomposition, \( \boldsymbol\sigma = J^{-1}\mathbf{R}\boldsymbol\tau_R\mathbf{R}^T \), and the
    !! constitutive tangent \( d\boldsymbol\tau_R/d\mathbf{H} \) to the spatial one with
    !! the derivative of \( \ln\mathbf{C} \) and the rotation R (`kin_log_tangent`, divided by J;
    !! before D-018.15f only \( c_{ijkl} = J^{-1} R_{iI} R_{jJ} R_{kK} R_{lL} C_{IJKL} \), still its value
    !! with C = I); the geometric term at a fixed rotated Kirchhoff stress is the spin of R
    !! (`kin_spin_tangent`). The Hencky strain drops the eigenvalues of C at or below
    !! `KIN_EIG_MIN_<k>` (which also give `STATUS_INVALID_DEFORMATION`, D-017.14a).
    !!
    !! Kernel API (D-017.14): the (empty) parameter type `kin_material_logarithmic_<k>` and the
    !! `pure` procedures `kin_update_material_logarithmic_<k>(prm, F, state, status)` (one spectral
    !! decomposition of C for the rotation and the strain),
    !! `kin_to_cauchy_material_logarithmic_<k>(prm, state, stress)`,
    !! `kin_to_spatial_tangent_material_logarithmic_<k>(prm, state, tangent)`,
    !! `kin_geometric_tangent_material_logarithmic_<k>(prm, state, stress)` and
    !! `kin_is_finite_strain_material_logarithmic_<k>(prm)`, also through the generics `kin_*` of
    !! muscle_kin_laws.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_tensors, only : ${', '.join(tname('3D2O', k) + ', ' + S2(k) + ', ' + C4(k) for k in REAL_KINDS)}$, &
        operator(.transform.), operator(/)
    use muscle_kin_finite, only : ${', '.join('kin_state_' + k for k in REAL_KINDS)}$, kin_finite_update, kin_log_measure, &
        kin_log_tangent, kin_spin_tangent
    implicit none
    private

    $:MODEL_PUBLIC('kin', 'material_logarithmic')
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('kin', 'material_logarithmic', k, model_param_list('kin', 'material_logarithmic'))
#:endfor

contains
#:for k in REAL_KINDS

    $:MODEL_FUNCTION('kin', 'material_logarithmic', 'update', k, doc=r'Strain: material Hencky \( \mathbf{H} = \tfrac{1}{2}\ln\mathbf{C} \), from the spectral decomposition of the rotation.')
        real(${k}$) :: eig(3)
        type(${S2(k)}$) :: proj(3)

        call kin_finite_update(F, state, status, eig, proj)
        state%strain = kin_log_measure(eig, proj)
    end subroutine kin_update_material_logarithmic_${k}$

    $:MODEL_FUNCTION('kin', 'material_logarithmic', 'update_norot', k, doc=r'The same as `kin_update` (its conversions read R (KINEMATICS_ROTATION)).')

        call kin_update_material_logarithmic_${k}$(prm, F, state, status)
    end subroutine kin_update_norot_material_logarithmic_${k}$

    $:MODEL_FUNCTION('kin', 'material_logarithmic', 'to_cauchy', k, doc=r'Rotated Kirchhoff stress to Cauchy, \( J^{-1}\mathbf{R}\boldsymbol\tau_R\mathbf{R}^T \).')

        res = (state%R .transform. stress) / state%J
    end function kin_to_cauchy_material_logarithmic_${k}$

    $:MODEL_FUNCTION('kin', 'material_logarithmic', 'to_spatial_tangent', k, doc=r'Through the derivative of \( \ln\mathbf{C} \), rotated with R (`kin_log_tangent`), divided by J.')

        res = kin_log_tangent(state, tangent) / state%J
    end function kin_to_spatial_tangent_material_logarithmic_${k}$

    $:MODEL_FUNCTION('kin', 'material_logarithmic', 'geometric_tangent', k, doc=r'The spin of R at a fixed rotated Kirchhoff stress (`kin_spin_tangent`).')

        res = kin_spin_tangent(state, stress)
    end function kin_geometric_tangent_material_logarithmic_${k}$

    $:MODEL_FUNCTION('kin', 'material_logarithmic', 'is_finite_strain', k)

        res = .true.
    end function kin_is_finite_strain_material_logarithmic_${k}$
#:endfor

end module muscle_kin_material_logarithmic
