#!
#! Historical OO adapters of the kinematics driven by F (host only, removed in Phase 7 with
#! Base_F_kinematics, D-017.1): a type extending Base_F_kinematics with the cached strain, whose
#! bindings call the dp kernel procedures of the model (D-017.14) and ignore their status
#! (historical behaviour, same bits, D-017.14a). Included by the model templates
#! (src/kinematics/muscle_kin_<model>.fypp), after muscle_models_common.fypp. The model module
#! writes `use muscle_kin_finite_base, only : Base_F_kinematics, finite_state_of, finite_set_state`.
#!
#!   $:KIN_F_OO_TYPE(model, oo_type, strain_doc)   the OO type (strain component and bindings
#!                                                 update_F, get_strain, to_Cauchy, to_spatial_tangent)
#!   $:KIN_F_OO_PROCS(model, oo_type)              its type-bound procedures
#:mute
#:def KIN_F_OO_TYPE(model, oo_type, strain_doc)

    ! Historical OO interface (host only, D-017.1): removed in Phase 7 with Base_F_kinematics.
    type, extends(Base_F_kinematics) :: ${oo_type}$
        !! The ${model_label('kin', model)}$ kinematics through the polymorphic `Base_F_kinematics`
        !! interface (historical API, double precision, host only). Kernels use
        !! `${model_type('kin', model, 'dp')}$`, `kin_state_dp` and the free procedures.
        type(${tname('3D2Osym', 'dp')}$) :: strain
            !! ${strain_doc}$
    contains
        procedure :: update_F => update_F_tbp
            !! Caches the kinematic state and the strain of F.
        procedure :: get_strain => get_strain_tbp
            !! Cached strain.
        procedure :: to_Cauchy => to_Cauchy_tbp
            !! ${model_func('kin', 'to_cauchy').doc}$.
        procedure :: to_spatial_tangent => to_spatial_tangent_tbp
            !! ${model_func('kin', 'to_spatial_tangent').doc}$.
    end type ${oo_type}$
#:enddef

#:def KIN_F_OO_PROCS(model, oo_type)
#:set prm_t = model_type('kin', model, 'dp')

    pure subroutine update_F_tbp(self, F)
        !! Caches the kinematic state and the strain of F (type-bound, historical API; host only).
        !! Calls `${model_specific('kin', 'update', model, 'dp')}$` and ignores its status (D-017.14a).
        implicit none
        class(${oo_type}$), intent(inout) :: self
            !! Kinematics.
        type(${tname('3D2O', 'dp')}$), intent(in) :: F
            !! Deformation gradient.
        type(${prm_t}$) :: prm
        type(kin_state_dp) :: state
        integer :: status

        call ${model_specific('kin', 'update', model, 'dp')}$(prm, F, state, status)
        call finite_set_state(self, state)
        self%strain = state%strain
    end subroutine update_F_tbp

    pure function get_strain_tbp(self) result(strain)
        !! Cached strain (type-bound, historical API; host only).
        implicit none
        class(${oo_type}$), intent(in) :: self
            !! Kinematics.
        type(${tname('3D2Osym', 'dp')}$) :: strain
            !! Strain of the kinematics.

        strain = self%strain
    end function get_strain_tbp

    pure function to_Cauchy_tbp(self, constitutive_stress) result(sigma_cauchy)
        !! ${model_func('kin', 'to_cauchy').doc}$ (type-bound, historical API; host only).
        !! Calls `${model_specific('kin', 'to_cauchy', model, 'dp')}$`.
        implicit none
        class(${oo_type}$), intent(in) :: self
            !! Kinematics.
        type(${tname('3D2Osym', 'dp')}$), intent(in) :: constitutive_stress
            !! Stress of the constitutive model.
        type(${tname('3D2Osym', 'dp')}$) :: sigma_cauchy
            !! Cauchy stress.
        type(${prm_t}$) :: prm

        sigma_cauchy = ${model_specific('kin', 'to_cauchy', model, 'dp')}$(prm, finite_state_of(self), constitutive_stress)
    end function to_Cauchy_tbp

    pure function to_spatial_tangent_tbp(self, C_constitutive, stress_spatial) result(c_spatial)
        !! ${model_func('kin', 'to_spatial_tangent').doc}$ (type-bound, historical API; host only).
        !! Calls `${model_specific('kin', 'to_spatial_tangent', model, 'dp')}$`; `stress_spatial` is
        !! ignored (D-017.14b).
        implicit none
        class(${oo_type}$), intent(in) :: self
            !! Kinematics.
        type(${tname('3D4O2sym', 'dp')}$), intent(in) :: C_constitutive
            !! Tangent of the constitutive model.
        type(${tname('3D2Osym', 'dp')}$), intent(in), optional :: stress_spatial
            !! Spatial stress (ignored).
        type(${tname('3D4O2sym', 'dp')}$) :: c_spatial
            !! Spatial tangent.
        type(${prm_t}$) :: prm

        c_spatial = ${model_specific('kin', 'to_spatial_tangent', model, 'dp')}$(prm, finite_state_of(self), C_constitutive)
    end function to_spatial_tangent_tbp
#:enddef
#:endmute
