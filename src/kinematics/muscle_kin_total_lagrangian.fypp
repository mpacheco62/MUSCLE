#:include "muscle_models_common.fypp"
#! Model contract of the kinematics family (D-017.14): include/muscle_models_common.fypp. No
#! parameters: the parameter type is empty and only selects the kinematics.
#:set S2 = lambda k: tname('3D2Osym', k)
#:set C4 = lambda k: tname('3D4O2sym', k)

module muscle_kin_total_lagrangian
    !! Module muscle_kin_total_lagrangian
    !! ==================================
    !! Total Lagrangian kinematics: the strain is the Green-Lagrange strain
    !! \( \mathbf{E} = \tfrac{1}{2}(\mathbf{C} - \mathbf{I}) \) and the constitutive stress its work
    !! conjugate, the second Piola-Kirchhoff stress \( \mathbf{S} \), pushed forward to Cauchy,
    !! \( \boldsymbol\sigma = J^{-1}\mathbf{F}\mathbf{S}\mathbf{F}^T \); the constitutive tangent is
    !! pushed forward with F, \( c_{ijkl} = J^{-1} F_{iI} F_{jJ} F_{kK} F_{lL} C_{IJKL} \) (exact for
    !! \( \delta\mathbf{F} = \delta\boldsymbol\varepsilon\,\mathbf{F} \)), and the geometric term of the
    !! Jaumann rate is \( \tfrac{1}{2}(\delta_{ik}\sigma_{jl} + \delta_{il}\sigma_{jk} + \sigma_{ik}\delta_{jl} +
    !! \sigma_{il}\delta_{jk}) \) (`kin_jaumann_tangent`, D-018.15f).
    !!
    !! Kernel API (D-017.14): the (empty) parameter type `kin_total_lagrangian_<k>` and the `pure`
    !! procedures `kin_update_total_lagrangian_<k>(prm, F, state, status)` (status:
    !! `STATUS_INVALID_DEFORMATION` for det F <= 0, a singular F or a vanishing eigenvalue of C,
    !! D-017.14a), `kin_to_cauchy_total_lagrangian_<k>(prm, state, stress)`,
    !! `kin_to_spatial_tangent_total_lagrangian_<k>(prm, state, tangent)`,
    !! `kin_geometric_tangent_total_lagrangian_<k>(prm, state, stress)` and
    !! `kin_is_finite_strain_total_lagrangian_<k>(prm)`, also through the generics `kin_*` of
    !! muscle_kin_laws.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_tensors, only : ${', '.join(tname('3D2O', k) + ', ' + S2(k) + ', ' + C4(k) for k in REAL_KINDS)}$
    use muscle_kin_finite, only : ${', '.join('kin_state_' + k for k in REAL_KINDS)}$, kin_finite_update, kin_green_lagrange, &
        kin_pk2_to_cauchy, kin_push_forward_tangent, kin_jaumann_tangent
    implicit none
    private

    $:MODEL_PUBLIC('kin', 'total_lagrangian')
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('kin', 'total_lagrangian', k, model_param_list('kin', 'total_lagrangian'))
#:endfor

contains
#:for k in REAL_KINDS

    $:MODEL_FUNCTION('kin', 'total_lagrangian', 'update', k, doc=r'Strain: Green-Lagrange \( \mathbf{E} \).')

        call kin_finite_update(F, state, status)
        state%strain = kin_green_lagrange(state)
    end subroutine kin_update_total_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'total_lagrangian', 'to_cauchy', k, doc=r'Push-forward of the second Piola-Kirchhoff stress.')

        res = kin_pk2_to_cauchy(state, stress)
    end function kin_to_cauchy_total_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'total_lagrangian', 'to_spatial_tangent', k, doc=r'Push-forward with F.')

        res = kin_push_forward_tangent(state, tangent)
    end function kin_to_spatial_tangent_total_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'total_lagrangian', 'geometric_tangent', k, doc=r'The Kirchhoff stress \( \mathbf{F}\mathbf{S}\mathbf{F}^T \) at a fixed S: `kin_jaumann_tangent`.')

        res = kin_jaumann_tangent(stress)
    end function kin_geometric_tangent_total_lagrangian_${k}$

    $:MODEL_FUNCTION('kin', 'total_lagrangian', 'is_finite_strain', k)

        res = .true.
    end function kin_is_finite_strain_total_lagrangian_${k}$
#:endfor

end module muscle_kin_total_lagrangian
