#:include "muscle_models_common.fypp"
#! Model contract of the kinematics family (D-017.14): include/muscle_models_common.fypp. No
#! parameters: the parameter type is empty and only selects the kinematics.
#:set T2 = lambda k: tname('3D2O', k)
#:set S2 = lambda k: tname('3D2Osym', k)
#:set C4 = lambda k: tname('3D4O2sym', k)

module muscle_kin_small_strain
    !! Module muscle_kin_small_strain
    !! ==============================
    !! Small strain kinematics: the strain is the symmetric part of the displacement gradient,
    !! \( \boldsymbol\varepsilon = \tfrac{1}{2}(\mathbf{F} + \mathbf{F}^T) - \mathbf{I} \), and the
    !! configurations are not distinguished: the constitutive stress and tangent are the Cauchy
    !! stress and the spatial tangent, and \( J = 1 \).
    !!
    !! Kernel API (D-017.14): the (empty) parameter type `kin_small_strain_<k>` and the `pure`
    !! procedures `kin_update_small_strain_<k>(prm, F, state, status)` (the state keeps the reference
    !! configuration, \( \mathbf{F} = \mathbf{I} \), \( J = 1 \), and only its strain changes, so that
    !! the functions of muscle_kin_finite are the identity on it; no validation: `STATUS_OK`),
    !! `kin_to_cauchy_small_strain_<k>`, `kin_to_spatial_tangent_small_strain_<k>` (the identity),
    !! `kin_geometric_tangent_small_strain_<k>` (zero, D-018.15f) and
    !! `kin_is_finite_strain_small_strain_<k>` (false), also through the generics `kin_*` of
    !! muscle_kin_laws.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_status, only : STATUS_OK
    use muscle_tensors, only : ${', '.join(T2(k) + ', ' + S2(k) + ', ' + C4(k) for k in REAL_KINDS)}$, &
        transpose, operator(+), operator(*)
    use muscle_kin_finite, only : ${', '.join('kin_state_' + k for k in REAL_KINDS)}$
    implicit none
    private

    $:MODEL_PUBLIC('kin', 'small_strain')
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('kin', 'small_strain', k, model_param_list('kin', 'small_strain'))
#:endfor


contains
#:for k in REAL_KINDS

    $:MODEL_FUNCTION('kin', 'small_strain', 'update', k, doc=r'Strain \( \tfrac{1}{2}(\mathbf{F} + \mathbf{F}^T) - \mathbf{I} \); the rest of the state is the reference configuration.')
        type(${T2(k)}$) :: F_sym

        F_sym = 0.5_${k}$ * (F + transpose(F))
        state%strain%vals = [F_sym%vals(1) - 1.0_${k}$, F_sym%vals(5) - 1.0_${k}$, F_sym%vals(9) - 1.0_${k}$, &
                             F_sym%vals(2), F_sym%vals(6), F_sym%vals(3)]
        status = STATUS_OK
    end subroutine kin_update_small_strain_${k}$

    $:MODEL_FUNCTION('kin', 'small_strain', 'update_norot', k, doc=r'The same as `kin_update` (no polar decomposition).')

        call kin_update_small_strain_${k}$(prm, F, state, status)
    end subroutine kin_update_norot_small_strain_${k}$

    $:MODEL_FUNCTION('kin', 'small_strain', 'to_cauchy', k, doc=r'The identity.')

        res = stress
    end function kin_to_cauchy_small_strain_${k}$

    $:MODEL_FUNCTION('kin', 'small_strain', 'to_spatial_tangent', k, doc=r'The identity.')

        res = tangent
    end function kin_to_spatial_tangent_small_strain_${k}$

    $:MODEL_FUNCTION('kin', 'small_strain', 'geometric_tangent', k, doc=r'Zero: the configurations are not distinguished.')

        res%vals = 0.0_${k}$
    end function kin_geometric_tangent_small_strain_${k}$

    $:MODEL_FUNCTION('kin', 'small_strain', 'is_finite_strain', k)

        res = .false.
    end function kin_is_finite_strain_small_strain_${k}$
#:endfor

end module muscle_kin_small_strain
