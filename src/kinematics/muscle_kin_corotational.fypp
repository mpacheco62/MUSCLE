#:include "muscle_models_common.fypp"
#! Model contract of the kinematics family (D-017.14): include/muscle_models_common.fypp. No
#! parameters: the parameter type is empty and only selects the kinematics. Updated by
#! `kin_corot_update` (strain and rotation, D-017.14d) instead of `kin_update` (F).
#:set T2 = lambda k: tname('3D2O', k)
#:set S2 = lambda k: tname('3D2Osym', k)
#:set C4 = lambda k: tname('3D4O2sym', k)

module muscle_kin_corotational
    !! Module muscle_kin_corotational
    !! ==============================
    !! Corotational kinematics: the strain is given in the unrotated (corotational) frame together
    !! with the rotation \( \mathbf{R} \) of that frame, the volume ratio is
    !! \( J = \exp(\operatorname{tr}\boldsymbol\varepsilon) \), and the constitutive stress and
    !! tangent are rotated to the spatial frame, \( \boldsymbol\sigma = \mathbf{R}\hat{\boldsymbol\sigma}\mathbf{R}^T \),
    !! \( c_{ijkl} = R_{iI} R_{jJ} R_{kK} R_{lL} C_{IJKL} \) (no division by J). The geometric term of the
    !! Jaumann rate of the Kirchhoff stress over J is the volume change, \( \boldsymbol\sigma\otimes\mathbf{I} \):
    !! the corotational frame is rotated by the FE code (Abaqus, ANSYS), so there is no spin term
    !! (D-018.15f).
    !!
    !! Kernel API (D-017.14d): the (empty) parameter type `kin_corotational_<k>` and the `pure`
    !! procedures `kin_corot_update_corotational_<k>(prm, strain, state, status [, R])` (the state
    !! holds the strain, J and R, the identity when `R` is absent; its F-based components keep the
    !! reference configuration, so the F-based functions of muscle_kin_finite do not apply to it; no
    !! validation: `STATUS_OK`; without `R` the conversions apply \( \mathbf{I} \) with
    !! `.transform.`, which differs from the identity only with Inf/NaN components or a negative
    !! zero), `kin_to_cauchy_corotational_<k>(prm, state, stress)`,
    !! `kin_to_spatial_tangent_corotational_<k>(prm, state, tangent)`,
    !! `kin_geometric_tangent_corotational_<k>(prm, state, stress)` and
    !! `kin_is_finite_strain_corotational_<k>(prm)`, also through the generics `kin_corot_update` and
    !! `kin_*` of muscle_kin_laws. Back to the corotational frame: `kin_rotate_to_corotational`.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_status, only : STATUS_OK
    use muscle_tensors, only : ${', '.join(T2(k) + ', ' + S2(k) + ', ' + C4(k) for k in REAL_KINDS)}$
    use muscle_kin_finite, only : ${', '.join('kin_state_' + k for k in REAL_KINDS)}$, kin_rotate_from_corotational, &
        kin_rotate_to_corotational, kin_volumetric_tangent
    implicit none
    private

    $:MODEL_PUBLIC('kin', 'corotational')
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('kin', 'corotational', k, model_param_list('kin', 'corotational'))
#:endfor


contains
#:for k in REAL_KINDS

    $:MODEL_FUNCTION('kin', 'corotational', 'corot_update', k, doc=r'\( J = \exp(\varepsilon_{xx} + \varepsilon_{yy} + \varepsilon_{zz}) \).')

        state%strain = strain
        state%J = exp(strain%vals(1) + strain%vals(2) + strain%vals(3))
        if (present(R)) state%R = R
        status = STATUS_OK
    end subroutine kin_corot_update_corotational_${k}$

    $:MODEL_FUNCTION('kin', 'corotational', 'to_cauchy', k, doc=r'Rotation to the spatial frame, \( \mathbf{R}\hat{\boldsymbol\sigma}\mathbf{R}^T \).')

        res = kin_rotate_from_corotational(stress, state%R)
    end function kin_to_cauchy_corotational_${k}$

    $:MODEL_FUNCTION('kin', 'corotational', 'to_spatial_tangent', k, doc=r'Rotation to the spatial frame with R.')

        res = kin_rotate_from_corotational(tangent, state%R)
    end function kin_to_spatial_tangent_corotational_${k}$

    $:MODEL_FUNCTION('kin', 'corotational', 'geometric_tangent', k, doc=r'The volume change, \( \boldsymbol\sigma\otimes\mathbf{I} \) (`kin_volumetric_tangent`; no spin: the FE code rotates the frame).')

        res = kin_volumetric_tangent(stress)
    end function kin_geometric_tangent_corotational_${k}$

    $:MODEL_FUNCTION('kin', 'corotational', 'is_finite_strain', k)

        res = .true.
    end function kin_is_finite_strain_corotational_${k}$
#:endfor

end module muscle_kin_corotational
