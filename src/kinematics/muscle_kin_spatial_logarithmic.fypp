#:include "muscle_common.fypp"

module muscle_kin_spatial_logarithmic
    !! Module muscle_kin_spatial_logarithmic
    !! =====================================
    !! Kinematic strategy using Spatial Hencky strain h = ln(V) = 0.5*ln(b).
    !! Conjugate stress is spatial Kirchhoff stress tau.
    !!
    !! The Kirchhoff stress is converted to Cauchy, \( \boldsymbol\sigma = J^{-1}\boldsymbol\tau \),
    !! and the constitutive tangent to the spatial one through the derivative of \( \ln\mathbf{b} \)
    !! (`kin_spatial_log_tangent`, divided by J; before D-018.15f only the division by J); the
    !! geometric term at a fixed Kirchhoff stress is zero. The Hencky strain comes from the eigenvalues and eigenprojections of b (those of C
    !! are mathematically the same eigenvalues, but computed from other components: reusing them
    !! would change the bits, D-017.14e) and drops those at or below `KIN_EIG_MIN_<k>`; the status
    !! only checks the eigenvalues of C (D-017.14e).
    !!
    !! Kernel API (D-017.14): the (empty) parameter type `kin_spatial_logarithmic_<k>` and the `pure`
    !! procedures `kin_update_spatial_logarithmic_<k>(prm, F, state, status)` (status:
    !! `STATUS_INVALID_DEFORMATION` for det F <= 0, a singular F or a vanishing eigenvalue of C,
    !! D-017.14a), `kin_to_cauchy_spatial_logarithmic_<k>(prm, state, stress)`,
    !! `kin_to_spatial_tangent_spatial_logarithmic_<k>(prm, state, tangent)`,
    !! `kin_geometric_tangent_spatial_logarithmic_<k>(prm, state, stress)` and
    !! `kin_is_finite_strain_spatial_logarithmic_<k>(prm)`, also through the generics `kin_*` of
    !! muscle_kin_laws.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
#:for k in REAL_KINDS
    use muscle_tensors, only : ten_3D2O_${k}$, ten_3D2Osym_${k}$, ten_3D4O2sym_${k}$
    use muscle_kin_finite, only : kin_state_${k}$
#:endfor
    use muscle_tensors, only : operator(/)
    use muscle_kin_finite, only : kin_finite_update, kin_finite_update_norot, kin_spatial_log, kin_spatial_log_tangent
    implicit none
    private

#:for k in REAL_KINDS
    public :: kin_spatial_logarithmic_${k}$
    public :: kin_update_spatial_logarithmic_${k}$
    public :: kin_update_norot_spatial_logarithmic_${k}$
    public :: kin_to_cauchy_spatial_logarithmic_${k}$
    public :: kin_to_spatial_tangent_spatial_logarithmic_${k}$
    public :: kin_geometric_tangent_spatial_logarithmic_${k}$
    public :: kin_is_finite_strain_spatial_logarithmic_${k}$
#:endfor

#:for k in REAL_KINDS
    type :: kin_spatial_logarithmic_${k}$
        !! Parameters of the spatial logarithmic model in `real(${k}$)`.
    end type kin_spatial_logarithmic_${k}$

#:endfor
contains
#:for k in REAL_KINDS

    pure subroutine kin_update_spatial_logarithmic_${k}$(prm, F, state, status)
        !! Kinematic state of a deformation gradient \( \mathbf{F} \) (the deformation gradient is validated) of the spatial
        !! logarithmic model in `real(${k}$)`.
        !! Strain: spatial Hencky \( \mathbf{h} = \tfrac{1}{2}\ln\mathbf{b} \), from the spectral decomposition of b.
        implicit none
        @:DEVICE()
        type(kin_spatial_logarithmic_${k}$), intent(in) :: prm
            !! Parameters.
        type(ten_3D2O_${k}$), intent(in) :: F
            !! Deformation gradient \( \mathbf{F} \).
        type(kin_state_${k}$), intent(out) :: state
            !! Kinematic state (not valid when `status` is not `STATUS_OK`).
        integer, intent(out) :: status
            !! `STATUS_OK` or `STATUS_INVALID_DEFORMATION` (muscle_status).

        call kin_finite_update(F, state, status)
        state%strain = kin_spatial_log(state)
    end subroutine kin_update_spatial_logarithmic_${k}$

    pure subroutine kin_update_norot_spatial_logarithmic_${k}$(prm, F, state, status)
        !! `kin_update` without the polar decomposition (D-019.7c): the rotation R of the state is the identity, unless the
        !! functions of the kinematics read it (`KINEMATICS_ROTATION`: then the same state as `kin_update`); every other component
        !! and `status` are the same bits of the spatial logarithmic model in `real(${k}$)`.
        !! `kin_update` with `kin_finite_update_norot` (R not computed).
        implicit none
        @:DEVICE()
        type(kin_spatial_logarithmic_${k}$), intent(in) :: prm
            !! Parameters.
        type(ten_3D2O_${k}$), intent(in) :: F
            !! Deformation gradient \( \mathbf{F} \).
        type(kin_state_${k}$), intent(out) :: state
            !! Kinematic state without R (not valid when `status` is not `STATUS_OK`).
        integer, intent(out) :: status
            !! `STATUS_OK` or `STATUS_INVALID_DEFORMATION` (muscle_status).

        call kin_finite_update_norot(F, state, status)
        state%strain = kin_spatial_log(state)
    end subroutine kin_update_norot_spatial_logarithmic_${k}$

    pure function kin_to_cauchy_spatial_logarithmic_${k}$(prm, state, stress) result(res)
        !! Cauchy stress from the constitutive stress (work conjugate of the strain of the kinematics) of the spatial logarithmic
        !! model in `real(${k}$)`.
        !! Kirchhoff stress to Cauchy, \( J^{-1}\boldsymbol\tau \).
        implicit none
        @:DEVICE()
        type(kin_spatial_logarithmic_${k}$), intent(in) :: prm
            !! Parameters.
        type(kin_state_${k}$), intent(in) :: state
            !! Kinematic state (`kin_update` or `kin_corot_update`).
        type(ten_3D2Osym_${k}$), intent(in) :: stress
            !! Constitutive stress.
        type(ten_3D2Osym_${k}$) :: res
            !! Cauchy stress \( \boldsymbol\sigma \).

        res = stress / state%J
    end function kin_to_cauchy_spatial_logarithmic_${k}$

    pure function kin_to_spatial_tangent_spatial_logarithmic_${k}$(prm, state, tangent) result(res)
        !! Spatial tangent from the constitutive tangent: the part of \(
        !! J^{-1}\partial\boldsymbol\tau/\partial\boldsymbol\varepsilon \) through the constitutive stress, for \( \delta\mathbf{F}
        !! = \delta\boldsymbol\varepsilon\,\mathbf{F} \) (with the derivative of the strain measure, D-018.15f; without the
        !! geometric term) of the spatial logarithmic model in `real(${k}$)`.
        !! Through the derivative of \( \ln\mathbf{b} \) (`kin_spatial_log_tangent`), divided by J.
        implicit none
        @:DEVICE()
        type(kin_spatial_logarithmic_${k}$), intent(in) :: prm
            !! Parameters.
        type(kin_state_${k}$), intent(in) :: state
            !! Kinematic state (`kin_update` or `kin_corot_update`).
        type(ten_3D4O2sym_${k}$), intent(in) :: tangent
            !! Constitutive tangent.
        type(ten_3D4O2sym_${k}$) :: res
            !! Spatial tangent.

        res = kin_spatial_log_tangent(state, tangent) / state%J
    end function kin_to_spatial_tangent_spatial_logarithmic_${k}$

    pure function kin_geometric_tangent_spatial_logarithmic_${k}$(prm, state, stress) result(res)
        !! Geometric term of the spatial tangent: the part of \( J^{-1}\partial\boldsymbol\tau/\partial\boldsymbol\varepsilon \) at
        !! a fixed constitutive stress (D-018.15f); `to_spatial_tangent` plus this is the tangent of the Jaumann rate of the
        !! Kirchhoff stress of the spatial logarithmic model in `real(${k}$)`.
        !! Zero: the constitutive stress is the Kirchhoff stress.
        implicit none
        @:DEVICE()
        type(kin_spatial_logarithmic_${k}$), intent(in) :: prm
            !! Parameters.
        type(kin_state_${k}$), intent(in) :: state
            !! Kinematic state (`kin_update` or `kin_corot_update`).
        type(ten_3D2Osym_${k}$), intent(in) :: stress
            !! Cauchy stress.
        type(ten_3D4O2sym_${k}$) :: res
            !! Geometric term.

        res%vals = 0.0_${k}$
    end function kin_geometric_tangent_spatial_logarithmic_${k}$

    pure function kin_is_finite_strain_spatial_logarithmic_${k}$(prm) result(res)
        !! Whether the kinematics is a finite strain one of the spatial logarithmic model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(kin_spatial_logarithmic_${k}$), intent(in) :: prm
            !! Parameters.
        logical :: res
            !! `.true.` for a finite strain kinematics.

        res = .true.
    end function kin_is_finite_strain_spatial_logarithmic_${k}$
#:endfor

end module muscle_kin_spatial_logarithmic
