#:include "muscle_models_common.fypp"
#! Model contract of the kinematics family (D-017.14): include/muscle_models_common.fypp. No
#! parameters: the parameter type is empty and only selects the kinematics.
#:set S2 = lambda k: tname('3D2Osym', k)
#:set C4 = lambda k: tname('3D4O2sym', k)

module muscle_kin_spatial_logarithmic
    !! Module muscle_kin_spatial_logarithmic
    !! =====================================
    !! Kinematic strategy using Spatial Hencky strain h = ln(V) = 0.5*ln(b).
    !! Conjugate stress is spatial Kirchhoff stress tau.
    !!
    !! The Kirchhoff stress is converted to Cauchy, \( \boldsymbol\sigma = J^{-1}\boldsymbol\tau \),
    !! and the constitutive tangent to the spatial one through the derivative of \( \ln\mathbf{b} \)
    !! (`kin_spatial_log_tangent`, divided by J; before D-018.15f only the division by J); the
    !! geometric term at a fixed Kirchhoff stress is zero. The Hencky strain comes from the eigenvalues and eigenprojections of b (those of C
    !! are mathematically the same eigenvalues, but computed from other components: reusing them
    !! would change the bits, D-017.14e) and drops those at or below `KIN_EIG_MIN_<k>`; the status
    !! only checks the eigenvalues of C (D-017.14e).
    !!
    !! Kernel API (D-017.14): the (empty) parameter type `kin_spatial_logarithmic_<k>` and the `pure`
    !! procedures `kin_update_spatial_logarithmic_<k>(prm, F, state, status)` (status:
    !! `STATUS_INVALID_DEFORMATION` for det F <= 0, a singular F or a vanishing eigenvalue of C,
    !! D-017.14a), `kin_to_cauchy_spatial_logarithmic_<k>(prm, state, stress)`,
    !! `kin_to_spatial_tangent_spatial_logarithmic_<k>(prm, state, tangent)`,
    !! `kin_geometric_tangent_spatial_logarithmic_<k>(prm, state, stress)` and
    !! `kin_is_finite_strain_spatial_logarithmic_<k>(prm)`, also through the generics `kin_*` of
    !! muscle_kin_laws.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_tensors, only : ${', '.join(tname('3D2O', k) + ', ' + S2(k) + ', ' + C4(k) for k in REAL_KINDS)}$, &
        operator(/)
    use muscle_kin_finite, only : ${', '.join('kin_state_' + k for k in REAL_KINDS)}$, kin_finite_update, kin_spatial_log, &
        kin_spatial_log_tangent
    implicit none
    private

    $:MODEL_PUBLIC('kin', 'spatial_logarithmic')
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('kin', 'spatial_logarithmic', k, model_param_list('kin', 'spatial_logarithmic'))
#:endfor

contains
#:for k in REAL_KINDS

    $:MODEL_FUNCTION('kin', 'spatial_logarithmic', 'update', k, doc=r'Strain: spatial Hencky \( \mathbf{h} = \tfrac{1}{2}\ln\mathbf{b} \), from the spectral decomposition of b.')

        call kin_finite_update(F, state, status)
        state%strain = kin_spatial_log(state)
    end subroutine kin_update_spatial_logarithmic_${k}$

    $:MODEL_FUNCTION('kin', 'spatial_logarithmic', 'to_cauchy', k, doc=r'Kirchhoff stress to Cauchy, \( J^{-1}\boldsymbol\tau \).')

        res = stress / state%J
    end function kin_to_cauchy_spatial_logarithmic_${k}$

    $:MODEL_FUNCTION('kin', 'spatial_logarithmic', 'to_spatial_tangent', k, doc=r'Through the derivative of \( \ln\mathbf{b} \) (`kin_spatial_log_tangent`), divided by J.')

        res = kin_spatial_log_tangent(state, tangent) / state%J
    end function kin_to_spatial_tangent_spatial_logarithmic_${k}$

    $:MODEL_FUNCTION('kin', 'spatial_logarithmic', 'geometric_tangent', k, doc=r'Zero: the constitutive stress is the Kirchhoff stress.')

        res%vals = 0.0_${k}$
    end function kin_geometric_tangent_spatial_logarithmic_${k}$

    $:MODEL_FUNCTION('kin', 'spatial_logarithmic', 'is_finite_strain', k)

        res = .true.
    end function kin_is_finite_strain_spatial_logarithmic_${k}$
#:endfor

end module muscle_kin_spatial_logarithmic
