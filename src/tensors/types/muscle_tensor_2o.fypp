#:include "muscle_common.fypp"
#:include "muscle_tensor_common.fypp"
#! General (unsymmetric) second-order tensors, one type per dimension and kind (pattern of D-011,
#! see muscle_tensor_2osym.fypp):
#! - everything that depends on the component layout comes from layout('2O', dim); `det` and the
#!   2D `.ddot.` are written explicitly per dimension to keep the evaluation order (and the bits)
#!   of the original code;
#! - every operation is a free `type` procedure marked @:DEVICE() (callable from kernels); the
#!   type-bound procedures are `class` wrappers (`*_tbp`) kept for the historical API;
#! - the operations common to every family (+, -, *, /, =, .approx., .inv., is_approx and the
#!   type-bound wrappers) come from the macros of muscle_tensor_common.fypp (D-012);
#! - formatted output lives in muscle_tensor_io (host only);
#! - the historical names (ten_3D2O, ten_2D2O = dp) come from muscle_tensors (D-003).

module muscle_tensor_2o
    !! Module muscle_tensor_2o
    !! =======================
    !!
    !! General (unsymmetric) second-order tensors (deformation gradient, rotations, ...) in 3D
    !! and 2D, in single and double precision: `ten_3D2O_sp`, `ten_3D2O_dp`, `ten_2D2O_sp`,
    !! `ten_2D2O_dp`.
    !!
    !! Storage (column-major, consistent with Fortran arrays):
    !!
    !! - 3D: `vals(9)` = (11, 21, 31, 12, 22, 32, 13, 23, 33).
    !! - 2D (plane strain/stress, axisymmetry): `vals(5)` = (11, 21, 12, 22, 33): the in-plane
    !!   2x2 block in column-major order and the out-of-plane component; the coupling components
    !!   vanish (\(A_{13} = A_{23} = A_{31} = A_{32} = 0\)).
    !!
    !! Operations (generic over dimension and kind; operands must share the kind):
    !!
    !! - Operators: `.approx.`, `+`, `-` (binary and unary), `*` and `/` by a scalar of the same
    !!   kind, `.dev.`, `.ddot.` (scalar \(A_{ij} B_{ij}\)), `.inv.`, assignment of a scalar.
    !! - Generic functions (usable in GPU kernels): `transpose(a)`, `norm(a)`, `det(a)`,
    !!   `is_approx(a, b [, tol])` and `call inverse(a, a_inv, ok [, cond])`.
    !! - Type-bound (historical API, not for kernels): `init` (array in storage order, or the
    !!   named components in row-major order: 3D `xx, xy, xz, yx, yy, yz, zx, zy, zz`, 2D
    !!   `xx, xy, yx, yy, zz`), `norm`, `is_approx`, `det`, `transpose`, `inv`.
    !!
    !! ```fortran
    !! use muscle_tensors                      ! ten_2D2O is ten_2D2O_dp
    !! type(ten_2D2O) :: F, Ft
    !! call F%init(xx=1.0_dp, xy=0.3_dp, yx=0.0_dp, yy=1.0_dp, zz=1.1_dp)
    !! Ft = transpose(F)                       ! Ft%vals = (1.0, 0.3, 0.0, 1.0, 1.1)
    !! print *, F%det()                        ! 1.1
    !! ```
    !!
    !! For more information see [[muscle_tensors]]
    use muscle_kinds, only: sp, dp
#:for k in REAL_KINDS
    use muscle_kinds, only: TOL_APPROX_${k}$, EPS_ABS_${k}$
#:endfor
    implicit none
    private

#:set F = '2O'
#:for d in DIMS
#:set lay = layout(F, d)
#:set n = len(lay.comps)
#:set S = d + F
#:for k in REAL_KINDS
#:set T = tname(S, k)
    type, public :: ${T}$
        !! General ${d}$ second-order tensor in `real(${k}$)`, stored column-major:
        !! `vals` = (${', '.join(c.name for c in lay.comps)}$).
        real(${k}$), dimension(${n}$) :: vals
            !! Stored components (${', '.join(c.name for c in lay.comps)}$).
        contains
            generic, public :: init => init_${S}$_${k}$_tbp, init2_${S}$_${k}$_tbp
                !! Initializes from a ${n}$-element array (storage order) or from the named
                !! components (row-major order).
            procedure, private :: init_${S}$_${k}$_tbp, init2_${S}$_${k}$_tbp
            procedure, public :: norm => norm_${S}$_${k}$_tbp
                !! L1 norm of the stored components.
            procedure, public :: is_approx => is_approx_${S}$_${k}$_tbp
                !! Component-wise approximate equality.
            procedure, public :: det => det_${S}$_${k}$_tbp
                !! Determinant.
            procedure, public :: transpose => transpose_${S}$_${k}$_tbp
                !! Transposed tensor.
            procedure, public :: inv => inv_${S}$_${k}$_tbp
                !! Inverse tensor (quiet NaN if singular).
    end type ${T}$

#:endfor
#:endfor
$:TENSOR_COMMON_INTERFACES(F)

    public :: operator(.dev.)
    interface operator (.dev.)
        module procedure ${specifics('dev_{0}_{1}', F)}$
    end interface

    public :: operator(.ddot.)
    interface operator (.ddot.)
        module procedure ${specifics('ddot_{0}_{0}_{1}', F)}$
    end interface

    public :: transpose
    interface transpose
        !! Transposed tensor \(A^T_{ij} = A_{ji}\) (extends the intrinsic `transpose`).
        module procedure ${specifics('transpose_{0}_{1}', F)}$
    end interface

    public :: norm
    interface norm
        !! L1 norm of the stored components.
        module procedure ${specifics('norm_{0}_{1}', F)}$
    end interface

    public :: det
    interface det
        !! Determinant.
        module procedure ${specifics('det_{0}_{1}', F)}$
    end interface

contains

#:for d in DIMS
#:set lay = layout(F, d)
#:set n = len(lay.comps)
#:set S = d + F
#! Positions of the normal components A_11, A_22, A_33 (trace, .dev.)
#:set diag = [lay.index(i, i)[0] for i in range(1, 4)]
#! init2 takes the components in row-major order (historical interface), storage is column-major
#:set row_major = sorted(lay.comps, key=lambda c: c.idx)
#:for k in REAL_KINDS
#:set T = tname(S, k)
#:set P = S + '_' + k
    ! ---------------------------------------------------------------------------------------
    ! ${T}$
    ! ---------------------------------------------------------------------------------------

$:TENSOR_COMMON_PROCEDURES(d, F, k)

    pure function norm_${P}$(a) result(res)
        !! L1 norm of the ${n}$ stored components of a `${T}$`, \(\sum |A_{ij}|\).
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Tensor whose norm is computed.
        real(${k}$) :: res
            !! L1 norm.
        res = ${join_terms(norm_terms(lay, 'a%vals'))}$
    end function norm_${P}$

    pure function ddot_${S}$_${P}$(a, b) result(res)
        !! Double contraction (Frobenius inner product) of two `${T}$`, \(A_{ij} B_{ij}\).
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! First operand.
        type(${T}$), intent(in) :: b
            !! Second operand.
        real(${k}$) :: res
            !! Scalar result.
#:if d == '3D'
        res = ${join_terms(['a%vals({0})*b%vals({0})'.format(c.pos[0]) for c in lay.comps])}$
#:else
#! sum() starts from +0: kept so that a result of -0 stays +0, as in the original 2D code
        res = sum(a%vals * b%vals)
#:endif
    end function ddot_${S}$_${P}$

    pure function dev_${P}$(a) result(res)
        !! Deviatoric part of a `${T}$`, \(\mathbf{A} - \frac{1}{3}\mathrm{tr}(\mathbf{A})\mathbf{I}\).
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Operand.
        type(${T}$) :: res
            !! Deviatoric tensor.
        real(${k}$) :: hydro
        hydro = (${' + '.join('a%vals({})'.format(p) for p in diag)}$)/3.0_${k}$
#:for c in lay.comps
#:if c.pos[0] in diag
        res%vals(${c.pos[0]}$) = a%vals(${c.pos[0]}$) - hydro
#:else
        res%vals(${c.pos[0]}$) = a%vals(${c.pos[0]}$)
#:endif
#:endfor
    end function dev_${P}$

    pure function det_${P}$(a) result(res)
        !! Determinant of a `${T}$`.
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Tensor.
        real(${k}$) :: res
            !! Determinant.
#! Explicit formulas (original evaluation order); they assume the column-major storage
#:assert [c.idx for c in layout('2O', d).comps] == ([(i, j) for j in (1, 2, 3) for i in (1, 2, 3)] if d == '3D' else [(1, 1), (2, 1), (1, 2), (2, 2), (3, 3)])
#:if d == '3D'
        res = a%vals(1)*a%vals(5)*a%vals(9) + a%vals(2)*a%vals(6)*a%vals(7) &
            + a%vals(3)*a%vals(4)*a%vals(8) - a%vals(7)*a%vals(5)*a%vals(3) &
            - a%vals(8)*a%vals(6)*a%vals(1) - a%vals(9)*a%vals(4)*a%vals(2)
#:else
        ! (A11 A22 - A12 A21) A33
        res = (a%vals(1)*a%vals(4) - a%vals(2)*a%vals(3)) * a%vals(5)
#:endif
    end function det_${P}$

    pure function transpose_${P}$(self) result(res)
        !! Transpose of a `${T}$`, \(A^T_{ij} = A_{ji}\) (generic `transpose`; the dummy keeps
        !! its historical name `self`, usable as a keyword).
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: self
            !! Tensor.
        type(${T}$) :: res
            !! Transposed tensor.
#:for c in lay.comps
#:set i, j = c.idx
        res%vals(${c.pos[0]}$) = ${lay.ref('self%vals', j, i)}$
#:endfor
    end function transpose_${P}$

    pure subroutine inverse_${P}$(a, a_inv, ok, cond)
        !! Inverse of a `${T}$` with a success flag (generic `inverse`, also used by `.inv.`).
        !!
        !! The full 3x3 matrix is inverted with `M33INV` (adjugate + \( \kappa_\infty \), LU
        !! fallback). If it is singular (or contains NaN): `ok = .false.`, `a_inv` is filled with
        !! quiet NaN and `cond = huge(1.0_${k}$)`.
        use muscle_math_inverses, only : M33INV_${k}$, QUIET_NAN_${k}$
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Tensor to invert.
        type(${T}$), intent(out) :: a_inv
            !! Inverse tensor (quiet NaN if `a` is singular).
        logical, intent(out) :: ok
            !! `.true.` if the inversion succeeded, `.false.` if `a` is singular.
        real(${k}$), intent(out), optional :: cond
            !! Condition number \( \kappa_\infty \) of the inverted 3x3 matrix; `huge(1.0_${k}$)` if singular.
        real(${k}$) :: m(3,3), x(3,3)

$:LOAD_MATRIX('m', lay, k)
        ! The inverse routine sets cond (if present): kappa_inf, or huge if singular
        call M33INV_${k}$(m, x, ok, cond)
        if (.not. ok) then
            a_inv%vals = QUIET_NAN_${k}$()
            return
        end if
#:for c in lay.comps
        a_inv%vals(${c.pos[0]}$) = x(${c.idx[0]}$,${c.idx[1]}$)
#:endfor
    end subroutine inverse_${P}$

    ! Type-bound wrappers of ${T}$ (historical API; `class` passed object, not for kernels)

$:TENSOR_COMMON_TBP(d, F, k, scalar_ops=['norm', 'det'], tensor_ops=['transpose', 'inv'])

    pure subroutine init2_${P}$_tbp(self, ${', '.join(c.name for c in row_major)}$)
        !! `%init(${', '.join(c.name for c in row_major)}$)`: initializes a `${T}$` from its
        !! ${n}$ individual components, given in row-major order (stored column-major).
        implicit none
        class(${T}$), intent(inout) :: self
            !! Tensor to initialize.
#:for c in row_major
        real(${k}$), intent(in) :: ${c.name}$
            !! Component ${c.idx}$.
#:endfor
        self%vals = (/${', '.join(c.name for c in lay.comps)}$/)
    end subroutine init2_${P}$_tbp

#:endfor
#:endfor
end module muscle_tensor_2o
