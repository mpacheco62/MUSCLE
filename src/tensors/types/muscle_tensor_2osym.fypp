#:include "muscle_common.fypp"
#! Symmetric second-order tensors, one type per dimension and kind (pattern of D-011):
#! - everything that depends on the component layout comes from layout('2Osym', dim); the few
#!   formulas that are genuinely different per dimension (square, det) are written explicitly
#!   to keep the evaluation order (and the bits) of the original code;
#! - every operation is a free `type` procedure marked @:DEVICE() (callable from kernels); the
#!   type-bound procedures are `class` wrappers (`*_tbp`) kept for the historical API;
#! - formatted output lives in muscle_tensor_io (host only);
#! - the historical names (ten_3D2Osym, ten_2D2Osym = dp) come from the compatibility modules
#!   muscle_tensor_3d2osym / muscle_tensor_2d2osym and from muscle_tensors (D-003).

module muscle_tensor_2osym
    !! Module muscle_tensor_2osym
    !! ==========================
    !!
    !! Symmetric second-order tensors (stress, strain) in 3D and 2D, in single and double
    !! precision: `ten_3D2Osym_sp`, `ten_3D2Osym_dp`, `ten_2D2Osym_sp`, `ten_2D2Osym_dp`.
    !!
    !! Storage (tensorial Voigt notation, the shear is not doubled):
    !!
    !! - 3D: `vals(6)` = (11, 22, 33, 12, 23, 13).
    !! - 2D (plane strain/stress, axisymmetry): `vals(4)` = (11, 22, 33, 12); the out-of-plane
    !!   shear components vanish (\(A_{13} = A_{23} = 0\)) and \(A_{33}\) is kept.
    !!
    !! Operations (generic over dimension and kind; operands must share the kind):
    !!
    !! - Operators: `.approx.`, `+`, `-` (binary and unary), `*` and `/` by a scalar of the same
    !!   kind, `.dev.`, `.ddot.` (scalar \(a_{ij} b_{ij}\)), `.inv.`, assignment of a scalar.
    !! - Generic functions (usable in GPU kernels): `norm(a)`, `det(a)`, `square(a)`,
    !!   `is_approx(a, b [, tol])` and `call inverse(a, a_inv, ok [, cond])`.
    !! - Type-bound (historical API, not for kernels): `init` (array or named components),
    !!   accessors `xx()`, `yy()`, `zz()`, `xy()` (3D also `yz()`, `xz()`), `square`, `norm`,
    !!   `is_approx`, `det`, `inv`.
    !!
    !! ```fortran
    !! use muscle_tensors                      ! ten_3D2Osym is ten_3D2Osym_dp
    !! type(ten_3D2Osym) :: stress
    !! type(ten_3D2Osym_sp) :: stress_sp
    !! call stress%init(100.0_dp, 50.0_dp, 20.0_dp, 10.0_dp, 5.0_dp, -2.0_dp)
    !! print *, stress%xy(), stress .ddot. stress, (.dev. stress)%zz()
    !! ```
    !!
    !! For more information see [[muscle_tensors]]
    use muscle_kinds, only: sp, dp
#:for k in REAL_KINDS
    use muscle_kinds, only: TOL_APPROX_${k}$, EPS_ABS_${k}$
#:endfor
    implicit none
    private

#:set F = '2Osym'
#:for d in DIMS
#:set lay = layout(F, d)
#:set n = len(lay.comps)
#:set S = d + F
#:for k in REAL_KINDS
#:set T = tname(S, k)
    type, public :: ${T}$
        !! Symmetric ${d}$ second-order tensor in `real(${k}$)`, stored in tensorial Voigt
        !! notation: `vals` = (${', '.join(c.name for c in lay.comps)}$).
        real(${k}$), dimension(${n}$) :: vals
            !! Independent components (${', '.join(c.name for c in lay.comps)}$).
        contains
            generic, public :: init => init_${S}$_${k}$_tbp, init2_${S}$_${k}$_tbp
                !! Initializes from a ${n}$-element array (Voigt order) or from the named components.
            procedure, private :: init_${S}$_${k}$_tbp, init2_${S}$_${k}$_tbp
#:for c in lay.comps
            procedure, public :: ${c.name}$ => ${c.name}$_${S}$_${k}$_tbp
                !! Accessor for the ${c.name}$ ${c.idx}$ component.
#:endfor
            procedure, public :: square => square_${S}$_${k}$_tbp
                !! Square \(\mathbf{a}\cdot\mathbf{a}\).
            procedure, public :: norm => norm_${S}$_${k}$_tbp
                !! Modified L1 norm (shear components weighted by 2).
            procedure, public :: is_approx => is_approx_${S}$_${k}$_tbp
                !! Component-wise approximate equality.
            procedure, public :: det => det_${S}$_${k}$_tbp
                !! Determinant.
            procedure, public :: inv => inv_${S}$_${k}$_tbp
                !! Inverse tensor (quiet NaN if singular).
    end type ${T}$

#:endfor
#:endfor
    public :: operator(.approx.)
    interface operator (.approx.)
        module procedure ${specifics('approx_{0}_{1}', F)}$
    end interface

    public :: operator(+)
    interface operator (+)
        module procedure ${specifics('sum_{0}_{1}', F)}$
    end interface

    public :: operator(-)
    interface operator (-)
        module procedure ${specifics('sub_{0}_{1}', F)}$
        module procedure ${specifics('subU_{0}_{1}', F)}$
    end interface

    public :: operator(*)
    interface operator (*)
        module procedure ${specifics('mul_real_{0}_{1}', F)}$
        module procedure ${specifics('mul_{0}_real_{1}', F)}$
    end interface

    public :: operator( / )
    interface operator ( / )
        module procedure ${specifics('div_{0}_real_{1}', F)}$
    end interface

    public :: operator(.dev.)
    interface operator (.dev.)
        module procedure ${specifics('dev_{0}_{1}', F)}$
    end interface

    public :: operator(.ddot.)
    interface operator (.ddot.)
        module procedure ${specifics('ddot_{0}_{0}_{1}', F)}$
    end interface

    public :: assignment (=)
    interface assignment (=)
        module procedure ${specifics('assign_{0}_real_{1}', F)}$
    end interface

    public :: operator(.inv.)
    interface operator (.inv.)
        module procedure ${specifics('inv_{0}_{1}', F)}$
    end interface

    public :: inverse
    interface inverse
        !! `call inverse(a, a_inv, ok [, cond])`: inverse with a success flag and condition number.
        module procedure ${specifics('inverse_{0}_{1}', F)}$
    end interface

    public :: norm
    interface norm
        !! Modified L1 norm (shear components weighted by 2).
        module procedure ${specifics('norm_{0}_{1}', F)}$
    end interface

    public :: det
    interface det
        !! Determinant.
        module procedure ${specifics('det_{0}_{1}', F)}$
    end interface

    public :: square
    interface square
        !! Square \(\mathbf{a}\cdot\mathbf{a}\).
        module procedure ${specifics('square_{0}_{1}', F)}$
    end interface

    public :: is_approx
    interface is_approx
        !! Component-wise approximate equality, optional relative tolerance.
        module procedure ${specifics('is_approx_{0}_{1}', F)}$
    end interface

contains

#:for d in DIMS
#:set lay = layout(F, d)
#:set n = len(lay.comps)
#:set S = d + F
#:set normals = [c for c in lay.comps if c.idx[0] == c.idx[1]]
#! .dev. and the trace below rely on the normal components being stored first
#:assert [c.pos[0] for c in normals] == [1, 2, 3]
#:for k in REAL_KINDS
#:set T = tname(S, k)
#:set P = S + '_' + k
    ! ---------------------------------------------------------------------------------------
    ! ${T}$
    ! ---------------------------------------------------------------------------------------

    pure subroutine assign_${S}$_real_${k}$(a, b)
        !! `${T}$ = scalar`: assigns `b` to every stored component.
        implicit none
        @:DEVICE()
        type(${T}$), intent(out) :: a
            !! Target tensor.
        real(${k}$), intent(in) :: b
            !! Scalar value copied to all ${n}$ components.
        a%vals = b
    end subroutine assign_${S}$_real_${k}$

    pure function norm_${P}$(a) result(res)
        !! Modified L1 norm of a `${T}$`, shear components weighted by 2:
        !! ${' + '.join(('2|' if c.mult == 2 else '|') + 'a_' + ''.join(map(str, c.idx)) + '|' for c in lay.comps)}$.
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Tensor whose norm is computed.
        real(${k}$) :: res
            !! Modified L1 norm.
        res = ${join_terms([('{}*'.format(c.mult) if c.mult > 1 else '') + 'abs(a%vals({}))'.format(c.pos[0]) for c in lay.comps])}$
    end function norm_${P}$

    pure function is_approx_${P}$(a, b, tol) result(res)
        !! Component-wise approximate equality of two `${T}$` with a relative tolerance:
        !! \( |a_I - b_I| \le tol \cdot \max(\max|a|, \max|b|, \epsilon_{abs}) \) for all I.
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! First tensor.
        type(${T}$), intent(in) :: b
            !! Second tensor.
        real(${k}$), optional, intent(in) :: tol
            !! Relative tolerance (default `TOL_APPROX_${k}$`).
        logical :: res
            !! `.true.` if both tensors are approximately equal.
        real(${k}$) :: tol2, max_val

        tol2 = TOL_APPROX_${k}$
        if (present(tol)) tol2 = tol
        max_val = max(maxval(abs(a%vals)), maxval(abs(b%vals)), EPS_ABS_${k}$)
        res = all(abs(a%vals - b%vals) .le. tol2 * max_val)
    end function is_approx_${P}$

    pure function approx_${P}$(a, b) result(res)
        !! `${T}$ .approx. ${T}$`: `is_approx` with its default tolerance.
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! First tensor.
        type(${T}$), intent(in) :: b
            !! Second tensor.
        logical :: res
            !! `.true.` if both tensors are approximately equal.
        res = is_approx_${P}$(a, b)
    end function approx_${P}$

    pure function sum_${P}$(a, b) result(res)
        !! Component-wise sum of two `${T}$`.
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! First operand.
        type(${T}$), intent(in) :: b
            !! Second operand.
        type(${T}$) :: res
            !! Sum.
        res%vals = a%vals + b%vals
    end function sum_${P}$

    pure function sub_${P}$(a, b) result(res)
        !! Component-wise difference of two `${T}$`.
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Minuend.
        type(${T}$), intent(in) :: b
            !! Subtrahend.
        type(${T}$) :: res
            !! Difference.
        res%vals = a%vals - b%vals
    end function sub_${P}$

    pure function subU_${P}$(a) result(res)
        !! Unary negation of a `${T}$`.
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Operand.
        type(${T}$) :: res
            !! Negated tensor.
        res%vals = -a%vals
    end function subU_${P}$

    pure function mul_real_${P}$(a, b) result(res)
        !! `real(${k}$) * ${T}$`.
        implicit none
        @:DEVICE()
        real(${k}$), intent(in) :: a
            !! Scalar factor.
        type(${T}$), intent(in) :: b
            !! Tensor.
        type(${T}$) :: res
            !! Scaled tensor.
        res%vals = a * b%vals
    end function mul_real_${P}$

    pure function mul_${S}$_real_${k}$(a, b) result(res)
        !! `${T}$ * real(${k}$)`.
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Tensor.
        real(${k}$), intent(in) :: b
            !! Scalar factor.
        type(${T}$) :: res
            !! Scaled tensor.
        res%vals = a%vals * b
    end function mul_${S}$_real_${k}$

    pure function div_${S}$_real_${k}$(a, b) result(res)
        !! `${T}$ / real(${k}$)`.
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Tensor.
        real(${k}$), intent(in) :: b
            !! Scalar divisor (must be non-zero).
        type(${T}$) :: res
            !! Scaled tensor.
        res%vals = a%vals/b
    end function div_${S}$_real_${k}$

    pure function ddot_${S}$_${P}$(a, b) result(res)
        !! Double contraction of two `${T}$`, \(a_{ij} b_{ij}\) (shear products counted twice).
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! First operand.
        type(${T}$), intent(in) :: b
            !! Second operand.
        real(${k}$) :: res
            !! Scalar result.
        res = ${join_terms([('{}*'.format(c.mult) if c.mult > 1 else '') + 'a%vals({0})*b%vals({0})'.format(c.pos[0]) for c in lay.comps])}$
    end function ddot_${S}$_${P}$

    pure function dev_${P}$(a) result(res)
        !! Deviatoric part of a `${T}$`, \(\mathbf{a} - \frac{1}{3}\mathrm{tr}(\mathbf{a})\mathbf{I}\).
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Operand.
        type(${T}$) :: res
            !! Deviatoric tensor.
        real(${k}$) :: hydro
        hydro = (a%vals(1) + a%vals(2) + a%vals(3))/3.0_${k}$
        res%vals(1:3) = a%vals(1:3) - hydro
        res%vals(4:${n}$) = a%vals(4:${n}$)
    end function dev_${P}$

    pure function square_${P}$(a) result(res)
        !! Square \(\mathbf{a}\cdot\mathbf{a}\) of a `${T}$` (symmetric for a symmetric tensor).
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Operand.
        type(${T}$) :: res
            !! Squared tensor.
#:if d == '3D'
        res%vals(1) = a%vals(1)**2 + a%vals(4)**2 + a%vals(6)**2
        res%vals(2) = a%vals(2)**2 + a%vals(4)**2 + a%vals(5)**2
        res%vals(3) = a%vals(3)**2 + a%vals(5)**2 + a%vals(6)**2
        res%vals(4) = a%vals(4)*(a%vals(1) + a%vals(2)) + a%vals(5)*a%vals(6)
        res%vals(5) = a%vals(5)*(a%vals(2) + a%vals(3)) + a%vals(4)*a%vals(6)
        res%vals(6) = a%vals(6)*(a%vals(1) + a%vals(3)) + a%vals(4)*a%vals(5)
#:else
        res%vals(1) = a%vals(1)**2 + a%vals(4)**2
        res%vals(2) = a%vals(2)**2 + a%vals(4)**2
        res%vals(3) = a%vals(3)**2
        res%vals(4) = a%vals(4)*(a%vals(1) + a%vals(2))
#:endif
    end function square_${P}$

    pure function det_${P}$(a) result(res)
        !! Determinant of a `${T}$` (of its symmetric 3x3 matrix).
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Tensor.
        real(${k}$) :: res
            !! Determinant.
#:if d == '3D'
        real(${k}$) :: a11, a22, a33, a12, a23, a13

        a11 = a%vals(1); a22 = a%vals(2); a33 = a%vals(3)
        a12 = a%vals(4); a23 = a%vals(5); a13 = a%vals(6)

        res = a11 * (a22 * a33 - a23**2) &
            - a12 * (a12 * a33 - a23 * a13) &
            + a13 * (a12 * a23 - a22 * a13)
#:else
        ! (A11 A22 - A12^2) A33
        res = (a%vals(1)*a%vals(2) - a%vals(4)**2) * a%vals(3)
#:endif
    end function det_${P}$

    pure subroutine inverse_${P}$(a, a_inv, ok, cond)
        !! Inverse of a `${T}$` with a success flag (generic `inverse`, also used by `.inv.`).
        !!
        !! The full symmetric 3x3 matrix is inverted with `M33INV` (adjugate + \( \kappa_\infty \),
        !! LU fallback); the off-diagonal result is symmetrized. If it is singular (or contains
        !! NaN): `ok = .false.`, `a_inv` is filled with quiet NaN and `cond = huge(1.0_${k}$)`.
        use muscle_math_inverses, only : M33INV, QUIET_NAN_${k}$
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Tensor to invert.
        type(${T}$), intent(out) :: a_inv
            !! Inverse tensor (quiet NaN if `a` is singular).
        logical, intent(out) :: ok
            !! `.true.` if the inversion succeeded, `.false.` if `a` is singular.
        real(${k}$), intent(out), optional :: cond
            !! Condition number \( \kappa_\infty \) of the inverted 3x3 matrix; `huge(1.0_${k}$)` if singular.
        real(${k}$) :: m(3,3), x(3,3), kap

#:for j in range(1, 4)
        m(:,${j}$) = (/ ${', '.join(lay.ref('a%vals', i, j, zero='0.0_' + k) for i in range(1, 4))}$ /)
#:endfor
        call M33INV(m, x, ok, kap)
        if (.not. ok) then
            a_inv%vals = QUIET_NAN_${k}$()
            if (present(cond)) cond = huge(1.0_${k}$)
            return
        end if
#:for c in lay.comps
#:set i, j = c.idx
#:if i == j
        a_inv%vals(${c.pos[0]}$) = x(${i}$,${j}$)
#:else
        a_inv%vals(${c.pos[0]}$) = 0.5_${k}$*(x(${i}$,${j}$) + x(${j}$,${i}$))
#:endif
#:endfor
        if (present(cond)) cond = kap
    end subroutine inverse_${P}$

    pure function inv_${P}$(a) result(res)
        !! `.inv. ${T}$`: inverse; quiet NaN if singular (use the generic `inverse` to get a
        !! success flag and the condition number).
        implicit none
        @:DEVICE()
        type(${T}$), intent(in) :: a
            !! Tensor to invert.
        type(${T}$) :: res
            !! Inverse tensor.
        logical :: ok
        call inverse_${P}$(a, res, ok)
    end function inv_${P}$

    ! Type-bound wrappers of ${T}$ (historical API; `class` passed object, not for kernels)

    pure subroutine init_${P}$_tbp(self, vals)
        !! `%init(vals)`: initializes a `${T}$` from a ${n}$-element array in Voigt order
        !! (${', '.join(c.name for c in lay.comps)}$).
        implicit none
        class(${T}$), intent(inout) :: self
            !! Tensor to initialize.
        real(${k}$), intent(in) :: vals(${n}$)
            !! Components in Voigt order.
        self%vals = vals
    end subroutine init_${P}$_tbp

    pure subroutine init2_${P}$_tbp(self, ${', '.join(c.name for c in lay.comps)}$)
        !! `%init(${', '.join(c.name for c in lay.comps)}$)`: initializes a `${T}$` from its
        !! ${n}$ individual components.
        implicit none
        class(${T}$), intent(inout) :: self
            !! Tensor to initialize.
#:for c in lay.comps
        real(${k}$), intent(in) :: ${c.name}$
            !! Component ${c.idx}$.
#:endfor
        self%vals = (/${', '.join(c.name for c in lay.comps)}$/)
    end subroutine init2_${P}$_tbp

#:for c in lay.comps
    pure function ${c.name}$_${P}$_tbp(self) result(res)
        !! `%${c.name}$()`: component ${c.idx}$ of a `${T}$` (`vals(${c.pos[0]}$)`).
        implicit none
        class(${T}$), intent(in) :: self
            !! Tensor.
        real(${k}$) :: res
            !! Component value.
        res = self%vals(${c.pos[0]}$)
    end function ${c.name}$_${P}$_tbp

#:endfor
#:for op, rtype in [('square', 'type(' + T + ')'), ('norm', 'real(' + k + ')'), ('det', 'real(' + k + ')'), ('inv', 'type(' + T + ')')]
    pure function ${op}$_${P}$_tbp(self) result(res)
        !! `%${op}$()`: type-bound wrapper of `${op}$_${P}$`.
        implicit none
        class(${T}$), intent(in) :: self
            !! Tensor.
        ${rtype}$ :: res
            !! Result.
        res = ${op}$_${P}$(self)
    end function ${op}$_${P}$_tbp

#:endfor
    pure function is_approx_${P}$_tbp(self, b, tol) result(res)
        !! `%is_approx(b [, tol])`: type-bound wrapper of `is_approx_${P}$`.
        implicit none
        class(${T}$), intent(in) :: self
            !! First tensor.
        type(${T}$), intent(in) :: b
            !! Second tensor.
        real(${k}$), optional, intent(in) :: tol
            !! Relative tolerance (default `TOL_APPROX_${k}$`).
        logical :: res
            !! `.true.` if both tensors are approximately equal.
        res = is_approx_${P}$(self, b, tol)
    end function is_approx_${P}$_tbp

#:endfor
#:endfor
end module muscle_tensor_2osym
