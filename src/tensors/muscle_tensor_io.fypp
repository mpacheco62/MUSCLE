#:include "muscle_common.fypp"
! lint: host-only
#! Formatted output (UDTIO `write(formatted)`) of the templated tensor types, generated from
#! their layouts. Host-only: kept out of the kernel modules (D-011). Families are added here as
#! they are migrated (Phase 3).
#:set IO_FAMILIES = ['2Osym']

module muscle_tensor_io
    !! Formatted output of tensors (only with `ENABLE_UDTIO`):
    !!
    !! - `write(unit, '(DT"LIST")') t` (optionally `DT"LIST"(w,d)`): the stored components,
    !!   `[ xx yy ... ]` in storage order.
    !! - `write(unit, '(DT)') t` and list-directed `write(unit, *) t`: the full 3x3 matrix, one
    !!   row per record (2D types print the vanishing out-of-plane components as zero). gfortran 15
    !!   ignores the record breaks when `unit` is an internal (character) unit.
    use muscle_kinds, only: sp, dp
    use muscle_tensor_2osym, only: ${', '.join(tname(d + f, k) for f in IO_FAMILIES for d in DIMS for k in REAL_KINDS)}$
    implicit none
    private
#:if defined('ENABLE_UDTIO')

    public :: write(formatted)
    interface write(formatted)
#:for f in IO_FAMILIES
        module procedure ${specifics('print_{0}_{1}', f)}$
#:endfor
    end interface

contains

#:for f in IO_FAMILIES
#:for d in DIMS
#:set lay = layout(f, d)
#:set n = len(lay.comps)
#:for k in REAL_KINDS
#:set T = tname(d + f, k)
    subroutine print_${d + f}$_${k}$(dtv, unit, iotype, v_list, iostat, iomsg)
        !! Formatted output of a `${T}$`: list mode prints the ${n}$ stored components
        !! (${', '.join(c.name for c in lay.comps)}$), matrix mode the full 3x3 matrix.
        class(${T}$), intent(in) :: dtv
            !! Tensor to print.
        integer, intent(in) :: unit
            !! Output unit.
        character(len=*), intent(in) :: iotype
            !! Edit descriptor type (`LISTDIRECTED`, `DT...`).
        integer, intent(in) :: v_list(:)
            !! Optional (width, decimals).
        integer, intent(out) :: iostat
            !! I/O status.
        character(len=*), intent(inout) :: iomsg
            !! I/O error message.
        character(len=100) :: fmt_string
        integer :: w, d

        w = 11
        d = 4
        iostat = 0
        if (size(v_list) >= 1) w = v_list(1)
        if (size(v_list) >= 2) d = v_list(2)

        if (iotype == "DTLIST" .or. iotype == "LIST") then
            write(fmt_string, "('(A, ${n}$(ES', I0, '.', I0, ', 1X), A)')") w, d
            write(unit, fmt_string, iostat=iostat) "[", dtv%vals, "]"
        else
            ! One format with '/' line breaks between the rows of the 3x3 matrix
            write(fmt_string, "('(/, 3(ES', I0, '.', I0, ', 2X), /, 3(ES', I0, '.', I0, ', 2X), ', &
                               & '/, 3(ES', I0, '.', I0, ', 2X))')") w, d, w, d, w, d
            write(unit, fmt_string, iostat=iostat) &
#:for i in range(1, 4)
                ${', '.join(lay.ref('dtv%vals', i, j, zero='0.0_' + k) for j in range(1, 4))}$${', &' if i < 3 else ''}$
#:endfor
        end if

        if (iostat /= 0) then
            iomsg = "Error in print_${d + f}$_${k}$: Failed to write to the specified unit."
        end if
    end subroutine print_${d + f}$_${k}$

#:endfor
#:endfor
#:endfor
#:endif
end module muscle_tensor_io
