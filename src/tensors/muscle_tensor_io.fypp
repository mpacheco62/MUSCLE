#:include "muscle_common.fypp"
! lint: host-only
#! Formatted output (UDTIO `write(formatted)`) of the templated tensor types, generated from
#! their layouts. Host-only: kept out of the kernel modules (D-011). Families are added here as
#! they are migrated (Phase 3).
#:set IO_FAMILIES = ['2Osym', '2O', '4O3sym', '4O2sym', '4O']
#! Families that keep their historical output: the matrix whatever the edit descriptor (no list
#! mode), one write per row with the entries separated by 1X. Their storage is the matrix itself.
#:set IO_MATRIX_ONLY = ['4O']
#! Identities (muscle_tensor_iden, D-014): unscaled `I` (factor 1, printed with dp literals as the
#! original iden_2O) and scaled `S` of each kind. Output of iden_2O/iden_2OS kept character for
#! character, including its default width 10; the error message names its own routine (D-014).

module muscle_tensor_io
    !! Formatted output of tensors (only with `ENABLE_UDTIO`):
    !!
    !! - `write(unit, '(DT"LIST")') t` (optionally `DT"LIST"(w,d)`): the stored components,
    !!   `[ xx yy ... ]` in storage order.
    !! - `write(unit, '(DT)') t` and list-directed `write(unit, *) t`: the matrix, one row per
    !!   record: the full 3x3 matrix for 2nd-order tensors (2D types print the vanishing
    !!   out-of-plane components as zero) and the Voigt matrix \(C_{IJ}\) (6x6 in 3D, 4x4 in 2D,
    !!   tensorial components, no shear factors) for fourth-order ones. gfortran 15 ignores the
    !!   record breaks when `unit` is an internal (character) unit.
    !! - General fourth-order tensors (`ten_3D4O`, `ten_2D4O`) keep their historical output in
    !!   every mode: the 9x9 / 5x5 matrix, one record per row, entries separated by one blank.
    !! - Identities (`iden_2O`, `iden_4O3T`, `iden_4O4T` and their scaled `iden_*S_sp/_dp`), `F`
    !!   format with default width 10: list mode prints the factor, `[ c ]` (`[ 1.0000 ]` for an
    !!   unscaled one); matrix mode the 3x3 matrix \( c\,\delta_{ij} \) (2nd order) or the 6x6
    !!   Voigt matrix \(C_{IJ}\) (11, 22, 33, 12, 23, 13; tensorial components) of the 4th-order
    !!   ones: \(c\) in the normal 3x3 block for `iden_4O3T` (\(\delta_{ij}\delta_{kl}\)),
    !!   `diag(c, c, c, c/2, c/2, c/2)` for `iden_4O4T` (symmetric identity).
    use muscle_kinds, only: sp, dp
#:for f in IO_FAMILIES
    use muscle_tensor_${f.lower()}$, only: ${', '.join(tname(d + f, k) for d in DIMS for k in REAL_KINDS)}$
#:endfor
    use muscle_tensor_iden, only: ${', '.join(iname(X) for X in IDENTITIES)}$
#:for X in IDENTITIES
    use muscle_tensor_iden, only: ${', '.join(iname(X + 'S', k) for k in REAL_KINDS)}$
#:endfor
    implicit none
    private
#:if defined('ENABLE_UDTIO')

    public :: write(formatted)
    interface write(formatted)
#:for f in IO_FAMILIES
        module procedure ${specifics('print_{0}_{1}', f)}$
#:endfor
#:for X in IDENTITIES
        module procedure print_I${X}$, ${kspecifics('print_I{0}S_{1}', X)}$
#:endfor
    end interface

contains

#:for f in IO_FAMILIES
#:for d in DIMS
#:set lay = layout(f, d)
#:set n = len(lay.comps)
#:for k in REAL_KINDS
#:set T = tname(d + f, k)
#:set rows = lay.matrix('dtv%vals', zero='0.0_' + k)
#:set m = len(rows)
    subroutine print_${d + f}$_${k}$(dtv, unit, iotype, v_list, iostat, iomsg)
#:if f in IO_MATRIX_ONLY
        !! Formatted output of a `${T}$`: the ${m}$x${m}$ matrix `vals`, one record per row, in
        !! every mode.
#:else
        !! Formatted output of a `${T}$`: list mode prints the ${n}$ stored components
        !! (${', '.join(c.name for c in lay.comps)}$), matrix mode the ${m}$x${m}$ matrix.
#:endif
        class(${T}$), intent(in) :: dtv  ! lint: allow(oop) the standard requires class in UDTIO
            !! Tensor to print.
        integer, intent(in) :: unit
            !! Output unit.
        character(len=*), intent(in) :: iotype
            !! Edit descriptor type (`LISTDIRECTED`, `DT...`).
        integer, intent(in) :: v_list(:)
            !! Optional (width, decimals).
        integer, intent(out) :: iostat
            !! I/O status.
        character(len=*), intent(inout) :: iomsg
            !! I/O error message.
        character(len=100) :: fmt_string
        integer :: w, d
#:if f in IO_MATRIX_ONLY
        integer :: r
#:endif

        w = 11
        d = 4
        iostat = 0
        if (size(v_list) >= 1) w = v_list(1)
        if (size(v_list) >= 2) d = v_list(2)

#:if f in IO_MATRIX_ONLY
#:assert rows == [['dtv%vals({}, {})'.format(i, j) for j in range(1, m + 1)] for i in range(1, m + 1)]
        ! Historical output of this family, whatever iotype: one record per row of the matrix
        write(fmt_string, "('(/, ${m}$(ES', I0, '.', I0, ', 1X))')") w, d
        do r = 1, ${m}$
            write(unit, fmt_string, iostat=iostat) dtv%vals(r, :)
        end do
#:else
        if (iotype == "DTLIST" .or. iotype == "LIST") then
            write(fmt_string, "('(A, ${n}$(ES', I0, '.', I0, ', 1X), A)')") w, d
            write(unit, fmt_string, iostat=iostat) "[", dtv%vals, "]"
        else
            ! One format with a '/' line break before each row of the ${m}$x${m}$ matrix
            write(fmt_string, "('(${m}$(/, ${m}$(ES', I0, '.', I0, ', 2X)))')") w, d
            write(unit, fmt_string, iostat=iostat) &
#:for i, row in enumerate(rows)
                ${', '.join(row)}$${', &' if i < m - 1 else ''}$
#:endfor
        end if
#:endif

        if (iostat /= 0) then
            iomsg = "Error in print_${d + f}$_${k}$: Failed to write to the specified unit."
        end if
    end subroutine print_${d + f}$_${k}$

#:endfor
#:endfor
#:endfor
#:for X in IDENTITIES
#:for k in [None] + REAL_KINDS
#! Unscaled: factor 1 with dp literals (as the original print_ten_I2O); scaled: dtv%val
#:set P = 'print_I' + X + ('S_' + k if k else '')
#:set T = iname(X + 'S', k) if k else iname(X)
#:set c = 'dtv%val' if k else '1.0_dp'
#:set ck = k if k else 'dp'
#:set rows = iden_matrix(X, one=c, half='0.5_{0} * {1}'.format(ck, c) if k else '0.5_dp', zero='0.0_' + ck)
#:set m = len(rows)
    subroutine ${P}$(dtv, unit, iotype, v_list, iostat, iomsg)
        !! Formatted output of a `${T}$`: list mode prints the factor, matrix mode the ${m}$x${m}$
        !! ${'matrix' if m == 3 else 'Voigt matrix'}$ of the identity.
        class(${T}$), intent(in) :: dtv  ! lint: allow(oop) the standard requires class in UDTIO
            !! Identity to print.
        integer, intent(in) :: unit
            !! Output unit.
        character(len=*), intent(in) :: iotype
            !! Edit descriptor type (`LISTDIRECTED`, `DT...`).
        integer, intent(in) :: v_list(:)
            !! Optional (width, decimals).
        integer, intent(out) :: iostat
            !! I/O status.
        character(len=*), intent(inout) :: iomsg
            !! I/O error message.
        character(len=100) :: fmt_string
        integer :: w, d

        w = 10
        d = 4
        iostat = 0
        if (size(v_list) >= 1) w = v_list(1)
        if (size(v_list) >= 2) d = v_list(2)

        if (iotype == "DTLIST" .or. iotype == "LIST") then
            write(fmt_string, "('(A, 1(F', I0, '.', I0, ', 1X), A)')") w, d
            write(unit, fmt_string, iostat=iostat) "[", ${c}$, "]"
        else
            ! One format with a '/' line break before each row of the ${m}$x${m}$ matrix
            write(fmt_string, "('(${m}$(/, ${m}$(F', I0, '.', I0, ', 2X)))')") w, d
            write(unit, fmt_string, iostat=iostat) &
#:for i, row in enumerate(rows)
                ${', '.join(row)}$${', &' if i < m - 1 else ''}$
#:endfor
        end if

        if (iostat /= 0) then
            iomsg = "Error in ${P}$: Failed to write to the specified unit."
        end if
    end subroutine ${P}$

#:endfor
#:endfor
#:endif
end module muscle_tensor_io
