#:include "muscle_common.fypp"
#:include "muscle_tensor_ops_common.fypp"
#! Dyadic products `.tdot.` and `.tdotsym.` (D-015): the pairs come from OP_TABLE (muscle_meta);
#! the bodies are written once in index notation over the layout of the result:
#! - `.tdot.`: C_ijkl = a_ij b_kl, one row (a_I b_J for every J) of the Voigt matrix per line;
#!   with the identity, a (x) I fills the normal columns and I (x) a the normal rows;
#! - `.tdotsym.`: C_ijkl = (a_ij b_kl + b_ij a_kl)/2 on the stored (upper-triangle) components;
#!   the unary `.tdotsym. a` is a_ij a_kl; with the identity, (a_ij d_kl + d_ij a_kl)/2 and the
#!   mirror I .tdotsym. a calls a .tdotsym. I (same value, as in the original).
#:set MODULE = 'dyadic'

module muscle_tensor_ops_${MODULE}$
    !! This module defines the overloaded dyadic (outer) product operators `.tdot.`
    !! and `.tdotsym.` for mixed second-order symmetric and identity tensors, in 3D and 2D,
    !! single and double precision (both operands of the same kind).
    !!
    !! The standard dyadic product `a .tdot. b` computes the tensor product:
    !! \[ \mathbb{C} = \mathbf{a} \otimes \mathbf{b} \quad \implies \quad C_{ijkl} = a_{ij} b_{kl} \]
    !! The result is a fourth-order tensor with minor symmetries (`ten_3D4O2sym`, `ten_2D4O2sym`):
    !! the Voigt matrix \(C_{IJ} = a_I b_J\). Major symmetry holds only when \(\mathbf{a}\) and
    !! \(\mathbf{b}\) are proportional.
    !!
    !! The symmetrized dyadic product `a .tdotsym. b` computes the symmetric part:
    !! \[ \mathbb{C} = \frac{1}{2} (\mathbf{a} \otimes \mathbf{b} + \mathbf{b} \otimes \mathbf{a}) \]
    !! This formulation preserves major symmetry, yielding a fully symmetric fourth-order tensor
    !! (`ten_3D4O3sym`, `ten_2D4O3sym`).
    !! It is also overloaded for the unary-like self-product `.tdotsym. a` which computes \(\mathbf{a} \otimes \mathbf{a}\).
    !!
    !! With the identity \(\mathbf{I}\) as an operand, `a .tdot. I` (`I .tdot. a`) fills the normal
    !! columns (rows) of the Voigt matrix with \(\mathbf{a}\) and zeroes the rest; `a .tdotsym. I`
    !! and `I .tdotsym. a` are equal.
$:OP_USES(MODULE)
    implicit none
    private

$:OP_INTERFACES(MODULE)
contains

#:for d in DIMS
#:for k in REAL_KINDS
#! ------------------------------------------------------------------------------------------
#! .tdot.: C_IJ = a_I b_J (4O2sym, Voigt matrix of the 2Osym layout)
#! ------------------------------------------------------------------------------------------
#:for e in op_entries('.tdot.', d, k)
#:set x, y = op_args(e)
#:set rows = op_layout(e.tag_res).base.comps
#:set A, B, R = op_symbols(e, 'ab')
#:if not op_iden(e.tag_a) and not op_iden(e.tag_b)
#:set doc = 'Dyadic product \\(\\mathbb{C} = \\mathbf{a} \\otimes \\mathbf{b}\\), \\( C_{IJ} = a_I b_J \\)'
    pure function ${e.name}$(${x}$, ${y}$) result(res)
        !! ${op_doc(e, doc)}$
        implicit none
        @:DEVICE()
        type(${e.a}$), intent(in) :: ${x}$
        type(${e.b}$), intent(in) :: ${y}$
        ${op_res_decl(e)}$ :: res
#! b%vals(:) runs over the columns: the result columns use the storage order of b
#:assert [c.idx for c in rows] == [c.idx for c in op_layout(e.tag_b).comps]
#:for r in rows
        res%vals(${r.pos[0]}$,:) = ${op_layout(e.tag_a).ref('a%vals', *r.idx)}$ * b%vals(:)
#:endfor
    end function ${e.name}$

#:else
#! a (x) I: a in every normal column (d_kl = 1); I (x) a: a in every normal row
#:set left = op_iden(e.tag_a) is not None
#:set doc = 'Dyadic product \\(\\mathbb{{C}} = {} \\otimes {}\\)'.format(A, B)
    pure function ${e.name}$(${x}$, ${y}$) result(res)
        !! ${op_doc(e, doc)}$
        implicit none
        @:DEVICE()
        type(${e.a}$), intent(in) :: ${x}$
        type(${e.b}$), intent(in) :: ${y}$
        ${op_res_decl(e)}$ :: res
        res%vals = 0.0_${k}$
#:for r in rows
#:if r.idx[0] == r.idx[1]
        res%vals(${'{},:'.format(r.pos[0]) if left else ':,{}'.format(r.pos[0])}$) = a%vals
#:endif
#:endfor
    end function ${e.name}$

#:endif
#:endfor
#! ------------------------------------------------------------------------------------------
#! .tdotsym.: upper triangle of the Voigt matrix (4O3sym storage)
#! ------------------------------------------------------------------------------------------
#:for e in op_entries('.tdotsym.', d, k)
#:set x = op_args(e)[0]
#:set y = op_args(e)[-1]
#:set comps = op_layout(e.tag_res).comps
#:if e.tag_b is None
#:set la = op_layout(e.tag_a)
#:set doc = 'Dyadic product with itself \\(\\mathbb{C} = \\mathbf{a} \\otimes \\mathbf{a}\\)'
    pure function ${e.name}$(${x}$) result(res)
        !! ${op_doc(e, doc)}$
        implicit none
        @:DEVICE()
        type(${e.a}$), intent(in) :: ${x}$
        ${op_res_decl(e)}$ :: res
#:for c in comps
        res%vals(${c.pos[0]}$) = ${la.ref('a%vals', *c.idx[:2])}$*${la.ref('a%vals', *c.idx[2:])}$
#:endfor
    end function ${e.name}$

#:elif not op_iden(e.tag_a) and not op_iden(e.tag_b)
#:set la, lb = op_layout(e.tag_a), op_layout(e.tag_b)
#:set doc = 'Symmetrized dyadic product &
    & \\(\\mathbb{C} = \\frac{1}{2} (\\mathbf{a} \\otimes \\mathbf{b} + \\mathbf{b} \\otimes \\mathbf{a})\\)'
    pure function ${e.name}$(${x}$, ${y}$) result(res)
        !! ${op_doc(e, doc)}$
        implicit none
        @:DEVICE()
        type(${e.a}$), intent(in) :: ${x}$
        type(${e.b}$), intent(in) :: ${y}$
        ${op_res_decl(e)}$ :: res
#:for c in comps
#:set ij, kl = c.idx[:2], c.idx[2:]
#! The diagonal (I == J) is written a_I b_I: (a_I b_I + b_I a_I)/2 gives the same bits but
#! overflows when a_I b_I > huge/2 (the original 3D code; unified by the user, 2026-10-30)
#:if c.voigt[0] == c.voigt[1]
        res%vals(${c.pos[0]}$) = ${la.ref('a%vals', *ij)}$*${lb.ref('b%vals', *kl)}$
#:else
        res%vals(${c.pos[0]}$) = 0.5_${k}$ * (${la.ref('a%vals', *ij)}$*${lb.ref('b%vals', *kl)}$ + ${lb.ref('b%vals', *ij)}$*${la.ref('a%vals', *kl)}$)
#:endif
#:endfor
    end function ${e.name}$

#:elif op_iden(e.tag_b)
#! C_ijkl = (a_ij d_kl + d_ij a_kl)/2
#:set la = op_layout(e.tag_a)
#:set doc = 'Symmetrized dyadic product &
    & \\(\\mathbb{C} = \\frac{1}{2}(\\mathbf{a} \\otimes \\mathbf{I} + \\mathbf{I} \\otimes \\mathbf{a})\\)'
    pure function ${e.name}$(${x}$, ${y}$) result(res)
        !! ${op_doc(e, doc)}$
        implicit none
        @:DEVICE()
        type(${e.a}$), intent(in) :: ${x}$
        type(${e.b}$), intent(in) :: ${y}$
        ${op_res_decl(e)}$ :: res
#:for c in comps
#:set ij, kl = c.idx[:2], c.idx[2:]
#:set terms = [la.ref('a%vals', *x) for x, y in ((ij, kl), (kl, ij)) if y[0] == y[1]]
#:if not terms
        res%vals(${c.pos[0]}$) = 0.0_${k}$
#:elif ij == kl
        res%vals(${c.pos[0]}$) = ${terms[0]}$
#:elif len(terms) == 1
        res%vals(${c.pos[0]}$) = 0.5_${k}$ * ${terms[0]}$
#:else
        res%vals(${c.pos[0]}$) = 0.5_${k}$ * (${' + '.join(terms)}$)
#:endif
#:endfor
    end function ${e.name}$

#:else
#:set doc = 'Symmetrized dyadic product &
    & \\(\\mathbb{C} = \\frac{1}{2}(\\mathbf{I} \\otimes \\mathbf{a} + \\mathbf{a} \\otimes \\mathbf{I})\\)'
    pure function ${e.name}$(${x}$, ${y}$) result(res)
        !! ${op_doc(e, doc)}$
        implicit none
        @:DEVICE()
        type(${e.a}$), intent(in) :: ${x}$
        type(${e.b}$), intent(in) :: ${y}$
        ${op_res_decl(e)}$ :: res
        res = ${op_mirror(e).name}$(a, I2)
    end function ${e.name}$

#:endif
#:endfor
#:endfor
#:endfor
end module muscle_tensor_ops_${MODULE}$
