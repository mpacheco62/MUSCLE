#:include "muscle_common.fypp"

module muscle_math_derivatives
    !! Derivatives of tensor functions: `dsquare`, the analytical derivative of the square of a
    !! symmetric tensor, for each real kind (`dsquare_sp`, `dsquare_dp`); kernel routine.
    !! Numerical derivatives are the finite-difference macros of `tests/common/muscle_fd.fypp`
    !! (`FD_DERIV`, `FD_GRAD`, `FD_JAC`, `FD_HESS`), which call the function directly.
    use muscle_kinds, only : sp, dp
    use muscle_tensor_2osym, only : ${', '.join(tname('3D2Osym', k) for k in REAL_KINDS)}$
    use muscle_tensor_4o3sym, only : ${', '.join(tname('3D4O3sym', k) for k in REAL_KINDS)}$
    implicit none
    private

    public :: dsquare
#:for k in REAL_KINDS
    public :: dsquare_${k}$
#:endfor

    interface dsquare
        module procedure ${kspecifics('{0}_{1}', 'dsquare')}$
    end interface dsquare

contains
#:for k in REAL_KINDS

    pure function dsquare_${k}$(a) result(res)
        !! Analytical derivative of the square of a symmetric tensor with respect to the tensor
        !! (Itskov, 2007, Eq. 6.119 with k = 2), in `real(${k}$)`:
        !! \[ \frac{\partial (A^2)_{ij}}{\partial A_{kl}} = \frac{1}{2} \left( \delta_{ik} A_{lj}
        !!    + \delta_{jl} A_{ik} + \delta_{il} A_{kj} + \delta_{jk} A_{il} \right) \]
        !! It is linear in A, so `dsquare(c*A)` equals `c * dsquare(A)`.
        !! Called by `d2Eigenvalues_dTensor2` (`muscle_math_spectral_derivs`).
        implicit none
        @:DEVICE()
        type(${tname('3D2Osym', k)}$), intent(in) :: a
            !! Symmetric tensor \( A \).
        type(${tname('3D4O3sym', k)}$) :: res
            !! \( \partial (A^2)/\partial A \).

        ! Storage order of ten_3D4O3sym; a%vals = (xx, yy, zz, xy, yz, xz)
        res%vals(1) = 2.0_${k}$*a%vals(1)
        res%vals(2) = 2.0_${k}$*a%vals(2)
        res%vals(3) = 2.0_${k}$*a%vals(3)
        res%vals(4) = 0.5_${k}$*(a%vals(1)+a%vals(2))
        res%vals(5) = 0.5_${k}$*(a%vals(2)+a%vals(3))
        res%vals(6) = 0.5_${k}$*(a%vals(1)+a%vals(3))
        res%vals(7) = 0.0_${k}$
        res%vals(8) = 0.0_${k}$
        res%vals(9) = 0.0_${k}$
        res%vals(10) = 0.5_${k}$*a%vals(6)
        res%vals(11) = 0.5_${k}$*a%vals(4)
        res%vals(12) = 0.0_${k}$
        res%vals(13) = a%vals(4)
        res%vals(14) = a%vals(5)
        res%vals(15) = 0.5_${k}$*a%vals(5)
        res%vals(16) = a%vals(4)
        res%vals(17) = a%vals(5)
        res%vals(18) = a%vals(6)
        res%vals(19) = 0.0_${k}$
        res%vals(20) = 0.0_${k}$
        res%vals(21) = a%vals(6)
    end function dsquare_${k}$
#:endfor

end module muscle_math_derivatives
