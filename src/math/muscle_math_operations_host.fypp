#:include "muscle_common.fypp"
#:include "muscle_fd.fypp"
! lint: host-only
#! Finite differences of `muscle_math_operations` that take the function as a `procedure(...)`
#! argument: host-only API kept in sp/dp until Phase 6 (D-016.3). Re-exported by
#! muscle_math_operations.
#! Steps per kind: FD_STEP_FWD_<k> and FD_STEP_CEN_<k> of muscle_kinds (D-016.7); the central
#! difference is the kernel macro FD_GRAD of muscle_fd.fypp (D-016.4).

module muscle_math_operations_host
    !! Forward finite-difference derivatives of a scalar function of a 3x3 matrix or of a
    !! `ten_3D2Osym`, for each real kind (`derivative_escalar_tensor3x3_sp`, `..._dp`, ...) under
    !! the historical names. Host-only: the function is passed as a `procedure(...)` argument,
    !! which is not allowed in kernels (D-016). Use them through `muscle_math_operations`.
    use muscle_kinds, only : sp, dp
#:for k in REAL_KINDS
    use muscle_kinds, only : FD_STEP_FWD_${k}$
#:endfor
    use muscle_tensor_2osym, only : ${', '.join(tname('3D2Osym', k) for k in REAL_KINDS)}$
    implicit none
    private

    public :: derivative, derivative_escalar_tensor3x3, derivative_escalar_tensor3x3sym, &
              derivative_escalar_tensor3x3sym2
#:for k in REAL_KINDS
    public :: derivative_escalar_tensor3x3_${k}$, derivative_escalar_tensor3x3sym_${k}$, &
              derivative_escalar_tensor3x3sym2_${k}$
#:endfor

    interface derivative
        module procedure ${kspecifics('{0}_{1}', 'derivative_escalar_tensor3x3sym')}$
        module procedure ${kspecifics('{0}_{1}', 'derivative_escalar_tensor3x3sym2')}$
    end interface derivative

#:for name in ['derivative_escalar_tensor3x3', 'derivative_escalar_tensor3x3sym', 'derivative_escalar_tensor3x3sym2']
    interface ${name}$
        module procedure ${kspecifics('{0}_{1}', name)}$
    end interface ${name}$

#:endfor
  contains
#:for k in REAL_KINDS
#:set T2 = tname('3D2Osym', k)

      pure function derivative_escalar_tensor3x3_${k}$(func, mat) result(res)
        !! Forward difference \( \partial f/\partial A_{ij} \) of a scalar function of a 3x3
        !! `real(${k}$)` matrix, absolute step `FD_STEP_FWD_${k}$`.
        implicit none
        interface
          pure function f_scalar_3x3(x)
            import :: ${k}$
            implicit none
            real(${k}$), intent(in), dimension(3,3) :: x
            real(${k}$) :: f_scalar_3x3
          end function f_scalar_3x3
        end interface

        procedure(f_scalar_3x3) :: func
        real(${k}$), intent(in) :: mat(3,3)
        real(${k}$) :: res(3,3)

        real(${k}$) :: mat_var(3,3), val_func, val_func_var
        real(${k}$), parameter :: EPS = FD_STEP_FWD_${k}$
        integer :: i,j


        res = 0.0_${k}$
        val_func = func(mat)
        do i=1,3
            do j=1,3
                mat_var = mat
                mat_var(i,j) = mat_var(i,j) + EPS
                val_func_var = func(mat_var)
                res(i,j) = (val_func_var - val_func)/EPS
            end do
        end do
      end function derivative_escalar_tensor3x3_${k}$

      pure function derivative_escalar_tensor3x3sym_${k}$(func, mat) result(res)
        !! Central difference of a scalar function of a `${T2}$` (`FD_GRAD`), shear components
        !! perturbed by half the step. Step \( h = \max(\|A\|\,rel, min) \) (\( h = rel \)
        !! if \( \|A\| = 0 \)), relative to the `norm` of the argument with `rel = FD_STEP_CEN_${k}$`
        !! and `min = FD_STEP_MIN_${k}$` (D-016.4; formerly relative to \( |f(A)| \)).
        implicit none
        interface
          pure function f_scalar_3x3(x)
            import :: ${k}$, ${T2}$
            implicit none
            type(${T2}$), intent(in) :: x
            real(${k}$) :: f_scalar_3x3
          end function f_scalar_3x3
        end interface

        procedure(f_scalar_3x3) :: func
        type(${T2}$), intent(in) :: mat
        type(${T2}$) :: res

        @:FD_GRAD(res, func({x}), mat, ${k}$, 3D, rel=FD_STEP_CEN)
      end function derivative_escalar_tensor3x3sym_${k}$

      pure function derivative_escalar_tensor3x3sym2_${k}$(func, mat) result(res)
        !! Forward difference of a scalar function of a symmetric 3x3 `real(${k}$)` matrix, each
        !! pair of symmetric entries perturbed together (absolute step `FD_STEP_FWD_${k}$`).
        implicit none
        interface
          pure function f_scalar_3x3(x)
            import :: ${k}$
            implicit none
            real(${k}$), intent(in), dimension(3,3) :: x
            real(${k}$) :: f_scalar_3x3
          end function f_scalar_3x3
        end interface

        procedure(f_scalar_3x3) :: func
        real(${k}$), intent(in) :: mat(3,3)
        real(${k}$) :: res(3,3)

        real(${k}$) :: mat_var(3,3), val_func, val_func_var
        real(${k}$), parameter :: EPS = FD_STEP_FWD_${k}$
        integer :: i,j


        res = 0.0_${k}$
        val_func = func(mat)
        do i=1,3
            do j=1,3
                mat_var = mat
                mat_var(i,j) = mat_var(i,j) + EPS/2.0_${k}$
                mat_var(j,i) = mat_var(j,i) + EPS/2.0_${k}$
                val_func_var = func(mat_var)
                res(i,j) = (val_func_var - val_func)/EPS
            end do
        end do
      end function derivative_escalar_tensor3x3sym2_${k}$
#:endfor
end module muscle_math_operations_host
