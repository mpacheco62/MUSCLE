#!
#! Fixed-size LU bodies shared by the small dense inverses (muscle_math_inverses: M55INV, M66INV,
#! M99INV and the private LU fallbacks lu_inv3, lu_inv4 of M33INV, M44INV) and the small linear
#! solvers (muscle_math_lu_solve: LU<n>SOLVE). Two implementations with the same contract (D-034),
#! chosen by size with LU_UNROLL_MAX:
#!   N <= LU_UNROLL_MAX  fully unrolled bodies (lu_*_body_unrolled, section 2);
#!   N >  LU_UNROLL_MAX  loop-based bodies (lu_*_body_loops, section 1).
#! `$:lu_inverse_body(rk, N[, kappa=True])` and `$:lu_solve_body(rk, N)` dispatch on N.
#! Why: unrolled with literal subscripts keeps the work matrix in registers (0 bytes of private
#! memory on the Intel GPU, ~6x faster for 6x6; D-035, benchmarks/math/bench_linalg.fypp and
#! benchmarks/gpu/bench_linalg_gpu.fypp)
#! but costs ~N^3 statements of code. The limit 7 covers the sizes the kernels use (M33INV/M44INV
#! fallbacks, M66INV, LU2..LU7SOLVE); M99INV, LU8SOLVE, LU9SOLVE are not used by any kernel and
#! keep loops, since huge kernels are dropped by IGC in Release (D-019.8).
#!
#! Every body expands at the end of the specification part of a subroutine that declares
#!   integer, parameter :: N            -- matrix size (compile-time constant)
#!   real(rk), intent(in)  :: A(N,N)    -- matrix
#!   logical, intent(out)  :: OK_FLAG
#! Both variants: singular A (exactly zero pivot) or A with a NaN/Inf entry: OK_FLAG = .false.,
#! AINV = 0 (x = 0 and KAPPA = huge(1.0_<rk>) for the solver). With kappa=True the inverse also
#! sets the optional dummy real(rk), intent(out), optional :: KAPPA when present:
#! \kappa_\infty(A) = COND_INF_<rk>(A, AINV), huge(1.0_<rk>) if A is singular. The solver (needs
#! real(rk), intent(in) :: b(N); real(rk), intent(out) :: x(N); real(rk), intent(out), optional ::
#! KAPPA) gives x = inv(A) b and, when KAPPA is present, |A|_inf |inv(A)|_inf from the loop LU
#! (both variants). KAPPA does not change x or OK_FLAG.
#:set LU_UNROLL_MAX = 7

#:def lu_inverse_body(rk, N, kappa=False)
        #:if N <= LU_UNROLL_MAX
        $:lu_inverse_body_unrolled(rk, N, kappa)
        #:else
        $:lu_inverse_body_loops(rk, kappa)
        #:endif
#:enddef

#:def lu_solve_body(rk, N)
        #:if N <= LU_UNROLL_MAX
        $:lu_solve_body_unrolled(rk, N)
        #:else
        $:lu_solve_body_loops(rk)
        #:endif
#:enddef

#! ===== 1. Loop-based bodies (LAPACK DGETRF/DGETRI/DGETRS, unblocked) =====
#! Building blocks: lu_factor(rk, LU) (P A = L U in place, DGETF2-like, pivots in ipiv(N); needs
#! locals integer :: ipiv(N), i, j, k, p; real(rk) :: r, tmp) and lu_subst(rk, LU, v)
#! (v <- inv(A) v, like DGETRS). Inverse: factor, inv(U) in place (DTRTI2), solve inv(A) L =
#! inv(U) (DGETRI), undo the row interchanges as column interchanges.
#:def lu_factor(rk, LU)
        OK_FLAG = .true.
        do k = 1, N
            p = k
            do i = k+1, N
                if (abs(${LU}$(i,k)) > abs(${LU}$(p,k))) p = i
            end do
            ipiv(k) = p
            ! zero, NaN or Inf pivot: singular or not finite (an Inf anywhere in A reaches a pivot as Inf
            ! or NaN through the elimination, D-034)
            if (.not. (abs(${LU}$(p,k)) > 0.0_${rk}$ .and. abs(${LU}$(p,k)) <= huge(1.0_${rk}$))) then
                OK_FLAG = .false.
                exit
            end if
            if (p /= k) then
                do j = 1, N
                    tmp = ${LU}$(k,j); ${LU}$(k,j) = ${LU}$(p,j); ${LU}$(p,j) = tmp
                end do
            end if
            r = 1.0_${rk}$ / ${LU}$(k,k)
            do i = k+1, N
                ${LU}$(i,k) = ${LU}$(i,k) * r
            end do
            do j = k+1, N
                do i = k+1, N
                    ${LU}$(i,j) = ${LU}$(i,j) - ${LU}$(i,k) * ${LU}$(k,j)
                end do
            end do
        end do
#:enddef

#:def lu_subst(rk, LU, v)
        do k = 1, N
            p = ipiv(k)
            if (p /= k) then
                tmp = ${v}$(k); ${v}$(k) = ${v}$(p); ${v}$(p) = tmp
            end if
        end do
        do j = 1, N-1
            do i = j+1, N
                ${v}$(i) = ${v}$(i) - ${LU}$(i,j) * ${v}$(j)
            end do
        end do
        do j = N, 1, -1
            ${v}$(j) = ${v}$(j) / ${LU}$(j,j)
            do i = 1, j-1
                ${v}$(i) = ${v}$(i) - ${LU}$(i,j) * ${v}$(j)
            end do
        end do
#:enddef

#:def lu_inverse_body_loops(rk, kappa=False)
        integer :: ipiv(N), i, j, k, p
        real(${rk}$) :: r, tmp, ajj, s, work(N)

        AINV = A
        ! --- 1. factorization P A = L U ---
        $:lu_factor(rk, 'AINV')
        if (.not. OK_FLAG) then
            AINV = 0.0_${rk}$
            #:if kappa
            if (present(KAPPA)) KAPPA = huge(1.0_${rk}$)
            #:endif
            return
        end if
        ! --- 2. inv(U) in place ---
        do j = 1, N
            AINV(j,j) = 1.0_${rk}$ / AINV(j,j)
            ajj = -AINV(j,j)
            do i = 1, j-1
                work(i) = AINV(i,j)
            end do
            do i = 1, j-1
                s = 0.0_${rk}$
                do k = i, j-1
                    s = s + AINV(i,k) * work(k)
                end do
                AINV(i,j) = s * ajj
            end do
        end do
        ! --- 3. solve inv(A) L = inv(U) ---
        do j = N-1, 1, -1
            do i = j+1, N
                work(i) = AINV(i,j)
                AINV(i,j) = 0.0_${rk}$
            end do
            do k = j+1, N
                do i = 1, N
                    AINV(i,j) = AINV(i,j) - AINV(i,k) * work(k)
                end do
            end do
        end do
        ! --- 4. column interchanges ---
        do j = N-1, 1, -1
            p = ipiv(j)
            if (p /= j) then
                do i = 1, N
                    tmp = AINV(i,j); AINV(i,j) = AINV(i,p); AINV(i,p) = tmp
                end do
            end if
        end do
        #:if kappa
        if (present(KAPPA)) KAPPA = COND_INF_${rk}$(A, AINV)
        #:endif
#:enddef

#! KAPPA = |A|_inf |inv(A)|_inf from the factors in lu (after lu_factor), with the columns inv(A) e_c
#! (N more substitutions). Needs the locals of lu_factor plus integer :: c; real(rk) :: wc(N), rowsum(N).
#:def lu_kappa_cols(rk)
        rowsum = 0.0_${rk}$
        do c = 1, N
            wc = 0.0_${rk}$
            wc(c) = 1.0_${rk}$
            $:lu_subst(rk, 'lu', 'wc')
            do i = 1, N
                rowsum(i) = rowsum(i) + abs(wc(i))
            end do
        end do
        KAPPA = NORM_INF_${rk}$(A) * maxval(rowsum)
#:enddef

#:def lu_solve_body_loops(rk)
        integer :: ipiv(N), i, j, k, p, c
        real(${rk}$) :: r, tmp, lu(N,N), wc(N), rowsum(N)

        lu = A
        $:lu_factor(rk, 'lu')
        if (.not. OK_FLAG) then
            x = 0.0_${rk}$
            if (present(KAPPA)) KAPPA = huge(1.0_${rk}$)
            return
        end if
        x = b
        $:lu_subst(rk, 'lu', 'x')
        if (present(KAPPA)) then
            $:lu_kappa_cols(rk)
        end if
#:enddef

#! ===== 2. Unrolled bodies =====
#! Gauss elimination with partial pivoting on W = [A | rhs] written with FYPP #:for loops (only
#! literal subscripts). Pivoting by compare-and-swap with `merge` (no branch; same tie rule as
#! DGETF2); pivot check without early exit (ok = ok .and. 0 < |piv| <= huge, the reciprocal uses
#! merge(piv, 1, ok)). Blocks: lu_eliminate(rk, N, W, ncol) (needs W(N,ncol), rd(N), t, f, piv,
#! logical sw; OK_FLAG .true. on entry) and lu_backsub(N, W, c0, c1).
#:def lu_eliminate(rk, N, W, ncol)
        #:for kk in range(1, N)
        #:for i in range(kk + 1, N + 1)
        sw = abs(${W}$(${i}$,${kk}$)) > abs(${W}$(${kk}$,${kk}$))
        #:for j in range(kk, ncol + 1)
        t = ${W}$(${kk}$,${j}$)
        ${W}$(${kk}$,${j}$) = merge(${W}$(${i}$,${j}$), t, sw)
        ${W}$(${i}$,${j}$) = merge(t, ${W}$(${i}$,${j}$), sw)
        #:endfor
        #:endfor
        piv = ${W}$(${kk}$,${kk}$)
        OK_FLAG = OK_FLAG .and. (abs(piv) > 0.0_${rk}$ .and. abs(piv) <= huge(1.0_${rk}$))
        rd(${kk}$) = 1.0_${rk}$ / merge(piv, 1.0_${rk}$, OK_FLAG)
        #:for i in range(kk + 1, N + 1)
        f = ${W}$(${i}$,${kk}$) * rd(${kk}$)
        #:for j in range(kk + 1, ncol + 1)
        ${W}$(${i}$,${j}$) = ${W}$(${i}$,${j}$) - f * ${W}$(${kk}$,${j}$)
        #:endfor
        #:endfor
        #:endfor
        piv = ${W}$(${N}$,${N}$)
        OK_FLAG = OK_FLAG .and. (abs(piv) > 0.0_${rk}$ .and. abs(piv) <= huge(1.0_${rk}$))
        rd(${N}$) = 1.0_${rk}$ / merge(piv, 1.0_${rk}$, OK_FLAG)
#:enddef

#:def lu_backsub(N, W, c0, c1)
        #:for i in range(N, 0, -1)
        #:for j in range(c0, c1 + 1)
        #:for m in range(i + 1, N + 1)
        ${W}$(${i}$,${j}$) = ${W}$(${i}$,${j}$) - ${W}$(${i}$,${m}$) * ${W}$(${m}$,${j}$)
        #:endfor
        ${W}$(${i}$,${j}$) = ${W}$(${i}$,${j}$) * rd(${i}$)
        #:endfor
        #:endfor
#:enddef

#:def lu_inverse_body_unrolled(rk, N, kappa=False)
        real(${rk}$) :: W(N,${2*N}$), rd(N), t, f, piv
        logical :: sw

        #:for i in range(1, N + 1)
        #:for j in range(1, N + 1)
        W(${i}$,${j}$) = A(${i}$,${j}$)
        W(${i}$,${N + j}$) = ${'1.0' if i == j else '0.0'}$_${rk}$
        #:endfor
        #:endfor
        OK_FLAG = .true.
        $:lu_eliminate(rk, N, 'W', 2*N)
        $:lu_backsub(N, 'W', N + 1, 2*N)
        #:for i in range(1, N + 1)
        #:for j in range(1, N + 1)
        AINV(${i}$,${j}$) = W(${i}$,${N + j}$)
        #:endfor
        #:endfor
        if (.not. OK_FLAG) AINV = 0.0_${rk}$
        #:if kappa
        if (present(KAPPA)) then
            if (OK_FLAG) then
                KAPPA = COND_INF_${rk}$(A, AINV)
            else
                KAPPA = huge(1.0_${rk}$)
            end if
        end if
        #:endif
#:enddef

#:def lu_solve_body_unrolled(rk, N)
        real(${rk}$) :: W(N,${N + 1}$), rd(N), t, f, piv
        logical :: sw

        #:for i in range(1, N + 1)
        #:for j in range(1, N + 1)
        W(${i}$,${j}$) = A(${i}$,${j}$)
        #:endfor
        W(${i}$,${N + 1}$) = b(${i}$)
        #:endfor
        OK_FLAG = .true.
        $:lu_eliminate(rk, N, 'W', N + 1)
        $:lu_backsub(N, 'W', N + 1, N + 1)
        if (.not. OK_FLAG) then
            x = 0.0_${rk}$
            if (present(KAPPA)) KAPPA = huge(1.0_${rk}$)
            return
        end if
        #:for i in range(1, N + 1)
        x(${i}$) = W(${i}$,${N + 1}$)
        #:endfor
        if (present(KAPPA)) then
            ! kappa through the loop-based path (no second unrolled elimination: code size):
            ! refactor A with the loop LU and take |inv(A)|_inf from the columns inv(A) e_c
            block
                integer :: ipiv(N), i, j, k, p, c
                real(${rk}$) :: r, tmp, lu(N,N), wc(N), rowsum(N)
                lu = A
                $:lu_factor(rk, 'lu')
                if (OK_FLAG) then
                    $:lu_kappa_cols(rk)
                else
                    ! Unreachable in practice: the loop LU picks the same pivots as the unrolled one,
                    ! which succeeded (only a tie or another FMA contraction could differ). Defensive:
                    ! KAPPA must not change x or OK_FLAG.
                    KAPPA = huge(1.0_${rk}$)
                    OK_FLAG = .true.
                end if
            end block
        end if
#:enddef
