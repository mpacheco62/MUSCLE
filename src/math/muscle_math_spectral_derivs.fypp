#:include "muscle_common.fypp"
#! Thresholds per kind. dp keeps the historical values. sp keeps the same fraction of the
#! significant digits: tol_sp ~ tol_dp**(ln eps_sp/ln eps_dp) = tol_dp**0.442 (eps = epsilon(1.0_k)),
#! rounded to one significant digit (1e-11 -> 1.4e-5, 1e-6 -> 2.2e-3, 1e-9 -> 1.0e-4).
#! EPS_TOL and EPS_TOL_SECOND are relative to max(lam_1**2, lam_2**2, lam_3**2, EPS_ABS) (D-016.6; historically
#! absolute, in stress**2 units). REPEATED_TOL is relative to max(|lam_1|, |lam_3|); in dp 1e-9 keeps
#! the error of the quotient theta_ab below 1e-7.
#:set EPS_TOL = {'sp': '1.0e-5', 'dp': '1.0e-11'}
#:set EPS_TOL_SECOND = {'sp': '2.0e-3', 'dp': '1.0e-6'}
#:set REPEATED_TOL = {'sp': '1.0e-4', 'dp': '1.0e-9'}

module muscle_math_spectral_derivs
    !! Exact, analytical, eigenvector-free first and second derivatives of eigenvalues with
    !! respect to their parent symmetric second-order tensor.
    !!
    !! The eigenvalues \(\Sigma_a\) (\(a=1,2,3\)) are roots of the characteristic polynomial:
    !!
    !! \[ P(\Sigma_a) = \Sigma_a^3 - I_1 \Sigma_a^2 + I_2 \Sigma_a - I_3 = 0 \]
    !!
    !! By applying implicit differentiation and the Cayley-Hamilton theorem, the derivatives
    !! are calculated without computing eigenvectors or performing matrix inversions, ensuring
    !! absolute numerical stability even for singular tensors (e.g., when \(\det(\Sigma) = 0\)).
    !!
    !! See the technical documentation for further algebraic details.
    !!
    !! Every routine exists for each real kind (`dEigenvalues_dTensor_sp`, `..._dp`, ...) under
    !! the historical generic name. The thresholds of the double precision routines are the
    !! historical ones; the single precision ones keep the same fraction of the significant
    !! digits, \( tol_{sp} \approx tol_{dp}^{\ln\epsilon_{sp}/\ln\epsilon_{dp}} = tol_{dp}^{0.442} \).
    !! All thresholds are relative to the scale of the eigenvalues, so the results do not
    !! depend on the units of the tensor.
    !!
    !! Also `dsquare(a)`, the analytical derivative of the square of a symmetric tensor (Itskov, 2007), used
    !! by `d2Eigenvalues_dTensor2` and by the Drucker-Prager Hessian; and the gradient and Hessian of a
    !! symmetric function of the eigenvalues from the eigenvectors (`spectral_gradient`, `spectral_hessian`,
    !! de Souza Neto et al., 2008). The eigenvalues and eigenvectors themselves are in `muscle_math_eigen`.
    use muscle_kinds, only : sp, dp
    #:for k in REAL_KINDS
    use muscle_kinds, only : EPS_ABS_${k}$
    #:endfor
    use muscle_tensors
    use muscle_tensor_2osym, only : square
    implicit none
    private

    public :: dEigenvalues_dTensor
    public :: d2Eigenvalues_dTensor2
    public :: spectral_gradient
    public :: spectral_hessian
    public :: spectral_theta
    public :: dsquare
    #:for k in REAL_KINDS
    public :: dEigenvalues_dTensor_${k}$, d2Eigenvalues_dTensor2_${k}$
    public :: spectral_gradient_${k}$, spectral_hessian_${k}$, spectral_theta_${k}$, dsquare_${k}$
    #:endfor

    #:for name in ['dEigenvalues_dTensor', 'd2Eigenvalues_dTensor2', 'spectral_gradient', 'spectral_hessian', 'spectral_theta', &
        & 'dsquare']
    interface ${name}$
        module procedure ${kspecifics('{0}_{1}', name)}$
    end interface ${name}$

    #:endfor
    #:for k in REAL_KINDS
    real(${k}$), parameter :: EPS_TOL_${k}$ = ${EPS_TOL[k]}$_${k}$
        !! `real(${k}$)`: smallest \(|3\Sigma_a^2 - 2I_1\Sigma_a + I_2| / \max(\Sigma_1^2, \Sigma_2^2, \Sigma_3^2)\)
        !! taken as a distinct eigenvalue by `dEigenvalues_dTensor` (below it the root is treated as
        !! repeated). Relative threshold.
    real(${k}$), parameter :: EPS_TOL_SECOND_${k}$ = ${EPS_TOL_SECOND[k]}$_${k}$
        !! `real(${k}$)`: the same relative threshold for `d2Eigenvalues_dTensor2`. Safe tolerance
        !! threshold to prevent division by zero at repeated roots (singularities).
    real(${k}$), parameter :: REPEATED_TOL_${k}$ = ${REPEATED_TOL[k]}$_${k}$
        !! `real(${k}$)`: relative eigenvalue gap below which theta_ab of spectral_hessian takes its
        !! limit value. The limit assumes phi is twice differentiable between the two eigenvalues: the
        !! tolerance keeps that band narrow where it is not (CPB06, a = 2, k /= 0: h'' jumps at lam = 0).
    #:endfor

contains
    #:for k in REAL_KINDS
    #:set T2 = tname('3D2Osym', k)
    #:set T4 = tname('3D4O3sym', k)

    pure function dEigenvalues_dTensor_${k}$(Sigma, eigenvalues) result(res)
        !! First derivative of the eigenvalues (`real(${k}$)`): the first analytical derivative of
        !! all three eigenvalues of a symmetric second-order tensor \(\Sigma_{ij}\) with respect to itself,
        !!
        !! \[ H_{mn}^{(a)} = \frac{\partial \Sigma_a}{\partial \Sigma_{mn}} \]
        !!
        !! The computation is based on the implicit differentiation of the characteristic
        !! polynomial and the Cayley-Hamilton theorem. This approach yields a closed-form
        !! expression free of eigenvectors:
        !!
        !! \[ H_{mn}^{(a)} = \frac{\Sigma^2_{mn} - (I_1 - \Sigma_a)\Sigma_{mn} + (\Sigma_a^2 - I_1\Sigma_a + I_2)\delta_{mn}}
        !!   {3\Sigma_a^2 - 2I_1\Sigma_a + I_2} \]
        !!
        !! Singularities (repeated roots): when eigenvalues coincide (e.g., uniaxial tension or
        !! hydrostatic states), the denominator approaches zero, leading to an indeterminate form
        !! \(0/0\). This routine robustly handles such states by exploiting the identity property
        !! \(\sum_{a=1}^3 \frac{\partial \Sigma_a}{\partial \pmb{\Sigma}} = \mathbf{I}\).
        !! With two identical eigenvalues, the remaining subspace is isotropically divided among the
        !! repeated roots; with three, the identity tensor is isotropically divided by 3.
        implicit none
        @:DEVICE()
        type(${T2}$), intent(in) :: Sigma
            !! Symmetric second-order tensor \(\Sigma_{ij}\)
        real(${k}$), intent(in) :: eigenvalues(3)
            !! Eigenvalues \(\Sigma_1 \ge \Sigma_2 \ge \Sigma_3\) (as from `eigenvals`)
        type(${T2}$) :: res(3)
            !! Resulting derivatives \(H_{ij}^{(a)}\) for \(a=1,2,3\)

        real(${k}$) :: I1, I2, D_scal(3), lam, tol
        type(${T2}$) :: F_tensor
        type(iden_2O) :: I2O
        integer :: a, num_sing
        integer :: good_idx, sing_idx(3)

        ! 1. Compute Invariants
        ! First invariant: trace(\Sigma)
        I1 = Sigma%vals(1) + Sigma%vals(2) + Sigma%vals(3)
        ! Second invariant: 0.5*(I1^2 - tr(\Sigma^2))
        I2 = 0.5_${k}$ * (I1**2 - (Sigma .ddot. Sigma))
        ! Threshold relative to the eigenvalue scale (eigenvalues ordered as by eigenvals);
        ! EPS_ABS avoids a zero threshold for the zero tensor
        tol = EPS_TOL_${k}$*max(eigenvalues(1)**2, eigenvalues(2)**2, eigenvalues(3)**2, EPS_ABS_${k}$)
        ! Second-order identity tensor (\delta_ij)

        num_sing = 0
        good_idx = 1 ! Default initialization

        ! 2. First Pass: Compute denominators and identify singular roots
        do a = 1, 3
            lam = eigenvalues(a)
            ! Characteristic polynomial derivative (scalar denominator)
            D_scal(a) = (3.0_${k}$*lam - 2.0_${k}$*I1)*lam + I2

            ! Check for distinct eigenvalues (well-conditioned denominator)
            if (abs(D_scal(a)) > tol) then
                ! Numerator tensor using Cayley-Hamilton expression
                F_tensor = square(Sigma) - (I1 - lam)*Sigma + (lam*(lam - I1))*I2O + I2*I2O
                res(a) = F_tensor / D_scal(a)
                good_idx = a
            else
                ! Mark as repeated/singular root for post-processing
                num_sing = num_sing + 1
                sing_idx(num_sing) = a
            end if
        end do

        ! 3. Second Pass: Repair singular roots using orthogonal projections
        if (num_sing == 2) then
            ! Two repeated eigenvalues (e.g., pure uniaxial tension/compression)
            ! The degenerate subspace is isotropically averaged from the remaining identity space.
            F_tensor = 0.5_${k}$ * (I2O - res(good_idx))
            res(sing_idx(1)) = F_tensor
            res(sing_idx(2)) = F_tensor

        else if (num_sing == 3) then
            ! Three repeated eigenvalues (e.g., pure hydrostatic stress)
            ! All principal directions are isotropic.
            F_tensor = (1.0_${k}$ / 3.0_${k}$) * I2O
            res(1) = F_tensor
            res(2) = F_tensor
            res(3) = F_tensor
        end if

    end function dEigenvalues_dTensor_${k}$



    pure function d2Eigenvalues_dTensor2_${k}$(Sigma, eigenvalues, H_tensors) result(res)
        !! Second derivative (Hessian) of the eigenvalues (`real(${k}$)`): the second analytical
        !! derivative of all three eigenvalues of a symmetric second-order tensor \(\Sigma_{ij}\)
        !! with respect to itself,
        !!
        !! \[ \mathcal{H}_{mnop}^{(a)} = \frac{\partial^2 \Sigma_a}{\partial \Sigma_{mn} \partial \Sigma_{op}} \]
        !!
        !! This function is pure and returns an array of three fully symmetric fourth-order tensors.
        implicit none
        @:DEVICE()
        type(${T2}$), intent(in) :: Sigma
            !! Symmetric second-order tensor \(\Sigma_{ij}\)
        real(${k}$), intent(in) :: eigenvalues(3)
            !! Eigenvalues \(\Sigma_1 \ge \Sigma_2 \ge \Sigma_3\) (as from `eigenvals`)
        type(${T2}$), intent(in) :: H_tensors(3)
            !! Pre-computed first derivatives \(H_{ij}^{(a)}\)
        type(${T4}$) :: res(3)
            !! Resulting Hessians for \(a=1,2,3\)

        type(${T4}$) :: M_tensor
        type(${T4}$) :: N_tensor
        type(${T2}$) :: H
        type(iden_2O) :: I2O
        type(iden_4O4T) :: I4O4T
        type(iden_4O3T) :: I4O3T
        real(${k}$) :: I1, I2, D_scal, lam, tol
        integer :: a, num_sing, good_idx, sing_idx(3)

        ! First invariant: trace(\Sigma)
        I1 = Sigma%vals(1) + Sigma%vals(2) + Sigma%vals(3)
        ! Second invariant
        I2 = 0.5_${k}$ * (I1**2 - (Sigma .ddot. Sigma))

        ! Fourth-order tensor M_ijkl (analytical derivative of \Sigma^2)
        M_tensor = dsquare(Sigma)
        ! Threshold relative to the eigenvalue scale, as in dEigenvalues_dTensor
        tol = EPS_TOL_SECOND_${k}$*max(eigenvalues(1)**2, eigenvalues(2)**2, eigenvalues(3)**2, EPS_ABS_${k}$)

        num_sing = 0
        good_idx = 1

        do a = 1, 3
            lam = eigenvalues(a)
            D_scal = (3.0_${k}$*lam - 2.0_${k}$*I1)*lam + I2

            if (abs(D_scal) > tol) then
                H = H_tensors(a)
                ! 2. Symmetrized fourth-order N_tensor (numerator) using Cayley-Hamilton-based expression
                N_tensor = M_tensor &
                           - (I1 - lam)*I4O4T &
                           + (I1 - lam)*I4O3T &
                           - 2.0_${k}$ * (Sigma .tdotsym. I2O) &
                           + 2.0_${k}$ * (Sigma .tdotsym. H) &
                           + 2.0_${k}$ * (2.0_${k}$*lam - I1) * (I2O .tdotsym. H) &
                           - 2.0_${k}$ * (3.0_${k}$*lam - I1) * (.tdotsym. H)

                res(a) = N_tensor / D_scal
                good_idx = a
            else
                num_sing = num_sing + 1
                sing_idx(num_sing) = a
            end if
        end do

        ! Repair singular roots using orthogonal projections
        if (num_sing == 2) then
            ! Two repeated eigenvalues: Isotropic averaging of the degenerate subspace
            res(sing_idx(1)) = (-0.5_${k}$) * res(good_idx)
            res(sing_idx(2)) = (-0.5_${k}$) * res(good_idx)
        else if (num_sing == 3) then
            ! Three repeated eigenvalues: Isotropic distribution of the identity subspace
            res(1) = 0.0_${k}$
            res(2) = 0.0_${k}$
            res(3) = 0.0_${k}$
        end if

    end function d2Eigenvalues_dTensor2_${k}$

    pure function spectral_gradient_${k}$(V, dphi) result(res)
        !! Gradient of a symmetric function of the eigenvalues, phi(T) = phi(lam_1, lam_2, lam_3):
        !! dphi/dT = sum_a phi_a v_a (x) v_a, with phi_a = dphi/dlam_a supplied by the caller
        !! (de Souza Neto et al., 2008, Eq. A.7), in `real(${k}$)`. Called by the CPB06 and
        !! Yld2004-18p gradients.
        implicit none
        @:DEVICE()
        real(${k}$), intent(in) :: V(3,3)
            !! Eigenvectors from spectral_decomposition
        real(${k}$), intent(in) :: dphi(3)
            !! phi_a = dphi/dlam_a
        type(${T2}$) :: res

        res%vals(1) = dphi(1)*V(1,1)*V(1,1) + dphi(2)*V(1,2)*V(1,2) + dphi(3)*V(1,3)*V(1,3)
        res%vals(2) = dphi(1)*V(2,1)*V(2,1) + dphi(2)*V(2,2)*V(2,2) + dphi(3)*V(2,3)*V(2,3)
        res%vals(3) = dphi(1)*V(3,1)*V(3,1) + dphi(2)*V(3,2)*V(3,2) + dphi(3)*V(3,3)*V(3,3)
        res%vals(4) = dphi(1)*V(1,1)*V(2,1) + dphi(2)*V(1,2)*V(2,2) + dphi(3)*V(1,3)*V(2,3)
        res%vals(5) = dphi(1)*V(2,1)*V(3,1) + dphi(2)*V(2,2)*V(3,2) + dphi(3)*V(2,3)*V(3,3)
        res%vals(6) = dphi(1)*V(1,1)*V(3,1) + dphi(2)*V(1,2)*V(3,2) + dphi(3)*V(1,3)*V(3,3)
    end function spectral_gradient_${k}$

    pure function spectral_hessian_${k}$(lam, V, dphi, d2phi) result(res)
        !! Hessian of a symmetric function of the eigenvalues, \( \phi(T) = \phi(\lambda_1, \lambda_2, \lambda_3) \),
        !! in `real(${k}$)`, from its eigenvalue derivatives \( \phi_a = \partial\phi/\partial\lambda_a \) and
        !! \( \phi_{ab} = \partial^2\phi/\partial\lambda_a\partial\lambda_b \), supplied by the caller (the yield criterion).
        !! Called by the CPB06, CPB06ex2 and Yld2004-18p Hessians.
        !!
        !! **Where it comes from.** With \( E_a = v_a \otimes v_a \) and \( N_{ab} = \mathrm{sym}(v_a \otimes v_b) \)
        !! (orthonormal eigenvectors \( v_a \)), the derivative of the eigenprojections gives
        !! (de Souza Neto et al., 2008, Box A.6; Miehe, 1998, Eq. 10)
        !!
        !! \[ \frac{\partial^2\phi}{\partial T^2} = \sum_{a,b} \phi_{ab}\, E_a \otimes E_b
        !!    + \sum_{a \lt b} 2\theta_{ab}\, N_{ab} \otimes N_{ab}, \qquad
        !!    \theta_{ab} = \frac{\phi_a - \phi_b}{\lambda_a - \lambda_b}, \]
        !!
        !! and, when \( |\lambda_a - \lambda_b| \le \) `REPEATED_TOL` \( \max(|\lambda_1|, |\lambda_3|) \), the limit
        !! \( \theta_{ab} = \tfrac12(\phi_{aa} + \phi_{bb}) - \phi_{ab} \).
        !!
        !! **Algorithm.** The six eigenbasis tensors resolve the symmetric identity,
        !! \( \sum_a E_a \otimes E_a + 2\sum_{a \lt b} N_{ab} \otimes N_{ab} = I_{sym} \), so the \( N_{13} \) term is
        !! written through the others:
        !!
        !! \[ \frac{\partial^2\phi}{\partial T^2} = \sum_{a,b} (\phi_{ab} - \theta_{13}\delta_{ab})\, E_a \otimes E_b
        !!    + 2(\theta_{12} - \theta_{13})\, N_{12} \otimes N_{12} + 2(\theta_{23} - \theta_{13})\, N_{23} \otimes N_{23}
        !!    + \theta_{13}\, I_{sym}. \]
        !!
        !! 1. \( \theta_{12}, \theta_{13}, \theta_{23} \) (divided difference or its limit, `spectral_theta`).
        !! 2. \( E_a \), \( N_{12} \), \( N_{23} \) in Voigt storage, and
        !!    \( G_a = \sum_b (\phi_{ab} - \theta_{13}\delta_{ab}) E_b \),
        !!    \( S_{12} = 2(\theta_{12} - \theta_{13}) N_{12} \), \( S_{23} = 2(\theta_{23} - \theta_{13}) N_{23} \).
        !! 3. Each of the 21 stored entries, unrolled:
        !!    \( H_{IJ} = \sum_a E_{a,I} G_{a,J} + N_{12,I} S_{12,J} + N_{23,I} S_{23,J} \), plus \( \theta_{13} \) on the
        !!    normal diagonal and \( \theta_{13}/2 \) on the shear diagonal (\( I_{sym} \) in the tensorial storage).
        !!
        !! Five products per entry instead of the nine of the explicit sum and no fourth-order temporaries, so
        !! that on a GPU it stays in registers (D-050). The rounding differs from the explicit sum by a few eps.
        !!
        !! **Weak points (what to watch or improve).**
        !!
        !! - *The quotient \( \theta_{ab} \) dominates the error.* For close eigenvalues \( \phi_a - \phi_b \) cancels:
        !!   the relative error of \( \theta_{ab} \) grows like \( \epsilon\,|\phi_a| / |\phi_a - \phi_b| \) until the gap
        !!   reaches the tolerance. With `REPEATED_TOL` (sp 1e-4, dp 1e-9) the Hessian is accurate to about 3e-5
        !!   relative in sp and 1e-8 in dp near that band, whatever the assembly; the assembly itself adds a few
        !!   eps. Improvements: a tolerance of \( \sqrt\epsilon \) (dp 100 to 1000 times better), or a divided
        !!   difference supplied by the criterion, computed without cancellation (a few eps).
        !! - *The limit assumes \( \phi \) is twice differentiable between the two eigenvalues.* Where
        !!   \( \phi_{ab} \) jumps (CPB06 with a = 2 and k /= 0 at \( \lambda = 0 \)) the limit is wrong inside the band,
        !!   which is why the tolerance stays narrow.
        !! - *The identity needs orthonormal eigenvectors.* The \( \theta_{13} I_{sym} \) term replaces
        !!   \( 2\theta_{13} N_{13} \otimes N_{13} \) exactly only if \( V \) is orthonormal: with the eigenvectors of
        !!   `spectral_decomposition` (orthogonal to a few eps) it adds about \( \epsilon|\theta_{13}| \); a caller passing
        !!   another basis gets the error of the identity, not the explicit sum.
        !! - *The pair eliminated is (1,3).* With the eigenvalues in descending order (as `spectral_decomposition`
        !!   returns them) it is the widest gap, so \( \theta_{13} \) is the best conditioned of the three; the
        !!   differences \( \theta_{12} - \theta_{13} \), \( \theta_{23} - \theta_{13} \) and \( \phi_{aa} - \theta_{13} \)
        !!   cancel when the three are close, but the error stays relative to the size of the entries.
        !! - *Inputs are not checked.* A NaN in `lam`, `dphi` or `d2phi` propagates to every entry; non-finite
        !!   divided differences are not trapped. `spectral_theta` evaluates both the divided difference and the
        !!   limit and selects one: an infinite \( \phi_{aa} \) (CPB06 with 1 <= a < 2 at \( \lambda = 0 \)) raises
        !!   the invalid flag even when the divided difference is selected (the Hessian is then not finite anyway).
        !! - *Memory traffic.* The result has 21 values; on the GPU writing them costs more than computing them.
        !!   Callers that only need \( L^T H L \) or \( C^{-1} + \Delta\gamma H \) could assemble that directly
        !!   from \( E_a \), \( N_{ab} \) without forming \( H \) (not done).
        implicit none
        @:DEVICE()
        real(${k}$), intent(in) :: lam(3)
            !! Eigenvalues from spectral_decomposition, in descending order
        real(${k}$), intent(in) :: V(3,3)
            !! Orthonormal eigenvectors from spectral_decomposition (columns)
        real(${k}$), intent(in) :: dphi(3)
            !! phi_a = dphi/dlam_a
        real(${k}$), intent(in) :: d2phi(3,3)
            !! phi_ab = d2phi/dlam_a dlam_b (symmetric)
        type(${T4}$) :: res

        type(${T2}$) :: E1, E2, E3, N12, N23
        real(${k}$) :: theta(3), g1(6), g2(6), g3(6), s12(6), s23(6)

        theta = spectral_theta_${k}$(lam, dphi, d2phi)
        E1 = sym_outer_${k}$(V(:,1), V(:,1))
        E2 = sym_outer_${k}$(V(:,2), V(:,2))
        E3 = sym_outer_${k}$(V(:,3), V(:,3))
        N12 = sym_outer_${k}$(V(:,1), V(:,2))
        N23 = sym_outer_${k}$(V(:,2), V(:,3))
        ! G_a = sum_b (phi_ab - theta_13 delta_ab) E_b
        g1 = (d2phi(1,1) - theta(2))*E1%vals + d2phi(1,2)*E2%vals + d2phi(1,3)*E3%vals
        g2 = d2phi(1,2)*E1%vals + (d2phi(2,2) - theta(2))*E2%vals + d2phi(2,3)*E3%vals
        g3 = d2phi(1,3)*E1%vals + d2phi(2,3)*E2%vals + (d2phi(3,3) - theta(2))*E3%vals
        s12 = (2.0_${k}$*(theta(1) - theta(2)))*N12%vals
        s23 = (2.0_${k}$*(theta(3) - theta(2)))*N23%vals
        ! Entry (I, J) of the upper triangle
        #:for c in layout('4O3sym', '3D').comps
        #:set I, J = c.voigt
        res%vals(${c.pos[0]}$) = E1%vals(${I}$)*g1(${J}$) + E2%vals(${I}$)*g2(${J}$) + E3%vals(${I}$)*g3(${J}$) &
            + N12%vals(${I}$)*s12(${J}$) + N23%vals(${I}$)*s23(${J}$)
        #:endfor
        ! theta_13 I_sym: 1 on the normal diagonal, 1/2 on the shear diagonal (tensorial storage; entries 1 to 6 of
        ! the 4O3sym storage are the diagonal (11,11) ... (13,13))
        res%vals(1:3) = res%vals(1:3) + theta(2)
        res%vals(4:6) = res%vals(4:6) + 0.5_${k}$*theta(2)
    end function spectral_hessian_${k}$

    pure function spectral_theta_${k}$(lam, dphi, d2phi) result(theta)
        !! The factors \( \theta_{ab} \) of `spectral_hessian` for the pairs (1,2), (1,3), (2,3), in `real(${k}$)`:
        !! the divided difference \( (\phi_a - \phi_b)/(\lambda_a - \lambda_b) \), or its limit
        !! \( \tfrac12(\phi_{aa} + \phi_{bb}) - \phi_{ab} \) when the gap is within `REPEATED_TOL` relative to
        !! \( \max(|\lambda_1|, |\lambda_3|) \). For callers that assemble the Hessian in another basis (the pull-back
        !! of an anisotropic criterion), so that the threshold stays in one place. Selects (merge) instead of
        !! branches; the divisor is 1 in the unused lane, so no division by zero is evaluated.
        implicit none
        @:DEVICE()
        real(${k}$), intent(in) :: lam(3)
            !! Eigenvalues, in descending order
        real(${k}$), intent(in) :: dphi(3)
            !! phi_a = dphi/dlam_a
        real(${k}$), intent(in) :: d2phi(3,3)
            !! phi_ab = d2phi/dlam_a dlam_b
        real(${k}$) :: theta(3)
            !! theta_12, theta_13, theta_23

        real(${k}$) :: tol
        logical :: far(3)

        tol = REPEATED_TOL_${k}$*max(abs(lam(1)), abs(lam(3)))
        far = [abs(lam(1) - lam(2)) > tol, abs(lam(1) - lam(3)) > tol, abs(lam(2) - lam(3)) > tol]
        theta(1) = merge((dphi(1) - dphi(2))/merge(lam(1) - lam(2), 1.0_${k}$, far(1)), &
                         0.5_${k}$*(d2phi(1,1) + d2phi(2,2)) - d2phi(1,2), far(1))
        theta(2) = merge((dphi(1) - dphi(3))/merge(lam(1) - lam(3), 1.0_${k}$, far(2)), &
                         0.5_${k}$*(d2phi(1,1) + d2phi(3,3)) - d2phi(1,3), far(2))
        theta(3) = merge((dphi(2) - dphi(3))/merge(lam(2) - lam(3), 1.0_${k}$, far(3)), &
                         0.5_${k}$*(d2phi(2,2) + d2phi(3,3)) - d2phi(2,3), far(3))
    end function spectral_theta_${k}$

    pure function sym_outer_${k}$(x, y) result(res)
        ! Symmetric part of the outer product of two vectors, sym(x (x) y); x = y gives x (x) x.
        ! Used by spectral_hessian
        implicit none
        @:DEVICE()
        real(${k}$), intent(in) :: x(3), y(3)
        type(${T2}$) :: res

        res%vals(1) = 0.5_${k}$*(x(1)*y(1) + x(1)*y(1))
        res%vals(2) = 0.5_${k}$*(x(2)*y(2) + x(2)*y(2))
        res%vals(3) = 0.5_${k}$*(x(3)*y(3) + x(3)*y(3))
        res%vals(4) = 0.5_${k}$*(x(1)*y(2) + y(1)*x(2))
        res%vals(5) = 0.5_${k}$*(x(2)*y(3) + y(2)*x(3))
        res%vals(6) = 0.5_${k}$*(x(1)*y(3) + y(1)*x(3))
    end function sym_outer_${k}$

    pure function dsquare_${k}$(a) result(res)
        !! Analytical derivative of the square of a symmetric tensor with respect to the tensor
        !! (Itskov, 2007, Eq. 6.119 with k = 2), in `real(${k}$)`:
        !! \[ \frac{\partial (A^2)_{ij}}{\partial A_{kl}} = \frac{1}{2} \left( \delta_{ik} A_{lj}
        !!    + \delta_{jl} A_{ik} + \delta_{il} A_{kj} + \delta_{jk} A_{il} \right) \]
        !! It is linear in A, so `dsquare(c*A)` equals `c * dsquare(A)`.
        !! Called by `d2Eigenvalues_dTensor2` and by the Drucker-Prager Hessian.
        implicit none
        @:DEVICE()
        type(${tname('3D2Osym', k)}$), intent(in) :: a
            !! Symmetric tensor \( A \).
        type(${tname('3D4O3sym', k)}$) :: res
            !! \( \partial (A^2)/\partial A \).

        ! Storage order of ten_3D4O3sym; a%vals = (xx, yy, zz, xy, yz, xz)
        res%vals(1) = 2.0_${k}$*a%vals(1)
        res%vals(2) = 2.0_${k}$*a%vals(2)
        res%vals(3) = 2.0_${k}$*a%vals(3)
        res%vals(4) = 0.5_${k}$*(a%vals(1)+a%vals(2))
        res%vals(5) = 0.5_${k}$*(a%vals(2)+a%vals(3))
        res%vals(6) = 0.5_${k}$*(a%vals(1)+a%vals(3))
        res%vals(7) = 0.0_${k}$
        res%vals(8) = 0.0_${k}$
        res%vals(9) = 0.0_${k}$
        res%vals(10) = 0.5_${k}$*a%vals(6)
        res%vals(11) = 0.5_${k}$*a%vals(4)
        res%vals(12) = 0.0_${k}$
        res%vals(13) = a%vals(4)
        res%vals(14) = a%vals(5)
        res%vals(15) = 0.5_${k}$*a%vals(5)
        res%vals(16) = a%vals(4)
        res%vals(17) = a%vals(5)
        res%vals(18) = a%vals(6)
        res%vals(19) = 0.0_${k}$
        res%vals(20) = 0.0_${k}$
        res%vals(21) = a%vals(6)
    end function dsquare_${k}$
    #:endfor

end module muscle_math_spectral_derivs
