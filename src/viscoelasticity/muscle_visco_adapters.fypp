#!
#! Historical OO adapters of the viscoelastic models (host only, removed in Phase 7 with
#! Base_viscoelasticity, D-017.1): the bindings that every model overrides, which copy the
#! parameters to the kernel type and call the dp kernel procedures (D-017.13). Included by the
#! model templates (src/viscoelasticity/muscle_visco_<model>.fypp), after muscle_models_common.fypp.
#!
#!   VISCO_OO_BINDINGS                  extra_bindings of OO_ADAPTER_TYPE for these procedures
#!   $:VISCO_OO_PROCS(model, oo_type, params, dt_rule)
#!                                      n_branches, coefficients (stops with `error stop` when the
#!                                      kernel returns an error status: `dt_rule` is the message),
#!                                      freeze (an Elasticity_frozen from the kernel frozen
#!                                      elasticity) and update (state_np1 of the history from its
#!                                      state_n)
#:mute
#:set VISCO_OO_BINDINGS = [('n_branches', 'n_branches_tbp', 'Number of history tensors used by the model.'), &
    &                      ('coefficients', 'coefficients_tbp', 'Step-dependent coefficients of the model.'), &
    &                      ('freeze', 'freeze_tbp', 'Algorithmic elasticity over the step, from the converged state.'), &
    &                      ('update', 'update_tbp', 'Writes state_np1 from state_n and the elastic strain at t_n+1.')]

#:def VISCO_OO_PROCS(model, oo_type, params, dt_rule)
#:set prm_t = model_type('visco', model, 'dp')

    pure function n_branches_tbp(self) result(res)
        !! Number of history tensors used by the model (type-bound, historical API; host only).
        !! Calls `${model_specific('visco', 'n_branches', model, 'dp')}$`.
        implicit none
        class(${oo_type}$), intent(in) :: self
            !! Model.
        integer :: res
            !! Number of branches.
        type(${prm_t}$) :: prm

$:OO_COPY_PARAMS('prm', 'self', params)
        res = ${model_specific('visco', 'n_branches', model, 'dp')}$(prm)
    end function n_branches_tbp

    pure function coefficients_tbp(self, dt) result(coefs)
        !! Step-dependent coefficients of the model (type-bound, historical API; host only). Calls
        !! `${model_specific('visco', 'step_coefficients', model, 'dp')}$` and stops with an error when the
        !! time step is invalid: ${dt_rule}$ (D-017.13b).
        implicit none
        class(${oo_type}$), intent(in) :: self
            !! Model.
        real(dp), intent(in) :: dt
            !! Time step.
        type(visco_coefs_dp) :: coefs
            !! Coefficients.
        type(${prm_t}$) :: prm
        integer :: status

$:OO_COPY_PARAMS('prm', 'self', params)
        call ${model_specific('visco', 'step_coefficients', model, 'dp')}$(prm, dt, coefs, status)
        if (status /= STATUS_OK) error stop &  ! lint: allow(io)
            "ERROR FATAL [${oo_type}$%coefficients]: ${dt_rule}$"
    end function coefficients_tbp

    pure function freeze_tbp(self, coefs, history) result(elas)
        !! Algorithmic elasticity over the step, from the converged state `history%state_n`
        !! (type-bound, historical API; host only). Calls `${model_specific('visco', 'freeze', model, 'dp')}$`.
        implicit none
        class(${oo_type}$), intent(in) :: self
            !! Model.
        type(visco_coefs_dp), intent(in) :: coefs
            !! Coefficients of the step.
        type(Viscoelastic_history), intent(in) :: history
            !! History of the point.
        type(Elasticity_frozen) :: elas
            !! Frozen elasticity.
        type(${prm_t}$) :: prm
        type(elas_frozen_dp) :: frozen

$:OO_COPY_PARAMS('prm', 'self', params)
        frozen = ${model_specific('visco', 'freeze', model, 'dp')}$(prm, coefs, history%state_n)
        call elas%set(frozen%k_alg, frozen%g_alg, frozen%stress_hist)
    end function freeze_tbp

    pure subroutine update_tbp(self, coefs, strain_e, history)
        !! Writes `history%state_np1` from `history%state_n` and the elastic strain at t_n+1
        !! (type-bound, historical API; host only). Calls `${model_specific('visco', 'update', model, 'dp')}$`.
        implicit none
        class(${oo_type}$), intent(in) :: self
            !! Model.
        type(visco_coefs_dp), intent(in) :: coefs
            !! Coefficients of the step.
        type(${tname('3D2Osym', 'dp')}$), intent(in) :: strain_e
            !! Elastic strain at t_n+1.
        type(Viscoelastic_history), intent(inout) :: history
            !! History of the point.
        type(${prm_t}$) :: prm

$:OO_COPY_PARAMS('prm', 'self', params)
        call ${model_specific('visco', 'update', model, 'dp')}$(prm, coefs, history%state_n, strain_e, history%state_np1)
    end subroutine update_tbp
#:enddef
#:endmute
