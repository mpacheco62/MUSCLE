#:include "muscle_models_common.fypp"
#:include "muscle_visco_adapters.fypp"
#! Model contract of the viscoelastic family (D-017.13): include/muscle_models_common.fypp.
#! Every parameter is private: the initializers (`visco_maxwell_init`, `visco_maxwell_init_normalized`;
#! OO `set_parameters`, `set_parameters_normalized`) validate them and keep the unused branch slots
#! at their defaults (G_k = 0, tau_k = 1). Storage order of the historical type.
#:set PARAMS = [('k', 'real', '', r'Bulk modulus \( K \).', '0.0', True), &
    &          ('g_inf', 'real', '', r'Long-term shear modulus \( G_\infty \).', '0.0', True), &
    &          ('n', 'integer', '', r'Number of Maxwell branches.', '0', True), &
    &          ('g', 'real', '(MAX_VISCO_BRANCHES)', r'Branch shear moduli \( G_k \) (0 in the unused slots).', '0.0', True), &
    &          ('tau', 'real', '(MAX_VISCO_BRANCHES)', r'Branch relaxation times \( \tau_k \) (1 in the unused slots).', '1.0', True)]
#:set OO_EXTRA = VISCO_OO_BINDINGS + &
    & [('set_parameters', 'set_parameters_tbp', 'Sets the Prony series with absolute moduli.'), &
    &  ('set_parameters_normalized', 'set_parameters_normalized_tbp', 'Sets the Prony series as in Abaqus (normalized moduli).'), &
    &  ('relaxation_shear', 'relaxation_shear_tbp', 'Shear relaxation modulus G(t).'), &
    &  ('shear_instantaneous', 'shear_instantaneous_tbp', 'Instantaneous shear modulus G_0 = G(0).')]
#! Switch of gamma = (1 - exp(-x))/x to its series 1 - x/2 + x^2/6 (D-017.13a): optimum near
#! (24 eps)^(1/4) (truncation x^3/24 against the cancellation ~eps/x of the direct formula),
#! rounded down to a power of ten: 1e-4 in dp (2.7e-4), 1e-2 in sp (4.1e-2). Measured largest
#! relative error of gamma: dp 5.5e-13, sp 3.0e-6.
#:set GAMMA_SERIES = {'sp': '1.0e-2', 'dp': '1.0e-4'}
#:set T2 = lambda k: tname('3D2Osym', k)
#:set INITS = ['visco_maxwell_init', 'visco_maxwell_init_normalized', 'visco_maxwell_relaxation_shear', &
    &         'visco_maxwell_shear_instantaneous']

module muscle_visco_maxwell
    !! Module muscle_visco_maxwell
    !! ===========================
    !! Isotropic generalized Maxwell model (Prony series) with deviatoric relaxation:
    !!
    !! \[
    !!   G(t) = G_\infty + \sum_k G_k e^{-t/\tau_k}, \qquad K(t) = K
    !! \]
    !!
    !! The single Maxwell element (G_inf = 0) and the standard linear solid (one branch) are
    !! particular cases. The history tensors are the deviatoric branch stresses s_k, integrated
    !! exactly for an elastic strain that varies linearly within the step:
    !!
    !! \[
    !!   a_k = e^{-\Delta t/\tau_k}, \quad \gamma_k = \frac{1 - a_k}{\Delta t/\tau_k}, \quad
    !!   s_k^{n+1} = a_k s_k^n + 2 G_k \gamma_k (e^{n+1} - e^n)
    !! \]
    !!
    !! which gives G_alg = G_inf + sum(G_k gamma_k) and
    !! sigma_hist = sum(a_k s_k^n - 2 G_k gamma_k e^n). See
    !! Theory/viscoelasticity/generalized_maxwell.tex.
    !!
    !! Coefficients: `decay(k) = a_k`, `weight(k) = 2 G_k gamma_k`. For
    !! \( x = \Delta t/\tau_k \) below a threshold (1e-4 in dp, 1e-2 in sp; D-017.13a) gamma is its
    !! series \( 1 - x/2 + x^2/6 \) (the direct formula cancels).
    !!
    !! Time step (D-017.13b): \( \Delta t = 0 \) is valid (instantaneous response, G_alg = G_0);
    !! \( \Delta t < 0 \) is an error (`STATUS_INVALID_TIME_STEP`; the OO adapter stops). Limits
    !! (D-017.13c): negative moduli and \( \nu = 1/2 \) in `set_parameters_normalized` are not
    !! validated; 3D only.
    !!
    !! Kernel API (D-017.13): parameter types `visco_maxwell_<k>` (private components, built with
    !! `visco_maxwell_init(prm, bulk, shear_inf, shear, tau, status)` or
    !! `visco_maxwell_init_normalized(prm, young, poisson, g, tau, status)`: `STATUS_INVALID_PARAMETER`
    !! if `shear` and `tau` differ in size, have more than `MAX_VISCO_BRANCHES` branches, a
    !! `tau_k <= 0`, or `sum(g) > 1`), the `pure` procedures `visco_step_coefficients_maxwell_<k>`,
    !! `visco_freeze_maxwell_<k>`, `visco_update_maxwell_<k>` and `visco_n_branches_maxwell_<k>`
    !! (generics `visco_*` of muscle_visco_laws) and `visco_maxwell_relaxation_shear(prm, t)`,
    !! `visco_maxwell_shear_instantaneous(prm)`.
    !!
    !! `Generalized_maxwell` is the historical OO type (host only, removed in Phase 7), extending
    !! `Base_viscoelasticity`: its bindings call the dp kernel procedures; the initializers and
    !! `coefficients` stop with `error stop` when the kernel returns an error status.
    !!
    !! ```fortran
    !! type(visco_maxwell_dp) :: prm
    !! type(visco_coefs_dp) :: coefs
    !! call visco_maxwell_init(prm, bulk=2000.0_dp, shear_inf=100.0_dp, shear=[300.0_dp], tau=[1.0_dp], &
    !!                         status=status)
    !! call visco_step_coefficients(prm, dt, coefs, status)      ! once per step
    !! elas = visco_freeze(prm, coefs, state_n)             ! per point: elas_* generics
    !! call visco_update(prm, coefs, state_n, strain_e, state_np1)
    !! ```
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_status, only : STATUS_OK, STATUS_INVALID_PARAMETER, STATUS_INVALID_TIME_STEP
    use muscle_tensors, only : ${', '.join(T2(k) for k in REAL_KINDS)}$, operator(.dev.), operator(-)
    use muscle_visco_types, only : MAX_VISCO_BRANCHES, ${', '.join('visco_state_{0}, visco_coefs_{0}'.format(k) for k in REAL_KINDS)}$
    use muscle_visco_frozen, only : ${', '.join('elas_frozen_' + k for k in REAL_KINDS)}$, Elasticity_frozen
    use muscle_visco_state, only : Viscoelastic_history
    use muscle_visco_base, only : Base_viscoelasticity
    implicit none
    private

    $:MODEL_PUBLIC('visco', 'maxwell')
#:for n in INITS
    public :: ${n}$, ${', '.join(n + '_' + k for k in REAL_KINDS)}$
#:endfor
    public :: Generalized_maxwell
#:for k in REAL_KINDS

    real(${k}$), parameter :: MAXWELL_GAMMA_SERIES_${k}$ = ${GAMMA_SERIES[k]}$_${k}$
        !! Below this \( x = \Delta t/\tau_k \), \( \gamma_k \) is its series (`real(${k}$)`, D-017.13a).
#:endfor
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('visco', 'maxwell', k, PARAMS, validated=True)
#:endfor
    $:OO_ADAPTER_TYPE('visco', 'maxwell', 'Generalized_maxwell', 'Base_viscoelasticity', PARAMS, bindings=[], &
        & extra_bindings=OO_EXTRA, oo_private=True)
#:for n in INITS

    interface ${n}$
        module procedure ${', '.join(n + '_' + k for k in REAL_KINDS)}$
    end interface ${n}$
#:endfor

contains
#:for k in REAL_KINDS

    pure subroutine visco_maxwell_init_${k}$(prm, bulk, shear_inf, shear, tau, status)
        !! Parameters of the generalized Maxwell model in `real(${k}$)` from the Prony series with
        !! absolute moduli. `STATUS_INVALID_PARAMETER` (and the default parameters) if `shear` and
        !! `tau` differ in size, have more than `MAX_VISCO_BRANCHES` branches or a `tau <= 0`.
        implicit none
        @:DEVICE()
        type(visco_maxwell_${k}$), intent(out) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: bulk
            !! Bulk modulus \( K \).
        real(${k}$), intent(in) :: shear_inf
            !! Long-term shear modulus \( G_\infty \).
        real(${k}$), intent(in) :: shear(:)
            !! Branch shear moduli \( G_k \).
        real(${k}$), intent(in) :: tau(:)
            !! Branch relaxation times \( \tau_k \).
        integer, intent(out) :: status
            !! `STATUS_OK` or `STATUS_INVALID_PARAMETER`.

        if (size(shear) /= size(tau) .or. size(shear) > MAX_VISCO_BRANCHES) then
            status = STATUS_INVALID_PARAMETER
            return
        end if
        if (any(tau <= 0.0_${k}$)) then
            status = STATUS_INVALID_PARAMETER
            return
        end if
        status = STATUS_OK
        prm%k = bulk
        prm%g_inf = shear_inf
        prm%n = size(shear)
        prm%g(1:prm%n) = shear
        prm%tau(1:prm%n) = tau
    end subroutine visco_maxwell_init_${k}$

    pure subroutine visco_maxwell_init_normalized_${k}$(prm, young, poisson, g, tau, status)
        !! Parameters of the generalized Maxwell model in `real(${k}$)` as in Abaqus: instantaneous E and
        !! nu, and normalized shear moduli g_k = G_k/G_0 (sum(g) <= 1, sum(g) = 1 is a Maxwell fluid).
        !! `STATUS_INVALID_PARAMETER` as `visco_maxwell_init`, or if `sum(g) > 1`.
        implicit none
        @:DEVICE()
        type(visco_maxwell_${k}$), intent(out) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: young
            !! Instantaneous Young modulus.
        real(${k}$), intent(in) :: poisson
            !! Instantaneous Poisson ratio.
        real(${k}$), intent(in) :: g(:)
            !! Normalized branch shear moduli g_k.
        real(${k}$), intent(in) :: tau(:)
            !! Branch relaxation times \( \tau_k \).
        integer, intent(out) :: status
            !! `STATUS_OK` or `STATUS_INVALID_PARAMETER`.
        real(${k}$) :: g0, shear(MAX_VISCO_BRANCHES)
        integer :: n

        n = size(g)
        if (sum(g) > 1.0_${k}$ .or. n > MAX_VISCO_BRANCHES) then
            status = STATUS_INVALID_PARAMETER
            return
        end if
        g0 = 0.5_${k}$*young/(1.0_${k}$ + poisson)
        shear(1:n) = g0*g  ! fixed-size local: no array temporary
        call visco_maxwell_init_${k}$(prm, bulk=young/(3.0_${k}$*(1.0_${k}$ - 2.0_${k}$*poisson)), &
                                  shear_inf=g0*(1.0_${k}$ - sum(g)), shear=shear(1:n), tau=tau, status=status)
    end subroutine visco_maxwell_init_normalized_${k}$

    pure function visco_maxwell_relaxation_shear_${k}$(prm, t) result(res)
        !! Shear relaxation modulus \( G(t) \) of the generalized Maxwell model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(visco_maxwell_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: t
            !! Time.
        real(${k}$) :: res
            !! \( G(t) \).

        res = prm%g_inf + sum(prm%g(1:prm%n)*exp(-t/prm%tau(1:prm%n)))
    end function visco_maxwell_relaxation_shear_${k}$

    pure function visco_maxwell_shear_instantaneous_${k}$(prm) result(res)
        !! Instantaneous shear modulus \( G_0 = G(0) \) of the generalized Maxwell model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(visco_maxwell_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$) :: res
            !! \( G_0 \).

        res = prm%g_inf + sum(prm%g(1:prm%n))
    end function visco_maxwell_shear_instantaneous_${k}$

    $:MODEL_FUNCTION('visco', 'maxwell', 'step_coefficients', k, doc=r'\( a_k = e^{-x} \), \( \gamma_k = (1 - a_k)/x \), \( x = \Delta t/\tau_k \); \( \Delta t = 0 \) is valid, \( \Delta t < 0 \) gives `STATUS_INVALID_TIME_STEP` (D-017.13b).')
        real(${k}$) :: x, gamma
        integer :: i

        if (dt < 0.0_${k}$) then
            status = STATUS_INVALID_TIME_STEP
            return
        end if
        status = STATUS_OK
        coefs%dt = dt
        coefs%k_alg = prm%k
        coefs%g_alg = prm%g_inf
        do i = 1, prm%n
            x = dt/prm%tau(i)
            coefs%decay(i) = exp(-x)
            if (x < MAXWELL_GAMMA_SERIES_${k}$) then  ! (1 - exp(-x))/x without cancellation
                gamma = 1.0_${k}$ - x/2.0_${k}$ + x*x/6.0_${k}$
            else
                gamma = (1.0_${k}$ - coefs%decay(i))/x
            end if
            coefs%weight(i) = 2.0_${k}$*prm%g(i)*gamma
            coefs%g_alg = coefs%g_alg + prm%g(i)*gamma
        end do
    end subroutine visco_step_coefficients_maxwell_${k}$

    $:MODEL_FUNCTION('visco', 'maxwell', 'freeze', k, doc=r'\( K^{alg} = K \), \( G^{alg} \) of the coefficients and \( \boldsymbol\sigma^{hist}_n = \sum_k (a_k \mathbf{s}_k^n - 2 G_k \gamma_k \mathbf{e}^n) \).')
        type(${T2(k)}$) :: e_n, hist
        integer :: i

        e_n = .dev. state_n%strain_e
        hist%vals = 0.0_${k}$
        do i = 1, prm%n
            hist%vals = hist%vals + coefs%decay(i)*state_n%h(:, i) - coefs%weight(i)*e_n%vals
        end do
        elas%k_alg = coefs%k_alg
        elas%g_alg = coefs%g_alg
        elas%stress_hist = hist
    end function visco_freeze_maxwell_${k}$

    $:MODEL_FUNCTION('visco', 'maxwell', 'update', k, doc=r'\( \mathbf{s}_k^{n+1} = a_k \mathbf{s}_k^n + 2 G_k \gamma_k (\mathbf{e}^{n+1} - \mathbf{e}^n) \); the other components of `state_n` are carried over.')
        type(${T2(k)}$) :: de
        integer :: i

        de = (.dev. strain_e) - (.dev. state_n%strain_e)
        state_np1 = state_n
        state_np1%n_branches = prm%n
        do i = 1, prm%n
            state_np1%h(:, i) = coefs%decay(i)*state_n%h(:, i) + coefs%weight(i)*de%vals
        end do
        state_np1%strain_e = strain_e
    end subroutine visco_update_maxwell_${k}$

    $:MODEL_FUNCTION('visco', 'maxwell', 'n_branches', k)

        res = prm%n
    end function visco_n_branches_maxwell_${k}$
#:endfor
    $:VISCO_OO_PROCS('maxwell', 'Generalized_maxwell', PARAMS, "'dt' must be >= 0.")

    pure subroutine set_parameters_tbp(self, bulk, shear_inf, shear, tau)
        !! Sets the Prony series with absolute moduli (type-bound, historical API; host only): calls
        !! `visco_maxwell_init_dp` and stops on an invalid parameter.
        implicit none
        class(Generalized_maxwell), intent(inout) :: self
            !! Model.
        real(dp), intent(in) :: bulk
            !! Bulk modulus K
        real(dp), intent(in) :: shear_inf
            !! Long-term shear modulus G_inf
        real(dp), intent(in) :: shear(:)
            !! Branch shear moduli G_k
        real(dp), intent(in) :: tau(:)
            !! Branch relaxation times tau_k
        type(visco_maxwell_dp) :: prm
        integer :: status

        call visco_maxwell_init_dp(prm, bulk, shear_inf, shear, tau, status)
        if (status /= STATUS_OK) error stop "ERROR FATAL [Generalized_maxwell%set_parameters]: " // &  ! lint: allow(io)
            "'shear' and 'tau' must have the same size (<= MAX_VISCO_BRANCHES) and 'tau' must be positive."
$:OO_COPY_PARAMS('self', 'prm', PARAMS)
    end subroutine set_parameters_tbp

    pure subroutine set_parameters_normalized_tbp(self, young, poisson, g, tau)
        !! Sets the Prony series as in Abaqus: instantaneous E and nu, and normalized shear moduli
        !! g_k = G_k/G_0 (sum(g) <= 1, sum(g) = 1 is a Maxwell fluid) (type-bound, historical API; host
        !! only): calls `visco_maxwell_init_normalized_dp` and stops on an invalid parameter.
        implicit none
        class(Generalized_maxwell), intent(inout) :: self
            !! Model.
        real(dp), intent(in) :: young
            !! Instantaneous Young modulus
        real(dp), intent(in) :: poisson
            !! Instantaneous Poisson ratio
        real(dp), intent(in) :: g(:)
            !! Normalized branch shear moduli g_k
        real(dp), intent(in) :: tau(:)
            !! Branch relaxation times tau_k
        type(visco_maxwell_dp) :: prm
        integer :: status

        call visco_maxwell_init_normalized_dp(prm, young, poisson, g, tau, status)
        if (status /= STATUS_OK) error stop "ERROR FATAL [Generalized_maxwell%set_parameters_normalized]: " // &  ! lint: allow(io)
            "sum(g) must be <= 1, 'g' and 'tau' of the same size (<= MAX_VISCO_BRANCHES), 'tau' positive."
$:OO_COPY_PARAMS('self', 'prm', PARAMS)
    end subroutine set_parameters_normalized_tbp

    pure function relaxation_shear_tbp(self, t) result(res)
        !! Shear relaxation modulus G(t) (type-bound, historical API; host only).
        implicit none
        class(Generalized_maxwell), intent(in) :: self
            !! Model.
        real(dp), intent(in) :: t
            !! Time.
        real(dp) :: res
            !! G(t).
        type(visco_maxwell_dp) :: prm

$:OO_COPY_PARAMS('prm', 'self', PARAMS)
        res = visco_maxwell_relaxation_shear_dp(prm, t)
    end function relaxation_shear_tbp

    pure function shear_instantaneous_tbp(self) result(res)
        !! Instantaneous shear modulus G_0 = G(0) (type-bound, historical API; host only).
        implicit none
        class(Generalized_maxwell), intent(in) :: self
            !! Model.
        real(dp) :: res
            !! G_0.
        type(visco_maxwell_dp) :: prm

$:OO_COPY_PARAMS('prm', 'self', PARAMS)
        res = visco_maxwell_shear_instantaneous_dp(prm)
    end function shear_instantaneous_tbp

end module muscle_visco_maxwell
