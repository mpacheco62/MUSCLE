#:include "muscle_models_common.fypp"
#:include "muscle_visco_adapters.fypp"
#! Model contract of the viscoelastic family (D-017.13): include/muscle_models_common.fypp.
#! Every parameter is private: the initializer (`visco_kelvin_init`, OO `set_parameters`) validates
#! them. Storage order of the historical type.
#:set PARAMS = [('k', 'real', '', r'Elastic bulk modulus \( K \).', '0.0', True), &
    &          ('g', 'real', '', r'Elastic shear modulus \( G \).', '0.0', True), &
    &          ('zeta', 'real', '', r'Volumetric viscosity of the dashpot \( \zeta \).', '0.0', True), &
    &          ('mu_v', 'real', '', r'Deviatoric viscosity of the dashpot \( \mu_v \).', '0.0', True)]
#:set OO_EXTRA = VISCO_OO_BINDINGS + &
    & [('set_parameters', 'set_parameters_tbp', 'Sets the elastic moduli and the viscosities of the solid.')]
#:set T2 = lambda k: tname('3D2Osym', k)

module muscle_visco_kelvin
    !! Module muscle_visco_kelvin
    !! ==========================
    !! Isotropic Kelvin-Voigt solid: Hookean spring and Newtonian dashpot in parallel,
    !!
    !! \[ \sigma = K\,\mathrm{tr}(\varepsilon)\,\mathbf{I} + 2G\,\mathrm{dev}(\varepsilon)
    !!          + \zeta\,\mathrm{tr}(\dot\varepsilon)\,\mathbf{I}
    !!          + 2\mu_v\,\mathrm{dev}(\dot\varepsilon) \]
    !! (Picard and Fafard (2011), Eqs. (47)-(48), isotropic case.)
    !!
    !! With the strain varying linearly over the step, \(\dot\varepsilon = \Delta\varepsilon/\Delta t\),
    !! the stress is affine in the elastic strain: \(K^{alg} = K + \zeta/\Delta t\),
    !! \(G^{alg} = G + \mu_v/\Delta t\) and \(\sigma^{hist}_n\) depends on \(\varepsilon_n\) alone
    !! (see Theory/viscoelasticity/generalized_maxwell.tex, pending Kelvin-Voigt item).
    !!
    !! Coefficients: `weight(1) = zeta/dt`, `weight(2) = 2 mu_v/dt`; `decay` is unused.
    !!
    !! Time step (D-017.13b): the model is infinitely stiff for \( \Delta t \le 0 \):
    !! `STATUS_INVALID_TIME_STEP` (the OO adapter stops). Limits (D-017.13c): with a very small
    !! \( \Delta t \) the stress is a difference of terms \( \propto \zeta/\Delta t \) and loses
    !! digits; 3D only.
    !!
    !! Kernel API (D-017.13): parameter types `visco_kelvin_<k>` (private components, built with
    !! `visco_kelvin_init(prm, bulk, shear, bulk_viscosity, shear_viscosity, status)`:
    !! `STATUS_INVALID_PARAMETER` with a negative modulus or viscosity) and the `pure` procedures
    !! `visco_step_coefficients_kelvin_<k>`, `visco_freeze_kelvin_<k>`, `visco_update_kelvin_<k>` and
    !! `visco_n_branches_kelvin_<k>` (generics `visco_*` of muscle_visco_laws).
    !!
    !! `Kelvin_voigt` is the historical OO type (host only, removed in Phase 7), extending
    !! `Base_viscoelasticity`: its bindings call the dp kernel procedures; `set_parameters` and
    !! `coefficients` stop with `error stop` when the kernel returns an error status.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_status, only : STATUS_OK, STATUS_INVALID_PARAMETER, STATUS_INVALID_TIME_STEP
    use muscle_tensors, only : ${', '.join(T2(k) for k in REAL_KINDS)}$, iden_2O, operator(.dev.), operator(.ddot.), &
        operator(*), operator(-)
    use muscle_visco_types, only : ${', '.join('visco_state_{0}, visco_coefs_{0}'.format(k) for k in REAL_KINDS)}$
    use muscle_visco_frozen, only : ${', '.join('elas_frozen_' + k for k in REAL_KINDS)}$, Elasticity_frozen
    use muscle_visco_state, only : Viscoelastic_history
    use muscle_visco_base, only : Base_viscoelasticity
    implicit none
    private

    $:MODEL_PUBLIC('visco', 'kelvin')
    public :: visco_kelvin_init, ${', '.join('visco_kelvin_init_' + k for k in REAL_KINDS)}$
    public :: Kelvin_voigt
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('visco', 'kelvin', k, PARAMS, validated=True)
#:endfor
    $:OO_ADAPTER_TYPE('visco', 'kelvin', 'Kelvin_voigt', 'Base_viscoelasticity', PARAMS, bindings=[], &
        & extra_bindings=OO_EXTRA, oo_private=True)

    interface visco_kelvin_init
        !! Parameters of the Kelvin-Voigt solid.
        module procedure ${', '.join('visco_kelvin_init_' + k for k in REAL_KINDS)}$
    end interface visco_kelvin_init

contains
#:for k in REAL_KINDS

    pure subroutine visco_kelvin_init_${k}$(prm, bulk, shear, bulk_viscosity, shear_viscosity, status)
        !! Parameters of the Kelvin-Voigt solid in `real(${k}$)`: elastic moduli and viscosities.
        !! `STATUS_INVALID_PARAMETER` (and the default parameters) if any of them is negative.
        implicit none
        @:DEVICE()
        type(visco_kelvin_${k}$), intent(out) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: bulk
            !! Bulk modulus \( K \).
        real(${k}$), intent(in) :: shear
            !! Shear modulus \( G \).
        real(${k}$), intent(in) :: bulk_viscosity
            !! Volumetric viscosity \( \zeta \).
        real(${k}$), intent(in) :: shear_viscosity
            !! Deviatoric viscosity \( \mu_v \).
        integer, intent(out) :: status
            !! `STATUS_OK` or `STATUS_INVALID_PARAMETER`.

        if (bulk < 0.0_${k}$ .or. shear < 0.0_${k}$ .or. bulk_viscosity < 0.0_${k}$ .or. shear_viscosity < 0.0_${k}$) then
            status = STATUS_INVALID_PARAMETER
            return
        end if
        status = STATUS_OK
        prm%k = bulk
        prm%g = shear
        prm%zeta = bulk_viscosity
        prm%mu_v = shear_viscosity
    end subroutine visco_kelvin_init_${k}$

    $:MODEL_FUNCTION('visco', 'kelvin', 'step_coefficients', k, doc=r'Algorithmic moduli \(K^{alg} = K + \zeta/\Delta t\), \(G^{alg} = G + \mu_v/\Delta t\) and the two viscous factors used by `visco_freeze`; \( \Delta t \le 0 \) gives `STATUS_INVALID_TIME_STEP` (D-017.13b).')

        if (dt <= 0.0_${k}$) then
            status = STATUS_INVALID_TIME_STEP
            return
        end if
        status = STATUS_OK
        coefs%dt = dt
        coefs%k_alg = prm%k + prm%zeta/dt
        coefs%g_alg = prm%g + prm%mu_v/dt
        coefs%weight(1) = prm%zeta/dt
        coefs%weight(2) = 2.0_${k}$*prm%mu_v/dt
    end subroutine visco_step_coefficients_kelvin_${k}$

    $:MODEL_FUNCTION('visco', 'kelvin', 'freeze', k, doc=r'History stress \(\sigma^{hist}_n = -(\zeta/\Delta t)\,\mathrm{tr}(\varepsilon_n)\,\mathbf{I} - (2\mu_v/\Delta t)\,\mathrm{dev}(\varepsilon_n)\), constant over the step.')
        type(${T2(k)}$) :: e_n

        e_n = state_n%strain_e
        elas%k_alg = coefs%k_alg
        elas%g_alg = coefs%g_alg
        elas%stress_hist = -coefs%weight(2)*(.dev. e_n) - (coefs%weight(1)*(e_n .ddot. iden_2O()))*iden_2O()
    end function visco_freeze_kelvin_${k}$

    $:MODEL_FUNCTION('visco', 'kelvin', 'update', k, doc=r'Stores the elastic strain; there are no branch tensors (the other components of `state_n` are carried over).')

        state_np1 = state_n
        state_np1%n_branches = 0
        state_np1%strain_e = strain_e
    end subroutine visco_update_kelvin_${k}$

    $:MODEL_FUNCTION('visco', 'kelvin', 'n_branches', k, doc='No history tensors: the elastic strain at t_n is the whole history of the model.')

        res = 0
    end function visco_n_branches_kelvin_${k}$
#:endfor
    $:VISCO_OO_PROCS('kelvin', 'Kelvin_voigt', PARAMS, "'dt' must be > 0 (rigid at dt = 0).")

    pure subroutine set_parameters_tbp(self, bulk, shear, bulk_viscosity, shear_viscosity)
        !! Sets the elastic moduli and the viscosities of the solid (type-bound, historical API; host
        !! only): calls `visco_kelvin_init_dp` and stops on a negative parameter.
        implicit none
        class(Kelvin_voigt), intent(inout) :: self
            !! Model.
        real(dp), intent(in) :: bulk
            !! Bulk modulus K
        real(dp), intent(in) :: shear
            !! Shear modulus G
        real(dp), intent(in) :: bulk_viscosity
            !! Volumetric viscosity zeta
        real(dp), intent(in) :: shear_viscosity
            !! Deviatoric viscosity mu_v
        type(visco_kelvin_dp) :: prm
        integer :: status

        call visco_kelvin_init_dp(prm, bulk, shear, bulk_viscosity, shear_viscosity, status)
        if (status /= STATUS_OK) error stop "ERROR FATAL [Kelvin_voigt%set_parameters]: " // &  ! lint: allow(io)
            "the moduli and the viscosities cannot be negative."
$:OO_COPY_PARAMS('self', 'prm', PARAMS)
    end subroutine set_parameters_tbp

end module muscle_visco_kelvin
