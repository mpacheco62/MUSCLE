#:include "muscle_models_common.fypp"
#! Model contract of the viscoelastic family (D-017.13): include/muscle_models_common.fypp.
#! Every parameter is private: the initializer (`visco_kelvin_init`) validates them. Storage order of
#! the historical type.
#:set PARAMS = model_param_list('visco', 'kelvin')
#:set T2 = lambda k: tname('3D2Osym', k)

module muscle_visco_kelvin
    !! Module muscle_visco_kelvin
    !! ==========================
    !! Isotropic Kelvin-Voigt solid: Hookean spring and Newtonian dashpot in parallel,
    !!
    !! \[ \sigma = K\,\mathrm{tr}(\varepsilon)\,\mathbf{I} + 2G\,\mathrm{dev}(\varepsilon)
    !!          + \zeta\,\mathrm{tr}(\dot\varepsilon)\,\mathbf{I}
    !!          + 2\mu_v\,\mathrm{dev}(\dot\varepsilon) \]
    !! (Picard and Fafard (2011), Eqs. (47)-(48), isotropic case.)
    !!
    !! With the strain varying linearly over the step, \(\dot\varepsilon = \Delta\varepsilon/\Delta t\),
    !! the stress is affine in the elastic strain: \(K^{alg} = K + \zeta/\Delta t\),
    !! \(G^{alg} = G + \mu_v/\Delta t\) and \(\sigma^{hist}_n\) depends on \(\varepsilon_n\) alone
    !! (see Theory/viscoelasticity/generalized_maxwell.tex, pending Kelvin-Voigt item).
    !!
    !! Coefficients: `weight(1) = zeta/dt`, `weight(2) = 2 mu_v/dt`; `decay` is unused.
    !!
    !! Time step (D-017.13b): the model is infinitely stiff for \( \Delta t \le 0 \):
    !! `STATUS_INVALID_TIME_STEP`. Limits (D-017.13c): with a very small
    !! \( \Delta t \) the stress is a difference of terms \( \propto \zeta/\Delta t \) and loses
    !! digits; 3D only.
    !!
    !! Kernel API (D-017.13): parameter types `visco_kelvin_<k>` (private components, built with
    !! `visco_kelvin_init(prm, bulk, shear, bulk_viscosity, shear_viscosity, status)`:
    !! `STATUS_INVALID_PARAMETER` with a negative modulus or viscosity) and the `pure` procedures
    !! `visco_step_coefficients_kelvin_<k>`, `visco_freeze_kelvin_<k>`, `visco_update_kelvin_<k>` and
    !! `visco_n_branches_kelvin_<k>` (generics `visco_*` of muscle_visco_laws).
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_status, only : STATUS_OK, STATUS_INVALID_PARAMETER, STATUS_INVALID_TIME_STEP
    use muscle_tensors, only : ${', '.join(T2(k) for k in REAL_KINDS)}$, iden_2O, operator(.dev.), operator(.ddot.), &
        operator(*), operator(-)
    use muscle_visco_types, only : MAX_VISCO_BRANCHES, ${', '.join('visco_state_{0}, visco_coefs_{0}'.format(k) for k in REAL_KINDS)}$
    use muscle_visco_frozen, only : ${', '.join('elas_frozen_' + k for k in REAL_KINDS)}$
    implicit none
    private

    $:MODEL_PUBLIC('visco', 'kelvin')
    public :: visco_kelvin_init, ${', '.join('visco_kelvin_init_' + k for k in REAL_KINDS)}$
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('visco', 'kelvin', k, PARAMS, validated=True)
#:endfor

    interface visco_kelvin_init
        !! Parameters of the Kelvin-Voigt solid.
        module procedure ${', '.join('visco_kelvin_init_' + k for k in REAL_KINDS)}$
    end interface visco_kelvin_init

contains
#:for k in REAL_KINDS

    $:MODEL_INIT('visco', 'kelvin', k)

        if (bulk < 0.0_${k}$ .or. shear < 0.0_${k}$ .or. bulk_viscosity < 0.0_${k}$ .or. shear_viscosity < 0.0_${k}$) then
            status = STATUS_INVALID_PARAMETER
            return
        end if
        status = STATUS_OK
        prm%k = bulk
        prm%g = shear
        prm%zeta = bulk_viscosity
        prm%mu_v = shear_viscosity
    end subroutine visco_kelvin_init_${k}$

    $:MODEL_FUNCTION('visco', 'kelvin', 'step_coefficients', k, doc=r'Algorithmic moduli \(K^{alg} = K + \zeta/\Delta t\), \(G^{alg} = G + \mu_v/\Delta t\) and the two viscous factors used by `visco_freeze`; \( \Delta t \le 0 \) gives `STATUS_INVALID_TIME_STEP` (D-017.13b).')

        if (dt <= 0.0_${k}$) then
            status = STATUS_INVALID_TIME_STEP
            return
        end if
        status = STATUS_OK
        coefs%dt = dt
        coefs%k_alg = prm%k + prm%zeta/dt
        coefs%g_alg = prm%g + prm%mu_v/dt
        coefs%weight(1) = prm%zeta/dt
        coefs%weight(2) = 2.0_${k}$*prm%mu_v/dt
    end subroutine visco_step_coefficients_kelvin_${k}$

    $:MODEL_FUNCTION('visco', 'kelvin', 'freeze', k, doc=r'History stress \(\sigma^{hist}_n = -(\zeta/\Delta t)\,\mathrm{tr}(\varepsilon_n)\,\mathbf{I} - (2\mu_v/\Delta t)\,\mathrm{dev}(\varepsilon_n)\), constant over the step (`visco_freeze_branches`).')

        elas = visco_freeze_branches_kelvin_${k}$(prm, coefs, state_n%strain_e, MAX_VISCO_BRANCHES, state_n%h)
    end function visco_freeze_kelvin_${k}$

    $:MODEL_FUNCTION('visco', 'kelvin', 'update', k, doc=r'Stores the elastic strain; there are no branch tensors (the other components of `state_n` are carried over).')

        state_np1%n_branches = 0
        call visco_update_branches_kelvin_${k}$(prm, coefs, state_n%strain_e, MAX_VISCO_BRANCHES, state_n%h, strain_e, &
            state_np1%h)
        state_np1%strain_e = strain_e
    end subroutine visco_update_kelvin_${k}$

    $:MODEL_FUNCTION('visco', 'kelvin', 'freeze_branches', k, doc=r'History stress \(\sigma^{hist}_n = -(\zeta/\Delta t)\,\mathrm{tr}(\varepsilon_n)\,\mathbf{I} - (2\mu_v/\Delta t)\,\mathrm{dev}(\varepsilon_n)\) (no history tensors: `h_n` is not used).')
        type(${T2(k)}$) :: e_n

        e_n = strain_e_n
        elas%k_alg = coefs%k_alg
        elas%g_alg = coefs%g_alg
        elas%stress_hist = -coefs%weight(2)*(.dev. e_n) - (coefs%weight(1)*(e_n .ddot. iden_2O()))*iden_2O()
    end function visco_freeze_branches_kelvin_${k}$

    $:MODEL_FUNCTION('visco', 'kelvin', 'update_branches', k, doc=r'No branch tensors: `h_np1` is a copy of `h_n` (the elastic strain is the whole history of the model).')

        h_np1 = h_n
    end subroutine visco_update_branches_kelvin_${k}$

    $:MODEL_FUNCTION('visco', 'kelvin', 'n_branches', k, doc='No history tensors: the elastic strain at t_n is the whole history of the model.')

        res = 0
    end function visco_n_branches_kelvin_${k}$
#:endfor

end module muscle_visco_kelvin
