#:include "muscle_common.fypp"

module muscle_visco_types
    !! Module muscle_visco_types
    !! =========================
    !! State and step coefficients of the linear viscoelastic models for kernels, in
    !! every real kind. Fixed size (`MAX_VISCO_BRANCHES` history tensors, no allocatable
    !! components): a state is copied (commit, rollback, private copies, device arrays) without
    !! allocating memory. 3D only, as the models.
    !!
    !! - `visco_state_<k>`: state of a material point at an instant: number of active branches,
    !!   elastic strain and the history tensors (Voigt order of `ten_3D2Osym`); their meaning is
    !!   model specific (the deviatoric branch stresses in the generalized Maxwell model).
    !! - `visco_coefs_<k>`: coefficients of a time step (`visco_step_coefficients`): time step,
    !!   algorithmic bulk and shear moduli, and two model specific factors per branch (`decay`,
    !!   `weight`, see each model).
    !! - `visco_state_init(state, n_branches, status[, strain_e])`: a zero history.
    !!
    !! The kernel procedures of the models never modify the converged state: `visco_update` reads
    !! `state_n` and writes `state_np1` (separate arguments): the caller keeps the converged state
    !! (the FE program, in its history array).
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    #:for k in REAL_KINDS
    use muscle_tensors, only : ten_3D2Osym_${k}$
    #:endfor
    use muscle_status, only : STATUS_OK, STATUS_INVALID_PARAMETER
    implicit none
    private

    integer, parameter, public :: MAX_VISCO_BRANCHES = 10
        !! Maximum number of branches (history tensors) of a viscoelastic state

    public :: visco_state_init
    #:for k in REAL_KINDS
    public :: visco_state_${k}$, visco_coefs_${k}$, visco_state_init_${k}$
    #:endfor

    #:for k in REAL_KINDS
    type :: visco_state_${k}$
        !! Viscoelastic state of a material point at an instant, `real(${k}$)`.
        integer :: n_branches = 0
            !! Number of active branches.
        type(ten_3D2Osym_${k}$) :: strain_e = ten_3D2Osym_${k}$([0.0_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$])
            !! Elastic strain.
        real(${k}$) :: h(6, MAX_VISCO_BRANCHES) = 0.0_${k}$
            !! History tensors (Voigt order of `ten_3D2Osym_${k}$`); only `h(:, 1:n_branches)` is used.
    end type visco_state_${k}$

    type :: visco_coefs_${k}$
        !! Coefficients of a time step, `real(${k}$)` (fixed size). The meaning of `decay` and
        !! `weight` is model specific (see each model).
        real(${k}$) :: dt = 0.0_${k}$
            !! Time step.
        real(${k}$) :: k_alg = 0.0_${k}$
            !! Algorithmic bulk modulus.
        real(${k}$) :: g_alg = 0.0_${k}$
            !! Algorithmic shear modulus.
        real(${k}$) :: decay(MAX_VISCO_BRANCHES) = 0.0_${k}$
            !! Per branch decay factor.
        real(${k}$) :: weight(MAX_VISCO_BRANCHES) = 0.0_${k}$
            !! Per branch strain weight.
    end type visco_coefs_${k}$

    #:endfor
    interface visco_state_init
        !! Zero history with a number of branches (every kind).
        #:for k in REAL_KINDS
        module procedure visco_state_init_${k}$
        #:endfor
    end interface visco_state_init

contains
    #:for k in REAL_KINDS
    pure subroutine visco_state_init_${k}$(state, n_branches, status, strain_e)
        !! State with `n_branches` zero history tensors and the elastic strain `strain_e` (zero if
        !! absent), `real(${k}$)`. `status`: `STATUS_INVALID_PARAMETER` (and the default state) if
        !! `n_branches` is not in [0, `MAX_VISCO_BRANCHES`].
        implicit none
        @:DEVICE()
        type(visco_state_${k}$), intent(out) :: state
            !! New state.
        integer, intent(in) :: n_branches
            !! Number of branches of the model (`visco_n_branches`).
        integer, intent(out) :: status
            !! `STATUS_OK` or `STATUS_INVALID_PARAMETER`.
        type(ten_3D2Osym_${k}$), intent(in), optional :: strain_e
            !! Initial elastic strain.

        if (n_branches < 0 .or. n_branches > MAX_VISCO_BRANCHES) then
            status = STATUS_INVALID_PARAMETER
            return
        end if
        status = STATUS_OK
        state%n_branches = n_branches
        if (present(strain_e)) state%strain_e = strain_e
    end subroutine visco_state_init_${k}$

    #:endfor

end module muscle_visco_types
