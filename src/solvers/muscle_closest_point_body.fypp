#! SPDX-License-Identifier: GPL-3.0-or-later
#! Copyright (C) 2025 Matias Pacheco-Alarcon <matias.pacheco.a@gmail.com>
#! Body of the closest point return mapping of a declared material (D-018.5), written once against
#! the family generics `elas_*`, `yield_*` and `hard_*` (Phase 6): they resolve at compile time by
#! the parameter types of the components of the material, so every material only changes those
#! types. Port of the historical OO solver (muscle_solver_closest_point, removed in Phase 7 step 9)
#! operation by operation, so that both give the same bits in double precision; relative Newton
#! tolerance (D-018.3) and `iters = min(i, iter_nw)` (D-018.10a) in both.
#!
#! Included by src/materials/muscle_material.fypp inside its `#:for k` loop (contained procedures of
#! the material module), with these variables set: `k` (kind), `MAT` (the `muscle_meta.Material`),
#! `MAT_T` (material type), `ELAS_T` (parameter type of the elasticity of a step), `SOLVE` / `ITER` /
#! `TANGENT` (specific procedure names) and `S2` / `C4` / `T4` (types 3D2Osym / 3D4O3sym / 3D4O2sym of
#! kind k). 3D only. The material type has the components `yield` and `hard`
#! (MATERIAL_SOLVERS['closest_point']), `iter_nw` and `tol`. Every procedure of a body takes the
#! elasticity of the step as the argument `elas` (the linear elasticity of the material, or the frozen
#! elasticity of its viscoelastic model, D-017.13d) and the plastic state; the point kernel `UPDATE`
#! that calls `SOLVE` (and updates the viscoelastic state) and the history layout are generated by the
#! material template.
#! The dummy arguments of `SOLVE` are the macro `SOLVE_DUMMIES` of the material template.
#! Preprocessed alone (FORD preprocesses every template) it expands to nothing.
#:if defined('MAT')

    pure subroutine ${SOLVE}$(mat, elas, strain, dt, state_n, state_np1, stress, tangent, status, iters)
        !! Closest point return mapping of material `${MAT.name}$` at one point, `real(${k}$)`: the
        !! state at \( t_{n+1} \), the stress and the consistent (analytic) tangent for the total
        !! strain `strain` from the converged state `state_n`. Rate independent: the time step `dt` of
        !! the common kernel signature is not used.
        !!
        !! Elastic predictor \( f_{trial}/\max(\sigma_y, \) `SY_MIN_${k}$`\( ) \le \) `TOL_ELASTIC_${k}$`;
        !! otherwise Newton iterations on \( \Delta\gamma \) with under-relaxation (factor 0.75 at
        !! iterations 10, 20, 30, 40 and when \( \Delta\gamma \) is clipped at 0) until
        !! \( |f| < tol\,\max(\sigma_y, \) `SY_MIN_${k}$`\( ) \) and the plastic strain residual is below
        !! `tol` (D-018.3, D-018.11b). An elastic and a converged plastic step
        !! return `STATUS_OK` (`iters` = 0 in an elastic step); with `STATUS_NOT_CONVERGED` the
        !! outputs hold the last iterate and must not be used (D-017.14f).
        use muscle_kinds, only : TOL_ELASTIC_${k}$, SY_MIN_${k}$
        use muscle_status, only : STATUS_OK, STATUS_NOT_CONVERGED
        use muscle_tensors, only : operator(-)
        use muscle_elasticity_laws, only : elas_stress
        use muscle_yield_criteria, only : yield_stress_eq
        use muscle_hard_laws, only : hard_stress
        implicit none
        @:DEVICE()
@:SOLVE_DUMMIES()

        type(${S2}$) :: stress_trial
        real(${k}$) :: hard_n, f_trial, dgamma, omega
        logical :: converged
        integer :: i

        ! dt: argument of the common kernel signature of the materials (D-018.12c), not used here
        associate (unused_dt => dt)
        end associate

        ! Elastic trial check
        stress_trial = elas_stress(elas, strain - state_n%strain_p)
        hard_n = hard_stress(mat%hard, state_n%strain_pf)
        f_trial = yield_stress_eq(mat%yield, stress_trial) - hard_n

        if (f_trial/max(hard_n, SY_MIN_${k}$) <= TOL_ELASTIC_${k}$) then
            state_np1%stress = stress_trial
            state_np1%strain_p = state_n%strain_p
            state_np1%strain_pf = state_n%strain_pf
            status = STATUS_OK
            iters = 0
        else
            ! Newton-Raphson loop with adaptive relaxation from the converged state
            state_np1 = state_n
            dgamma = 0.0_${k}$
            omega = 1.0_${k}$
            status = STATUS_NOT_CONVERGED
            do i = 1, mat%iter_nw
                ! Stagnation protection
                if (i == 10 .or. i == 20 .or. i == 30 .or. i == 40) then
                    omega = omega*0.75_${k}$
                end if
                call ${ITER}$(mat, elas, strain, state_n, state_np1, dgamma, omega, converged)
                if (converged) then
                    status = STATUS_OK
                    exit
                end if
            end do
            ! Exhausted iterations: the loop counter ends at iter_nw + 1 (D-018.10a)
            iters = min(i, mat%iter_nw)
        end if

        stress = state_np1%stress
        call ${TANGENT}$(mat, elas, strain, state_n, state_np1, tangent)
    end subroutine ${SOLVE}$

    pure subroutine ${ITER}$(mat, elas, strain, state_n, state, dgamma, omega, converged)
        !! One Newton-Raphson iteration of the closest point return mapping of material `${MAT.name}$`,
        !! `real(${k}$)`, with under-relaxation `omega` of \( \Delta\gamma \) and of the plastic strain.
        use muscle_tensors, only : operator(+), operator(-), operator(*), operator(/), operator(.ddot.), &
            operator(.inv.)
        use muscle_elasticity_laws, only : elas_stress, elas_dstress_dstrain
        use muscle_yield_criteria, only : yield_stress_eq, yield_dstress_eq, yield_ddstress_eq, &
            yield_stress_eq_and_derivatives, yield_joint_evaluation
        use muscle_kinds, only : SY_MIN_${k}$
        use muscle_hard_laws, only : hard_stress, hard_dstress_dep
        implicit none
        @:DEVICE()
        type(${MAT_T}$), intent(in) :: mat
            !! Material.
        type(${ELAS_T}$), intent(in) :: elas
            !! Elasticity of the step (that of the material, or the frozen one of its viscoelastic model).
        type(${S2}$), intent(in) :: strain
            !! Total strain at \( t_{n+1} \).
        type(plastic_state_${k}$), intent(in) :: state_n
            !! Converged state at \( t_n \).
        type(plastic_state_${k}$), intent(inout) :: state
            !! Candidate state at \( t_{n+1} \): iterate k in, k+1 out (unchanged plastic variables and
            !! the stress of iterate k when converged).
        real(${k}$), intent(inout) :: dgamma
            !! Plastic multiplier increment \( \Delta\gamma \).
        real(${k}$), intent(inout) :: omega
            !! Relaxation factor, \( 0 < \omega \le 1 \) (reduced when \( \Delta\gamma \) is clipped at 0).
        logical, intent(out) :: converged
            !! Iterate k meets the tolerance.

        type(${S2}$) :: strain_p, df, residual, dstrain_p, stress
        type(${C4}$) :: elas_tan, elas_inv, hess, ddf
        real(${k}$) :: strain_pf, hard, dhard, f, norm_res, ddgamma
        logical :: joint

        strain_p = state%strain_p
        strain_pf = state%strain_pf

        ! Elastic tangent, stress, equivalent stress and its gradient (and the Hessian too when the
        ! criterion evaluates the three together)
        elas_tan = elas_dstress_dstrain(elas, strain - strain_p)
        stress = elas_stress(elas, strain - strain_p)
        hard = hard_stress(mat%hard, strain_pf)
        joint = yield_joint_evaluation(mat%yield)
        if (joint) then
            call yield_stress_eq_and_derivatives(mat%yield, stress, f, df, ddf)
            f = f - hard
        else
            f = yield_stress_eq(mat%yield, stress) - hard
            df = yield_dstress_eq(mat%yield, stress)
        end if

        ! Plastic strain residual
        dhard = hard_dstress_dep(mat%hard, strain_pf)
        residual = state_n%strain_p - strain_p + (dgamma*df)
        norm_res = sqrt(sum(residual%vals**2))

        ! Convergence: |f| relative to the current yield stress (D-018.3); the plastic strain residual
        ! (dimensionless) against the same tolerance
        if (abs(f) < mat%tol*max(hard, SY_MIN_${k}$) .and. norm_res < mat%tol) then
            converged = .true.
            state%stress = stress
            return
        end if
        converged = .false.

        ! Algorithmic Hessian and Newton correction of dgamma
        if (.not. joint) ddf = yield_ddstress_eq(mat%yield, stress)
        elas_inv = .inv. elas_tan
        hess = .inv. (elas_inv + dgamma*ddf)

        ddgamma = (f - (df .ddot. hess .ddot. residual))/((df .ddot. hess .ddot. df) + dhard)

        ! Under-relaxed step, non-negative plastic multiplier
        dgamma = dgamma + omega*ddgamma
        if (dgamma < 0.0_${k}$) then
            dgamma = 0.0_${k}$
            omega = omega*0.75_${k}$
        end if

        strain_pf = state_n%strain_pf + dgamma

        ! The plastic strain takes the same relaxed step as dgamma (except in an iteration where
        ! dgamma is clipped at zero)
        dstrain_p = (elas_inv .ddot. hess) .ddot. (residual + ddgamma*df)
        strain_p = strain_p + omega*dstrain_p

        state%strain_p = strain_p
        state%strain_pf = strain_pf
        state%stress = stress
    end subroutine ${ITER}$

#:include "muscle_closest_point_tangent.fypp"
#:endif
