#! SPDX-License-Identifier: GPL-3.0-or-later
#! Copyright (C) 2025 Matias Pacheco-Alarcon <matias.pacheco.a@gmail.com>
#! Body of the closest point return mapping with a symmetric 6x6 Cholesky factorization of a declared material
#! (D-054), written once against the family generics `elas_*`, `yield_*` and `hard_*`. Same Newton iteration as
#! `closest_point` (elastic predictor, under-relaxation, clipping of the multiplier at zero, same convergence test);
#! each correction eliminates the multiplier (Schur complement) and solves two systems with K = C + dgamma C:d2f:C
#! (symmetric positive definite for a convex criterion) in Mandel components (one Cholesky factorization, no
#! pivoting, no inverse of the elasticity). The consistent tangent reuses the same factorization (seven solutions).
#!
#! Included by src/materials/muscle_material.fypp inside its `#:for k` loop, with these variables set: `k`, `MAT`,
#! `MAT_T`, `ELAS_T`, `SOLVE` / `ITER` / `TANGENT` and `S2` / `C4` / `T4` (see muscle_closest_point_body.fypp). 3D
#! only. The material type has the components `yield` and `hard` (MATERIAL_SOLVERS['closest_point_chol']), `iter_nw`
#! and `tol`. The dummy arguments of `SOLVE` are declared by hand in the body (one signature for every solver).
#! Preprocessed alone (FORD preprocesses every template) it expands to nothing.
#:if defined('MAT')

    pure subroutine ${SOLVE}$(mat, elas, strain, dt, state_n, state_np1, stress, tangent, status, iters)
        !! Cholesky closest point return mapping of material `${MAT.name}$` at one point, `real(${k}$)`:
        !! the state at \( t_{n+1} \), the stress and the consistent (analytic) tangent for the total
        !! strain `strain` from the converged state `state_n`. Rate independent: the time step `dt` of
        !! the common kernel signature is not used.
        !!
        !! The Newton iteration of `closest_point`: elastic predictor \( f_{trial}/\max(\sigma_y, \)
        !! `SY_MIN_${k}$`\( ) \le \) `TOL_ELASTIC_${k}$`; otherwise Newton iterations on \( \Delta\gamma \) with
        !! under-relaxation (factor 0.75 at iterations 10, 20, 30, 40 and when \( \Delta\gamma \) is clipped at
        !! 0) until \( |f| < tol\,\max(\sigma_y, \) `SY_MIN_${k}$`\( ) \) and the plastic strain residual is below
        !! `tol`. Each correction comes from one 6x6 Cholesky factorization (`${ITER}$`). An elastic and a
        !! converged plastic step return `STATUS_OK` (`iters` = 0 in an elastic step); with
        !! `STATUS_NOT_CONVERGED` the outputs hold the last iterate and must not be used.
        !!
        !! **Why this solver (D-054).** The direct alternative to the conjugate gradients of `closest_point_cg`: it
        !! forms the second derivative of the criterion and the matrix \( \mathbb{K} = \mathbb{C} + \Delta\gamma\,
        !! \mathbb{C}:\partial^2 f/\partial\boldsymbol\sigma^2:\mathbb{C} \) (symmetric positive definite for a convex
        !! criterion) once per iteration and factorizes it by Cholesky (no pivoting, no inverse); the factorization
        !! and the solutions are unrolled with literal subscripts, so that the matrix stays in registers on a GPU, and
        !! the tangent reuses the same factorization. Measured (D-056): on the Intel UHD 770 (sp, 100 000 points)
        !! it is the fastest closest point with the polynomial Yld2004 (`yld2004p`, 37.0 ms, with
        !! `closest_point_lu` 37.9 and `closest_point_cg` 42.9) and slower than `closest_point_cg` with every other
        !! criterion (with CPB06ex2 and the spectral Yld2004 its kernels exceed the size where the Intel GPU
        !! compiler stops inlining: correct results, 67 and 60 ms against 21 and 47); on the CPU `closest_point_lu`
        !! is faster. Same Newton iteration, tolerances and limits as `closest_point`; its iterates agree with
        !! those of `closest_point` up to rounding.
        use muscle_kinds, only : TOL_ELASTIC_${k}$, SY_MIN_${k}$
        use muscle_status, only : STATUS_OK, STATUS_NOT_CONVERGED
        use muscle_tensors, only : operator(-)
        use muscle_elas_laws, only : elas_stress
        use muscle_yield_laws, only : yield_stress_eq
        use muscle_hard_laws, only : hard_stress
        implicit none
        @:DEVICE()
        type(${MAT_T}$), intent(in) :: mat
            !! Material (parameters of its models, iteration limit and tolerance).
        type(${ELAS_T}$), intent(in) :: elas
            !! Elasticity of the step (that of the material, or the frozen one of its viscoelastic model).
        type(${S2}$), intent(in) :: strain
            !! Total strain at \( t_{n+1} \).
        real(${k}$), intent(in) :: dt
            !! Time step (not used).
        type(plastic_state_${k}$), intent(in) :: state_n
            !! Converged state at \( t_n \).
        type(plastic_state_${k}$), intent(out) :: state_np1
            !! State at \( t_{n+1} \) (stress, plastic strain, equivalent plastic strain).
        type(${S2}$), intent(out) :: stress
            !! Stress at \( t_{n+1} \) (the stress of `state_np1`).
        type(${T4}$), intent(out) :: tangent
            !! Consistent tangent \( d\boldsymbol\sigma/d\boldsymbol\varepsilon \) at \( t_{n+1} \).
        integer, intent(out) :: status
            !! `STATUS_OK` or `STATUS_NOT_CONVERGED` (muscle_status).
        integer, intent(out) :: iters
            !! Newton iterations (0 in an elastic step, at most `mat%iter_nw`).

        type(${S2}$) :: stress_trial
        real(${k}$) :: hard_n, f_trial, dgamma, omega
        logical :: converged
        integer :: i

        ! dt: argument of the common kernel signature of the materials, not used here
        associate (unused_dt => dt)
        end associate

        ! Elastic trial check
        stress_trial = elas_stress(elas, strain - state_n%strain_p)
        hard_n = hard_stress(mat%hard, state_n%strain_pf)
        f_trial = yield_stress_eq(mat%yield, stress_trial) - hard_n

        if (f_trial/max(hard_n, SY_MIN_${k}$) <= TOL_ELASTIC_${k}$) then
            state_np1%stress = stress_trial
            state_np1%strain_p = state_n%strain_p
            state_np1%strain_pf = state_n%strain_pf
            status = STATUS_OK
            iters = 0
        else
            ! Newton-Raphson loop with adaptive relaxation from the converged state
            state_np1 = state_n
            dgamma = 0.0_${k}$
            omega = 1.0_${k}$
            status = STATUS_NOT_CONVERGED
            do i = 1, mat%iter_nw
                ! Stagnation protection
                if (i == 10 .or. i == 20 .or. i == 30 .or. i == 40) then
                    omega = omega*0.75_${k}$
                end if
                call ${ITER}$(mat, elas, strain, state_n, state_np1, dgamma, omega, converged)
                if (converged) then
                    status = STATUS_OK
                    exit
                end if
            end do
            ! Exhausted iterations: the loop counter ends at iter_nw + 1
            iters = min(i, mat%iter_nw)
        end if

        stress = state_np1%stress
        call ${TANGENT}$(mat, elas, strain, state_n, state_np1, tangent)
    end subroutine ${SOLVE}$

    pure subroutine ${ITER}$(mat, elas, strain, state_n, state, dgamma, omega, converged)
        !! One Newton-Raphson iteration of the Cholesky closest point return mapping of material `${MAT.name}$`,
        !! `real(${k}$)`, with under-relaxation `omega` of \( \Delta\gamma \) and of the plastic strain.
        !!
        !! The correction of `closest_point` (see `closest_point_cg`): \( \delta\Delta\gamma = (f - (\mathbb{C}:
        !! \mathbf{n}):\mathbf{y}_r)/((\mathbb{C}:\mathbf{n}):\mathbf{y}_n + h) \), \( \delta\boldsymbol\varepsilon^p =
        !! \mathbf{y}_r + \delta\Delta\gamma\,\mathbf{y}_n \), with \( \mathbb{K}\,\mathbf{y} = \mathbb{C}:\mathbf{b} \),
        !! \( \mathbb{K} = \mathbb{C} + \Delta\gamma\,\mathbb{C}:\partial^2 f/\partial\boldsymbol\sigma^2:\mathbb{C} \),
        !! for \( \mathbf{b} = \mathbf{r} \) and \( \mathbf{b} = \mathbf{n} \). \( \mathbb{K} \) is formed in Mandel
        !! components (shears times \( \sqrt 2 \), where it is a symmetric matrix and the double contraction the
        !! plain dot product) and factorized once by Cholesky (`${ITER}$_chol`). A factorization that fails (a
        !! matrix that is not positive definite) leaves the iterate unchanged (it then does not converge).
        use muscle_tensors, only : operator(+), operator(-), operator(*), operator(.ddot.)
        use muscle_elas_laws, only : elas_stress, elas_dstress_dstrain
        use muscle_yield_laws, only : yield_stress_eq, yield_dstress_eq, yield_ddstress_eq, &
            yield_stress_eq_and_derivatives, yield_joint_evaluation
        use muscle_kinds, only : SY_MIN_${k}$
        use muscle_hard_laws, only : hard_stress, hard_dstress_dep
        implicit none
        @:DEVICE()
        type(${MAT_T}$), intent(in) :: mat
            !! Material.
        type(${ELAS_T}$), intent(in) :: elas
            !! Elasticity of the step (that of the material, or the frozen one of its viscoelastic model).
        type(${S2}$), intent(in) :: strain
            !! Total strain at \( t_{n+1} \).
        type(plastic_state_${k}$), intent(in) :: state_n
            !! Converged state at \( t_n \).
        type(plastic_state_${k}$), intent(inout) :: state
            !! Candidate state at \( t_{n+1} \): iterate k in, k+1 out (unchanged plastic variables and
            !! the stress of iterate k when converged).
        real(${k}$), intent(inout) :: dgamma
            !! Plastic multiplier increment \( \Delta\gamma \).
        real(${k}$), intent(inout) :: omega
            !! Relaxation factor, \( 0 < \omega \le 1 \) (reduced when \( \Delta\gamma \) is clipped at 0).
        logical, intent(out) :: converged
            !! Iterate k meets the tolerance.

        type(${S2}$) :: strain_p, df, residual, stress, cb
        type(${C4}$) :: elas_tan, ddf
        real(${k}$) :: strain_pf, hard, dhard, f, norm_res, ddgamma
        real(${k}$) :: a(6,6), dinv(6), cn(6), yr(6), yn(6)
        logical :: joint, ok
        real(${k}$), parameter :: SQW(6) = [1.0_${k}$, 1.0_${k}$, 1.0_${k}$, &
            sqrt(2.0_${k}$), sqrt(2.0_${k}$), sqrt(2.0_${k}$)]
            ! Mandel factors: square roots of the weights of the components in the double contraction

        strain_p = state%strain_p
        strain_pf = state%strain_pf

        ! Elastic tangent, stress, equivalent stress and its gradient (and the Hessian too when the
        ! criterion evaluates the three together)
        elas_tan = elas_dstress_dstrain(elas, strain - strain_p)
        stress = elas_stress(elas, strain - strain_p)
        hard = hard_stress(mat%hard, strain_pf)
        joint = yield_joint_evaluation(mat%yield)
        if (joint) then
            call yield_stress_eq_and_derivatives(mat%yield, stress, f, df, ddf)
            f = f - hard
        else
            f = yield_stress_eq(mat%yield, stress) - hard
            df = yield_dstress_eq(mat%yield, stress)
        end if

        ! Plastic strain residual
        dhard = hard_dstress_dep(mat%hard, strain_pf)
        residual = state_n%strain_p - strain_p + (dgamma*df)
        norm_res = sqrt(sum(residual%vals**2))

        ! Convergence: |f| relative to the current yield stress; the plastic strain residual
        ! (dimensionless) against the same tolerance
        if (abs(f) < mat%tol*max(hard, SY_MIN_${k}$) .and. norm_res < mat%tol) then
            converged = .true.
            state%stress = stress
            return
        end if
        converged = .false.

        ! K in Mandel components, its Cholesky factor, then y_r and y_n (Mandel) and the correction
        if (.not. joint) ddf = yield_ddstress_eq(mat%yield, stress)
        call ${ITER}$_kmat(elas_tan, ddf, dgamma, a)
        call ${ITER}$_chol(a, dinv, ok)
        if (.not. ok) then
            state%stress = stress
            return
        end if
        cb = elas_tan .ddot. residual
        call ${ITER}$_csolve(a, dinv, SQW*cb%vals, yr)
        cb = elas_tan .ddot. df
        cn = SQW*cb%vals
        call ${ITER}$_csolve(a, dinv, cn, yn)
        ddgamma = (f - sum(cn*yr))/(sum(cn*yn) + dhard)

        ! Under-relaxed step, non-negative plastic multiplier
        dgamma = dgamma + omega*ddgamma
        if (dgamma < 0.0_${k}$) then
            dgamma = 0.0_${k}$
            omega = omega*0.75_${k}$
        end if

        strain_pf = state_n%strain_pf + dgamma

        ! The plastic strain takes the same relaxed step as dgamma (except in an iteration where
        ! dgamma is clipped at zero); back from Mandel components
        strain_p%vals = strain_p%vals + omega*(yr + ddgamma*yn)/SQW

        state%strain_p = strain_p
        state%strain_pf = strain_pf
        state%stress = stress
    end subroutine ${ITER}$

    pure subroutine ${ITER}$_kmat(elas_tan, ddf, dgamma, a)
        !! \( \mathbb{K} = \mathbb{C} + \Delta\gamma\,\mathbb{C}:\partial^2 f/\partial\boldsymbol\sigma^2:\mathbb{C} \)
        !! in Mandel components, `real(${k}$)`: column j is \( \mathbb{K} \) acting on the unit Mandel component j
        !! (\( \mathbf{e}_j/\sqrt{w_j} \) in the storage), times \( \sqrt{w_i} \) row by row (\( w \) = 1 normal, 2
        !! shear).
        use muscle_tensors, only : operator(+), operator(*), operator(.ddot.)
        implicit none
        @:DEVICE()
        type(${C4}$), intent(in) :: elas_tan
            !! Elastic tangent C.
        type(${C4}$), intent(in) :: ddf
            !! Second derivative of the criterion.
        real(${k}$), intent(in) :: dgamma
            !! Plastic multiplier increment.
        real(${k}$), intent(out) :: a(6,6)
            !! K (Mandel components; symmetric up to rounding, the factorization reads the lower triangle).
        type(${S2}$) :: x, cx, kx
        real(${k}$), parameter :: SQW(6) = [1.0_${k}$, 1.0_${k}$, 1.0_${k}$, &
            sqrt(2.0_${k}$), sqrt(2.0_${k}$), sqrt(2.0_${k}$)]
            ! Mandel factors: square roots of the weights of the components in the double contraction

        ! Unrolled with literal column subscripts (a runtime subscript sends x and a to private memory on the GPU)
        #:for j in range(1, 7)
        x%vals = 0.0_${k}$
        x%vals(${j}$) = 1.0_${k}$/SQW(${j}$)
        cx = elas_tan .ddot. x
        kx = cx + dgamma*(elas_tan .ddot. (ddf .ddot. cx))
        a(:, ${j}$) = SQW*kx%vals
        #:endfor
    end subroutine ${ITER}$_kmat

    pure subroutine ${ITER}$_chol(a, dinv, ok)
        !! In place Cholesky factorization \( \mathbb{K} = \mathbf{L}\mathbf{L}^T \) of a symmetric 6x6 matrix,
        !! `real(${k}$)`, unrolled with literal subscripts (the factor stays in registers): the strict lower
        !! triangle of `a` becomes that of \( \mathbf{L} \) and `dinv` the reciprocals of its diagonal. `ok` is
        !! false when a pivot is not positive and finite (not positive definite, NaN or Inf).
        implicit none
        @:DEVICE()
        real(${k}$), intent(inout) :: a(6,6)
            !! Matrix (lower triangle read); strict lower triangle of L on exit.
        real(${k}$), intent(out) :: dinv(6)
            !! Reciprocals of the diagonal of L.
        logical, intent(out) :: ok
            !! The factorization exists.
        real(${k}$) :: d

        ok = .false.
        dinv = 0.0_${k}$
        ! Column j: d = a(j,j) - sum_(p<j) a(j,p)**2, L(j,j) = sqrt(d) and, below the diagonal,
        ! a(i,j) = (a(i,j) - sum_(p<j) a(i,p) a(j,p))/L(j,j) (the inline loops expand the sums)
        #:for j in range(1, 7)
        d = a(${j}$,${j}$)#{for p in range(1, j)}# - a(${j}$,${p}$)*a(${j}$,${p}$)#{endfor}#
        if (.not. (d > 0.0_${k}$ .and. d <= huge(1.0_${k}$))) return
        dinv(${j}$) = 1.0_${k}$/sqrt(d)
        #:for i in range(j + 1, 7)
        a(${i}$,${j}$) = (a(${i}$,${j}$)#{for p in range(1, j)}# - a(${i}$,${p}$)*a(${j}$,${p}$)#{endfor}#)*dinv(${j}$)
        #:endfor
        #:endfor
        ok = .true.
    end subroutine ${ITER}$_chol

    pure subroutine ${ITER}$_csolve(a, dinv, b, x)
        !! Solution of \( \mathbf{L}\mathbf{L}^T\mathbf{x} = \mathbf{b} \) with the factor of `${ITER}$_chol`,
        !! `real(${k}$)`, unrolled with literal subscripts.
        implicit none
        @:DEVICE()
        real(${k}$), intent(in) :: a(6,6)
            !! Strict lower triangle of L.
        real(${k}$), intent(in) :: dinv(6)
            !! Reciprocals of the diagonal of L.
        real(${k}$), intent(in) :: b(6)
            !! Right-hand side.
        real(${k}$), intent(out) :: x(6)
            !! Solution.

        ! Forward: L z = b, z(i) = (b(i) - sum_(p<i) a(i,p) z(p))/L(i,i); backward: L^T x = z,
        ! x(i) = (z(i) - sum_(p>i) a(p,i) x(p))/L(i,i)
        #:for i in range(1, 7)
        x(${i}$) = (b(${i}$)#{for p in range(1, i)}# - a(${i}$,${p}$)*x(${p}$)#{endfor}#)*dinv(${i}$)
        #:endfor
        #:for i in range(6, 0, -1)
        x(${i}$) = (x(${i}$)#{for p in range(i + 1, 7)}# - a(${p}$,${i}$)*x(${p}$)#{endfor}#)*dinv(${i}$)
        #:endfor
    end subroutine ${ITER}$_csolve

    pure subroutine ${TANGENT}$(mat, elas, strain, state_n, state_np1, tangent)
        !! Consistent algorithmic tangent of the Cholesky closest point return mapping of material
        !! `${MAT.name}$` at the state `state_np1`, `real(${k}$)`: the tangent of `closest_point`,
        !! \( \mathbb{C}^{ep} = \mathbb{H} - (\mathbb{H}:\mathbf{n})\otimes(\mathbf{n}:\mathbb{H})
        !! /(\mathbf{n}:\mathbb{H}:\mathbf{n} + d\sigma_y/d\epsilon_p) \), with \( \mathbb{H}:\mathbf{b} =
        !! \mathbb{C}:\mathbf{y} \), \( \mathbb{K}\,\mathbf{y} = \mathbb{C}:\mathbf{b} \), from one Cholesky
        !! factorization of \( \mathbb{K} \) and seven solutions (the six unit components and \( \mathbf{n} \)).
        !! The elastic tangent when \( |\Delta\gamma| \le \) `DGAMMA_MIN_${k}$`, or when the factorization fails.
        use muscle_tensors, only : operator(-), operator(.ddot.), assignment(=)
        use muscle_elas_laws, only : elas_dstress_dstrain
        use muscle_yield_laws, only : yield_dstress_eq, yield_ddstress_eq
        use muscle_hard_laws, only : hard_dstress_dep
        use muscle_kinds, only : DGAMMA_MIN_${k}$
        implicit none
        @:DEVICE()
        type(${MAT_T}$), intent(in) :: mat
            !! Material.
        type(${ELAS_T}$), intent(in) :: elas
            !! Elasticity of the step (that of the material, or the frozen one of its viscoelastic model).
        type(${S2}$), intent(in) :: strain
            !! Total strain at \( t_{n+1} \).
        type(plastic_state_${k}$), intent(in) :: state_n
            !! Converged state at \( t_n \).
        type(plastic_state_${k}$), intent(in) :: state_np1
            !! State at \( t_{n+1} \).
        type(${T4}$), intent(out) :: tangent
            !! Consistent tangent.

        type(${S2}$) :: df, e_basis, col, m
        type(${C4}$) :: elas_tan, ddf
        real(${k}$) :: dhard, dgamma, den, a(6,6), dinv(6), y(6)
        logical :: ok
        integer :: j
        real(${k}$), parameter :: SQW(6) = [1.0_${k}$, 1.0_${k}$, 1.0_${k}$, &
            sqrt(2.0_${k}$), sqrt(2.0_${k}$), sqrt(2.0_${k}$)]
            ! Mandel factors: square roots of the weights of the components in the double contraction

        dgamma = state_np1%strain_pf - state_n%strain_pf
        elas_tan = elas_dstress_dstrain(elas, strain - state_np1%strain_p)
        if (abs(dgamma) <= DGAMMA_MIN_${k}$) then
            tangent = elas_tan
            return
        end if

        dhard = hard_dstress_dep(mat%hard, state_np1%strain_pf)
        df = yield_dstress_eq(mat%yield, state_np1%stress)
        ddf = yield_ddstress_eq(mat%yield, state_np1%stress)
        call ${ITER}$_kmat(elas_tan, ddf, dgamma, a)
        call ${ITER}$_chol(a, dinv, ok)
        if (.not. ok) then
            tangent = elas_tan
            return
        end if

        ! H acting on the unit component e_j; the stored entry is that action divided by the weight of
        ! component j in the contraction (1 normal, 2 shear); unrolled with literal subscripts
        #:for j in range(1, 7)
        e_basis%vals = 0.0_${k}$
        e_basis%vals(${j}$) = 1.0_${k}$
        col = elas_tan .ddot. e_basis
        call ${ITER}$_csolve(a, dinv, SQW*col%vals, y)
        e_basis%vals = y/SQW
        col = elas_tan .ddot. e_basis
        #:if j > 3
        tangent%vals(:, ${j}$) = 0.5_${k}$*col%vals
        #:else
        tangent%vals(:, ${j}$) = col%vals
        #:endif
        #:endfor
        ! H:n
        col = elas_tan .ddot. df
        call ${ITER}$_csolve(a, dinv, SQW*col%vals, y)
        e_basis%vals = y/SQW
        m = elas_tan .ddot. e_basis
        den = (df .ddot. m) + dhard
        do j = 1, 6
            tangent%vals(:, j) = tangent%vals(:, j) - m%vals*(m%vals(j)/den)
        end do
    end subroutine ${TANGENT}$
#:endif
