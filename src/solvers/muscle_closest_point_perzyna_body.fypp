#! Body of the closest point return mapping for overstress viscoplasticity (Perzyna, Chaboche) of a
#! declared material (D-018.5), written once against the family generics `elas_*`, `yield_*`, `os_*`
#! and `hard_*` (Phase 6): they resolve at compile time by the parameter types of the components of
#! the material. Port of the historical OO solver
#! (muscle_solver_closest_point_perzyna, removed in Phase 7 step 9) operation by operation, so that
#! both give the same bits in double precision; relative Newton tolerance on the residuals in stress
#! units in both (D-018.3, D-018.12a).
#!
#! Included by src/materials/muscle_material.fypp inside its `#:for k` loop (contained procedures of
#! the material module), with these variables set: `k` (kind), `MAT` (the `muscle_meta.Material`),
#! `MAT_T`, `ELAS_T`, `SOLVE` / `ITER` / `TANGENT` / `MERIT` (specific procedure names) and `S2` / `C4`
#! / `T4` (see muscle_closest_point_body.fypp, also for the argument `elas`). 3D only. The material type
#! has the components `yield`, `os` and `hard` (the hardening law the overstress law composes,
#! MATERIAL_SOLVERS['closest_point_perzyna']), `iter_nw` and `tol`.
#! The dummy arguments of `SOLVE` are the macro `SOLVE_DUMMIES` of the material template.
#! Preprocessed alone (FORD preprocesses every template) it expands to nothing.
#:if defined('MAT')
#! Values of the composed hardening law the overstress function `f` receives at `ep` (D-017.6b)
#:set HARD = lambda f, ep: muscle_meta.material_comp_args(MAT, 'os', f, ep)
#:set COMPOSED = muscle_meta.material_composed(MAT, 'os') is not None

    pure subroutine ${SOLVE}$(mat, elas, strain, dt, state_n, state_np1, stress, tangent, status, iters)
        !! Closest point return mapping for overstress viscoplasticity of material `${MAT.name}$` at one
        !! point, `real(${k}$)`: the state at \( t_{n+1} \), the stress and the consistent (analytic)
        !! tangent for the total strain `strain` after the time step `dt` from the converged state
        !! `state_n`.
        !!
        !! The plastic multiplier follows the flow law \( \Delta\lambda = \Delta t\, g(\sigma_{eq},
        !! \epsilon_p) \) (not the consistency condition): elastic step when \( g \le 0 \) at the trial
        !! stress; otherwise Newton iterations on the residuals \( R_{\epsilon_p} = \epsilon_{p,n} -
        !! \epsilon_p + \Delta\lambda\,\partial f/\partial\boldsymbol\sigma \) and \( R_\lambda = \Delta\lambda
        !! - \Delta t\, g \) with a backtracking line search, until both in stress units,
        !! \( |\mathbb{C}:R_{\epsilon_p}| \) and \( |R_\lambda|/(\Delta t\,\partial g/\partial\sigma_{eq}) \),
        !! are below \( tol\,\max(\sigma_y, \) `SY_MIN_${k}$`\( ) \) (D-018.3, D-018.12a; the first one
        !! with a floor at its rounding). An elastic and a converged plastic step return `STATUS_OK`
        !! (`iters` = 0 in an elastic step); with `STATUS_NOT_CONVERGED` the outputs hold the last iterate and must not be
        !! used (D-017.14f).
        use muscle_status, only : STATUS_OK, STATUS_NOT_CONVERGED
        use muscle_tensors, only : operator(-)
        use muscle_elasticity_laws, only : elas_stress
        use muscle_yield_criteria, only : yield_stress_eq
        use muscle_vp_overstress_laws, only : os_flow_rate
#:if COMPOSED
        use muscle_hard_laws, only : hard_stress
#:endif
        implicit none
        @:DEVICE()
@:SOLVE_DUMMIES()

        type(${S2}$) :: stress_trial
        logical :: converged
        integer :: i

        ! Elastic trial check: no flow if the flow rate vanishes
        stress_trial = elas_stress(elas, strain - state_n%strain_p)
        if (os_flow_rate(mat%os, yield_stress_eq(mat%yield, stress_trial), &
                         state_n%strain_pf${HARD('flow_rate', 'state_n%strain_pf')}$) <= 0.0_${k}$) then
            state_np1%stress = stress_trial
            state_np1%strain_p = state_n%strain_p
            state_np1%strain_pf = state_n%strain_pf
            status = STATUS_OK
            iters = 0
        else
            ! Newton-Raphson loop from the converged state
            state_np1 = state_n
            status = STATUS_NOT_CONVERGED
            do i = 1, mat%iter_nw
                call ${ITER}$(mat, elas, strain, dt, state_n, state_np1, converged)
                if (converged) then
                    status = STATUS_OK
                    exit
                end if
            end do
            ! Exhausted iterations: the loop counter ends at iter_nw + 1
            iters = min(i, mat%iter_nw)
        end if

        stress = state_np1%stress
        call ${TANGENT}$(mat, elas, strain, dt, state_n, state_np1, tangent)
    end subroutine ${SOLVE}$

    pure function ${MERIT}$(mat, elas, strain, dt, strain_p, strain_p_n, dgamma, strain_pf_n) result(res)
        !! Merit function of the line search of material `${MAT.name}$`, `real(${k}$)`: squared norm of
        !! the residuals \( (R_{\epsilon_p}, R_\lambda) \) at a trial state.
        use muscle_tensors, only : operator(+), operator(-), operator(*)
        use muscle_elasticity_laws, only : elas_stress
        use muscle_yield_criteria, only : yield_stress_eq, yield_dstress_eq
        use muscle_vp_overstress_laws, only : os_flow_rate
#:if COMPOSED
        use muscle_hard_laws, only : hard_stress
#:endif
        implicit none
        @:DEVICE()
        type(${MAT_T}$), intent(in) :: mat
            !! Material.
        type(${ELAS_T}$), intent(in) :: elas
            !! Elasticity of the step (that of the material, or the frozen one of its viscoelastic model).
        type(${S2}$), intent(in) :: strain
            !! Total strain at \( t_{n+1} \).
        real(${k}$), intent(in) :: dt
            !! Time step.
        type(${S2}$), intent(in) :: strain_p
            !! Trial plastic strain.
        type(${S2}$), intent(in) :: strain_p_n
            !! Converged plastic strain at \( t_n \).
        real(${k}$), intent(in) :: dgamma
            !! Trial plastic multiplier increment.
        real(${k}$), intent(in) :: strain_pf_n
            !! Converged equivalent plastic strain at \( t_n \).
        real(${k}$) :: res
            !! \( |R_{\epsilon_p}|^2 + R_\lambda^2 \).

        type(${S2}$) :: stress, residual1
        real(${k}$) :: stress_eq, ep

        stress = elas_stress(elas, strain - strain_p)
        stress_eq = yield_stress_eq(mat%yield, stress)
        residual1 = strain_p_n - strain_p + (dgamma*yield_dstress_eq(mat%yield, stress))
        ep = strain_pf_n + dgamma
        res = sum(residual1%vals**2) + (dgamma - dt*os_flow_rate(mat%os, stress_eq, ep${HARD('flow_rate', 'ep')}$))**2
    end function ${MERIT}$

    pure subroutine ${ITER}$(mat, elas, strain, dt, state_n, state, converged)
        !! One Newton-Raphson iteration on \( (R_{\epsilon_p}, R_\lambda) \) of material `${MAT.name}$`,
        !! `real(${k}$)`, with a backtracking line search on their norm (Newton can cycle when the
        !! hardening slope is very steep, e.g. Swift near zero plastic strain); \( \Delta\lambda \ge 0 \).
        !! The plastic multiplier increment is `state%strain_pf - state_n%strain_pf`.
        use muscle_kinds, only : SY_MIN_${k}$
        use muscle_tensors, only : operator(+), operator(-), operator(*), operator(.ddot.), operator(.inv.)
        use muscle_elasticity_laws, only : elas_stress, elas_dstress_dstrain
        use muscle_yield_criteria, only : yield_stress_eq, yield_dstress_eq, yield_ddstress_eq, &
            yield_stress_eq_and_derivatives, yield_joint_evaluation
        use muscle_vp_overstress_laws, only : os_flow_rate, os_dflow_dsigma, os_dflow_dep
#:if COMPOSED
        use muscle_hard_laws, only : hard_stress, hard_dstress_dep
#:endif
        implicit none
        @:DEVICE()
        type(${MAT_T}$), intent(in) :: mat
            !! Material.
        type(${ELAS_T}$), intent(in) :: elas
            !! Elasticity of the step (that of the material, or the frozen one of its viscoelastic model).
        type(${S2}$), intent(in) :: strain
            !! Total strain at \( t_{n+1} \).
        real(${k}$), intent(in) :: dt
            !! Time step.
        type(plastic_state_${k}$), intent(in) :: state_n
            !! Converged state at \( t_n \).
        type(plastic_state_${k}$), intent(inout) :: state
            !! Candidate state at \( t_{n+1} \): iterate k in, k+1 out (unchanged plastic variables and
            !! the stress of iterate k when converged).
        logical, intent(out) :: converged
            !! Iterate k meets the tolerance.

        integer, parameter :: MAX_BACKTRACK = 10
            ! Maximum number of halvings of the line search (historical value)
        real(${k}$), parameter :: RES_FLOOR_ROUNDINGS = 8.0_${k}$
            ! Roundings of margin of the floor of the plastic strain residual (D-018.12a)
        type(${S2}$) :: strain_p, strain_p_new, df, residual1, dstrain_p, stress
        type(${C4}$) :: elas_tan, elas_inv, hess, ddf
        real(${k}$) :: strain_pf, dgamma, dgamma_new, ddgamma, stress_eq, g, c, gp
        real(${k}$) :: res_lambda, norm_res, merit0, alpha, scale, res_floor
        type(${S2}$) :: res_stress
        logical :: joint
        integer :: i

        strain_p = state%strain_p
        strain_pf = state%strain_pf
        dgamma = strain_pf - state_n%strain_pf

        ! Elastic tangent, stress, equivalent stress and its gradient (and the Hessian too when the
        ! criterion evaluates the three together)
        elas_tan = elas_dstress_dstrain(elas, strain - strain_p)
        stress = elas_stress(elas, strain - strain_p)
        joint = yield_joint_evaluation(mat%yield)
        if (joint) then
            call yield_stress_eq_and_derivatives(mat%yield, stress, stress_eq, df, ddf)
        else
            stress_eq = yield_stress_eq(mat%yield, stress)
            df = yield_dstress_eq(mat%yield, stress)
        end if

        ! Flow law and its derivatives
        g = os_flow_rate(mat%os, stress_eq, strain_pf${HARD('flow_rate', 'strain_pf')}$)
        c = os_dflow_dsigma(mat%os, stress_eq, strain_pf${HARD('dflow_dsigma', 'strain_pf')}$)
        gp = os_dflow_dep(mat%os, stress_eq, strain_pf${HARD('dflow_dep', 'strain_pf')}$)

        ! Residuals (strains)
        residual1 = state_n%strain_p - strain_p + (dgamma*df)
        res_lambda = dgamma - dt*g
        norm_res = sqrt(sum(residual1%vals**2))

        ! Convergence: both residuals in stress units through the elastic tangent, relative to the
        ! current yield stress of the composed hardening law (D-018.3, D-018.12a)
#:if not COMPOSED
#:stop ('closest_point_perzyna body: the overstress law of {} composes no hardening law: no yield stress ' &
    & + 'for the Newton criterion').format(MAT.name)
#:endif
        scale = mat%tol*max(hard_stress(mat%hard, strain_pf), SY_MIN_${k}$)
        res_stress = elas_tan .ddot. residual1
        ! Rounding floor of the plastic strain residual in stress units (D-018.12a): its rounding is about
        ! epsilon |C| |strain_p| (|C| the largest elastic modulus), above tol sigma_y in sp at large plastic
        ! strains (~20 yield strains); 8 roundings of margin. Far below tol sigma_y in dp.
        res_floor = RES_FLOOR_ROUNDINGS*epsilon(1.0_${k}$)*maxval(abs(elas_tan%vals))*sqrt(sum(strain_p%vals**2))
        ! R_lambda/(dt c) is the overstress error (stress units), multiplied out: no division when c = 0
        if (abs(res_lambda) < scale*(dt*c) .and. &
            sqrt(sum(res_stress%vals**2)) < max(scale, res_floor)) then
            converged = .true.
            state%stress = stress
            return
        end if
        converged = .false.

        ! Hessian and Newton correction (finite for c = 0: then ddgamma = -dgamma)
        if (.not. joint) ddf = yield_ddstress_eq(mat%yield, stress)
        elas_inv = .inv. elas_tan
        hess = .inv. (elas_inv + dgamma*ddf)

        ddgamma = -(res_lambda + dt*c*(df .ddot. hess .ddot. residual1)) &
                  /(1.0_${k}$ - dt*gp + dt*c*(df .ddot. hess .ddot. df))
        dstrain_p = (elas_inv .ddot. hess) .ddot. (residual1 + ddgamma*df)

        ! Backtracking line search on the residual norm, dgamma >= 0
        merit0 = res_lambda**2 + norm_res**2
        alpha = 1.0_${k}$
        do i = 1, MAX_BACKTRACK
            dgamma_new = max(dgamma + alpha*ddgamma, 0.0_${k}$)
            strain_p_new = strain_p + alpha*dstrain_p
            if (${MERIT}$(mat, elas, strain, dt, strain_p_new, state_n%strain_p, dgamma_new, state_n%strain_pf) &
                < merit0) exit
            alpha = 0.5_${k}$*alpha
        end do

        state%strain_p = strain_p_new
        state%strain_pf = state_n%strain_pf + dgamma_new
        state%stress = stress
    end subroutine ${ITER}$

    pure subroutine ${TANGENT}$(mat, elas, strain, dt, state_n, state_np1, tangent)
        !! Consistent algorithmic tangent of the overstress closest point return mapping of material
        !! `${MAT.name}$` at the state `state_np1`, `real(${k}$)`: with \( \mathbb{H} = [\mathbb{C}^{-1} +
        !! \Delta\lambda\,\partial^2 f/\partial\boldsymbol\sigma^2]^{-1} \), \( c = \partial g/\partial\sigma_{eq}
        !! \) and \( g_\epsilon = \partial g/\partial\epsilon_p \),
        !! \( \mathbb{C}^{ep} = \mathbb{H} - (\mathbb{H}:\mathbf{n})\otimes(\mathbf{n}:\mathbb{H})
        !! /[(1 - \Delta t\,g_\epsilon)/(\Delta t\,c) + \mathbf{n}:\mathbb{H}:\mathbf{n}] \); \( \mathbb{H} \) when
        !! \( c \le 0 \) and the elastic tangent when \( \Delta\lambda \le 10^{-12} \).
        use muscle_tensors, only : operator(+), operator(-), operator(*), operator(/), operator(.ddot.), &
            operator(.inv.), operator(.tdotsym.), assignment(=)
        use muscle_elasticity_laws, only : elas_dstress_dstrain
        use muscle_yield_criteria, only : yield_stress_eq, yield_dstress_eq, yield_ddstress_eq
        use muscle_vp_overstress_laws, only : os_dflow_dsigma, os_dflow_dep
#:if COMPOSED
        use muscle_hard_laws, only : hard_stress, hard_dstress_dep
#:endif
        implicit none
        @:DEVICE()
        type(${MAT_T}$), intent(in) :: mat
            !! Material.
        type(${ELAS_T}$), intent(in) :: elas
            !! Elasticity of the step (that of the material, or the frozen one of its viscoelastic model).
        type(${S2}$), intent(in) :: strain
            !! Total strain at \( t_{n+1} \).
        real(${k}$), intent(in) :: dt
            !! Time step.
        type(plastic_state_${k}$), intent(in) :: state_n
            !! Converged state at \( t_n \).
        type(plastic_state_${k}$), intent(in) :: state_np1
            !! State at \( t_{n+1} \).
        type(${T4}$), intent(out) :: tangent
            !! Consistent tangent.

        real(${k}$), parameter :: DGAMMA_MIN = 1.0e-12_${k}$
            ! Elastic step threshold of the plastic multiplier increment (historical value, both kinds)
        type(${S2}$) :: df
        type(${C4}$) :: elas_tan, hess, ddf
        real(${k}$) :: dgamma, strain_pf, stress_eq, c, gp, denom

        strain_pf = state_np1%strain_pf
        dgamma = strain_pf - state_n%strain_pf
        elas_tan = elas_dstress_dstrain(elas, strain - state_np1%strain_p)
        if (dgamma <= DGAMMA_MIN) then
            tangent = elas_tan
            return
        end if

        stress_eq = yield_stress_eq(mat%yield, state_np1%stress)
        c = os_dflow_dsigma(mat%os, stress_eq, strain_pf${HARD('dflow_dsigma', 'strain_pf')}$)
        gp = os_dflow_dep(mat%os, stress_eq, strain_pf${HARD('dflow_dep', 'strain_pf')}$)
        df = yield_dstress_eq(mat%yield, state_np1%stress)
        ddf = yield_ddstress_eq(mat%yield, state_np1%stress)
        hess = .inv. ((.inv. elas_tan) + dgamma*ddf)

        if (c <= 0.0_${k}$) then  ! No overstress sensitivity: no plastic correction
            tangent = hess
            return
        end if

        ! denom = (1 - dt gp)/(dt c) + n:H:n, gp = dg/dep
        denom = (1.0_${k}$ - dt*gp)/(dt*c) + (df .ddot. hess .ddot. df)
        tangent = hess - (.tdotsym. (df .ddot. hess))/denom
    end subroutine ${TANGENT}$
#:endif
