#:include "muscle_common.fypp"

module muscle_vp_jc
    !! Johnson-Cook viscoplastic law (strain rate term; no temperature term): the static yield
    !! stress \( \sigma_y(\epsilon_p) \) of a composed hardening law scaled by the rate factor
    !! \[ \sigma(\epsilon_p, \dot\epsilon_p) = \sigma_y(\epsilon_p) \left[ 1 + C \ln x \right], \quad
    !!    x = \frac{\max^*(\dot\epsilon_p, \dot\epsilon_{min})}{\dot\epsilon_{p0}} \]
    !! where \( \max^* \) takes \( \dot\epsilon_{min} \) when \( \dot\epsilon_p \le \dot\epsilon_{min} \)
    !! (then \( \partial\sigma/\partial\dot\epsilon_p = 0 \)). Partial derivatives:
    !! \[ \frac{\partial\sigma}{\partial\epsilon_p} = \frac{d\sigma_y}{d\epsilon_p} (1 + C \ln x), \quad
    !!    \frac{\partial\sigma}{\partial\dot\epsilon_p} = \sigma_y \frac{C}{x \dot\epsilon_{p0}} \]
    !!
    !! Composed law (D-017.6b): the free functions receive \( \sigma_y \) (`sy`) and
    !! \( d\sigma_y/d\epsilon_p \) (`dsy_dep`) already evaluated, e.g. with `hard_stress` and
    !! `hard_dstress_dep` of `muscle_hard_laws`; `ep` is part of the family contract but unused.
    !!
    !! Kernel API: parameter types `vp_jc_<k>` and `pure` functions `vp_flow_stress_jc_<k>(prm, ep,
    !! epd, sy)`, `vp_dflow_dep_jc_<k>(prm, ep, epd, sy, dsy_dep)`, `vp_dflow_depd_jc_<k>(prm, ep,
    !! epd, sy)` and `vp_dstress_dep_jc_<k>(prm, ep, epd, dt, sy, dsy_dep)` (derivative with respect
    !! to the plastic strain increment, \( \partial\sigma/\partial\epsilon_p +
    !! \partial\sigma/\partial\dot\epsilon_p/\Delta t \)) for each real kind, also through the
    !! generics `vp_*` of `muscle_vp_laws`. `vp_newton_dstress_dep_jc_<k>(prm, ep, epd, dt, sy, dsy_dep)`
    !! is `dstress_dep` with the right-hand rate derivative \( \sigma_y C/\dot\epsilon_{min} \) on the
    !! floor: only for the Newton direction of the rate-dependent return mapping (D-018.19b; with the 0
    !! of the floor its iterations started at a zero rate overshoot and stall at the clip of
    !! \( \Delta\lambda \ge 0 \)).
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    implicit none
    private

#:for k in REAL_KINDS
    public :: vp_jc_${k}$
    public :: vp_flow_stress_jc_${k}$, vp_dflow_dep_jc_${k}$, vp_dflow_depd_jc_${k}$, &
        & vp_dstress_dep_jc_${k}$, vp_newton_dstress_dep_jc_${k}$
#:endfor

#:for k in REAL_KINDS
    type :: vp_jc_${k}$
        !! Parameters of the Johnson-Cook model in `real(${k}$)`.
        real(${k}$) :: C
            !! Strain rate sensitivity \( C \).
        real(${k}$) :: epdmax
            !! Reference equivalent plastic strain rate \( \dot\epsilon_{p0} \).
        real(${k}$) :: epmin = 1.0e-7_${k}$
            !! Minimum strain rate \( \dot\epsilon_{min} \) (floor of the rate, avoids \( \ln 0 \)).
    end type vp_jc_${k}$
#:endfor

contains
#:for k in REAL_KINDS
    pure subroutine vp_jc_rate_${k}$(prm, epd, x, dx)
        !! Normalized rate \( x \) of the Johnson-Cook model in `real(${k}$)` and \( dx/d\dot\epsilon_p \)
        !! times \( \dot\epsilon_{p0} \) (1, or 0 on the floor \( \dot\epsilon_p \le \dot\epsilon_{min} \)).
        implicit none
        @:DEVICE()
        type(vp_jc_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: epd
            !! Equivalent plastic strain rate.
        real(${k}$), intent(out) :: x
            !! \( x \).
        real(${k}$), intent(out) :: dx
            !! \( \dot\epsilon_{p0} \, dx/d\dot\epsilon_p \).

        x = epd/prm%epdmax
        dx = 1.0_${k}$
        if (epd <= prm%epmin) then
            x = prm%epmin/prm%epdmax
            dx = 0.0_${k}$
        end if
    end subroutine vp_jc_rate_${k}$

    pure function vp_flow_stress_jc_${k}$(prm, ep, epd, sy) &
        & result(res)
        !! Viscoplastic flow stress \( \sigma(\epsilon_p, \dot\epsilon_p) \) of the Johnson-Cook model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(vp_jc_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$), intent(in) :: epd
            !! Equivalent plastic strain rate \( \dot\epsilon_p \).
        real(${k}$), intent(in) :: sy
            !! Static yield stress \( \sigma_y(\epsilon_p) \) of the composed hardening law (`hard_stress`).
        real(${k}$) :: res
            !! \( \sigma \).
        real(${k}$) :: x, dx
        call vp_jc_rate_${k}$(prm, epd, x, dx)
        res = sy*(1.0_${k}$ + prm%C*log(x))
    end function vp_flow_stress_jc_${k}$

    pure function vp_dflow_dep_jc_${k}$(prm, ep, epd, sy, dsy_dep) &
        & result(res)
        !! Partial derivative \( \partial\sigma/\partial\epsilon_p \) (at constant \( \dot\epsilon_p \)) of the Johnson-Cook
        !! model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(vp_jc_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$), intent(in) :: epd
            !! Equivalent plastic strain rate \( \dot\epsilon_p \).
        real(${k}$), intent(in) :: sy
            !! Static yield stress \( \sigma_y(\epsilon_p) \) of the composed hardening law (`hard_stress`).
        real(${k}$), intent(in) :: dsy_dep
            !! Hardening modulus \( d\sigma_y/d\epsilon_p \) of the composed hardening law (`hard_dstress_dep`).
        real(${k}$) :: res
            !! \( \partial\sigma/\partial\epsilon_p \).
        real(${k}$) :: x, dx
        call vp_jc_rate_${k}$(prm, epd, x, dx)
        res = dsy_dep*(1.0_${k}$ + prm%C*log(x))
    end function vp_dflow_dep_jc_${k}$

    pure function vp_dflow_depd_jc_${k}$(prm, ep, epd, sy) &
        & result(res)
        !! Partial derivative \( \partial\sigma/\partial\dot\epsilon_p \) (at constant \( \epsilon_p \)) of the Johnson-Cook
        !! model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(vp_jc_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$), intent(in) :: epd
            !! Equivalent plastic strain rate \( \dot\epsilon_p \).
        real(${k}$), intent(in) :: sy
            !! Static yield stress \( \sigma_y(\epsilon_p) \) of the composed hardening law (`hard_stress`).
        real(${k}$) :: res
            !! \( \partial\sigma/\partial\dot\epsilon_p \).
        real(${k}$) :: x, dx
        call vp_jc_rate_${k}$(prm, epd, x, dx)
        res = sy*(prm%C*dx/x/prm%epdmax)
    end function vp_dflow_depd_jc_${k}$

    pure function vp_dstress_dep_jc_${k}$(prm, ep, epd, dt, sy, dsy_dep) &
        & result(res)
        !! Derivative of the flow stress with respect to the plastic strain increment, \( \partial\sigma/\partial\epsilon_p
        !! + \partial\sigma/\partial\dot\epsilon_p/\Delta t \) of the Johnson-Cook model in `real(${k}$)`.
        !! dflow_dep + dflow_depd/dt, computed once (original operation order).
        implicit none
        @:DEVICE()
        type(vp_jc_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$), intent(in) :: epd
            !! Equivalent plastic strain rate \( \dot\epsilon_p \).
        real(${k}$), intent(in) :: dt
            !! Time step \( \Delta t \) (\( \dot\epsilon_p = \Delta\epsilon_p/\Delta t \)).
        real(${k}$), intent(in) :: sy
            !! Static yield stress \( \sigma_y(\epsilon_p) \) of the composed hardening law (`hard_stress`).
        real(${k}$), intent(in) :: dsy_dep
            !! Hardening modulus \( d\sigma_y/d\epsilon_p \) of the composed hardening law (`hard_dstress_dep`).
        real(${k}$) :: res
            !! \( d\sigma/d\Delta\epsilon_p \).
        real(${k}$) :: x, dx
        call vp_jc_rate_${k}$(prm, epd, x, dx)
        res = dsy_dep*(1.0_${k}$ + prm%C*log(x)) + sy*(prm%C*dx/x/prm%epdmax)/dt
    end function vp_dstress_dep_jc_${k}$

    pure function vp_newton_dstress_dep_jc_${k}$(prm, ep, epd, dt, sy, dsy_dep) &
        & result(res)
        !! Derivative `dstress_dep` for the Newton direction of a rate-dependent return mapping: on the rate floor of a law
        !! with one, the right-hand rate derivative at the floor instead of the 0 of the constant part, so that an iteration
        !! started at a zero rate sees the rate sensitivity (D-018.19b; elsewhere `dstress_dep`) of the Johnson-Cook model
        !! in `real(${k}$)`.
        !! dstress_dep with the right-hand rate derivative on the floor (D-018.19b).
        implicit none
        @:DEVICE()
        type(vp_jc_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$), intent(in) :: epd
            !! Equivalent plastic strain rate \( \dot\epsilon_p \).
        real(${k}$), intent(in) :: dt
            !! Time step \( \Delta t \) (\( \dot\epsilon_p = \Delta\epsilon_p/\Delta t \)).
        real(${k}$), intent(in) :: sy
            !! Static yield stress \( \sigma_y(\epsilon_p) \) of the composed hardening law (`hard_stress`).
        real(${k}$), intent(in) :: dsy_dep
            !! Hardening modulus \( d\sigma_y/d\epsilon_p \) of the composed hardening law (`hard_dstress_dep`).
        real(${k}$) :: res
            !! \( d\sigma/d\Delta\epsilon_p \) for the Newton direction.
        real(${k}$) :: x, dx
        call vp_jc_rate_${k}$(prm, epd, x, dx)
        res = dsy_dep*(1.0_${k}$ + prm%C*log(x)) + sy*(prm%C/x/prm%epdmax)/dt
    end function vp_newton_dstress_dep_jc_${k}$

#:endfor
end module muscle_vp_jc
