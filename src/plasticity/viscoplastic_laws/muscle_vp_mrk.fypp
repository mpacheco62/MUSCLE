#:include "muscle_models_common.fypp"
#! Model contract of the viscoplastic family (D-017.6): include/muscle_models_common.fypp
#:set PARAMS = model_param_list('vp', 'mrk')

module muscle_vp_mrk
    !! Modified Rusinek-Klepaczko (MRK) viscoplastic law (self-contained: it does not compose a
    !! hardening law), an extension of the RK model:
    !! \[ \sigma(\epsilon_p, \dot\epsilon_p) = \langle F \rangle^{1/\chi_2} \sigma_{0a} + \sigma_u, \quad
    !!    \sigma_{0a} = B_1 \epsilon_p + B_2 (1 - e^{-n \epsilon_p}) \]
    !! \[ L = \log_{10}(\dot\epsilon_{max}/\dot\epsilon_p), \quad B_i = B_{0i} L^{-\nu_i}, \quad
    !!    n = n_0 \langle 1 - D_2 \log_{10}(\dot\epsilon_p/\dot\epsilon_{min}) \rangle, \quad
    !!    F = 1 - \chi_1 L \]
    !! (\( \langle F \rangle^{1/\chi_2} \) is 0 for \( F \le 0 \)). The derivative with respect to the
    !! plastic strain increment is `dstress_dep` = `dflow_dep + dflow_depd/dt`, written with the
    !! structure of the original code (same results in every case: 0 for \( \dot\epsilon_p \le 10^{-12} \)
    !! without dividing by \( \Delta t \), also for \( \Delta t = 0 \)), with
    !! \( \partial\sigma/\partial\epsilon_p = F^{1/\chi_2} \partial\sigma_{0a}/\partial\epsilon_p \) and
    !! \( \partial\sigma/\partial\dot\epsilon_p = (dF^{1/\chi_2}/d\dot\epsilon_p) \sigma_{0a} +
    !! F^{1/\chi_2} \partial\sigma_{0a}/\partial\dot\epsilon_p \), evaluated with \( L \ge 10^{-10} \) and
    !! \( F \ge 10^{-10} \).
    !!
    !! Known issues, kept with the same results as the original code (D-017.7, not fixed in Phase 6):
    !!
    !! - `flow_stress` jumps at \( \dot\epsilon_p = 0^+ \): it is \( \sigma_u \) for
    !!   \( \dot\epsilon_p \le 0 \); it is Inf at \( \dot\epsilon_p = \dot\epsilon_{max} \) and NaN above.
    !! - The derivatives are 0 for \( \dot\epsilon_p \le 10^{-12} \), and finite where `flow_stress` is
    !!   NaN or Inf (the floors of \( L \) and \( F \)).
    !! - With \( F = 1 - \chi_1 L \le 0 \) the flow stress is \( \sigma_u \) (constant), but the derivatives
    !!   use \( F = 10^{-10} \): with \( \chi_2 > 1 \) they are large (\( \propto 10^{-10(1/\chi_2 - 1)} \))
    !!   where \( \sigma \) is constant.
    !!
    !! The original default-real literals (`0.0`, `1.0`) are exact, so writing them with the kind
    !! changes no result. In sp, \( 1 - e^{-n \epsilon_p} \) loses relative precision
    !! \( \sim \varepsilon/(n \epsilon_p) \) at small \( \epsilon_p \) (cancellation of the original
    !! formula, kept: e.g. \( 4 \cdot 10^{-5} \) in `dflow_depd` at \( \epsilon_p = 10^{-4} \)).
    !!
    !! Kernel API: parameter types `vp_mrk_<k>` and `pure` functions `vp_flow_stress_mrk_<k>(prm, ep,
    !! epd)`, `vp_dflow_dep_mrk_<k>`, `vp_dflow_depd_mrk_<k>(prm, ep, epd)` and
    !! `vp_dstress_dep_mrk_<k>(prm, ep, epd, dt)` for each real kind, also through the generics `vp_*`
    !! of `muscle_vp_laws`.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    implicit none
    private

    $:MODEL_PUBLIC('vp', 'mrk')
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('vp', 'mrk', k, PARAMS)
#:endfor

contains
#:for k in REAL_KINDS
    $:MODEL_FUNCTION('vp', 'mrk', 'flow_stress', k)
        real(${k}$) :: n_val, B1_val, B2_val
        real(${k}$) :: sig0_a, sig_a
        real(${k}$) :: factor_n, factor_rate, log_arg

        if (epd <= 0.0_${k}$) then
            res = prm%sig_u
            return
        end if

        factor_n = 1.0_${k}$ - prm%D2*log10(epd/prm%epdmin)
        if (factor_n > 0.0_${k}$) then
            n_val = prm%n0*factor_n
        else
            n_val = 0.0_${k}$
        end if

        log_arg = log10(prm%epdmax/epd)
        B1_val = prm%B01*log_arg**(-prm%nu1)
        B2_val = prm%B02*log_arg**(-prm%nu2)

        sig0_a = B1_val*ep + B2_val*(1.0_${k}$ - exp(-ep*n_val))

        factor_rate = 1.0_${k}$ - prm%chi1*log10(prm%epdmax/epd)
        if (factor_rate > 0.0_${k}$) then
            sig_a = factor_rate**(1.0_${k}$/prm%chi2)*sig0_a
        else
            sig_a = 0.0_${k}$
        end if

        res = sig_a + prm%sig_u
    end function vp_flow_stress_mrk_${k}$

    pure subroutine vp_mrk_dparts_${k}$(prm, ep, epd, dep, depd)
        !! Partial derivatives of the MRK model in `real(${k}$)` (original formulas and operation
        !! order, with the floors of the module documentation; 0 for \( \dot\epsilon_p \le 10^{-12} \)).
        implicit none
        @:DEVICE()
        type(vp_mrk_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain.
        real(${k}$), intent(in) :: epd
            !! Equivalent plastic strain rate.
        real(${k}$), intent(out) :: dep
            !! \( \partial\sigma/\partial\epsilon_p \).
        real(${k}$), intent(out) :: depd
            !! \( \partial\sigma/\partial\dot\epsilon_p \).
        real(${k}$) :: n_val, B1_val, B2_val, sig0_a, factor_rate
        real(${k}$) :: dsig0_dep, dsig0_depd, dfactor_depd, dn_depd, dB1_depd, dB2_depd
        real(${k}$) :: log_arg, inv_ln10, epd_eff

        if (epd <= 1.0e-12_${k}$) then
            dep = 0.0_${k}$
            depd = 0.0_${k}$
            return
        end if

        epd_eff = epd
        inv_ln10 = 1.0_${k}$/log(10.0_${k}$)
        log_arg = max(1.0e-10_${k}$, log10(prm%epdmax/epd_eff))

        n_val = prm%n0*max(0.0_${k}$, 1.0_${k}$ - prm%D2*log10(epd_eff/prm%epdmin))
        B1_val = prm%B01*log_arg**(-prm%nu1)
        B2_val = prm%B02*log_arg**(-prm%nu2)
        sig0_a = B1_val*ep + B2_val*(1.0_${k}$ - exp(-ep*n_val))
        factor_rate = max(1.0e-10_${k}$, 1.0_${k}$ - prm%chi1*log_arg)

        dsig0_dep = B1_val + B2_val*n_val*exp(-ep*n_val)

        dn_depd = -prm%n0*prm%D2*inv_ln10/epd_eff
        dB1_depd = prm%nu1*B1_val/(log_arg*epd_eff*log(10.0_${k}$))
        dB2_depd = prm%nu2*B2_val/(log_arg*epd_eff*log(10.0_${k}$))

        dsig0_depd = dB1_depd*ep + dB2_depd*(1.0_${k}$ - exp(-ep*n_val)) &
                     + B2_val*(ep*exp(-ep*n_val)*dn_depd)

        dfactor_depd = (1.0_${k}$/prm%chi2)*(factor_rate**(1.0_${k}$/prm%chi2 - 1.0_${k}$)) &
                       *(prm%chi1*inv_ln10/epd_eff)

        dep = (factor_rate**(1.0_${k}$/prm%chi2))*dsig0_dep
        depd = (dfactor_depd*sig0_a) + (factor_rate**(1.0_${k}$/prm%chi2))*dsig0_depd
    end subroutine vp_mrk_dparts_${k}$

    $:MODEL_FUNCTION('vp', 'mrk', 'dflow_dep', k)
        real(${k}$) :: depd
        call vp_mrk_dparts_${k}$(prm, ep, epd, res, depd)
    end function vp_dflow_dep_mrk_${k}$

    $:MODEL_FUNCTION('vp', 'mrk', 'dflow_depd', k)
        real(${k}$) :: dep
        call vp_mrk_dparts_${k}$(prm, ep, epd, dep, res)
    end function vp_dflow_depd_mrk_${k}$

    $:MODEL_FUNCTION('vp', 'mrk', 'dstress_dep', k, doc='dflow_dep + dflow_depd/dt, and 0 for epd <= 1e-12 without dividing by dt (as the original code, also for dt = 0).')
        real(${k}$) :: dep, depd

        if (epd <= 1.0e-12_${k}$) then
            res = 0.0_${k}$
            return
        end if
        call vp_mrk_dparts_${k}$(prm, ep, epd, dep, depd)
        res = dep + depd/dt
    end function vp_dstress_dep_mrk_${k}$
#:endfor

end module muscle_vp_mrk
