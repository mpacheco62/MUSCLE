#:include "muscle_models_common.fypp"
#! Model contract of the overstress family (D-017.6): include/muscle_models_common.fypp
#:set PARAMS = model_param_list('os', 'perzyna')

module muscle_vp_perzyna
    !! Perzyna overstress law:
    !! \[ g(\sigma_{eq}, \epsilon_p) = \frac{1}{\eta} \langle \psi \rangle^N, \quad
    !!    \psi = \frac{\sigma_{eq}}{\sigma_y(\epsilon_p)} - 1 \]
    !! with the static yield stress \( \sigma_y \) of a composed hardening law, viscosity
    !! \( \eta \) and rate sensitivity exponent \( N \). Derivatives (0 for \( \psi \le 0 \)):
    !! \[ \frac{\partial g}{\partial\sigma_{eq}} = \frac{g_\psi}{\sigma_y}, \quad
    !!    \frac{\partial g}{\partial\epsilon_p} = -g_\psi \frac{\sigma_{eq}}{\sigma_y^2}
    !!    \frac{d\sigma_y}{d\epsilon_p}, \quad g_\psi = \frac{N}{\eta} \psi^{N-1} \]
    !!
    !! Composed law (D-017.6b): the free functions receive \( \sigma_y \) (`sy`) and
    !! \( d\sigma_y/d\epsilon_p \) (`dsy_dep`) already evaluated, e.g. with `hard_stress` and
    !! `hard_dstress_dep` of `muscle_hard_laws`; `ep` is part of the family contract but unused.
    !! Known issue (D-017.7, kept): division by zero if \( \sigma_y = 0 \).
    !!
    !! Kernel API: parameter types `os_perzyna_<k>` and `pure` functions
    !! `os_flow_rate_perzyna_<k>(prm, sigma_eq, ep, sy)`, `os_dflow_dsigma_perzyna_<k>(prm, sigma_eq,
    !! ep, sy)` and `os_dflow_dep_perzyna_<k>(prm, sigma_eq, ep, sy, dsy_dep)` for each real kind,
    !! also through the generics `os_*` of `muscle_vp_overstress_laws`.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    implicit none
    private

    $:MODEL_PUBLIC('os', 'perzyna')
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('os', 'perzyna', k, PARAMS)
#:endfor

contains
#:for k in REAL_KINDS
    pure function os_perzyna_dpsi_${k}$(prm, psi) result(res)
        !! Derivative \( g_\psi \) of the Perzyna law in `real(${k}$)` (0 for \( \psi \le 0 \)).
        implicit none
        @:DEVICE()
        type(os_perzyna_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: psi
            !! Overstress \( \psi \).
        real(${k}$) :: res
            !! \( g_\psi \).

        if (psi <= 0.0_${k}$) then
            res = 0.0_${k}$
        else
            res = prm%n*psi**(prm%n - 1.0_${k}$)/prm%eta
        end if
    end function os_perzyna_dpsi_${k}$

    $:MODEL_FUNCTION('os', 'perzyna', 'flow_rate', k)
        real(${k}$) :: psi

        psi = sigma_eq/sy - 1.0_${k}$
        if (psi <= 0.0_${k}$) then
            res = 0.0_${k}$
        else
            res = psi**prm%n/prm%eta
        end if
    end function os_flow_rate_perzyna_${k}$

    $:MODEL_FUNCTION('os', 'perzyna', 'dflow_dsigma', k)
        res = os_perzyna_dpsi_${k}$(prm, sigma_eq/sy - 1.0_${k}$)/sy
    end function os_dflow_dsigma_perzyna_${k}$

    $:MODEL_FUNCTION('os', 'perzyna', 'dflow_dep', k)
        res = -os_perzyna_dpsi_${k}$(prm, sigma_eq/sy - 1.0_${k}$)*sigma_eq*dsy_dep/sy**2
    end function os_dflow_dep_perzyna_${k}$
#:endfor

end module muscle_vp_perzyna
