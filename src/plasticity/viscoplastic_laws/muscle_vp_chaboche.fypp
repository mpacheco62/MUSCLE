#:include "muscle_common.fypp"
#! Note: the parameter `k` (historical keyword, `prm%k`) is unrelated to the fypp kind variable `${k}$`
#! of the `#:for k in REAL_KINDS` loops: write the kind always as `${k}$` and the parameter as `prm%k`.

module muscle_vp_chaboche
    !! Additive power overstress law, Chaboche (2008), Eq. (15), p. 1646:
    !! \[ g(\sigma_{eq}, \epsilon_p) = \langle z \rangle^n, \quad
    !!    z = \frac{\sigma_{eq} - \sigma_y(\epsilon_p)}{K} \]
    !! with the static yield stress \( \sigma_y \) of a composed hardening law; \( K \) is independent
    !! of \( \sigma_y \). Derivatives (chain rule):
    !! \[ \frac{\partial g}{\partial\sigma_{eq}} = \frac{g_z}{K}, \quad
    !!    \frac{\partial g}{\partial\epsilon_p} = -\frac{g_z}{K} \frac{d\sigma_y}{d\epsilon_p}, \quad
    !!    g_z = n z^{n-1} \]
    !! \( g \) and its derivatives are 0 for \( \sigma_{eq} \le \sigma_y \) by convention; the
    !! right-hand derivative at the threshold is not 0 for \( n \le 1 \).
    !!
    !! Composed law (D-017.6b): the free functions receive \( \sigma_y \) (`sy`) and
    !! \( d\sigma_y/d\epsilon_p \) (`dsy_dep`) already evaluated, e.g. with `hard_stress` and
    !! `hard_dstress_dep` of `muscle_hard_laws`; `ep` is part of the family contract but unused.
    !!
    !! Kernel API: parameter types `os_chaboche_<k>` and `pure` functions
    !! `os_flow_rate_chaboche_<k>(prm, sigma_eq, ep, sy)`, `os_dflow_dsigma_chaboche_<k>(prm,
    !! sigma_eq, ep, sy)` and `os_dflow_dep_chaboche_<k>(prm, sigma_eq, ep, sy, dsy_dep)` for each real
    !! kind, also through the generics `os_*` of `muscle_vp_overstress_laws`.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    implicit none
    private

#:for k in REAL_KINDS
    public :: os_chaboche_${k}$
    public :: os_flow_rate_chaboche_${k}$, os_dflow_dsigma_chaboche_${k}$, os_dflow_dep_chaboche_${k}$
#:endfor

#:for k in REAL_KINDS
    type :: os_chaboche_${k}$
        !! Parameters of the Chaboche model in `real(${k}$)`.
        real(${k}$) :: k = 1.0_${k}$
            !! Viscous resistance \( K \) (stress time\(^{1/n}\)).
        real(${k}$) :: n = 1.0_${k}$
            !! Positive rate exponent \( n \).
    end type os_chaboche_${k}$
#:endfor

contains
#:for k in REAL_KINDS
    pure function os_chaboche_dz_${k}$(prm, z) result(res)
        !! Slope \( g_z \) of the Chaboche law in `real(${k}$)` (0 for \( z \le 0 \)).
        implicit none
        @:DEVICE()
        type(os_chaboche_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: z
            !! Normalized overstress \( z \).
        real(${k}$) :: res
            !! \( g_z \).

        if (z <= 0.0_${k}$) then
            res = 0.0_${k}$
        else
            res = prm%n*z**(prm%n - 1.0_${k}$)
        end if
    end function os_chaboche_dz_${k}$

    pure function os_flow_rate_chaboche_${k}$(prm, sigma_eq, ep, sy) &
        & result(res)
        !! Plastic multiplier rate \( g(\sigma_{eq}, \epsilon_p) \) of the Chaboche model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(os_chaboche_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: sigma_eq
            !! Equivalent stress \( \sigma_{eq} \).
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$), intent(in) :: sy
            !! Static yield stress \( \sigma_y(\epsilon_p) \) of the composed hardening law (`hard_stress`).
        real(${k}$) :: res
            !! \( g \).
        real(${k}$) :: z

        z = (sigma_eq - sy)/prm%k
        if (z <= 0.0_${k}$) then
            res = 0.0_${k}$
        else
            res = z**prm%n
        end if
    end function os_flow_rate_chaboche_${k}$

    pure function os_dflow_dsigma_chaboche_${k}$(prm, sigma_eq, ep, sy) &
        & result(res)
        !! Derivative \( \partial g/\partial\sigma_{eq} \) of the Chaboche model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(os_chaboche_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: sigma_eq
            !! Equivalent stress \( \sigma_{eq} \).
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$), intent(in) :: sy
            !! Static yield stress \( \sigma_y(\epsilon_p) \) of the composed hardening law (`hard_stress`).
        real(${k}$) :: res
            !! \( \partial g/\partial\sigma_{eq} \).
        res = os_chaboche_dz_${k}$(prm, (sigma_eq - sy)/prm%k)/prm%k
    end function os_dflow_dsigma_chaboche_${k}$

    pure function os_dflow_dep_chaboche_${k}$(prm, sigma_eq, ep, sy, dsy_dep) &
        & result(res)
        !! Derivative \( \partial g/\partial\epsilon_p \) of the Chaboche model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(os_chaboche_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: sigma_eq
            !! Equivalent stress \( \sigma_{eq} \).
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$), intent(in) :: sy
            !! Static yield stress \( \sigma_y(\epsilon_p) \) of the composed hardening law (`hard_stress`).
        real(${k}$), intent(in) :: dsy_dep
            !! Hardening modulus \( d\sigma_y/d\epsilon_p \) of the composed hardening law (`hard_dstress_dep`).
        real(${k}$) :: res
            !! \( \partial g/\partial\epsilon_p \).
        res = -os_chaboche_dz_${k}$(prm, (sigma_eq - sy)/prm%k)*dsy_dep/prm%k
    end function os_dflow_dep_chaboche_${k}$

#:endfor
end module muscle_vp_chaboche
