#:include "muscle_common.fypp"

module muscle_hard_ludwik
    !! Ludwik isotropic hardening law:
    !! \[ \sigma_y(\epsilon_p) = \sigma_0 + K \epsilon_p^n \]
    !! with initial yield stress \( \sigma_0 \), strength coefficient \( K \) and hardening
    !! exponent \( n \).
    !!
    !! The derivatives are evaluated at \( \epsilon_p + \delta \), not at \( \epsilon_p \)
    !! (regularization at \( \epsilon_p = 0 \), where they are singular for \( n < 1 \), D-017.4a):
    !! \[ \frac{d\sigma_y}{d\epsilon_p} \approx K n (\epsilon_p + \delta)^{n-1}, \quad
    !!    \frac{d^2\sigma_y}{d\epsilon_p^2} \approx K n (n-1) (\epsilon_p + \delta)^{n-2} \]
    !! so they are not the exact derivatives of the flow stress. The offset
    !! \( \delta \) = `LUDWIK_EP_OFFSET_<k>` = \( 10^{-10} \) is the historical value (same results
    !! as the original code in dp) and the same regularization in every kind: the derivatives are
    !! finite at \( \epsilon_p = 0 \) and differ from the exact ones by a relative
    !! \( \approx (1-n) \delta/\epsilon_p \) (resp. \( (2-n) \delta/\epsilon_p \)), e.g. \( 10^{-6} \) at
    !! \( \epsilon_p = 10^{-4} \). In sp the offset vanishes by rounding,
    !! \( \epsilon_p + \delta = \epsilon_p \), from \( \epsilon_p \approx 1.7 \cdot 10^{-3} \).
    !!
    !! Kernel API: parameter types `hard_ludwik_<k>` and `pure` functions
    !! `hard_stress_ludwik_<k>(prm, ep)`, `hard_dstress_dep_ludwik_<k>(prm, ep)` and
    !! `hard_ddstress_ddep_ludwik_<k>(prm, ep)` for each real kind, also through the generics
    !! `hard_stress`, `hard_dstress_dep` and `hard_ddstress_ddep` of `muscle_hard_laws`.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    implicit none
    private

#:for k in REAL_KINDS
    public :: hard_ludwik_${k}$
    public :: hard_stress_ludwik_${k}$, hard_dstress_dep_ludwik_${k}$, hard_ddstress_ddep_ludwik_${k}$
    public :: LUDWIK_EP_OFFSET_${k}$
#:endfor

#:for k in REAL_KINDS
    real(${k}$), parameter :: LUDWIK_EP_OFFSET_${k}$ = 1.0e-10_${k}$
        !! Offset \( \delta \) added to \( \epsilon_p \) in the derivatives in `real(${k}$)`: regularization
        !! at \( \epsilon_p = 0 \), same value in every kind (see the module documentation).

    type :: hard_ludwik_${k}$
        !! Parameters of the Ludwik model in `real(${k}$)`.
        real(${k}$) :: sigma0
            !! Initial yield stress \( \sigma_0 \).
        real(${k}$) :: k
            !! Strength coefficient \( K \).
        real(${k}$) :: n
            !! Hardening exponent \( n \).
    end type hard_ludwik_${k}$

#:endfor
contains
#:for k in REAL_KINDS
    pure function hard_stress_ludwik_${k}$(prm, ep) result(res)
        !! Flow stress \( \sigma_y(\epsilon_p) \) of the Ludwik model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(hard_ludwik_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( \sigma_y \).
        res = prm%sigma0 + prm%k*(ep)**prm%n
    end function hard_stress_ludwik_${k}$

    pure function hard_dstress_dep_ludwik_${k}$(prm, ep) result(res)
        !! Hardening modulus \( d\sigma_y/d\epsilon_p \) of the Ludwik model in `real(${k}$)`.
        !! Evaluated at ep + LUDWIK_EP_OFFSET_${k}$.
        implicit none
        @:DEVICE()
        type(hard_ludwik_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( d\sigma_y/d\epsilon_p \).
        res = prm%k*prm%n*(ep + LUDWIK_EP_OFFSET_${k}$)**(prm%n - 1.0_${k}$)
    end function hard_dstress_dep_ludwik_${k}$

    pure function hard_ddstress_ddep_ludwik_${k}$(prm, ep) result(res)
        !! Second derivative \( d^2\sigma_y/d\epsilon_p^2 \) of the Ludwik model in `real(${k}$)`.
        !! Evaluated at ep + LUDWIK_EP_OFFSET_${k}$.
        implicit none
        @:DEVICE()
        type(hard_ludwik_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( d^2\sigma_y/d\epsilon_p^2 \).
        res = prm%k*prm%n*(prm%n - 1.0_${k}$)*(ep + LUDWIK_EP_OFFSET_${k}$)**(prm%n - 2.0_${k}$)
    end function hard_ddstress_ddep_ludwik_${k}$

#:endfor
end module muscle_hard_ludwik
