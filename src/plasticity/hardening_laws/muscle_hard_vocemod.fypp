#:include "muscle_models_common.fypp"
#! Model contract of the hardening family (D-017.6): include/muscle_models_common.fypp
#:set PARAMS = [('Sy', 'real', '', r'Initial yield stress \( \sigma_{y0} \).', None), &
    &          ('k', 'real', '', r'Linear hardening modulus \( k \) (asymptotic slope).', None), &
    &          ('q', 'real', '', r'Saturation stress range \( q \) of the exponential term.', None), &
    &          ('n', 'real', '', r'Saturation rate \( n \).', None)]

module muscle_hard_vocemod
    !! Modified Voce isotropic hardening law (Voce saturation plus a linear term):
    !! \[ \sigma_y(\epsilon_p) = \sigma_{y0} + k \epsilon_p + q \left( 1 - e^{-n \epsilon_p} \right), \quad
    !!    \frac{d\sigma_y}{d\epsilon_p} = k + q n e^{-n \epsilon_p}, \quad
    !!    \frac{d^2\sigma_y}{d\epsilon_p^2} = -q n^2 e^{-n \epsilon_p} \]
    !! with initial yield stress \( \sigma_{y0} \) (component `Sy`), linear hardening modulus
    !! \( k \), saturation stress range \( q \) and saturation rate \( n \). It models materials whose
    !! hardening rate first decreases quickly and then tends to the constant slope \( k \)
    !! (classic Voce law with \( k = 0 \)).
    !!
    !! Kernel API: parameter types `hard_vocemod_<k>` and `pure` functions
    !! `hard_stress_vocemod_<k>(prm, ep)`, `hard_dstress_dep_vocemod_<k>(prm, ep)` and
    !! `hard_ddstress_ddep_vocemod_<k>(prm, ep)` for each real kind, also through the generics
    !! `hard_stress`, `hard_dstress_dep` and `hard_ddstress_ddep` of `muscle_hard_laws`.
    !! `Voce_modified_hardening` is the historical OO type (host only, removed in Phase 7).
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_hard_base, only : Base_hardening_laws
    implicit none
    private

    $:MODEL_PUBLIC('hard', 'vocemod')
    public :: Voce_modified_hardening
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('hard', 'vocemod', k, PARAMS)
#:endfor
    $:OO_ADAPTER_TYPE('hard', 'vocemod', 'Voce_modified_hardening', 'Base_hardening_laws', PARAMS)

contains
#:for k in REAL_KINDS
    $:MODEL_FUNCTION('hard', 'vocemod', 'stress', k)
        res = prm%Sy + prm%k*ep + prm%q*(1.0_${k}$ - exp(-prm%n*ep))
    end function hard_stress_vocemod_${k}$

    $:MODEL_FUNCTION('hard', 'vocemod', 'dstress_dep', k)
        res = prm%k + prm%q*prm%n*exp(-prm%n*ep)
    end function hard_dstress_dep_vocemod_${k}$

    $:MODEL_FUNCTION('hard', 'vocemod', 'ddstress_ddep', k)
        res = -prm%q*prm%n*prm%n*exp(-prm%n*ep)
    end function hard_ddstress_ddep_vocemod_${k}$
#:endfor
    $:OO_ADAPTER_PROCS('hard', 'vocemod', 'Voce_modified_hardening', PARAMS)

end module muscle_hard_vocemod
