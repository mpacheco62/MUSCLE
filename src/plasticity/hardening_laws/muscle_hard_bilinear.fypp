#:include "muscle_models_common.fypp"
#! Model contract of the hardening family (D-017.6): include/muscle_models_common.fypp
#:set PARAMS = [('y0', 'real', '', r'Initial yield stress \( \sigma_{y0} \).', None), &
    &          ('K', 'real', '', r'Hardening modulus \( K \).', None)]

module muscle_hard_bilinear
    !! Bilinear (linear isotropic) hardening law:
    !! \[ \sigma_y(\epsilon_p) = \sigma_{y0} + K \epsilon_p, \quad
    !!    \frac{d\sigma_y}{d\epsilon_p} = K, \quad \frac{d^2\sigma_y}{d\epsilon_p^2} = 0 \]
    !! (perfect plasticity with \( K = 0 \), softening with \( K < 0 \)).
    !!
    !! Kernel API: parameter types `hard_bilinear_<k>` and `pure` functions
    !! `hard_stress_bilinear_<k>(prm, ep)`, `hard_dstress_dep_bilinear_<k>(prm, ep)` and
    !! `hard_ddstress_ddep_bilinear_<k>(prm, ep)` for each real kind, also through the generics
    !! `hard_stress`, `hard_dstress_dep` and `hard_ddstress_ddep` of `muscle_hard_laws`.
    !! `Bilinear_hardening` is the historical OO type (host only, removed in Phase 7).
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_hard_base, only : Base_hardening_laws
    implicit none
    private

    $:MODEL_PUBLIC('hard', 'bilinear')
    public :: Bilinear_hardening
#:for k in REAL_KINDS
    $:MODEL_PARAMS_TYPE('hard', 'bilinear', k, PARAMS)
#:endfor
    $:OO_ADAPTER_TYPE('hard', 'bilinear', 'Bilinear_hardening', 'Base_hardening_laws', PARAMS)

contains
#:for k in REAL_KINDS
    $:MODEL_FUNCTION('hard', 'bilinear', 'stress', k)
        res = prm%y0 + prm%K*ep
    end function hard_stress_bilinear_${k}$

    $:MODEL_FUNCTION('hard', 'bilinear', 'dstress_dep', k)
        res = prm%K
    end function hard_dstress_dep_bilinear_${k}$

    $:MODEL_FUNCTION('hard', 'bilinear', 'ddstress_ddep', k)
        res = 0.0_${k}$
    end function hard_ddstress_ddep_bilinear_${k}$
#:endfor
    $:OO_ADAPTER_PROCS('hard', 'bilinear', 'Bilinear_hardening', PARAMS)

end module muscle_hard_bilinear
