#:include "muscle_common.fypp"

module muscle_yield_cpb06ex2
    !! CPB06ex2 criterion, with two transformations of the stress deviator (Plunkett et al., 2008,
    !! Eq. 8):
    !! \[ \sigma_{eq} = B \left( \sum_i (|\Sigma_i| - k \Sigma_i)^a
    !!    + \sum_i (|\Sigma^\prime_i| - k^\prime \Sigma^\prime_i)^a \right)^{1/a}, \quad
    !!    \boldsymbol\Sigma = \mathbf{L} : \boldsymbol\sigma, \quad
    !!    \boldsymbol\Sigma^\prime = \mathbf{L}^\prime : \boldsymbol\sigma \]
    !! with \( \Sigma_i \), \( \Sigma^\prime_i \) the principal values (`eigenvals`). Library
    !! (c44, c55, c66) on (xy, yz, xz) = paper (C66, C44, C55): xy from Eq. (13), yz and xz from the
    !! out-of-plane values of Tables 9 and 11. The analytical derivatives go through the spectral
    !! decompositions of both transformed tensors; the mixed principal block of the Hessian is
    !! \( (1-a)/\sigma_{eq} \) times the outer product of the two gradients.
    !!
    !! Scaling (D-017.10c): the powers are evaluated on the six principal values divided by the power
    !! of two of their largest magnitude (exact in floating point), using the homogeneity of degree 1
    !! of \( \sigma_{eq} \), 0 of its gradient and -1 of its Hessian, so that no power under- or
    !! overflows (in sp the sum was subnormal or zero for small stresses with a large a).
    !!
    !! At a null equivalent stress (zero or hydrostatic stress) both derivatives are 0 (D-017.9; the
    !! original code gave NaN). Known limits, kept with the same results as the original code:
    !! `eigenvals` uses an absolute threshold (1e-10 in dp) that discards small shears on a
    !! hydrostatic stress; with \( k = \pm 1 \) and a null principal value the Hessian takes the
    !! value chosen in `yield_cpb_curvature_<k>` of `muscle_yield_anisotropic` (for
    !! \( 1 \le a < 2 \) the second derivative is not bounded there).
    !!
    !! Kernel API: parameter types `yield_cpb06ex2_<k>` (built only with `yield_cpb06ex2_init`, which
    !! computes the private components L, Lp and B), and `pure` functions
    !! `yield_stress_eq_cpb06ex2_3D_<k>(prm, sigma)`, `yield_dstress_eq_cpb06ex2_3D_<k>(prm, sigma)`,
    !! `yield_ddstress_eq_cpb06ex2_3D_<k>(prm, sigma)` and the joint evaluation
    !! `yield_stress_eq_and_derivatives_cpb06ex2_3D_<k>(prm, sigma, f, df[, ddf])` (the three in turn)
    !! for each real kind, also through the generics `yield_*` of `muscle_yield_laws`.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_status, only : STATUS_OK
    #:for k in REAL_KINDS
    use muscle_tensors, only : ten_3D2Osym_${k}$, ten_3D4O3sym_${k}$
    #:endfor
    use muscle_tensors, only : operator(.tdotsym.), operator(*), operator(+), assignment(=)
    use muscle_math_eigen, only : eigenvals, spectral_decomposition
    use muscle_math_spectral_derivs, only : spectral_gradient, spectral_hessian
    use muscle_math_fp, only : fp_exponent
    use muscle_yield_anisotropic, only : yield_lin_dev_block, yield_lin_apply, yield_lin_pull_back, &
        & yield_lin_pull_back_hessian, yield_cpb_terms, yield_cpb_hessian
    implicit none
    private

    #:for k in REAL_KINDS
    public :: yield_cpb06ex2_${k}$
    public :: yield_stress_eq_cpb06ex2_3D_${k}$, yield_dstress_eq_cpb06ex2_3D_${k}$, yield_ddstress_eq_cpb06ex2_3D_${k}$
    public :: yield_stress_eq_and_derivatives_cpb06ex2_3D_${k}$, yield_joint_evaluation_cpb06ex2_${k}$
    public :: yield_cpb06ex2_init_${k}$
    #:endfor
    public :: yield_cpb06ex2_init

    #:for k in REAL_KINDS
    type :: yield_cpb06ex2_${k}$
        !! Parameters of the CPB06ex2 (Plunkett-Cazacu-Barlat 2008) model in `real(${k}$)` (build it with `yield_cpb06ex2_init`,
        !! which computes the private derived components; do not change the inputs after `yield_cpb06ex2_init`).
        real(${k}$), private :: L(3,3)
            !! Normal block of \( \mathbf{L} = \mathbf{C} \mathbb{P}_{dev} \), which maps the normal stresses to those of
            !! \( \boldsymbol\Sigma \) (Plunkett et al., 2008, Eq. 9).
        real(${k}$), private :: Lp(3,3)
            !! Normal block of \( \mathbf{L}^\prime = \mathbf{C}^\prime \mathbb{P}_{dev} \), for \( \boldsymbol\Sigma^\prime \) (Eq.
            !! 9; suffix p = primed in the paper).
        real(${k}$) :: c_shear(3)
            !! Shear factors of \( \mathbf{C} \) on the tensorial shears (xy, yz, xz).
        real(${k}$) :: cp_shear(3)
            !! Shear factors of \( \mathbf{C}^\prime \) on the tensorial shears (xy, yz, xz).
        real(${k}$) :: k
            !! Strength differential parameter \( k \) of \( \boldsymbol\Sigma \) (Eq. 8).
        real(${k}$) :: kp
            !! Strength differential parameter \( k^\prime \) of \( \boldsymbol\Sigma^\prime \) (Eq. 8).
        real(${k}$) :: a
            !! Degree of homogeneity \( a \) (Eq. 8).
        real(${k}$), private :: B
            !! Normalization: \( \sigma_{eq} = s \) in uniaxial tension \( s \) along RD (Eq. 11 with \( \theta = 0 \)).
    end type yield_cpb06ex2_${k}$
    #:endfor

    interface yield_cpb06ex2_init
        !! Parameters of the CPB06ex2 model from the components of C and Cp, k, kp and a (computes L,
        !! Lp and B).
        #:for k in REAL_KINDS
        module procedure yield_cpb06ex2_init_${k}$
        #:endfor
    end interface yield_cpb06ex2_init

contains
    #:for k in REAL_KINDS

    pure subroutine yield_cpb06ex2_init_${k}$(prm, c11, c12, c13, c21, c22, c23, c31, c32, c33, c44, c55, c66, k, cp11, &
            & cp12, cp13, cp21, cp22, cp23, cp31, cp32, cp33, cp44, cp55, cp66, kp, a, status)
        !! Parameters of the CPB06ex2 model in `real(${k}$)`: the maps of Plunkett et al. (2008),
        !! Eqs. (9)-(10), and the normalization B of Eq. (8) to unit uniaxial tension in RD, as in
        !! Eq. (11), so that they are not computed in every call.
        implicit none
        @:DEVICE()
        type(yield_cpb06ex2_${k}$), intent(out) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: c11
            !! Coefficient \( C_{11} \).
        real(${k}$), intent(in) :: c12
            !! Coefficient \( C_{12} \).
        real(${k}$), intent(in) :: c13
            !! Coefficient \( C_{13} \).
        real(${k}$), intent(in) :: c21
            !! Coefficient \( C_{21} \).
        real(${k}$), intent(in) :: c22
            !! Coefficient \( C_{22} \).
        real(${k}$), intent(in) :: c23
            !! Coefficient \( C_{23} \).
        real(${k}$), intent(in) :: c31
            !! Coefficient \( C_{31} \).
        real(${k}$), intent(in) :: c32
            !! Coefficient \( C_{32} \).
        real(${k}$), intent(in) :: c33
            !! Coefficient \( C_{33} \).
        real(${k}$), intent(in) :: c44
            !! Coefficient \( C_{44} \) (shear xy).
        real(${k}$), intent(in) :: c55
            !! Coefficient \( C_{55} \) (shear yz).
        real(${k}$), intent(in) :: c66
            !! Coefficient \( C_{66} \) (shear xz).
        real(${k}$), intent(in) :: k
            !! Strength differential parameter of Sigma.
        real(${k}$), intent(in) :: cp11
            !! Coefficient \( C^\prime_{11} \).
        real(${k}$), intent(in) :: cp12
            !! Coefficient \( C^\prime_{12} \).
        real(${k}$), intent(in) :: cp13
            !! Coefficient \( C^\prime_{13} \).
        real(${k}$), intent(in) :: cp21
            !! Coefficient \( C^\prime_{21} \).
        real(${k}$), intent(in) :: cp22
            !! Coefficient \( C^\prime_{22} \).
        real(${k}$), intent(in) :: cp23
            !! Coefficient \( C^\prime_{23} \).
        real(${k}$), intent(in) :: cp31
            !! Coefficient \( C^\prime_{31} \).
        real(${k}$), intent(in) :: cp32
            !! Coefficient \( C^\prime_{32} \).
        real(${k}$), intent(in) :: cp33
            !! Coefficient \( C^\prime_{33} \).
        real(${k}$), intent(in) :: cp44
            !! Coefficient \( C^\prime_{44} \) (shear xy).
        real(${k}$), intent(in) :: cp55
            !! Coefficient \( C^\prime_{55} \) (shear yz).
        real(${k}$), intent(in) :: cp66
            !! Coefficient \( C^\prime_{66} \) (shear xz).
        real(${k}$), intent(in) :: kp
            !! Strength differential parameter of Sigmap.
        real(${k}$), intent(in) :: a
            !! Degree of homogeneity.
        integer, intent(out) :: status
            !! Always `STATUS_OK` (no input is validated): the argument exists so that every model
            !! initializer is called the same way.
        type(ten_3D2Osym_${k}$) :: rd
        real(${k}$) :: blk(3, 3)

        blk(:, 1) = [c11, c21, c31]
        blk(:, 2) = [c12, c22, c32]
        blk(:, 3) = [c13, c23, c33]
        prm%L = yield_lin_dev_block(blk)
        blk(:, 1) = [cp11, cp21, cp31]
        blk(:, 2) = [cp12, cp22, cp32]
        blk(:, 3) = [cp13, cp23, cp33]
        prm%Lp = yield_lin_dev_block(blk)
        prm%c_shear = [c44, c55, c66]
        prm%cp_shear = [cp44, cp55, cp66]
        prm%k = k
        prm%kp = kp
        prm%a = a
        rd%vals = 0.0_${k}$
        rd%vals(1) = 1.0_${k}$
        prm%B = 1.0_${k}$
        prm%B = 1.0_${k}$/yield_stress_eq_cpb06ex2_3D_${k}$(prm, rd)
        status = STATUS_OK
    end subroutine yield_cpb06ex2_init_${k}$

    pure subroutine yield_cpb06ex2_principal_${k}$(prm, lam, lamp, phi, df, dfp, d2f, d2fp, cross)
        !! Principal derivatives in `real(${k}$)` of f = B Psi**(1/a), Plunkett et al. (2008), Eq. (8):
        !! df/dlam_i = (f/Psi) psi_i**(a-1) (sgn(lam_i) - k), with Psi = Phi + Phip the sum over Sigma
        !! and Sigmap; the second derivatives as two diagonal blocks (`yield_cpb_hessian`, with the
        !! total Psi) and the coefficient (1-a)/f of the mixed block. Evaluated on the six principal
        !! values divided by 2**e: df (degree 0) is the same, d2f, d2fp and cross (degree
        !! -1) are scaled back by 2**(-e); `phi` is Psi of the scaled values. With Psi = 0 (null
        !! equivalent stress) every derivative is 0.
        implicit none
        @:DEVICE()
        type(yield_cpb06ex2_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: lam(3)
            !! Principal values of Sigma.
        real(${k}$), intent(in) :: lamp(3)
            !! Principal values of Sigmap.
        real(${k}$), intent(out) :: phi
            !! Psi (of the scaled values).
        real(${k}$), intent(out) :: df(3)
            !! df/dlam_i.
        real(${k}$), intent(out) :: dfp(3)
            !! df/dlamp_i.
        real(${k}$), intent(out), optional :: d2f(3,3)
            !! d2f/dlam_i dlam_j (the three optional outputs are requested together).
        real(${k}$), intent(out), optional :: d2fp(3,3)
            !! d2f/dlamp_i dlamp_j.
        real(${k}$), intent(out), optional :: cross
            !! (1-a)/f, coefficient of the mixed block.
        real(${k}$) :: x(3), xp(3), psi(3), psip(3), p(3), pp(3), s(3), sgp(3), f, f_phi, q
        integer :: e

        e = 0
        if (max(maxval(abs(lam)), maxval(abs(lamp))) > 0.0_${k}$) e = fp_exponent(max(maxval(abs(lam)), maxval(abs(lamp))))
        x = scale(lam, -e)
        xp = scale(lamp, -e)
        call yield_cpb_terms(x, prm%k, prm%a, psi, p, s)
        call yield_cpb_terms(xp, prm%kp, prm%a, psip, pp, sgp)
        phi = psi(1)*p(1) + psi(2)*p(2) + psi(3)*p(3) &
              + psip(1)*pp(1) + psip(2)*pp(2) + psip(3)*pp(3)
        if (phi == 0.0_${k}$) then
            df = 0.0_${k}$
            dfp = 0.0_${k}$
            if (present(d2f)) then
                d2f = 0.0_${k}$
                d2fp = 0.0_${k}$
                cross = 0.0_${k}$
            end if
            return
        end if
        f = prm%B*phi**(1.0_${k}$/prm%a)
        f_phi = f/phi
        df(1) = f_phi*p(1)*s(1)
        df(2) = f_phi*p(2)*s(2)
        df(3) = f_phi*p(3)*s(3)
        dfp(1) = f_phi*pp(1)*sgp(1)
        dfp(2) = f_phi*pp(2)*sgp(2)
        dfp(3) = f_phi*pp(3)*sgp(3)
        if (.not. present(d2f)) return
        q = (prm%a - 1.0_${k}$)/phi
        cross = scale((1.0_${k}$ - prm%a)/f, -e)
        d2f = scale(yield_cpb_hessian(x, prm%k, prm%a, psi, p, s, df, f_phi, q), -e)
        d2fp = scale(yield_cpb_hessian(xp, prm%kp, prm%a, psip, pp, sgp, dfp, f_phi, q), -e)
    end subroutine yield_cpb06ex2_principal_${k}$

    pure function yield_stress_eq_cpb06ex2_3D_${k}$(prm, sigma) result(res)
        !! Equivalent stress \( \sigma_{eq}(\boldsymbol\sigma) \) of the CPB06ex2 (Plunkett-Cazacu-Barlat 2008) model in
        !! `real(${k}$)` (3D).
        implicit none
        @:DEVICE()
        type(yield_cpb06ex2_${k}$), intent(in) :: prm
            !! Parameters.
        type(ten_3D2Osym_${k}$), intent(in) :: sigma
            !! Stress tensor \( \boldsymbol\sigma \).
        real(${k}$) :: res
            !! \( \sigma_{eq} \).
        ! Equivalent stress B Psi**(1/a), Plunkett et al. (2008), Eq. (8), on the principal values
        ! scaled by 2**(-e) (homogeneity of degree 1)
        real(${k}$) :: lam(3), lamp(3)
        integer :: e

        lam = eigenvals(yield_lin_apply(prm%L, prm%c_shear, sigma))
        lamp = eigenvals(yield_lin_apply(prm%Lp, prm%cp_shear, sigma))
        e = 0
        if (max(maxval(abs(lam)), maxval(abs(lamp))) > 0.0_${k}$) e = fp_exponent(max(maxval(abs(lam)), maxval(abs(lamp))))
        lam = scale(lam, -e)
        lamp = scale(lamp, -e)
        res = ((abs(lam(1)) - prm%k*lam(1))**prm%a &
               + (abs(lam(2)) - prm%k*lam(2))**prm%a &
               + (abs(lam(3)) - prm%k*lam(3))**prm%a &
               + (abs(lamp(1)) - prm%kp*lamp(1))**prm%a &
               + (abs(lamp(2)) - prm%kp*lamp(2))**prm%a &
               + (abs(lamp(3)) - prm%kp*lamp(3))**prm%a)**(1.0_${k}$/prm%a)
        res = scale(res, e)*prm%B
    end function yield_stress_eq_cpb06ex2_3D_${k}$

    pure function yield_dstress_eq_cpb06ex2_3D_${k}$(prm, sigma) result(res)
        !! Gradient \( \partial\sigma_{eq}/\partial\boldsymbol\sigma \) of the CPB06ex2 (Plunkett-Cazacu-Barlat 2008) model in
        !! `real(${k}$)` (3D).
        implicit none
        @:DEVICE()
        type(yield_cpb06ex2_${k}$), intent(in) :: prm
            !! Parameters.
        type(ten_3D2Osym_${k}$), intent(in) :: sigma
            !! Stress tensor \( \boldsymbol\sigma \).
        type(ten_3D2Osym_${k}$) :: res
            !! \( \partial\sigma_{eq}/\partial\boldsymbol\sigma \).
        ! L^T : sum_i (df/dlam_i) E_i + Lp^T : sum_i (df/dlamp_i) Ep_i, Plunkett et al. (2008),
        ! Eqs. (8)-(9)
        real(${k}$) :: lam(3), lamp(3), V(3,3), Vp(3,3), df(3), dfp(3), phi

        call spectral_decomposition(yield_lin_apply(prm%L, prm%c_shear, sigma), lam, V)
        call spectral_decomposition(yield_lin_apply(prm%Lp, prm%cp_shear, sigma), lamp, Vp)
        call yield_cpb06ex2_principal_${k}$(prm, lam, lamp, phi, df, dfp)
        if (phi == 0.0_${k}$) then
            res%vals = 0.0_${k}$  ! null equivalent stress: zero derivative
            return
        end if
        res = yield_lin_pull_back(prm%L, prm%c_shear, spectral_gradient(V, df)) &
              + yield_lin_pull_back(prm%Lp, prm%cp_shear, spectral_gradient(Vp, dfp))
    end function yield_dstress_eq_cpb06ex2_3D_${k}$

    pure function yield_ddstress_eq_cpb06ex2_3D_${k}$(prm, sigma) result(res)
        !! Second derivative \( \partial^2\sigma_{eq}/\partial\boldsymbol\sigma^2 \) of the CPB06ex2 (Plunkett-Cazacu-Barlat 2008)
        !! model in `real(${k}$)` (3D).
        implicit none
        @:DEVICE()
        type(yield_cpb06ex2_${k}$), intent(in) :: prm
            !! Parameters.
        type(ten_3D2Osym_${k}$), intent(in) :: sigma
            !! Stress tensor \( \boldsymbol\sigma \).
        type(ten_3D4O3sym_${k}$) :: res
            !! \( \partial^2\sigma_{eq}/\partial\boldsymbol\sigma^2 \).
        ! L^T : H : L + Lp^T : Hp : Lp + 2 cross sym(g (x) gp), Plunkett et al. (2008), Eqs. (8)-(9),
        ! with g and gp the two terms of the gradient
        type(ten_3D2Osym_${k}$) :: g, gp
        real(${k}$) :: lam(3), lamp(3), V(3,3), Vp(3,3), df(3), dfp(3), d2f(3,3), d2fp(3,3), cross, phi

        call spectral_decomposition(yield_lin_apply(prm%L, prm%c_shear, sigma), lam, V)
        call spectral_decomposition(yield_lin_apply(prm%Lp, prm%cp_shear, sigma), lamp, Vp)
        call yield_cpb06ex2_principal_${k}$(prm, lam, lamp, phi, df, dfp, d2f, d2fp, cross)
        if (phi == 0.0_${k}$) then
            res%vals = 0.0_${k}$  ! null equivalent stress: zero derivative
            return
        end if
        g = yield_lin_pull_back(prm%L, prm%c_shear, spectral_gradient(V, df))
        gp = yield_lin_pull_back(prm%Lp, prm%cp_shear, spectral_gradient(Vp, dfp))
        res = yield_lin_pull_back_hessian(prm%L, prm%c_shear, spectral_hessian(lam, V, df, d2f)) &
              + yield_lin_pull_back_hessian(prm%Lp, prm%cp_shear, spectral_hessian(lamp, Vp, dfp, d2fp)) &
              + (2.0_${k}$*cross)*(g .tdotsym. gp)
    end function yield_ddstress_eq_cpb06ex2_3D_${k}$

    pure function yield_joint_evaluation_cpb06ex2_${k}$(prm) result(res)
        !! Whether the criterion writes its own joint evaluation (cheaper than the three functions in turn): false for the CPB06ex2
        !! (Plunkett-Cazacu-Barlat 2008) model (`real(${k}$)` parameters; a constant, resolved at compile time).
        implicit none
        @:DEVICE()
        type(yield_cpb06ex2_${k}$), intent(in) :: prm
            !! Parameters (not used: only selects the model).
        logical :: res
            !! .false.

        res = .false.
    end function yield_joint_evaluation_cpb06ex2_${k}$

    pure subroutine yield_stress_eq_and_derivatives_cpb06ex2_3D_${k}$(prm, sigma, f, df, ddf)
        !! Equivalent stress and its first and second derivatives at the same stress of the CPB06ex2 (Plunkett-Cazacu-Barlat 2008)
        !! model in `real(${k}$)` (3D), computed by the functions `yield_stress_eq_cpb06ex2_3D_${k}$`,
        !! `yield_dstress_eq_cpb06ex2_3D_${k}$`, `yield_ddstress_eq_cpb06ex2_3D_${k}$` in turn.
        implicit none
        @:DEVICE()
        type(yield_cpb06ex2_${k}$), intent(in) :: prm
            !! Parameters.
        type(ten_3D2Osym_${k}$), intent(in) :: sigma
            !! Stress tensor \( \boldsymbol\sigma \).
        real(${k}$), intent(out) :: f
            !! \( \sigma_{eq} \).
        type(ten_3D2Osym_${k}$), intent(out) :: df
            !! \( \partial\sigma_{eq}/\partial\boldsymbol\sigma \).
        type(ten_3D4O3sym_${k}$), intent(out), optional :: ddf
            !! \( \partial^2\sigma_{eq}/\partial\boldsymbol\sigma^2 \). Optional: not computed when absent.

        f = yield_stress_eq_cpb06ex2_3D_${k}$(prm, sigma)
        df = yield_dstress_eq_cpb06ex2_3D_${k}$(prm, sigma)
        if (present(ddf)) ddf = yield_ddstress_eq_cpb06ex2_3D_${k}$(prm, sigma)
    end subroutine yield_stress_eq_and_derivatives_cpb06ex2_3D_${k}$
    #:endfor

end module muscle_yield_cpb06ex2
