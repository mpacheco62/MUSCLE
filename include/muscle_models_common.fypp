#!
#! Model contract macros, common to every model family (D-007, D-017.6). Include with
#! `#:include "muscle_models_common.fypp"` (it includes muscle_common.fypp and muscle_fd.fypp).
#!
#! Inverted pattern (D-017.6a): the author writes the model template as plain Fortran with
#! `#:for k in REAL_KINDS` (and `#:for d in DIMS` when the family depends on the dimension): the
#! module, its `use`s and docs, and the body of each function, so compiler messages and coverage
#! point to the author's lines (D-009) and the code may depend on `k`/`d`. These small macros only
#! write the repetitive parts, from the family metadata (`MODEL_FAMILIES` of
#! tools/fypp/muscle_meta.py: parameter argument name, function arguments and results, finite
#! difference scale and domain, registry):
#!
#!   $:MODEL_PUBLIC(fam, model)                    public statements of the kernel API (every kind)
#!   $:MODEL_PARAMS_TYPE(fam, model, k, params[, d])   parameter type `<fam>_<model>_<k>`
#!                                                 (`params`: `model_param_list(fam, model)`, the
#!                                                 single source in MODEL_PARAMS of muscle_meta)
#!   $:MODEL_INIT(fam, model, k)                    header of the initializer of a model built from
#!                                                 inputs other than its parameters (MODEL_INITS)
#!   $:MODEL_FUNCTION(fam, model, func, k[, d, uses, doc])
#!                                                 header of a function, up to the declarations of
#!                                                 its arguments; the author writes the body and
#!                                                 `end function` (`end subroutine` for a family
#!                                                 procedure with `intent(out)` arguments,
#!                                                 `ModelFunc.outs`, e.g. a `status`; then the
#!                                                 optional inputs `ModelFunc.opts`). A function
#!                                                 of only some models (`ModelFunc.models`) is
#!                                                 public, imported and in the family generic
#!                                                 for those models only
#!   $:MODEL_FD(fam, model, func, k[, d, second])   whole function computed with central finite
#!                                                 differences of the function it is the derivative
#!                                                 of (`second=True`: FD_DERIV2 of the function two
#!                                                 levels up, to avoid nested differences). In a
#!                                                 `2Osym` argument (yield criteria): FD_GRAD of a
#!                                                 scalar function, and with `second=True` FD_HESS
#!                                                 (the historical finite-difference steps)
#!   $:MODEL_DEFAULT(fam, model, func, k[, d])      whole function computed from the other functions
#!                                                 of the model with the family formula
#!                                                 (`ModelFunc.default`, e.g. the total derivative
#!                                                 of the viscoplastic laws). It calls each function
#!                                                 separately: use it only when they are cheap; if
#!                                                 they share an expensive part, write the function
#!                                                 with one call to a shared helper (e.g. the
#!                                                 `dparts` of the MRK and NNL laws)
#!   $:MODEL_JOINT(fam, model, k[, d, uses, doc]), $:MODEL_JOINT_DEFAULT(fam, model, k[, d])
#!                                                 joint evaluation of a family with `ModelJoint`
#!                                                 (yield: the equivalent stress and its two
#!                                                 derivatives, the second `optional`): flag
#!                                                 function and header of the subroutine written
#!                                                 by the author, or flag and the default
#!                                                 subroutine (the functions in turn; an optional
#!                                                 output only if present)
#!   $:FAMILY_USES(fam), $:FAMILY_EXPORTS(fam)      family module: generics over the registry
#!
#! Names (D-007, D-011.4, D-017.5b), for a family prefix `<fam>` (e.g. `hard`):
#! - parameter type `<fam>_<model>_<k>`; specific functions `<fam>_<func>_<model>_<k>` (with the
#!   dimension, `<fam>_<func>_<model>_<d>_<k>`, in a family with `ModelFamily.dims`: the template
#!   loops `#:for d in model_dims(fam)` and passes `d` to the macros); family
#!   generics `<fam>_<func>` (same for every model of the family, in the family module only:
#!   legacy code imports the model module whole and may have variables named like a function);
#! - inside a function: the parameter argument is named by the family (`prm` in hardening: never a
#!   physical name such as a pressure `p`), the other arguments and the result as in the family
#!   metadata (`ep`, `res`). The bodies may not use other names starting with `fd_`.
#!
#! Parameters of a model (`params`, MODEL_PARAMS of muscle_meta, one tuple per component, storage
#! order = order of the positional structure constructor): `(name, type, shape, doc, default)` with
#! - type: 'real' (kind of the instance), 'integer', 'logical', or a tensor family ('2Osym', ...:
#!   the type of dimension `d` and kind `k`, needs `d`);
#! - shape: '' (scalar) or a fixed shape, e.g. '(3)' (no allocatable components: kernels, GPU);
#! - doc: FORD text (use r'...' for LaTeX); default: None or a number without kind ('0.0'; the
#!   kind is appended for reals; only scalar intrinsic parameters).
#! Implemented and tested so far: real scalars (hardening, yield), fixed-shape real arrays
#! (CPB06: `C1(3,3)`, `C2(3)`; with a scalar default, the Prony series of Maxwell), integer scalars
#! (number of Maxwell branches) and a tensor of a fixed dimension with a default (`'3D2Osym'`, the
#! history stress of the frozen elasticity). The other forms are generated by the same code paths
#! (model_decl/model_default of muscle_meta) but not yet used by a model.
#! Arguments and results may also be derived types with one instance per kind, `'type:<name>'` ->
#! `type(<name>_<k>)` (the state and coefficients of the viscoelastic family).
#!
#! Composition (D-017.6b): a family whose models used to contain another law (viscoplastic laws
#! with a hardening law) receives the values already evaluated (sigma_y and its derivatives) as
#! ordinary arguments of its functions (ModelArg), not the other law. Only the models registered
#! as composed (`ModelFamily.composed`) take them, each function the ones it needs
#! (`ModelFunc.comp`), after the family and `extra` arguments (`model_args`); the caller (the
#! material, D-017.13d) evaluates them with the functions of the composed family
#! (`ModelComposition`). A finite difference in the argument the values depend on
#! (`ModelComposition.arg`) is refused for a composed model: with the values frozen it would miss
#! their variation.
#!
#! Line markers: everything the author writes keeps its own `#line` markers; the lines emitted by a
#! macro point to the line of the `$:` call.
#:mute
#:include "muscle_common.fypp"
#:include "muscle_fd.fypp"

#! Registered hardening laws (exported by the family module muscle_hard_laws)
#:set HARDENING_MODELS = list(muscle_meta.HARDENING_MODELS)
#:set model_family = muscle_meta.model_family
#:set model_func = muscle_meta.model_func
#:set model_type = muscle_meta.model_type
#:set model_module = muscle_meta.model_module
#:set model_label = muscle_meta.model_label
#:set model_specific = muscle_meta.model_specific
#:set model_decl = muscle_meta.model_decl
#:set model_params = muscle_meta.model_params
#:set model_params_init_doc = muscle_meta.model_params_init_doc
#:set model_default = muscle_meta.model_default
#:set model_call = muscle_meta.model_call
#:set model_args = muscle_meta.model_args
#:set model_composed = muscle_meta.model_composed
#:set model_comp_values = muscle_meta.model_comp_values
#:set model_default_expr = muscle_meta.model_default_expr
#:set model_dims = muscle_meta.model_dims
#:set model_procs = muscle_meta.model_procs
#:set model_proc_doc = muscle_meta.model_proc_doc
#:set model_proc_specifics = muscle_meta.model_proc_specifics
#:set model_specifics = muscle_meta.model_specifics
#:set model_joint = muscle_meta.model_joint
#:set model_joint_outs = muscle_meta.model_joint_outs
#:set model_param_list = muscle_meta.model_param_list
#:set model_init = muscle_meta.model_init
#:set model_init_signature = muscle_meta.model_init_signature
#! Components of an isotropic 4O3sym tensor from its three distinct values (elastic models)
#:set isotropic_4o3sym = muscle_meta.isotropic_4o3sym

#! Declaration `type, attrs :: name shape`
#:set model_var = lambda a, k, d=None, attrs='': '{}{} :: {}{}'.format(model_decl(a.type, a.shape, k, d), attrs, a.name, a.shape)

#! Public statements of the kernel API of a model (every kind and dimension): parameter type,
#! functions and, in a family with a joint evaluation, its subroutine and flag
#:def MODEL_PUBLIC(fam, model)
#:for k in REAL_KINDS
    public :: ${model_type(fam, model, k)}$
#:endfor
#:for n in model_procs(fam, model)
    public :: ${', '.join(model_proc_specifics(fam, n, model, REAL_KINDS))}$
#:endfor
#:enddef

#! Parameter type of a model in kind k (dimension d for tensor parameters). Private parameters
#! (`ModelParam.private`) are private components: the type is then built with the initializer of
#! the model module, not with the structure constructor. `validated`: the private parameters are
#! inputs validated by the initializer, not derived ones (only changes the docs).
#:def MODEL_PARAMS_TYPE(fam, model, k, params, d=None, validated=False)
#:set ps = model_params(params)

    type :: ${model_type(fam, model, k)}$
        !! Parameters of the ${model_label(fam, model)}$ model in `real(${k}$)`${model_params_init_doc(fam, model, params, validated)}$.
#:for p in ps
        ${model_var(p, k, d, ', private' if p.private else '')}$${model_default(p, k)}$
            !! ${p.doc}$
#:endfor
    end type ${model_type(fam, model, k)}$
#:enddef

#! Header of the initializer `<fam>_<model>_init_<k>` of a model (MODEL_INITS of muscle_meta, D-018.17e):
#! statement, docs and declarations of the parameters, the inputs and the status; the author writes
#! the body and `end subroutine`
#:def MODEL_INIT(fam, model, k)
#:set init = model_init(fam, model)
#:assert init is not None, 'no initializer registered for ' + fam + ' ' + model
${model_init_signature(fam, model, k)}$
#:for line in init.doc
        !! ${line.replace('{k}', k)}$
#:endfor
        implicit none
        @:DEVICE()
        type(${model_type(fam, model, k)}$), intent(${init.prm_intent}$) :: ${model_family(fam).par}$
            !! ${init.prm_doc}$
#:for a in init.inputs
        ${'real(' + k + ')' if a.type == 'real' else a.type}$, intent(in) :: ${a.name}$${a.shape}$
            !! ${a.doc}$
#:endfor
#:if init.status
        integer, intent(out) :: status
            !! ${init.status}$
#:endif
#:enddef

#! Function statement, docs, `use`s and argument declarations of a family function
#:def _MODEL_HEADER(fam, model, func, k, d, uses, doc, fd)
#:set F = model_family(fam)
#:set f = model_func(fam, func)
#:set args = model_args(fam, func, model)
#! A registered model only writes the functions it has (ModelFunc.models); optional inputs
#! (ModelFunc.opts) only in a subroutine, after its outputs
#:assert f.outs or not f.opts, 'optional arguments of a function: not implemented'
#:assert f.models is None or model not in F.models or model in f.models, func + ' is not a function of ' + model
#:if f.outs
#:assert not fd, 'finite difference or default body of a subroutine'
    pure subroutine ${model_specific(fam, func, model, k, d)}$(${', '.join([F.par] + [a.name for a in args] + [o.name for o in f.outs] + [o.name for o in f.opts])}$)
#:else
    pure function ${model_specific(fam, func, model, k, d)}$(${', '.join([F.par] + [a.name for a in args])}$) &
        & result(${f.result.name}$)
#:endif
        !! ${f.doc}$ of the ${model_label(fam, model)}$ model in `real(${k}$)`${'' if d is None else ' (' + d + ')'}$${',' if fd else '.'}$
#:if fd == 'fd'
        !! computed with central finite differences.
#:elif fd
        !! computed as `${f.default.replace("{", "").replace("}", "")}$`.
#:endif
#:if doc
        !! ${doc}$
#:endif
#:for u in (uses or [])
        use ${u}$
#:endfor
        implicit none
        @:DEVICE()
        type(${model_type(fam, model, k)}$), intent(in) :: ${F.par}$
            !! Parameters.
#:for a in args
        ${model_var(a, k, d, ', intent(in)')}$
            !! ${a.doc}$
#:endfor
#:for o in f.outs
        ${model_var(o, k, d, ', intent(out)')}$
            !! ${o.doc}$
#:endfor
#:for o in f.opts
        ${model_var(o, k, d, ', intent(in), optional')}$
            !! ${o.doc}$
#:endfor
#:if not f.outs
        ${model_var(f.result, k, d)}$
            !! ${f.result.doc}$
#:endif
#:enddef

#! Header of a function written by the author (body and `end function` follow in the template); of a
#! subroutine for a family procedure with outputs (`ModelFunc.outs`: body and `end subroutine`)
#:def MODEL_FUNCTION(fam, model, func, k, d=None, uses=None, doc=None)
$:_MODEL_HEADER(fam, model, func, k, d, uses, doc, False)
#:enddef

#! Whole function computed with finite differences (scale and domain of the family)
#:def MODEL_FD(fam, model, func, k, d=None, second=False)
#:set F = model_family(fam)
#:set f = model_func(fam, func)
#:assert f.deriv is not None
#:set parent, xarg = f.deriv
#:if second
#:set g = model_func(fam, parent)
#:assert g.deriv is not None and g.deriv[1] == xarg
#:set parent = g.deriv[0]
#:endif
#:set xa = [a for a in F.args if a.name == xarg][0]
#:assert not xa.shape and xa.type in ('real', '2Osym'), 'finite difference in an argument of type ' + xa.type
#:assert xa.type == 'real' or (second or model_func(fam, parent).result.type == 'real'), 'tensor Jacobian: not implemented'
#:assert not (model_composed(fam, model) and xarg == F.composition.arg), 'finite difference in ' + xarg + ' of a composed model'
#:set fcall = model_call(fam, parent, model, k, xarg, d)
#:set sc = None if F.fd_scale is None else F.fd_scale + '_' + k
#:set lo = None if F.fd_lower is None else F.fd_lower + '_' + k
$:_MODEL_HEADER(fam, model, func, k, d, None, None, 'fd')
#:if xa.type == '2Osym'
#:assert lo is None, 'lower bound of a tensor argument'
#! Gradient (FD_GRAD) or second derivative (FD_HESS, of the function two levels up) in the stress
#:if second
$:FD_HESS(f.result.name, fcall, xarg, k, d, scale=sc)
#:else
$:FD_GRAD(f.result.name, fcall, xarg, k, d, scale=sc)
#:endif
#:elif second
$:FD_DERIV2(f.result.name, fcall, xarg, k, scale=sc, lower=lo)
#:else
$:FD_DERIV(f.result.name, fcall, xarg, k, scale=sc, lower=lo)
#:endif
    end function ${model_specific(fam, func, model, k, d)}$
#:enddef

#! Whole function computed from the other functions of the model (family formula `default`)
#:def MODEL_DEFAULT(fam, model, func, k, d=None)
#:set f = model_func(fam, func)
$:_MODEL_HEADER(fam, model, func, k, d, None, None, 'default')

        ${f.result.name}$ = ${model_default_expr(fam, func, model, k, d)}$
    end function ${model_specific(fam, func, model, k, d)}$
#:enddef

#! Flag of the joint evaluation of a model (constant `joint`): true if the model writes its own
#:def _MODEL_JOINT_FLAG(fam, model, k, joint)
#:set F = model_family(fam)
#:set J = F.joint

    pure function ${model_specific(fam, J.flag, model, k)}$(${F.par}$) result(res)
        !! ${J.flag_doc}$: ${'true' if joint else 'false'}$ for the ${model_label(fam, model)}$ model
        !! (`real(${k}$)` parameters; a constant, resolved at compile time).
        implicit none
        @:DEVICE()
        type(${model_type(fam, model, k)}$), intent(in) :: ${F.par}$
            !! Parameters (not used: only selects the model).
        logical :: res
            !! ${'.true.' if joint else '.false.'}$

        res = ${'.true.' if joint else '.false.'}$
    end function ${model_specific(fam, J.flag, model, k)}$
#:enddef

#! Statement, docs and declarations of the joint evaluation subroutine
#:def _MODEL_JOINT_HEADER(fam, model, k, d, uses, doc, default)
#:set F = model_family(fam)
#:set J = F.joint
#:set outs = model_joint_outs(fam)

    pure subroutine ${model_specific(fam, J.name, model, k, d)}$(${', '.join([F.par] + [a.name for a in F.args] + [o.name for o in outs])}$)
        !! ${J.doc}$ of the ${model_label(fam, model)}$ model in `real(${k}$)`${'' if d is None else ' (' + d + ')'}$${',' if default else '.'}$
#:if default
        !! computed by the functions `${'`, `'.join(model_specific(fam, f, model, k, d) for f in J.funcs)}$` in turn.
#:endif
#:if doc
        !! ${doc}$
#:endif
#:for u in (uses or [])
        use ${u}$
#:endfor
        implicit none
        @:DEVICE()
        type(${model_type(fam, model, k)}$), intent(in) :: ${F.par}$
            !! Parameters.
#:for a in F.args
        ${model_var(a, k, d, ', intent(in)')}$
            !! ${a.doc}$
#:endfor
#:for o in outs
        ${model_var(o, k, d, ', intent(out)' + (', optional' if o.name in J.optional else ''))}$
            !! ${o.doc}$${' Optional: not computed when absent.' if o.name in J.optional else ''}$
#:endfor
#:enddef

#! Joint evaluation written by the author (model in ModelJoint.models, or a model not registered in
#! the family, e.g. a test-only one): the flag function (true) and the header of the subroutine;
#! the body (which must honour `present()` of the optional outputs) and `end subroutine` follow in
#! the template. The flag (no dimension) is emitted with the first dimension of the family only.
#:def MODEL_JOINT(fam, model, k, d=None, uses=None, doc=None)
#:set F = model_family(fam)
#:assert model_joint(fam, model) or model not in F.models, model + ' is not registered in ModelJoint.models'
#:assert not model_composed(fam, model), 'joint evaluation of a composed model: not implemented'
#:if d == model_dims(fam)[0]
$:_MODEL_JOINT_FLAG(fam, model, k, True)
#:endif
$:_MODEL_JOINT_HEADER(fam, model, k, d, uses, doc, False)
#:enddef

#! Default joint evaluation (model not in ModelJoint.models): the flag function (false) and the
#! whole subroutine, the functions of ModelJoint.funcs called in turn (flag as in MODEL_JOINT).
#:def MODEL_JOINT_DEFAULT(fam, model, k, d=None)
#:set F = model_family(fam)
#:set J = F.joint
#:assert not model_joint(fam, model), model + ' writes its own joint evaluation: use MODEL_JOINT'
#:assert not model_composed(fam, model), 'joint evaluation of a composed model: not implemented'
#:if d == model_dims(fam)[0]
$:_MODEL_JOINT_FLAG(fam, model, k, False)
#:endif
$:_MODEL_JOINT_HEADER(fam, model, k, d, None, None, True)

#:for f, o in zip(J.funcs, J.outs)
#:if o in J.optional
        if (present(${o}$)) ${o}$ = ${model_call(fam, f, model, k, dim=d)}$
#:else
        ${o}$ = ${model_call(fam, f, model, k, dim=d)}$
#:endif
#:endfor
    end subroutine ${model_specific(fam, J.name, model, k, d)}$
#:enddef

#! Yield criteria (D-017.9): returns a zero derivative `res` (a tensor) when the equivalent stress
#! `seq` (or a quantity that vanishes with it) is exactly 0, where the formulas give 0/0: 0 belongs
#! to the subdifferential of a convex, positively homogeneous criterion at that point. A NaN `seq`
#! still propagates.
#:def YIELD_ZERO_AT_NULL(seq, k)
        if (${seq}$ == 0.0_${k}$) then
            res%vals = 0.0_${k}$  ! null equivalent stress: zero derivative (D-017.9)
            return
        end if
#:enddef

#! Yield criteria (D-017.10c): exponent `e` of the power of two of the largest magnitude `m >= 0` of
#! the principal values (e = 0 if m is 0 or NaN), so that `scale(x, -e)` (exact) brings them to
#! [1/2, 1) before raising them to the exponent of the criterion: no power under- or overflows.
#:def YIELD_SCALE_EXPONENT(e, m, k)
        ${e}$ = 0
        if (${m}$ > 0.0_${k}$) ${e}$ = exponent(${m}$)
#:enddef

#! Family module: `use` of every registered model (before `implicit none`)
#:def FAMILY_USES(fam)
#:set F = model_family(fam)
#:for m in F.models
#:for n in model_procs(fam, m)
    use ${model_module(fam, m)}$, only : ${', '.join(model_proc_specifics(fam, n, m, REAL_KINDS))}$
#:endfor
    use ${model_module(fam, m)}$, only : ${', '.join(model_type(fam, m, k) for k in REAL_KINDS)}$
#:endfor
#:enddef

#! Family module: public parameter types and the generics `<fam>_<func>` over every model and kind
#:def FAMILY_EXPORTS(fam)
#:set F = model_family(fam)
#:for n in model_procs(fam)
    public :: ${fam}$_${n}$
#:endfor
#:for m in F.models
    public :: ${', '.join(model_type(fam, m, k) for k in REAL_KINDS)}$
#:endfor
#:for n in model_procs(fam)

    interface ${fam}$_${n}$
        !! ${model_proc_doc(fam, n)}$ (every ${'' if all(n in model_procs(fam, m) for m in F.models) else 'applicable '}$model, kind${'' if F.dims is None else ' and dimension'}$ of the family).
#:for m in F.models
#:if n in model_procs(fam, m)
        module procedure ${', '.join(model_proc_specifics(fam, n, m, REAL_KINDS))}$
#:endif
#:endfor
    end interface ${fam}$_${n}$
#:endfor
#:enddef

#:endmute
