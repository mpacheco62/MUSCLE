#:include "muscle_common.fypp"
#:include "muscle_fd.fypp"
#!
#! Physical checks of the Kelvin-Voigt solid through the kernel API (dp): the step calls of a material
#! point (visco_test_steps) and the frozen elasticity through the elas_* generics.

program test_muscle_visco_kelvin
    implicit none
    logical :: passed

    call test_constant_rate(passed)
    if (.not. passed) STOP 1

    call test_step_and_hold(passed)
    if (.not. passed) STOP 2

    call test_time_step_limit(passed)
    if (.not. passed) STOP 3

    call test_frozen_stress_tangent_2d(passed)
    if (.not. passed) STOP 4

    call test_states(passed)
    if (.not. passed) STOP 5


    print*, "Passed!", passed
end program test_muscle_visco_kelvin

subroutine test_constant_rate(passed)
    ! Constant strain rate D: sigma(t) = t (K tr(D) I + 2 G dev(D)) + zeta tr(D) I + 2 mu_v dev(D),
    ! exact for any dt.
    use muscle_kinds, only : dp
    use muscle_tensors
    use muscle_test_utils
    use muscle_elas_laws, only : elas_stress
    use muscle_visco_laws, only : visco_freeze, visco_kelvin_dp, visco_state_dp, visco_coefs_dp, elas_frozen_dp
    use muscle_visco_kelvin, only : visco_kelvin_init
    use visco_test_steps, only : step_coefs, new_state, advance
    implicit none
    logical, intent(out) :: passed

    type(visco_kelvin_dp) :: model
    type(visco_state_dp) :: state
    type(elas_frozen_dp) :: elas
    type(visco_coefs_dp) :: coefs
    type(ten_3D2Osym) :: rate, strain, stress, expected
    real(dp), parameter :: K = 2000.0_dp, G = 800.0_dp, ZETA = 300.0_dp, MU_V = 150.0_dp
    real(dp), parameter :: DTS(5) = [0.03_dp, 0.2_dp, 0.5_dp, 1.5_dp, 3.0_dp]
    real(dp) :: t, trd
    integer :: i, status
    character(len=44) :: label

    passed = .true.
    call visco_kelvin_init(model, bulk=K, shear=G, bulk_viscosity=ZETA, shear_viscosity=MU_V, status=status)
    call new_state(model, state)

    ! Measured: 0
    coefs = step_coefs(model, 0.25_dp)
    call check_approx(passed, "coefficients: K_alg = K + zeta/dt", coefs%k_alg, K + ZETA/0.25_dp, tol=1.0e-14_dp)
    call check_approx(passed, "coefficients: G_alg = G + mu_v/dt", coefs%g_alg, G + MU_V/0.25_dp, tol=1.0e-14_dp)

    call rate%init(xx=2.0e-3_dp, yy=-1.0e-3_dp, zz=5.0e-4_dp, xy=1.0e-3_dp, yz=3.0e-4_dp, xz=-2.0e-4_dp)
    trd = rate .ddot. iden_2O()

    ! Measured: 1.2e-16 or less
    t = 0.0_dp
    do i = 1, size(DTS)
        t = t + DTS(i)
        strain = t*rate
        coefs = step_coefs(model, DTS(i))
        elas = visco_freeze(model, coefs, state)
        stress = elas_stress(elas, strain)
        call advance(model, coefs, strain, state)

        expected = t*(K*trd*(iden_2O()) + 2.0_dp*G*(.dev. rate)) + (ZETA*trd*(iden_2O()) + 2.0_dp*MU_V*(.dev. rate))
        write(label, "(A, ES9.2)") "constant rate: stress at t =", t
        call check_approx(passed, trim(label), stress, expected, tol=1.0e-12_dp)
    end do
end subroutine test_constant_rate

subroutine test_step_and_hold(passed)
    ! Step strain in a very short step, then held: with zero strain rate the stress is C:eps
    ! with any dt. A wrong sign or factor in sigma_hist passes the constant rate case, not this one.
    use muscle_kinds, only : dp
    use muscle_tensors
    use muscle_test_utils
    use muscle_elas_laws, only : elas_stress
    use muscle_visco_laws, only : visco_kelvin_dp, visco_state_dp, elas_frozen_dp
    use muscle_visco_kelvin, only : visco_kelvin_init
    use visco_test_steps, only : step_coefs, new_state, freeze_dt, advance
    implicit none
    logical, intent(out) :: passed

    type(visco_kelvin_dp) :: model
    type(visco_state_dp) :: state
    type(elas_frozen_dp) :: elas
    type(ten_3D2Osym) :: strain, stress, expected
    real(dp), parameter :: K = 2000.0_dp, G = 800.0_dp, ZETA = 300.0_dp, MU_V = 150.0_dp
    real(dp), parameter :: DT_STEP = 1.0e-6_dp
    real(dp), parameter :: DTS(3) = [0.5_dp, 1.0e-6_dp, 3.0e4_dp]
    real(dp) :: tr
    integer :: i, status
    character(len=44) :: label

    passed = .true.
    call visco_kelvin_init(model, bulk=K, shear=G, bulk_viscosity=ZETA, shear_viscosity=MU_V, status=status)
    call new_state(model, state)

    call strain%init(xx=1.0e-3_dp, yy=-2.0e-4_dp, zz=3.0e-4_dp, xy=5.0e-4_dp, yz=-1.0e-4_dp, xz=2.0e-4_dp)
    tr = strain .ddot. iden_2O()

    ! Step from eps_n = 0: elastic plus viscous response. Measured: 1.1e-16
    elas = freeze_dt(model, DT_STEP, state)
    stress = elas_stress(elas, strain)
    expected = (K*tr + ZETA*tr/DT_STEP)*(iden_2O()) + 2.0_dp*(G + MU_V/DT_STEP)*(.dev. strain)
    call check_approx(passed, "step: elastic plus viscous response", stress, expected, tol=1.0e-12_dp)
    call advance(model, step_coefs(model, DT_STEP), strain, state)

    ! Measured: 2.8e-16 (dt = 0.5 and 3e4), 1.5e-11 (dt = 1e-6: cancellation of the zeta/dt terms)
    do i = 1, size(DTS)
        elas = freeze_dt(model, DTS(i), state)
        stress = elas_stress(elas, strain)
        expected = K*tr*(iden_2O()) + 2.0_dp*G*(.dev. strain)
        write(label, "(A, ES9.2)") "hold: stress with dt =", DTS(i)
        call check_approx(passed, trim(label), stress, expected, tol=1.0e-9_dp)
        call advance(model, step_coefs(model, DTS(i)), strain, state)
    end do
end subroutine test_step_and_hold

subroutine test_time_step_limit(passed)
    ! dt -> inf from a non-zero state, and zero viscosity at any dt: both give the linear elasticity
    ! with the same K and G.
    use muscle_kinds, only : dp
    use muscle_tensors
    use muscle_test_utils
    use muscle_elas_laws, only : elas_stress, elas_dstress_dstrain, elas_linear_dp
    use muscle_elas_linear, only : elas_linear_init
    use muscle_status, only : STATUS_OK
    use muscle_visco_laws, only : visco_freeze, visco_kelvin_dp, visco_state_dp, visco_coefs_dp, elas_frozen_dp
    use muscle_visco_kelvin, only : visco_kelvin_init
    use visco_test_steps, only : step_coefs, new_state, advance
    implicit none
    logical, intent(out) :: passed

    type(visco_kelvin_dp) :: model, elastic
    type(elas_linear_dp) :: lin
    type(visco_state_dp) :: state, state0
    type(elas_frozen_dp) :: elas
    type(visco_coefs_dp) :: coefs
    type(ten_3D2Osym) :: strain
    real(dp), parameter :: K = 2000.0_dp, G = 800.0_dp, ZETA = 300.0_dp, MU_V = 150.0_dp
    real(dp), parameter :: DT_INF = 1.0e14_dp
    real(dp) :: young, poisson
    integer :: status

    passed = .true.
    call visco_kelvin_init(model, bulk=K, shear=G, bulk_viscosity=ZETA, shear_viscosity=MU_V, status=status)
    call new_state(model, state)
    call strain%init(xx=1.0e-3_dp, yy=-2.0e-4_dp, zz=3.0e-4_dp, xy=5.0e-4_dp, yz=-1.0e-4_dp, xz=2.0e-4_dp)
    call advance(model, step_coefs(model, 0.5_dp), strain, state)

    young = 9.0_dp*K*G/(3.0_dp*K + G)
    poisson = (3.0_dp*K - 2.0_dp*G)/(2.0_dp*(3.0_dp*K + G))
    call elas_linear_init(lin, young=young, poisson=poisson, status=status)
    call check_true(passed, "linear elastic reference: init status", status == STATUS_OK)

    ! Measured: 1.9e-15 or less
    coefs = step_coefs(model, DT_INF)
    call check_approx(passed, "dt -> inf: K_alg = K", coefs%k_alg, K, tol=1.0e-12_dp)
    call check_approx(passed, "dt -> inf: G_alg = G", coefs%g_alg, G, tol=1.0e-12_dp)

    ! Measured: 1.5e-15 or less
    call strain%init(xx=7.0e-4_dp, yy=-1.0e-4_dp, zz=2.0e-4_dp, xy=2.0e-4_dp, yz=1.0e-4_dp, xz=-3.0e-4_dp)
    elas = visco_freeze(model, coefs, state)
    call check_approx(passed, "dt -> inf: stress = linear elastic", elas_stress(elas, strain), &
                      elas_stress(lin, strain), tol=1.0e-12_dp)
    call check_approx(passed, "dt -> inf: tangent = linear elastic", elas_dstress_dstrain(elas, strain), &
                      elas_dstress_dstrain(lin, strain), tol=1.0e-12_dp)

    ! Measured: 1.9e-16 or less
    call visco_kelvin_init(elastic, bulk=K, shear=G, bulk_viscosity=0.0_dp, shear_viscosity=0.0_dp, status=status)
    call new_state(elastic, state0)
    coefs = step_coefs(elastic, 0.5_dp)
    elas = visco_freeze(elastic, coefs, state0)
    call check_approx(passed, "no viscosity: stress = linear elastic", elas_stress(elas, strain), &
                      elas_stress(lin, strain), tol=1.0e-12_dp)
    call check_approx(passed, "no viscosity: tangent = linear elastic", elas_dstress_dstrain(elas, strain), &
                      elas_dstress_dstrain(lin, strain), tol=1.0e-12_dp)
end subroutine test_time_step_limit

subroutine test_frozen_stress_tangent_2d(passed)
    ! Frozen stress at eps_n+1 (law with eps_dot = de/dt) and at eps_n (elastic), analytical vs
    ! numerical tangent, deviatoric stress and plane strain; normals and three distinct shears.
    use muscle_kinds, only : dp
    use muscle_tensors
    use muscle_test_utils
    use muscle_elas_laws, only : elas_stress, elas_stress_dev, elas_dstress_dstrain
    use muscle_visco_laws, only : visco_freeze, visco_kelvin_dp, visco_state_dp, visco_coefs_dp, elas_frozen_dp
    use muscle_visco_kelvin, only : visco_kelvin_init
    use visco_test_steps, only : step_coefs, new_state, advance
    implicit none
    logical, intent(out) :: passed

    type(visco_kelvin_dp) :: model
    type(visco_state_dp) :: state
    type(elas_frozen_dp) :: elas
    type(visco_coefs_dp) :: coefs
    type(ten_3D2Osym) :: strain, strain_n, de, stress, expected
    type(ten_2D2Osym) :: strain_2d, stress_2d, expected_2d
    type(ten_3D4O2sym) :: tan_an, tan_num
    real(dp), parameter :: K = 2000.0_dp, G = 800.0_dp, ZETA = 300.0_dp, MU_V = 150.0_dp
    real(dp), parameter :: DT = 0.3_dp
    real(dp) :: tr_n, tr_de
    integer :: status

    passed = .true.
    call visco_kelvin_init(model, bulk=K, shear=G, bulk_viscosity=ZETA, shear_viscosity=MU_V, status=status)
    call new_state(model, state)

    ! Two converged steps, the first one in plane strain
    call strain%init(xx=1.0e-3_dp, yy=-4.0e-4_dp, zz=0.0_dp, xy=6.0e-4_dp, yz=0.0_dp, xz=0.0_dp)
    call advance(model, step_coefs(model, 0.2_dp), strain, state)
    call strain%init(xx=4.0e-4_dp, yy=2.0e-4_dp, zz=0.0_dp, xy=-3.0e-4_dp, yz=0.0_dp, xz=0.0_dp)
    call advance(model, step_coefs(model, 0.5_dp), strain, state)

    strain_n = state%strain_e
    call strain%init(xx=7.0e-4_dp, yy=-1.0e-4_dp, zz=2.0e-4_dp, xy=2.0e-4_dp, yz=1.0e-4_dp, xz=-3.0e-4_dp)
    coefs = step_coefs(model, DT)
    elas = visco_freeze(model, coefs, state)

    ! Measured: 4.1e-17
    de = strain - strain_n
    tr_n = strain_n .ddot. iden_2O()
    tr_de = de .ddot. iden_2O()
    expected = K*(strain .ddot. iden_2O())*(iden_2O()) + 2.0_dp*G*(.dev. strain) &
             + (ZETA*tr_de/DT)*(iden_2O()) + (2.0_dp*MU_V/DT)*(.dev. de)
    call check_approx(passed, "frozen stress = C:eps_n+1 + eta:de/dt", elas_stress(elas, strain), expected, &
                      tol=1.0e-12_dp)

    ! Measured: 3.7e-17
    expected = K*tr_n*(iden_2O()) + 2.0_dp*G*(.dev. strain_n)
    call check_approx(passed, "frozen law at eps_n = elastic stress of eps_n", elas_stress(elas, strain_n), expected, &
                      tol=1.0e-12_dp)

    ! Measured: 2.0e-16
    call check_approx(passed, "stress_dev = dev(stress)", elas_stress_dev(elas, strain), &
                      .dev. elas_stress(elas, strain), tol=1.0e-12_dp)

    ! Measured: 1.2e-13 (finite differences)
    tan_an = elas_dstress_dstrain(elas, strain)
    @:FD_JAC(tan_num, elas_stress(elas, {x}), strain, dp, indent=4)
    call check_approx(passed, "frozen tangent: analytical vs numerical", tan_an, tan_num, tol=1.0e-7_dp)

    ! Measured: 0
    stress = elas_stress(elas, strain)
    call strain_2d%init(xx=strain%xx(), yy=strain%yy(), zz=strain%zz(), xy=strain%xy())
    stress_2d = elas_stress(elas, strain_2d)
    call expected_2d%init(xx=stress%xx(), yy=stress%yy(), zz=stress%zz(), xy=stress%xy())
    call check_approx(passed, "plane strain stress = 3D components", stress_2d, expected_2d, tol=1.0e-12_dp)
end subroutine test_frozen_stress_tangent_2d

subroutine test_states(passed)
    ! No branch tensors, and the frozen elasticity reads the converged state: an update to another
    ! strain (a failed global attempt) leaves the history stress of state_n. zeta /= 2 mu_v, so that the
    ! volumetric and deviatoric weights of the history stress differ (the other cases have zeta = 2 mu_v).
    use muscle_kinds, only : dp
    use muscle_tensors
    use muscle_test_utils
    use muscle_visco_laws, only : visco_update, visco_n_branches, visco_kelvin_dp, visco_state_dp, elas_frozen_dp
    use muscle_visco_kelvin, only : visco_kelvin_init
    use visco_test_steps, only : step_coefs, new_state, freeze_dt, advance
    implicit none
    logical, intent(out) :: passed

    type(visco_kelvin_dp) :: model
    type(visco_state_dp) :: state, trial_np1
    type(elas_frozen_dp) :: elas
    type(ten_3D2Osym) :: strain, other, expected
    integer :: status

    passed = .true.
    call visco_kelvin_init(model, bulk=2000.0_dp, shear=800.0_dp, bulk_viscosity=400.0_dp, shear_viscosity=150.0_dp, &
        status=status)
    call new_state(model, state)
    call check_true(passed, "init: zero branch tensors", state%n_branches == 0)
    call check_true(passed, "n_branches = 0", visco_n_branches(model) == 0)

    call strain%init(xx=1.0e-3_dp, yy=-2.0e-4_dp, zz=3.0e-4_dp, xy=5.0e-4_dp, yz=-1.0e-4_dp, xz=2.0e-4_dp)
    call advance(model, step_coefs(model, 0.1_dp), strain, state)
    call other%init(xx=-2.0e-3_dp, yy=1.0e-4_dp, zz=1.0e-4_dp, xy=0.0_dp, yz=2.0e-4_dp, xz=0.0_dp)
    call visco_update(model, step_coefs(model, 0.1_dp), state, other, trial_np1)

    ! freeze reads state_n, not the unconverged state_np1. Measured: 0
    elas = freeze_dt(model, 0.1_dp, state)
    expected = -(400.0_dp/0.1_dp)*(strain .ddot. iden_2O())*iden_2O() - (2.0_dp*150.0_dp/0.1_dp)*(.dev. strain)
    call check_approx(passed, "freeze after update: history stress of state_n", elas%stress_hist, expected, &
                      tol=1.0e-12_dp)
    call check_approx(passed, "update: elastic strain of state_np1", trial_np1%strain_e, other, tol=0.0_dp)
end subroutine test_states
