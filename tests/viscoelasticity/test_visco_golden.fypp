#:set VISCO = ['maxwell', 'kelvin']

module visco_golden_cases
    !! Cases of the golden test of the viscoelasticity family through the kernel API (D-018.18f): the
    !! step coefficients, the frozen algorithmic elasticity (`elas_frozen_dp` through the `elas_*`
    !! generics, 3D and 2D) and the states of Generalized Maxwell and Kelvin-Voigt
    !! (`visco_step_coefficients`, `visco_freeze`, `visco_update`, `visco_state_init`), along
    !! deterministic multi-step load histories. After every step the coefficients, the frozen
    !! elasticity, its stresses and tangents and the state are recorded.
    !!
    !! Removed with the OO layer (D-018.8): the transactional history (commit/rollback, the
    !! convenience freeze_dt/update_dt and the FEA wrapper paths, which were only checked, not
    !! recorded) and the `frozen transient` and `frozen | to_string` records (transient overloads and
    !! `to_string` of Base_elasticity).
    use, intrinsic :: iso_fortran_env, only : int64
    use muscle_kinds, only : dp
    use muscle_status, only : STATUS_OK
    use muscle_tensors, only : ten_3D2Osym, ten_2D2Osym, ten_3D4O3sym, ten_2D4O3sym, operator(.dev.)
    use muscle_elasticity_laws, only : elas_stress, elas_stress_dev, elas_dstress_dstrain, &
        elas_dstress_dstrain_dev, elas_frozen_dp
    use muscle_visco_laws, only : visco_step_coefficients, visco_freeze, visco_update, visco_n_branches, &
        visco_state_init, visco_state_dp, visco_coefs_dp, MAX_VISCO_BRANCHES, &
        ${', '.join('visco_' + m + '_dp' for m in VISCO)}$
    use muscle_test_golden, only : golden_check
    implicit none
    private

    public :: record_coefs, record_state, record_frozen, run_history, n_alt_bad, NHIST

    interface run_history
        !! Load history of a model (every viscoelastic model).
        module procedure ${', '.join('run_history_' + m for m in VISCO)}$
    end interface run_history

    integer, parameter :: NHIST = 7
        !! Number of load histories. (The eighth, dt = -0.01 then 0.1, was removed with D-017.13b: a
        !! negative time step is an error in every model; see `check_kernel_status`.)
    integer, parameter :: NHSV = 6*(MAX_VISCO_BRANCHES + 1)
        !! Length of the FEA history array (room for every branch).

    real(dp), parameter :: D1(6) = [1.0_dp, -0.4_dp, 0.2_dp, 0.6_dp, -0.2_dp, 0.1_dp]*1.0e-3_dp
        !! First strain direction (normal and shear, volumetric and deviatoric parts).
    real(dp), parameter :: D2(6) = [0.3_dp, 0.5_dp, -0.7_dp, -0.2_dp, 0.4_dp, 0.3_dp]*1.0e-3_dp
        !! Second strain direction (non-proportional paths).

    integer :: n_alt_bad = 0
        !! Checks of the kernel (status, inactive slots, state_n unchanged) that fail.

contains

    function history_names(ih) result(name)
        !! Name of the load history `ih`.
        integer, intent(in) :: ih
        character(len=:), allocatable :: name
        select case (ih)
        case (1); name = 'relaxation'
        case (2); name = 'constant rate'
        case (3); name = 'cycle with rollback'
        case (4); name = 'dt zero'
        case (5); name = 'dt large'
        case (6); name = 'dt tiny'
        case default; name = 'prestrain'
        end select
    end function history_names

    subroutine history_data(ih, eps, dts, rollback_at)
        !! Elastic strain at the end of each step, time step of each step, steps with a trial update
        !! that is rolled back before the real one.
        integer, intent(in) :: ih
        real(dp), allocatable, intent(out) :: eps(:, :), dts(:)
        logical, allocatable, intent(out) :: rollback_at(:)
        integer :: i
        select case (ih)
        case (1) ! step strain in a very short step, then hold with growing steps
            dts = [1.0e-12_dp, 0.01_dp, 0.1_dp, 1.0_dp, 10.0_dp, 100.0_dp]
            allocate(eps(6, size(dts)))
            do i = 1, size(dts)
                eps(:, i) = D1
            end do
        case (2) ! constant strain rate
            dts = [(0.05_dp, i = 1, 6)]
            allocate(eps(6, size(dts)))
            do i = 1, size(dts)
                eps(:, i) = 0.5_dp*real(i, dp)*D1
            end do
        case (3) ! non-proportional load-unload cycle through zero and compression
            dts = [(0.1_dp, i = 1, 8)]
            eps = reshape([D1, 2.0_dp*D1, D1 + D2, D2, 0.0_dp*D1, -D1, -2.0_dp*D1 + D2, 0.0_dp*D1], [6, 8])
        case (4) ! dt = 0 with and without a strain change
            dts = [0.1_dp, 0.0_dp, 0.0_dp, 0.1_dp]
            eps = reshape([D1, 2.0_dp*D1, 2.0_dp*D1, 2.0_dp*D1], [6, 4])
        case (5) ! dt much larger than every relaxation time
            dts = [1.0e6_dp, 1.0e6_dp, 1.0e6_dp]
            eps = reshape([D1, D1, D2], [6, 3])
        case (6) ! dt much smaller; the last two around the series switch x = 1e-5 of tau = 1
            dts = [1.0e-14_dp, 1.0e-14_dp, 9.99e-6_dp, 1.001e-5_dp]
            eps = reshape([D1, 1.001_dp*D1, D2, D2], [6, 4])
        case default ! (7) history initialised with a nonzero elastic strain (D2)
            dts = [0.2_dp, 0.2_dp, 0.2_dp]
            eps = reshape([D2, D1, D1], [6, 3])
        end select
        allocate(rollback_at(size(dts)))
        rollback_at = .false.
        if (ih == 3) rollback_at([3, 6]) = .true.
    end subroutine history_data

    function coefs_vals(c) result(v)
        !! Every component of the step coefficients (all branch slots).
        type(visco_coefs_dp), intent(in) :: c
        real(dp) :: v(3 + 2*MAX_VISCO_BRANCHES)
        v = [c%dt, c%k_alg, c%g_alg, c%decay, c%weight]
    end function coefs_vals

    function state_active(s) result(v)
        !! Recorded part of a state: n_branches, strain_e and the active history tensors. The
        !! inactive slots are checked to be zero (`check_inactive`), not recorded.
        type(visco_state_dp), intent(in) :: s
        real(dp), allocatable :: v(:)
        integer :: n
        n = min(max(s%n_branches, 0), MAX_VISCO_BRANCHES)
        v = [real(s%n_branches, dp), s%strain_e%vals, reshape(s%h(:, 1:n), [6*n])]
    end function state_active

    subroutine check_inactive(key, s)
        !! The history slots beyond n_branches stay zero (no model writes them).
        character(len=*), intent(in) :: key
        type(visco_state_dp), intent(in) :: s
        integer :: n
        n = min(max(s%n_branches, 0), MAX_VISCO_BRANCHES)
        if (any(s%h(:, n+1:) /= 0.0_dp)) then
            print '(a)', ' FAIL: inactive history slots written: ' // key
            n_alt_bad = n_alt_bad + 1
        end if
    end subroutine check_inactive

    subroutine record_coefs(key, c)
        character(len=*), intent(in) :: key
        type(visco_coefs_dp), intent(in) :: c
        call golden_check(key, coefs_vals(c))
    end subroutine record_coefs

    subroutine record_state(key, state_n, state_np1)
        !! Both states of a step (the converged one and the one being computed).
        character(len=*), intent(in) :: key
        type(visco_state_dp), intent(in) :: state_n, state_np1
        call golden_check(key // ' | state_n', state_active(state_n))
        call golden_check(key // ' | state_np1', state_active(state_np1))
        call check_inactive(key // ' state_n', state_n)
        call check_inactive(key // ' state_np1', state_np1)
    end subroutine record_state

    function fea_array(s) result(hsv)
        !! The FEA history array of a state in the layout of the retired `pack_to_fea`: strain_e,
        !! then the history tensor of each active branch, the rest zero.
        type(visco_state_dp), intent(in) :: s
        real(dp) :: hsv(6*(MAX_VISCO_BRANCHES + 1))
        integer :: n
        n = s%n_branches
        hsv = 0.0_dp
        hsv(1:6) = s%strain_e%vals
        hsv(7:6*(n + 1)) = reshape(s%h(:, 1:n), [6*n])
    end function fea_array

    subroutine record_frozen(key, elas, eps, tangents)
        !! Frozen elasticity at the elastic strain `eps` of the step: its parameters (bulk, shear,
        !! history stress), stress and deviatoric stress in 3D and 2D (2D strain = in-plane components
        !! 11, 22, 33, 12 of `eps`) and optionally the tangents. The 2D deviatoric stress is `.dev.` of
        !! the 2D stress, as the historical OO type inherited it from Base_elasticity (the kernel
        !! `elas_stress_dev` in 2D gives the same value up to rounding, checked in test_visco_kinds).
        character(len=*), intent(in) :: key
        type(elas_frozen_dp), intent(in) :: elas
        real(dp), intent(in) :: eps(6)
        logical, intent(in) :: tangents
        type(ten_3D2Osym) :: e3, s3, t3
        type(ten_2D2Osym) :: e2, s2, sd2
        type(ten_3D4O3sym) :: c3, cd3
        type(ten_2D4O3sym) :: c2

        call e3%init(eps)
        call e2%init(eps(1:4))
        s3 = elas_stress(elas, e3)
        t3 = elas_stress_dev(elas, e3)
        s2 = elas_stress(elas, e2)
        sd2 = .dev. s2
        call golden_check(key // ' | frozen stress', [elas%k_alg, elas%g_alg, elas%stress_hist%vals, s3%vals, &
            t3%vals, s2%vals, sd2%vals])
        if (.not. tangents) return
        c3 = elas_dstress_dstrain(elas, e3)
        cd3 = elas_dstress_dstrain_dev(elas, e3)
        c2 = elas_dstress_dstrain(elas, e2)
        call golden_check(key // ' | frozen tangents', [c3%vals, cd3%vals, c2%vals])
    end subroutine record_frozen

    subroutine expect_ok(key, status)
        !! The kernel status of a step must be STATUS_OK.
        character(len=*), intent(in) :: key
        integer, intent(in) :: status
        if (status /= STATUS_OK) then
            print '(a, i0)', ' FAIL: kernel status of ' // key // ': ', status
            n_alt_bad = n_alt_bad + 1
        end if
    end subroutine expect_ok
#:for m in VISCO

    subroutine run_history_${m}$(key, vm, ih)
        !! Runs the load history `ih` on the ${m}$ model `vm`, as a material does (coefficients once
        !! per step, freeze from state_n, update with the converged elastic strain), recording after
        !! every step; the FEA array (layout of the retired `pack_to_fea`) at the last step.
        character(len=*), intent(in) :: key
        type(visco_${m}$_dp), intent(in) :: vm
        integer, intent(in) :: ih
        real(dp), allocatable :: eps(:, :), dts(:)
        logical, allocatable :: rollback_at(:)
        type(visco_state_dp) :: state_n, state_np1, trial_np1
        type(visco_coefs_dp) :: coefs
        type(elas_frozen_dp) :: elas
        type(ten_3D2Osym) :: e3, trial
        real(dp) :: eps_n(6)
        integer :: i, status
        character(len=:), allocatable :: kk, ks
        character(len=160) :: buf

        kk = key // ' | ' // history_names(ih)
        call history_data(ih, eps, dts, rollback_at)
        if (ih == 7) then
            call e3%init(eps(:, 1))
            call visco_state_init(state_n, visco_n_branches(vm), status, e3)
        else
            call visco_state_init(state_n, visco_n_branches(vm), status)
        end if
        call expect_ok(kk // ' state init', status)
        state_np1 = state_n
        call record_state(kk // ' | step 0', state_n, state_np1)

        do i = 1, size(dts)
            write(buf, '(a, " | step ", i0)') kk, i
            ks = trim(buf)
            eps_n = state_n%strain_e%vals
            call e3%init(eps(:, i))
            call visco_step_coefficients(vm, dts(i), coefs, status)
            call expect_ok(ks // ' coefficients', status)
            call golden_check(ks // ' | dstrain_e, dt, coefficients', [eps(:, i) - eps_n, dts(i), &
                coefs_vals(coefs)])

            elas = visco_freeze(vm, coefs, state_n)
            call record_frozen(ks, elas, eps(:, i), tangents=(i == 1 .or. i == size(dts)))

            if (rollback_at(i)) then
                ! A failed global attempt: the update with a trial strain (discarded).
                call trial%init(3.0_dp*eps(:, i) + D2)
                call visco_update(vm, coefs, state_n, trial, trial_np1)
                call golden_check(ks // ' | trial state_np1', state_active(trial_np1))
            end if

            call visco_update(vm, coefs, state_n, e3, state_np1)
            call golden_check(ks // ' | state_np1 after update', state_active(state_np1))
            call check_inactive(ks // ' state_np1 after update', state_np1)
            if (i == size(dts)) call golden_check(ks // ' | FEA array', fea_array(state_np1))
            state_n = state_np1
        end do
    end subroutine run_history_${m}$
#:endfor

end module visco_golden_cases

program test_visco_golden
    !! Golden (characterization) test of the viscoelasticity family in double precision, bit for
    !! bit against tests/reference/viscoelasticity/viscoelasticity_dp.txt, captured from the
    !! original OO code (regenerate.sh there) and reproduced by the kernel API (D-018.18f): the
    !! initializers `visco_maxwell_init`, `visco_maxwell_init_normalized`, `visco_kelvin_init`, the
    !! family generics of muscle_visco_laws and the frozen elasticity `elas_frozen_dp`.
    !!
    !! Exit codes: 1-4 from `golden_finish` (muscle_test_golden); 5: a kernel status is not the
    !! expected one, or an inactive history slot was written.
    !!
    !! D-017.13b (approved change): a negative time step is an error in every model, so the Maxwell
    !! records with dt < 0 (the former load history 8 and the dt = -0.01 entry of the coefficient
    !! tables) were removed from the reference and replaced by checks of the kernel status
    !! (`check_kernel_status`, not recorded): dt < 0 gives STATUS_INVALID_TIME_STEP in both models,
    !! dt = 0 is valid in Maxwell and an error in Kelvin-Voigt.
    use muscle_kinds, only : dp
    use muscle_tensors, only : ten_3D2Osym
    use muscle_status, only : STATUS_OK, STATUS_INVALID_TIME_STEP
    use muscle_visco_laws, only : visco_step_coefficients, visco_n_branches, visco_state_dp, visco_coefs_dp, &
        elas_frozen_dp, MAX_VISCO_BRANCHES, visco_maxwell_dp, visco_kelvin_dp
    use muscle_visco_maxwell, only : visco_maxwell_init, visco_maxwell_init_normalized, &
        visco_maxwell_relaxation_shear, visco_maxwell_shear_instantaneous
    use muscle_visco_kelvin, only : visco_kelvin_init
    use muscle_test_golden, only : golden_init, golden_check, golden_finish
    use visco_golden_cases, only : record_coefs, record_state, record_frozen, run_history, &
        n_alt_bad, NHIST
    implicit none

    real(dp), parameter :: DT_LIST(10) = [0.0_dp, 1.0e-14_dp, 9.99e-6_dp, 1.0e-5_dp, 1.001e-5_dp, &
        1.0e-3_dp, 1.0_dp, 1.0e3_dp, 1.0e12_dp, -0.01_dp]
        !! Time steps of the coefficient tables (Maxwell; Kelvin only the positive ones).
    real(dp), parameter :: T_LIST(8) = [0.0_dp, 1.0e-6_dp, 0.1_dp, 1.0_dp, 10.0_dp, 1.0e6_dp, &
        1.0e300_dp, -1.0_dp]
        !! Times of the relaxation modulus.
    real(dp), parameter :: KV(4, 5) = reshape([ &
        0.0_dp, 0.0_dp, 0.0_dp, 0.0_dp, &           ! placeholder of the unset object (not used)
        2000.0_dp, 100.0_dp, 50.0_dp, 20.0_dp, &    ! K, G, zeta, mu_v
        2000.0_dp, 100.0_dp, 0.0_dp, 0.0_dp, &      ! no dashpot: elastic
        2000.0_dp, 100.0_dp, 1000.0_dp, 0.0_dp, &   ! volumetric dashpot only
        0.0_dp, 0.0_dp, 30.0_dp, 5.0_dp], [4, 5])   ! no spring: pure dashpot
        !! Kelvin-Voigt parameter sets (bulk, shear, bulk_viscosity, shear_viscosity).

    type(visco_maxwell_dp) :: gm, gm_unset
    type(visco_kelvin_dp) :: kv_model, kv_unset
    type(visco_state_dp) :: state_default
    type(visco_coefs_dp) :: coefs_default, c
    type(elas_frozen_dp) :: frozen
    type(ten_3D2Osym) :: hs
    real(dp), allocatable :: r(:)
    real(dp) :: tau10(MAX_VISCO_BRANCHES), g10(MAX_VISCO_BRANCHES)
    character(len=48) :: key
    integer :: im, ih, i, status

    call golden_init('viscoelasticity/viscoelasticity_dp.txt')

    ! Default-initialised containers and frozen elasticity.
    call record_state('defaults | history', state_default, state_default)
    call record_coefs('defaults | coefficients', coefs_default)
    call record_frozen('defaults | frozen', frozen, D_1(), .true.)
    ! Frozen elasticity set directly (as visco_freeze does).
    call hs%init([10.0_dp, -20.0_dp, 30.0_dp, -4.0_dp, 5.0_dp, -6.0_dp])
    frozen = elas_frozen_dp(k_alg=1500.0_dp, g_alg=250.0_dp, stress_hist=hs)
    call record_frozen('set | frozen', frozen, D_1(), .true.)
    frozen = elas_frozen_dp(k_alg=0.0_dp, g_alg=0.0_dp, stress_hist=hs)
    call record_frozen('set zero moduli | frozen', frozen, D_1(), .true.)

    ! Generalized Maxwell: parameter sets.
    do i = 1, MAX_VISCO_BRANCHES
        tau10(i) = 10.0_dp**(i - 5)
        g10(i) = 10.0_dp*real(i, dp)
    end do
    do im = 0, 9
        select case (im)
        case (0) ! default object (set_parameters never called)
            gm = gm_unset
        case (1) ! no branches: elastic
            call visco_maxwell_init(gm, bulk=2000.0_dp, shear_inf=100.0_dp, shear=[real(dp) ::], tau=[real(dp) ::], status=status)
        case (2) ! standard linear solid
            call visco_maxwell_init(gm, bulk=2000.0_dp, shear_inf=100.0_dp, shear=[300.0_dp], tau=[1.0_dp], status=status)
        case (3) ! single Maxwell element (fluid), G_inf = 0
            call visco_maxwell_init(gm, bulk=2000.0_dp, shear_inf=0.0_dp, shear=[500.0_dp], tau=[0.5_dp], status=status)
        case (4) ! two branches
            call visco_maxwell_init(gm, bulk=2000.0_dp, shear_inf=100.0_dp, shear=[200.0_dp, 300.0_dp], &
                tau=[0.1_dp, 1.0_dp], status=status)
        case (5) ! three branches with very different relaxation times, G_inf = 0
            call visco_maxwell_init(gm, bulk=2000.0_dp, shear_inf=0.0_dp, shear=[100.0_dp, 1000.0_dp, 10.0_dp], &
                tau=[1.0e-6_dp, 1.0_dp, 1.0e6_dp], status=status)
        case (6) ! MAX_VISCO_BRANCHES branches, tau = 1e-4 .. 1e5
            call visco_maxwell_init(gm, bulk=2000.0_dp, shear_inf=50.0_dp, shear=g10, tau=tau10, status=status)
        case (7) ! normalized (Abaqus) Prony series
            call visco_maxwell_init_normalized(gm, young=1000.0_dp, poisson=0.3_dp, g=[0.3_dp, 0.5_dp], &
                tau=[0.2_dp, 5.0_dp], status=status)
        case (8) ! normalized, sum(g) = 1: Maxwell fluid
            call visco_maxwell_init_normalized(gm, young=1000.0_dp, poisson=0.3_dp, g=[0.25_dp, 0.75_dp], &
                tau=[1.0_dp, 10.0_dp], status=status)
        case default ! re-initialisation with fewer branches: the unused slots must be reset
            call visco_maxwell_init(gm, bulk=2000.0_dp, shear_inf=50.0_dp, shear=g10, tau=tau10, status=status)
            call visco_maxwell_init(gm, bulk=3000.0_dp, shear_inf=100.0_dp, shear=[300.0_dp], tau=[2.0_dp], status=status)
        end select
        write(key, '(a, i0)') 'maxwell ', im
        if (im > 0) call expect(trim(key) // ' init', status, STATUS_OK)
        r = [real(visco_n_branches(gm), dp), visco_maxwell_shear_instantaneous(gm)]
        do i = 1, size(T_LIST)
            r = [r, visco_maxwell_relaxation_shear(gm, T_LIST(i))]
        end do
        call golden_check(trim(key) // ' | n_branches, G0, G(t)', r)
        r = [real(dp) ::]
        do i = 1, size(DT_LIST)
            if (DT_LIST(i) < 0.0_dp) cycle ! an error since D-017.13b (check_kernel_status)
            call visco_step_coefficients(gm, DT_LIST(i), c, status)
            call expect(trim(key) // ' coefficients', status, STATUS_OK)
            r = [r, coefs_table(c)]
        end do
        call golden_check(trim(key) // ' | coefficients table', r)
        do ih = 1, NHIST
            call run_history(trim(key), gm, ih)
        end do
    end do
    call check_kernel_status()

    ! Kelvin-Voigt: parameter sets (dt = 0 is an error: history 4 not run).
    do im = 1, size(KV, 2)
        if (im == 1) then
            kv_model = kv_unset
        else
            call visco_kelvin_init(kv_model, bulk=KV(1, im), shear=KV(2, im), bulk_viscosity=KV(3, im), &
                shear_viscosity=KV(4, im), status=status)
        end if
        write(key, '(a, i0)') 'kelvin ', im - 1
        if (im > 1) call expect(trim(key) // ' init', status, STATUS_OK)
        r = [real(visco_n_branches(kv_model), dp)]
        do i = 1, size(DT_LIST)
            if (DT_LIST(i) > 0.0_dp) then
                call visco_step_coefficients(kv_model, DT_LIST(i), c, status)
                call expect(trim(key) // ' coefficients', status, STATUS_OK)
                r = [r, coefs_table(c)]
            end if
        end do
        call golden_check(trim(key) // ' | n_branches, coefficients table', r)
        do ih = 1, NHIST
            if (ih == 4) cycle ! dt = 0
            call run_history(trim(key), kv_model, ih)
        end do
    end do
    ! Re-initialisation of a Kelvin-Voigt object.
    call visco_kelvin_init(kv_model, bulk=1.0_dp, shear=2.0_dp, bulk_viscosity=3.0_dp, shear_viscosity=4.0_dp, status=status)
    call visco_kelvin_init(kv_model, bulk=KV(1, 2), shear=KV(2, 2), bulk_viscosity=KV(3, 2), &
        shear_viscosity=KV(4, 2), status=status)
    call run_history('kelvin reinit', kv_model, 3)

    call golden_finish()
    if (n_alt_bad > 0) stop 5

contains

    subroutine check_kernel_status()
        !! D-017.13b: status of `visco_step_coefficients` with dt < 0 (the time steps of the former
        !! load history 8 and of the coefficient tables) and dt = 0, for the default parameters and a parameter set of
        !! each model; on an error the coefficients keep their default values.
        type(visco_maxwell_dp) :: pm(2)
        type(visco_kelvin_dp) :: pk(2)
        type(visco_coefs_dp) :: c, c_default
        integer :: j

        call visco_maxwell_init(pm(2), bulk=2000.0_dp, shear_inf=100.0_dp, shear=[300.0_dp], tau=[1.0_dp], &
            status=status)
        call expect('maxwell init', status, STATUS_OK)
        call visco_kelvin_init(pk(2), bulk=KV(1, 2), shear=KV(2, 2), bulk_viscosity=KV(3, 2), &
            shear_viscosity=KV(4, 2), status=status)
        call expect('kelvin init', status, STATUS_OK)
        do j = 1, 2
            call visco_step_coefficients(pm(j), -0.01_dp, c, status)
            call expect('maxwell dt < 0', status, STATUS_INVALID_TIME_STEP)
            if (any(coefs_table(c) /= coefs_table(c_default))) call expect('maxwell dt < 0 coefs', 1, 0)
            call visco_step_coefficients(pm(j), 0.0_dp, c, status)
            call expect('maxwell dt = 0', status, STATUS_OK)
            call visco_step_coefficients(pk(j), -0.01_dp, c, status)
            call expect('kelvin dt < 0', status, STATUS_INVALID_TIME_STEP)
            if (any(coefs_table(c) /= coefs_table(c_default))) call expect('kelvin dt < 0 coefs', 1, 0)
            call visco_step_coefficients(pk(j), 0.0_dp, c, status)
            call expect('kelvin dt = 0', status, STATUS_INVALID_TIME_STEP)
        end do
    end subroutine check_kernel_status

    subroutine expect(what, got, expected)
        !! Counts a kernel status that is not the expected one as a failed alternative path.
        character(len=*), intent(in) :: what
        integer, intent(in) :: got, expected
        if (got /= expected) then
            print '(a, i0, a, i0)', ' FAIL: kernel status of ' // what // ': ', got, ', expected ', expected
            n_alt_bad = n_alt_bad + 1
        end if
    end subroutine expect

    function D_1() result(v)
        !! First strain direction of the load histories.
        real(dp) :: v(6)
        v = [1.0_dp, -0.4_dp, 0.2_dp, 0.6_dp, -0.2_dp, 0.1_dp]*1.0e-3_dp
    end function D_1

    function coefs_table(c) result(v)
        type(visco_coefs_dp), intent(in) :: c
        real(dp) :: v(3 + 2*MAX_VISCO_BRANCHES)
        v = [c%dt, c%k_alg, c%g_alg, c%decay, c%weight]
    end function coefs_table

end program test_visco_golden
