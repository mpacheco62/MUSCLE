#:include "muscle_models_common.fypp"
#!
#! Kernel API of the elastic family (D-017.12) in every kind and dimension, through the generics of
#! muscle_elasticity_laws:
#! - the linear model against Hooke law written here on full 3x3 / 3x3x3x3 tensors, in dp from the
#!   same inputs (sp inputs converted to dp): stress, deviatoric stress, tangent and deviatoric
#!   tangent (assembled on the fly, D-017.12e), for several E, nu;
#! - 2D vs 3D (dims-2d-3d.md, nu = 0.25 and 0.49): every 2D function equals the 3D one of the embedded strain
#!   (11, 22, 33, 12, 0, 0): the stresses with zero out-of-plane shears, each stored 2D tangent
#!   component equals the 3D component of the same indices, and C2 : p2 embedded = C3 : p3;
#! - nu = 1/2 (D-017.12b): the full stress and the tangent are not finite (lambda = +Inf), the
#!   deviatoric stress and tangent are finite and analytic (D-017.12a/c), in every kind;
#! - the family generics against the dp specific functions, bit for bit;
#! - `pure`, `@:DEVICE()` point procedures that call the generics (stress and tangent).
#! Tolerances, relative to the largest component of the stress (or of the tangent) of the same case:
#! dp TOL_APPROX_dp (rounding of the formulas, measured ~1e-16), sp TOL_APPROX_sp (sp rounding of
#! lambda, mu and the sums: measured ~1e-7, nu = 0.49 amplifies 1 - 2 nu).
#:set ELAS_PRM = [('210000.0', '0.3'), ('70000.0', '0.0'), ('1000.0', '0.49'), ('1.0', '-0.5')]

module test_elas_point
    !! Point procedures (kernels) that call the elastic generics, for every kind and dimension.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_tensors, only : ${', '.join(tname(d + F, k) for d in DIMS for F in ('2Osym', '4O3sym') for k in REAL_KINDS)}$
    use muscle_elasticity_laws, only : elas_stress, elas_dstress_dstrain, ${', '.join('elas_linear_' + k for k in REAL_KINDS)}$
    implicit none
    private

#:for k in REAL_KINDS
#:for d in DIMS
    public :: point_${d}$_${k}$
#:endfor
#:endfor

contains
#:for k in REAL_KINDS
#:for d in DIMS

    pure subroutine point_${d}$_${k}$(prm, eps, sig, c)
        !! What an elastic predictor computes at a point in `real(${k}$)`, ${d}$: stress and tangent.
        implicit none
        @:DEVICE()
        type(elas_linear_${k}$), intent(in) :: prm
            !! Parameters.
        type(${tname(d + '2Osym', k)}$), intent(in) :: eps
            !! Strain.
        type(${tname(d + '2Osym', k)}$), intent(out) :: sig
            !! Stress.
        type(${tname(d + '4O3sym', k)}$), intent(out) :: c
            !! Tangent.

        sig = elas_stress(prm, eps)
        c = elas_dstress_dstrain(prm, eps)
    end subroutine point_${d}$_${k}$
#:endfor
#:endfor

end module test_elas_point

module test_elas_cases
    use, intrinsic :: iso_fortran_env, only : int64
    use, intrinsic :: ieee_arithmetic, only : ieee_is_finite
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$, ${', '.join('TOL_APPROX_' + k for k in REAL_KINDS)}$
    use muscle_tensors, only : ${', '.join(tname(d + F, k) for d in DIMS for F in ('2Osym', '4O3sym') for k in REAL_KINDS)}$, &
        operator(.ddot.), operator(*)
    use muscle_elasticity_laws, only : elas_stress, elas_stress_dev, elas_dstress_dstrain, elas_dstress_dstrain_dev, &
        ${', '.join('elas_linear_' + k for k in REAL_KINDS)}$
    use muscle_elasticity_linear, only : elas_linear_init, &
        ${', '.join(model_specific('elas', f.name, 'linear', 'dp', d) for f in model_family('elas').funcs for d in DIMS)}$
    use test_elas_point, only : ${', '.join('point_{}_{}'.format(d, k) for k in REAL_KINDS for d in DIMS)}$
    use muscle_test_utils, only : check_true, check_scaled
    implicit none
    private

    public :: run_all

    integer, parameter :: NSTRAIN = 4
        !! Strain states per dimension.

contains

    pure real(dp) function dl(i, j)
        !! Kronecker delta.
        integer, intent(in) :: i, j
        dl = merge(1.0_dp, 0.0_dp, i == j)
    end function dl

    pure subroutine lame(young, poisson, lam, mu)
        !! Lame parameters (dp reference).
        real(dp), intent(in) :: young, poisson
        real(dp), intent(out) :: lam, mu
        lam = young*poisson/((1.0_dp + poisson)*(1.0_dp - 2.0_dp*poisson))
        mu = young/(2.0_dp*(1.0_dp + poisson))
    end subroutine lame

    pure real(dp) function ref_sigma(e, lam, mu, i, j, dev)
        !! Hooke: sigma_ij = lambda tr(e) delta_ij + 2 mu e_ij, or its deviatoric part.
        real(dp), intent(in) :: e(3, 3), lam, mu
        integer, intent(in) :: i, j
        logical, intent(in) :: dev
        real(dp) :: tr
        tr = e(1, 1) + e(2, 2) + e(3, 3)
        if (dev) then
            ref_sigma = 2.0_dp*mu*(e(i, j) - tr/3.0_dp*dl(i, j))
        else
            ref_sigma = lam*tr*dl(i, j) + 2.0_dp*mu*e(i, j)
        end if
    end function ref_sigma

    pure real(dp) function ref_c(lam, mu, i, j, k, l, dev)
        !! C_ijkl = lambda d_ij d_kl + mu (d_ik d_jl + d_il d_jk), or 2 mu (I^S - d_ij d_kl/3).
        real(dp), intent(in) :: lam, mu
        integer, intent(in) :: i, j, k, l
        logical, intent(in) :: dev
        if (dev) then
            ref_c = mu*(dl(i, k)*dl(j, l) + dl(i, l)*dl(j, k)) - 2.0_dp*mu/3.0_dp*dl(i, j)*dl(k, l)
        else
            ref_c = lam*dl(i, j)*dl(k, l) + mu*(dl(i, k)*dl(j, l) + dl(i, l)*dl(j, k))
        end if
    end function ref_c

    subroutine compare(passed, label, got, expected, tol)
        !! Component-wise check relative to the largest expected component (a deviator that cancels
        !! is compared with the scale of the full result through `expected` of the caller).
        logical, intent(inout) :: passed
        character(len=*), intent(in) :: label
        real(dp), intent(in) :: got(:), expected(:), tol
        real(dp) :: sc
        integer :: i
        sc = maxval(abs(expected))
        do i = 1, size(got)
            call check_scaled(passed, label, got(i), expected(i), sc, tol)
        end do
    end subroutine compare

    logical function same_bits(a, b)
        !! Bitwise equality of two dp arrays.
        real(dp), intent(in) :: a(:), b(:)
        same_bits = size(a) == size(b)
        if (same_bits) same_bits = all(transfer(a, 1_int64, size(a)) == transfer(b, 1_int64, size(b)))
    end function same_bits

    pure function strain_vals(n, nc) result(v)
        !! Components (storage order, 11 22 33 12 [23 13]) of the strain state n.
        integer, intent(in) :: n, nc
        real(dp) :: v(nc), w(6)
        select case (n)
        case (1) ! general
            w = [1.0e-3_dp, -3.0e-4_dp, 5.5e-4_dp, 2.5e-4_dp, -1.25e-4_dp, 7.5e-4_dp]
        case (2) ! volumetric (deviator 0)
            w = [2.0e-3_dp, 2.0e-3_dp, 2.0e-3_dp, 0.0_dp, 0.0_dp, 0.0_dp]
        case (3) ! pure shear
            w = [0.0_dp, 0.0_dp, 0.0_dp, 1.5e-2_dp, 0.0_dp, 0.0_dp]
        case default ! large
            w = [0.25_dp, -0.125_dp, 0.0625_dp, 0.5_dp, 0.375_dp, -0.25_dp]
        end select
        v = w(1:nc)
    end function strain_vals
#:for k in REAL_KINDS
#:for d in DIMS
#:set L2 = layout('2Osym', d)
#:set L4 = layout('4O3sym', d)
#:set T2 = tname(d + '2Osym', k)
#:set T4 = tname(d + '4O3sym', k)

    subroutine test_analytic_${d}$_${k}$(passed)
        !! `real(${k}$)` ${d}$ functions against Hooke law (dp reference from the same inputs).
        logical, intent(inout) :: passed
        real(${k}$), parameter :: YOUNG(${len(ELAS_PRM)}$) = [${', '.join(p[0] + '_' + k for p in ELAS_PRM)}$]
        real(${k}$), parameter :: NU(${len(ELAS_PRM)}$) = [${', '.join(p[1] + '_' + k for p in ELAS_PRM)}$]
        type(elas_linear_${k}$) :: prm
        type(${T2}$) :: eps, s, sd, sp_
        type(${T4}$) :: c, cd, cp_
        real(dp) :: e(3, 3), lam, mu, rs(${len(L2.comps)}$), rsd(${len(L2.comps)}$), rc(${len(L4.comps)}$), rcd(${len(L4.comps)}$)
        real(dp), parameter :: TOL = real(TOL_APPROX_${k}$, dp)
        character(len=64) :: lab
        integer :: ip, n

        do ip = 1, size(YOUNG)
            call lame(real(YOUNG(ip), dp), real(NU(ip), dp), lam, mu)
            call elas_linear_init(prm, YOUNG(ip), NU(ip))
            do n = 1, NSTRAIN
                write(lab, '(a, i0, a, i0)') '${d}$ ${k}$ E,nu #', ip, ' strain ', n
                eps%vals = real(strain_vals(n, ${len(L2.comps)}$), ${k}$)
                e = 0.0_dp
#:for c in L2.comps
                e(${c.idx[0]}$, ${c.idx[1]}$) = real(eps%vals(${c.pos[0]}$), dp)
                e(${c.idx[1]}$, ${c.idx[0]}$) = real(eps%vals(${c.pos[0]}$), dp)
#:endfor
#:for c in L2.comps
                rs(${c.pos[0]}$) = ref_sigma(e, lam, mu, ${c.idx[0]}$, ${c.idx[1]}$, .false.)
                rsd(${c.pos[0]}$) = ref_sigma(e, lam, mu, ${c.idx[0]}$, ${c.idx[1]}$, .true.)
#:endfor
#:for c in L4.comps
                rc(${c.pos[0]}$) = ref_c(lam, mu, ${', '.join(map(str, c.idx))}$, .false.)
                rcd(${c.pos[0]}$) = ref_c(lam, mu, ${', '.join(map(str, c.idx))}$, .true.)
#:endfor
                s = elas_stress(prm, eps)
                sd = elas_stress_dev(prm, eps)
                c = elas_dstress_dstrain(prm, eps)
                cd = elas_dstress_dstrain_dev(prm, eps)
                call compare(passed, trim(lab) // ' stress', real(s%vals, dp), rs, TOL)
                ! deviator at the scale of the stress (it cancels for a volumetric strain)
                call compare(passed, trim(lab) // ' stress_dev', [real(sd%vals, dp), maxval(abs(rs))], &
                    [rsd, maxval(abs(rs))], TOL)
                call compare(passed, trim(lab) // ' dstress_dstrain', real(c%vals, dp), rc, TOL)
                call compare(passed, trim(lab) // ' dstress_dstrain_dev', real(cd%vals, dp), rcd, TOL)
                ! point procedure (pure, @:DEVICE()) = generics, bit for bit
                call point_${d}$_${k}$(prm, eps, sp_, cp_)
                call check_true(passed, trim(lab) // ' point procedure = generics', &
                    all(sp_%vals == s%vals) .and. all(cp_%vals == c%vals))
            end do
        end do
    end subroutine test_analytic_${d}$_${k}$
#:endfor

    subroutine test_embedding_${k}$(passed)
        !! 2D vs 3D (dims-2d-3d.md) in `real(${k}$)`: each 2D function equals the 3D one of the
        !! embedded strain (11, 22, 33, 12, 0, 0).
        logical, intent(inout) :: passed
        type(elas_linear_${k}$) :: prm
        type(${tname('2D2Osym', k)}$) :: e2, s2, p2, q2
        type(${tname('3D2Osym', k)}$) :: e3, s3, p3, q3
        type(${tname('2D4O3sym', k)}$) :: c2
        type(${tname('3D4O3sym', k)}$) :: c3
        real(dp), parameter :: TOL = real(TOL_APPROX_${k}$, dp)
        real(dp) :: sc
        character(len=64) :: lab
        real(${k}$), parameter :: NUS(2) = [0.25_${k}$, 0.49_${k}$]
            !! Poisson ratios (0.49: lambda/mu ~ 50).
        integer :: n, idev, inu

        p2%vals = [0.7_${k}$, -1.3_${k}$, 0.4_${k}$, 0.9_${k}$]
        p3%vals = [p2%vals, 0.0_${k}$, 0.0_${k}$]
        do inu = 1, size(NUS)
            call elas_linear_init(prm, 1000.0_${k}$, NUS(inu))
            do n = 1, NSTRAIN
                write(lab, '(a, f4.2, a, i0)') '${k}$ embedding, nu ', NUS(inu), ', strain ', n
                e2%vals = real(strain_vals(n, 4), ${k}$)
                e3%vals = [e2%vals, 0.0_${k}$, 0.0_${k}$]
                s3 = elas_stress(prm, e3)
                sc = maxval(abs(real(s3%vals, dp)))
                s2 = elas_stress(prm, e2)
                call compare(passed, trim(lab) // ' stress', [real(s2%vals, dp), 0.0_dp, 0.0_dp, sc], &
                    [real(s3%vals, dp), sc], TOL)
                s2 = elas_stress_dev(prm, e2)
                s3 = elas_stress_dev(prm, e3)
                call compare(passed, trim(lab) // ' stress_dev', [real(s2%vals, dp), 0.0_dp, 0.0_dp, sc], &
                    [real(s3%vals, dp), sc], TOL)
                do idev = 0, 1
                    if (idev == 0) then
                        c2 = elas_dstress_dstrain(prm, e2)
                        c3 = elas_dstress_dstrain(prm, e3)
                    else
                        c2 = elas_dstress_dstrain_dev(prm, e2)
                        c3 = elas_dstress_dstrain_dev(prm, e3)
                    end if
                    ! every stored 2D component = the 3D component of the same indices
                    call compare(passed, trim(lab) // merge(' dstress_dstrain_dev', ' dstress_dstrain    ', idev == 1) &
                        // ' components', real(c2%vals, dp), real([ &
#:for n, c in enumerate(layout('4O3sym', '2D').comps)
                        c3%vals(${layout('4O3sym', '3D').index(*c.idx)[0]}$)${',' if n < len(layout('4O3sym', '2D').comps) - 1 else ''}$ &
#:endfor
                        ], dp), TOL)
                    ! C2 : p2 embedded = C3 : p3
                    q2 = c2 .ddot. p2
                    q3 = c3 .ddot. p3
                    call compare(passed, trim(lab) // merge(' dstress_dstrain_dev', ' dstress_dstrain    ', idev == 1) &
                        // ' : probe', [real(q2%vals, dp), 0.0_dp, 0.0_dp], real(q3%vals, dp), TOL)
                end do
            end do
        end do
    end subroutine test_embedding_${k}$

    subroutine test_incompressible_${k}$(passed)
        !! nu = 1/2 in `real(${k}$)` (D-017.12b, D-017.12a/c): lambda = +Inf, so the normal components
        !! of the full stress and the lambda entries of the tangent are not finite, while the shears,
        !! the deviatoric stress and the deviatoric tangent (only mu) are finite and equal to the
        !! analytic ones.
        logical, intent(inout) :: passed
        type(elas_linear_${k}$) :: prm
        real(dp), parameter :: TOL = real(TOL_APPROX_${k}$, dp)
        real(dp) :: e(3, 3), lam, mu
#:for d in DIMS
#:set L2 = layout('2Osym', d)
#:set L4 = layout('4O3sym', d)
        type(${tname(d + '2Osym', k)}$) :: eps_${d}$, s_${d}$
        type(${tname(d + '4O3sym', k)}$) :: c_${d}$
        real(dp) :: rsd_${d}$(${len(L2.comps)}$), rcd_${d}$(${len(L4.comps)}$)
#:endfor

        call elas_linear_init(prm, 1000.0_${k}$, 0.5_${k}$)
        call lame(1000.0_dp, 0.5_dp, lam, mu)
        call check_true(passed, '${k}$ nu = 0.5: lambda = +Inf', lam > huge(1.0_dp))
#:for d in DIMS
#:set L2 = layout('2Osym', d)
#:set L4 = layout('4O3sym', d)
        eps_${d}$%vals = real(strain_vals(1, ${len(L2.comps)}$), ${k}$)
        e = 0.0_dp
#:for c in L2.comps
        e(${c.idx[0]}$, ${c.idx[1]}$) = real(eps_${d}$%vals(${c.pos[0]}$), dp)
        e(${c.idx[1]}$, ${c.idx[0]}$) = real(eps_${d}$%vals(${c.pos[0]}$), dp)
#:endfor
#:for c in L2.comps
        rsd_${d}$(${c.pos[0]}$) = ref_sigma(e, lam, mu, ${c.idx[0]}$, ${c.idx[1]}$, .true.)
#:endfor
#:for c in L4.comps
        rcd_${d}$(${c.pos[0]}$) = ref_c(lam, mu, ${', '.join(map(str, c.idx))}$, .true.)
#:endfor
        s_${d}$ = elas_stress(prm, eps_${d}$)
        call check_true(passed, '${k}$ ${d}$ nu = 0.5: normal stresses not finite', &
            all(.not. ieee_is_finite(s_${d}$%vals(1:3))))
        call check_true(passed, '${k}$ ${d}$ nu = 0.5: shear stresses finite', all(ieee_is_finite(s_${d}$%vals(4:))))
        c_${d}$ = elas_dstress_dstrain(prm, eps_${d}$)
        call check_true(passed, '${k}$ ${d}$ nu = 0.5: tangent with infinite entries', &
            any(.not. ieee_is_finite(c_${d}$%vals)))
        s_${d}$ = elas_stress_dev(prm, eps_${d}$)
        call check_true(passed, '${k}$ ${d}$ nu = 0.5: deviatoric stress finite', all(ieee_is_finite(s_${d}$%vals)))
        call compare(passed, '${k}$ ${d}$ nu = 0.5: stress_dev', real(s_${d}$%vals, dp), rsd_${d}$, TOL)
        c_${d}$ = elas_dstress_dstrain_dev(prm, eps_${d}$)
        call check_true(passed, '${k}$ ${d}$ nu = 0.5: deviatoric tangent finite', all(ieee_is_finite(c_${d}$%vals)))
        call compare(passed, '${k}$ ${d}$ nu = 0.5: dstress_dstrain_dev', real(c_${d}$%vals, dp), rcd_${d}$, TOL)
#:endfor
    end subroutine test_incompressible_${k}$
#:endfor

    subroutine test_generics(passed)
        !! The family generics give the bits of the dp specific functions.
        logical, intent(inout) :: passed
        real(dp), parameter :: YOUNG(${len(ELAS_PRM)}$) = [${', '.join(p[0] + '_dp' for p in ELAS_PRM)}$]
        real(dp), parameter :: NU(${len(ELAS_PRM)}$) = [${', '.join(p[1] + '_dp' for p in ELAS_PRM)}$]
        type(elas_linear_dp) :: prm
        type(${tname('3D2Osym', 'dp')}$) :: e3, a3, r3
        type(${tname('2D2Osym', 'dp')}$) :: e2, a2, r2
        type(${tname('3D4O3sym', 'dp')}$) :: c3, d3
        type(${tname('2D4O3sym', 'dp')}$) :: c2, d2
        character(len=64) :: lab
        integer :: ip, n

        do ip = 1, size(YOUNG)
            call elas_linear_init(prm, YOUNG(ip), NU(ip))
            do n = 1, NSTRAIN
                write(lab, '(a, i0, a, i0)') 'generic = specific, E,nu #', ip, ' strain ', n
                e3%vals = strain_vals(n, 6)
                e2%vals = strain_vals(n, 4)
                r3 = elas_stress_linear_3D_dp(prm, e3)
                a3 = elas_stress(prm, e3)
                call check_true(passed, trim(lab) // ' stress 3D', same_bits(a3%vals, r3%vals))
                r2 = elas_stress_linear_2D_dp(prm, e2)
                a2 = elas_stress(prm, e2)
                call check_true(passed, trim(lab) // ' stress 2D', same_bits(a2%vals, r2%vals))
                r3 = elas_stress_dev_linear_3D_dp(prm, e3)
                a3 = elas_stress_dev(prm, e3)
                call check_true(passed, trim(lab) // ' stress_dev 3D', same_bits(a3%vals, r3%vals))
                r2 = elas_stress_dev_linear_2D_dp(prm, e2)
                a2 = elas_stress_dev(prm, e2)
                call check_true(passed, trim(lab) // ' stress_dev 2D', same_bits(a2%vals, r2%vals))
                c3 = elas_dstress_dstrain(prm, e3)
                d3 = elas_dstress_dstrain_linear_3D_dp(prm, e3)
                call check_true(passed, trim(lab) // ' dstress_dstrain 3D', same_bits(c3%vals, d3%vals))
                c2 = elas_dstress_dstrain(prm, e2)
                d2 = elas_dstress_dstrain_linear_2D_dp(prm, e2)
                call check_true(passed, trim(lab) // ' dstress_dstrain 2D', same_bits(c2%vals, d2%vals))
                c3 = elas_dstress_dstrain_dev(prm, e3)
                d3 = elas_dstress_dstrain_dev_linear_3D_dp(prm, e3)
                call check_true(passed, trim(lab) // ' dstress_dstrain_dev 3D', same_bits(c3%vals, d3%vals))
            end do
        end do
    end subroutine test_generics

    subroutine run_all(code)
        integer, intent(out) :: code
        logical :: passed

        passed = .true.
#:for k in REAL_KINDS
#:for d in DIMS
        call test_analytic_${d}$_${k}$(passed)
#:endfor
        call test_embedding_${k}$(passed)
        call test_incompressible_${k}$(passed)
#:endfor
        call test_generics(passed)
        code = merge(0, 1, passed)
    end subroutine run_all

end module test_elas_cases

program test_elas_kinds
    use test_elas_cases, only : run_all
    implicit none
    integer :: code

    call run_all(code)
    if (code /= 0) stop code
    print '(a)', ' Passed!'
end program test_elas_kinds
