#:include "muscle_common.fypp"
#:include "muscle_fd.fypp"
#!
#! Test of the finite-difference macros of include/muscle_fd.fypp (D-016.1): FD_DERIV, FD_DERIV2,
#! FD_GRAD, FD_JAC and FD_HESS (default step, explicit `step`, `scale` of the argument, D-017.5a;
#! one-sided stencils with `lower`)
#! instantiated for every kind and dimension inside `pure`, `@:DEVICE()`
#! procedures, against the analytical derivatives of smooth test functions. Their dp bits against
#! the former `procedure(...)` API `derivative`/`derivative2O` (removed, D-018.18b) are fixed by
#! the golden test test_math_golden_derivatives.
#!
#! Tolerances (relative to the largest component): central differences have a truncation error
#! ~h^2 |f'''| and a rounding error ~eps |f|/h (eps |f|/h^2 for second derivatives), with the default
#! relative steps of muscle_kinds at arguments of order 1 (h = rel):
#! - dp: first derivatives rel = 1e-7 / 1e-6 / 1e-4 (jacobian), second derivatives rel = 1e-4:
#!   estimated <= 1e-8 and 2e-8; measured max 2e-9 (first) and 3e-9 (second); tolerance 1e-7.
#! - sp: first derivatives rel = 5e-3 (truncation ~3e-5, rounding ~2.4e-5), second derivatives
#!   rel = 2e-2 (stencil 2h = 4e-2: truncation ~1e-4, rounding ~3e-4); measured max 4e-5 (first)
#!   and 4e-5 (second); tolerance 1e-3.
#:set TOL1 = {'dp': '1.0e-7', 'sp': '1.0e-3'}
#:set TOL2 = {'dp': '1.0e-7', 'sp': '1.0e-3'}
#! One-sided FD_DERIV2 (`lower`): the stencil (2, -5, 4, -1)/h**2 has a rounding error up to
#! ~12 eps |f|/h**2 (dp 2e-7, sp 3e-3 at x ~ 1 with h = rel).
#:set TOL2F = {'dp': '1.0e-6', 'sp': '1.0e-2'}
#! Weights of the test functions per stored 2Osym component (the 2D layout uses the first four)
#:set A = ['0.6', '0.9', '1.1', '0.7', '1.3', '0.8']
#:set W = ['0.9', '-0.7', '0.5', '1.3', '-1.1', '0.8']
#! Weight W of component p (1-based) as a parenthesized literal
#:set wl = lambda p, k: '({}_{})'.format(W[p - 1], k)
#! Factor of a component in the macro derivatives: 1/2 for a shear component (tensorial Voigt)
#:set cf = lambda c, k: '1.0_{}'.format(k) if c.idx[0] == c.idx[1] else '0.5_{}'.format(k)

module test_fd_macros_funcs
    !! Test functions with known derivatives and the kernel procedures that differentiate them
    !! with the macros of `muscle_fd.fypp`, for every kind and dimension.
    use muscle_kinds, only : sp, dp
    use muscle_tensor_2o, only : ${', '.join(tname(d + '2O', k) for d in DIMS for k in REAL_KINDS)}$
    use muscle_tensor_2osym, only : ${', '.join(tname(d + '2Osym', k) for d in DIMS for k in REAL_KINDS)}$
    use muscle_tensor_4o2sym, only : ${', '.join(tname(d + '4O2sym', k) for d in DIMS for k in REAL_KINDS)}$
    use muscle_tensor_4o3sym, only : ${', '.join(tname(d + '4O3sym', k) for d in DIMS for k in REAL_KINDS)}$
    implicit none
    private
#:for k in REAL_KINDS
    public :: f1_${k}$, d1_${k}$, d1_h_${k}$, d1_s_${k}$, d2_${k}$, d2_h_${k}$, d2_s_${k}$, d1_l_${k}$, d2_l_${k}$
#:for d in DIMS
    public :: f2o_${d}$_${k}$, grad2o_${d}$_${k}$, grad2o_h_${d}$_${k}$
    public :: fs_${d}$_${k}$, gs_${d}$_${k}$, grad_${d}$_${k}$, jac_${d}$_${k}$, hess_${d}$_${k}$
    public :: grad_h_${d}$_${k}$, jac_h_${d}$_${k}$, hess_h_${d}$_${k}$
    public :: grad_s_${d}$_${k}$, jac_s_${d}$_${k}$, hess_s_${d}$_${k}$
#:endfor
#:endfor

contains
#:for k in REAL_KINDS

    pure function f1_${k}$(x) result(res)
        !! exp(0.5 x) + x^3 in `real(${k}$)`.
        @:DEVICE()
        real(${k}$), intent(in) :: x
            !! Argument.
        real(${k}$) :: res
            !! Value.
        res = exp(0.5_${k}$*x) + x**3
    end function f1_${k}$

    pure function d1_${k}$(x) result(res)
        !! `FD_DERIV` of `f1_${k}$` with the default step.
        @:DEVICE()
        real(${k}$), intent(in) :: x
            !! Argument.
        real(${k}$) :: res
            !! Derivative.
        @:FD_DERIV(res, f1_${k}$({x}), x, ${k}$)
    end function d1_${k}$

    pure function d1_h_${k}$(x, h) result(res)
        !! `FD_DERIV` of `f1_${k}$` with an explicit step.
        @:DEVICE()
        real(${k}$), intent(in) :: x
            !! Argument.
        real(${k}$), intent(in) :: h
            !! Step.
        real(${k}$) :: res
            !! Derivative.
        @:FD_DERIV(res, f1_${k}$({x}), x, ${k}$, step=h)
    end function d1_h_${k}$

    pure function d1_s_${k}$(x, sc) result(res)
        !! `FD_DERIV` of `f1_${k}$` with a scale of the argument (h = rel max(|x|, sc), D-017.5a).
        @:DEVICE()
        real(${k}$), intent(in) :: x
            !! Argument.
        real(${k}$), intent(in) :: sc
            !! Scale.
        real(${k}$) :: res
            !! Derivative.
        @:FD_DERIV(res, f1_${k}$({x}), x, ${k}$, scale=sc)
    end function d1_s_${k}$

    pure function d2_${k}$(x) result(res)
        !! `FD_DERIV2` of `f1_${k}$` with the default step.
        @:DEVICE()
        real(${k}$), intent(in) :: x
            !! Argument.
        real(${k}$) :: res
            !! Second derivative.
        @:FD_DERIV2(res, f1_${k}$({x}), x, ${k}$)
    end function d2_${k}$

    pure function d2_h_${k}$(x, h) result(res)
        !! `FD_DERIV2` of `f1_${k}$` with an explicit step.
        @:DEVICE()
        real(${k}$), intent(in) :: x
            !! Argument.
        real(${k}$), intent(in) :: h
            !! Step.
        real(${k}$) :: res
            !! Second derivative.
        @:FD_DERIV2(res, f1_${k}$({x}), x, ${k}$, step=h)
    end function d2_h_${k}$

    pure function d2_s_${k}$(x, sc) result(res)
        !! `FD_DERIV2` of `f1_${k}$` with a scale of the argument (h = rel max(|x|, sc)).
        @:DEVICE()
        real(${k}$), intent(in) :: x
            !! Argument.
        real(${k}$), intent(in) :: sc
            !! Scale.
        real(${k}$) :: res
            !! Second derivative.
        @:FD_DERIV2(res, f1_${k}$({x}), x, ${k}$, scale=sc)
    end function d2_s_${k}$

    pure function d1_l_${k}$(x) result(res)
        !! `FD_DERIV` of `f1_${k}$` with scale 1 and `lower = x`: always the one-sided stencil.
        @:DEVICE()
        real(${k}$), intent(in) :: x
            !! Argument.
        real(${k}$) :: res
            !! Derivative.
        @:FD_DERIV(res, f1_${k}$({x}), x, ${k}$, scale=1.0_${k}$, lower=x)
    end function d1_l_${k}$

    pure function d2_l_${k}$(x) result(res)
        !! `FD_DERIV2` of `f1_${k}$` with scale 1 and `lower = x`: always the one-sided stencil.
        @:DEVICE()
        real(${k}$), intent(in) :: x
            !! Argument.
        real(${k}$) :: res
            !! Second derivative.
        @:FD_DERIV2(res, f1_${k}$({x}), x, ${k}$, scale=1.0_${k}$, lower=x)
    end function d2_l_${k}$

#:for d in DIMS
#:set lay = layout('2Osym', d)
#:set T = tname(d + '2Osym', k)
#:set n2 = len(layout('2O', d).comps)

    pure function f2o_${d}$_${k}$(t) result(res)
        !! sum_i (1 + 0.1 i) t_i^2 + exp(0.2 (t_1 - t_2 + t_${n2}$)) of a `${tname(d + '2O', k)}$`.
        @:DEVICE()
        type(${tname(d + '2O', k)}$), intent(in) :: t
            !! Argument.
        real(${k}$) :: res
            !! Value.
        integer :: i
        res = exp(0.2_${k}$*(t%vals(1) - t%vals(2) + t%vals(${n2}$)))
        do i = 1, ${n2}$
            res = res + (1.0_${k}$ + 0.1_${k}$*i)*t%vals(i)**2
        end do
    end function f2o_${d}$_${k}$

    pure function grad2o_${d}$_${k}$(t) result(res)
        !! `FD_GRAD` (fam=2O) of `f2o_${d}$_${k}$` with the default step.
        @:DEVICE()
        type(${tname(d + '2O', k)}$), intent(in) :: t
            !! Argument.
        type(${tname(d + '2O', k)}$) :: res
            !! Gradient.
        @:FD_GRAD(res, f2o_${d}$_${k}$({x}), t, ${k}$, ${d}$, fam=2O)
    end function grad2o_${d}$_${k}$

    pure function grad2o_h_${d}$_${k}$(t, h) result(res)
        !! `FD_GRAD` (fam=2O) of `f2o_${d}$_${k}$` with an explicit step.
        @:DEVICE()
        type(${tname(d + '2O', k)}$), intent(in) :: t
            !! Argument.
        real(${k}$), intent(in) :: h
            !! Step.
        type(${tname(d + '2O', k)}$) :: res
            !! Gradient.
        @:FD_GRAD(res, f2o_${d}$_${k}$({x}), t, ${k}$, ${d}$, fam=2O, step=h)
    end function grad2o_h_${d}$_${k}$

    pure function fs_${d}$_${k}$(s) result(res)
        !! sum_p A_p s_p^2 + exp(0.3 W . s) of a `${T}$`.
        @:DEVICE()
        type(${T}$), intent(in) :: s
            !! Argument.
        real(${k}$) :: res
            !! Value.
        res = exp(0.3_${k}$*(${' + '.join('{}*s%vals({})'.format(wl(c.pos[0], k), c.pos[0]) for c in lay.comps)}$))
#:for c in lay.comps
        res = res + ${A[c.pos[0] - 1]}$_${k}$*s%vals(${c.pos[0]}$)**2
#:endfor
    end function fs_${d}$_${k}$

    pure function gs_${d}$_${k}$(s) result(res)
        !! Components exp(0.2 M_q . s) + 0.1 q s_q^2, M_qj = 1 + 0.1 (q - j), of a `${T}$`.
        @:DEVICE()
        type(${T}$), intent(in) :: s
            !! Argument.
        type(${T}$) :: res
            !! Value.
        integer :: q, j
        real(${k}$) :: l
        do q = 1, ${len(lay.comps)}$
            l = 0.0_${k}$
            do j = 1, ${len(lay.comps)}$
                l = l + (1.0_${k}$ + 0.1_${k}$*(q - j))*s%vals(j)
            end do
            res%vals(q) = exp(0.2_${k}$*l) + 0.1_${k}$*q*s%vals(q)**2
        end do
    end function gs_${d}$_${k}$

#! Default step, explicit step `h`, scale `sc` of the argument (D-017.5a)
#:set SDOC = {None: '', 'h': ' with an explicit step', 'sc': ' with a scale of the argument'}
#:for sfx, sarg, sdecl in [('', '', None), ('_h', ', h', 'h'), ('_s', ', sc', 'sc')]
    pure function grad${sfx}$_${d}$_${k}$(s${sarg}$) result(res)
        !! `FD_GRAD` of `fs_${d}$_${k}$`${SDOC[sdecl]}$.
        @:DEVICE()
        type(${T}$), intent(in) :: s
            !! Argument.
#:if sdecl
        real(${k}$), intent(in) :: ${sdecl}$
            !! ${'Step.' if sdecl == 'h' else 'Scale.'}$
#:endif
        type(${T}$) :: res
            !! Gradient.
#:if sdecl == 'h'
        @:FD_GRAD(res, fs_${d}$_${k}$({x}), s, ${k}$, ${d}$, step=h)
#:elif sdecl == 'sc'
        @:FD_GRAD(res, fs_${d}$_${k}$({x}), s, ${k}$, ${d}$, scale=sc)
#:else
        @:FD_GRAD(res, fs_${d}$_${k}$({x}), s, ${k}$, ${d}$)
#:endif
    end function grad${sfx}$_${d}$_${k}$

    pure function jac${sfx}$_${d}$_${k}$(s${sarg}$) result(res)
        !! `FD_JAC` of `gs_${d}$_${k}$`${SDOC[sdecl]}$.
        @:DEVICE()
        type(${T}$), intent(in) :: s
            !! Argument.
#:if sdecl
        real(${k}$), intent(in) :: ${sdecl}$
            !! ${'Step.' if sdecl == 'h' else 'Scale.'}$
#:endif
        type(${tname(d + '4O2sym', k)}$) :: res
            !! Jacobian.
#:if sdecl == 'h'
        @:FD_JAC(res, gs_${d}$_${k}$({x}), s, ${k}$, ${d}$, step=h)
#:elif sdecl == 'sc'
        @:FD_JAC(res, gs_${d}$_${k}$({x}), s, ${k}$, ${d}$, scale=sc)
#:else
        @:FD_JAC(res, gs_${d}$_${k}$({x}), s, ${k}$, ${d}$)
#:endif
    end function jac${sfx}$_${d}$_${k}$

    pure function hess${sfx}$_${d}$_${k}$(s${sarg}$) result(res)
        !! `FD_HESS` of `fs_${d}$_${k}$`${SDOC[sdecl]}$.
        @:DEVICE()
        type(${T}$), intent(in) :: s
            !! Argument.
#:if sdecl
        real(${k}$), intent(in) :: ${sdecl}$
            !! ${'Step.' if sdecl == 'h' else 'Scale.'}$
#:endif
        type(${tname(d + '4O3sym', k)}$) :: res
            !! Second derivative.
#:if sdecl == 'h'
        @:FD_HESS(res, fs_${d}$_${k}$({x}), s, ${k}$, ${d}$, step=h)
#:elif sdecl == 'sc'
        @:FD_HESS(res, fs_${d}$_${k}$({x}), s, ${k}$, ${d}$, scale=sc)
#:else
        @:FD_HESS(res, fs_${d}$_${k}$({x}), s, ${k}$, ${d}$)
#:endif
    end function hess${sfx}$_${d}$_${k}$

#:endfor
#:endfor
#:endfor
end module test_fd_macros_funcs

program test_math_fd_macros
    !! Checks the macros of `muscle_fd.fypp` against analytical derivatives (every kind and
    !! dimension, at a generic argument and at the zero argument, D-016.4) and, in double
    !! precision 3D, the historical minimum step at a tiny non-zero argument.
    use muscle_kinds, only : sp, dp
#:for k in REAL_KINDS
    use muscle_kinds, only : FD_STEP_CEN_${k}$, FD_STEP_CEN2_${k}$, FD_STEP_MIN_${k}$, FD_STEP_CEN_2OSYM_${k}$, &
        FD_STEP_CEN_JAC_${k}$
#:endfor
    use muscle_tensor_2o, only : ${', '.join(tname(d + '2O', k) for d in DIMS for k in REAL_KINDS)}$
    use muscle_tensor_2osym, only : ${', '.join(tname(d + '2Osym', k) for d in DIMS for k in REAL_KINDS)}$
    use muscle_tensor_4o2sym, only : ${', '.join(tname(d + '4O2sym', k) for d in DIMS for k in REAL_KINDS)}$
    use muscle_tensor_4o3sym, only : ${', '.join(tname(d + '4O3sym', k) for d in DIMS for k in REAL_KINDS)}$
    use muscle_test_utils, only : check_approx
    use test_fd_macros_funcs
    implicit none

    logical :: passed

    passed = .true.
#:for k in REAL_KINDS
    call check_scalar_${k}$(0.6_${k}$, 'x = 0.6', .true.)
    call check_scalar_${k}$(0.0_${k}$, 'x = 0', .true.)
    ! Small non-zero argument of a function with f(0) /= 0: the default step (relative to |x|)
    ! collapses there (rounding error ~ eps |f|/h); the scale keeps it (D-017.5a)
    call check_scalar_${k}$(1.0e-6_${k}$, 'x = 1e-6', .false.)
#:for d in DIMS
    call check_${d}$_${k}$([0.7_${k}$, -0.4_${k}$, 0.9_${k}$, 0.3_${k}$, -0.6_${k}$, 0.5_${k}$], '${d}$ ${k}$ generic')
    call check_${d}$_${k}$(spread(0.0_${k}$, 1, 6), '${d}$ ${k}$ zero')
#:endfor
#:endfor
    call check_tiny_dp(1.0e-36_dp*[0.7_dp, -0.4_dp, 0.9_dp, 0.3_dp, -0.6_dp, 0.5_dp])
    if (.not. passed) stop 1

contains
#:for k in REAL_KINDS

    subroutine check_scalar_${k}$(x, label, default_step)
        !! `FD_DERIV` against f1' = 0.5 exp(0.5 x) + 3 x^2 and `FD_DERIV2` against
        !! f1'' = 0.25 exp(0.5 x) + 6 x in `real(${k}$)`, and their step rules.
        real(${k}$), intent(in) :: x
            !! Argument.
        character(len=*), intent(in) :: label
            !! Case label.
        logical, intent(in) :: default_step
            !! Check the default step against the analytical derivatives too.
        real(${k}$) :: ex
        ex = 0.5_${k}$*exp(0.5_${k}$*x) + 3.0_${k}$*x**2
        if (default_step) then
            call check_approx(passed, 'FD_DERIV ${k}$ ' // label, d1_${k}$(x), ex, ${TOL1[k]}$_${k}$)
        end if
        call check_approx(passed, 'FD_DERIV(scale = 1) ${k}$ ' // label, d1_s_${k}$(x, 1.0_${k}$), ex, ${TOL1[k]}$_${k}$)
        call check_approx(passed, 'FD_DERIV(lower = x) ${k}$ ' // label, d1_l_${k}$(x), ex, ${TOL1[k]}$_${k}$)
        ex = 0.25_${k}$*exp(0.5_${k}$*x) + 6.0_${k}$*x
        if (default_step) then
            call check_approx(passed, 'FD_DERIV2 ${k}$ ' // label, d2_${k}$(x), ex, ${TOL2[k]}$_${k}$)
        end if
        call check_approx(passed, 'FD_DERIV2(scale = 1) ${k}$ ' // label, d2_s_${k}$(x, 1.0_${k}$), ex, ${TOL2[k]}$_${k}$)
        call check_approx(passed, 'FD_DERIV2(lower = x) ${k}$ ' // label, d2_l_${k}$(x), ex, ${TOL2F[k]}$_${k}$)
        ! Step rules, bit for bit: scale -> h = rel max(|x|, scale); default FD_DERIV2 -> D-016.4
        call check_approx(passed, 'FD_DERIV(scale) = FD_DERIV(rel max(|x|, scale)) ${k}$ ' // label, &
                          d1_s_${k}$(x, 0.5_${k}$), d1_h_${k}$(x, FD_STEP_CEN_${k}$*max(abs(x), 0.5_${k}$)), 0.0_${k}$)
        call check_approx(passed, 'FD_DERIV2(scale) = FD_DERIV2(rel max(|x|, scale)) ${k}$ ' // label, &
                          d2_s_${k}$(x, 0.5_${k}$), d2_h_${k}$(x, FD_STEP_CEN2_${k}$*max(abs(x), 0.5_${k}$)), 0.0_${k}$)
        call check_approx(passed, 'FD_DERIV2 default step ${k}$ ' // label, d2_${k}$(x), &
                          d2_h_${k}$(x, merge(max(abs(x)*FD_STEP_CEN2_${k}$, FD_STEP_MIN_${k}$), FD_STEP_CEN2_${k}$, &
                          abs(x) > 0.0_${k}$)), 0.0_${k}$)
    end subroutine check_scalar_${k}$
#:for d in DIMS
#:set lay = layout('2Osym', d)
#:set n = len(lay.comps)
#:set T = tname(d + '2Osym', k)
#:set n2 = len(layout('2O', d).comps)

    subroutine check_${d}$_${k}$(v, label)
        !! `FD_GRAD` (2Osym and 2O), `FD_JAC` and `FD_HESS` (${d}$, `real(${k}$)`)
        !! against the analytical derivatives of `fs_${d}$_${k}$`, `gs_${d}$_${k}$` and
        !! `f2o_${d}$_${k}$` (2Osym shear entries scaled by 1/2 per shear index, as the shear
        !! components are perturbed by h/2).
        real(${k}$), intent(in) :: v(6)
            !! Components (the first ${n}$ are used).
        character(len=*), intent(in) :: label
            !! Case label.
        type(${T}$) :: s, g, g2
        type(${tname(d + '4O2sym', k)}$) :: jc, jc2
        type(${tname(d + '4O3sym', k)}$) :: hs, hs2
        type(${tname(d + '2O', k)}$) :: t, tg
        real(${k}$) :: e, eg(${n}$), ej(${n}$, ${n}$), eh(${len(layout('4O3sym', d).comps)}$), l
        real(${k}$) :: e2, eg2(${n2}$), vt(9)
        integer :: q, j

        s%vals = v(1:${n}$)
        vt = [v, v(1:3)]
        t%vals = vt(1:${n2}$)
        e2 = exp(0.2_${k}$*(t%vals(1) - t%vals(2) + t%vals(${n2}$)))
        do q = 1, ${n2}$
            eg2(q) = 2.0_${k}$*(1.0_${k}$ + 0.1_${k}$*q)*t%vals(q)
        end do
        eg2(1) = eg2(1) + 0.2_${k}$*e2
        eg2(2) = eg2(2) - 0.2_${k}$*e2
        eg2(${n2}$) = eg2(${n2}$) + 0.2_${k}$*e2
        tg = grad2o_${d}$_${k}$(t)
        call check_approx(passed, 'FD_GRAD(2O) ' // label, tg%vals, eg2, ${TOL1[k]}$_${k}$)
        e = exp(0.3_${k}$*(${' + '.join('{}*s%vals({})'.format(wl(c.pos[0], k), c.pos[0]) for c in lay.comps)}$))
#:for c in lay.comps
#:set p = c.pos[0]
        eg(${p}$) = ${cf(c, k)}$*(2.0_${k}$*${A[p - 1]}$_${k}$*s%vals(${p}$) + 0.3_${k}$*${wl(p, k)}$*e)
#:endfor
        g = grad_${d}$_${k}$(s)
        call check_approx(passed, 'FD_GRAD ' // label, g%vals, eg, ${TOL1[k]}$_${k}$)

        do q = 1, ${n}$
            l = 0.0_${k}$
            do j = 1, ${n}$
                l = l + (1.0_${k}$ + 0.1_${k}$*(q - j))*s%vals(j)
            end do
            do j = 1, ${n}$
                ej(q, j) = 0.2_${k}$*(1.0_${k}$ + 0.1_${k}$*(q - j))*exp(0.2_${k}$*l)
            end do
            ej(q, q) = ej(q, q) + 0.2_${k}$*q*s%vals(q)
        end do
#:for c in lay.comps
        ej(:, ${c.pos[0]}$) = ${cf(c, k)}$*ej(:, ${c.pos[0]}$)
#:endfor
        jc = jac_${d}$_${k}$(s)
        call check_approx(passed, 'FD_JAC ' // label, reshape(jc%vals, [${n*n}$]), reshape(ej, [${n*n}$]), &
                          ${TOL1[k]}$_${k}$)

#:for c in layout('4O3sym', d).comps
#:set r, t = c.voigt
#:set diag = ' + 2.0_{}*{}_{}'.format(k, A[r - 1], k) if r == t else ''
        eh(${c.pos[0]}$) = ${cf(lay.comps[r - 1], k)}$*${cf(lay.comps[t - 1], k)}$ &
            *(0.09_${k}$*${wl(r, k)}$*${wl(t, k)}$*e${diag}$)
#:endfor
        hs = hess_${d}$_${k}$(s)
        call check_approx(passed, 'FD_HESS ' // label, hs%vals, eh, ${TOL2[k]}$_${k}$)

        ! Scale of the argument (D-017.5a): accurate with scale 1, and h = rel max(|s|, scale) bit for bit
        g = grad_s_${d}$_${k}$(s, 1.0_${k}$)
        call check_approx(passed, 'FD_GRAD(scale = 1) ' // label, g%vals, eg, ${TOL1[k]}$_${k}$)
        jc = jac_s_${d}$_${k}$(s, 1.0_${k}$)
        call check_approx(passed, 'FD_JAC(scale = 1) ' // label, reshape(jc%vals, [${n*n}$]), reshape(ej, [${n*n}$]), &
                          ${TOL1[k]}$_${k}$)
        hs = hess_s_${d}$_${k}$(s, 1.0_${k}$)
        call check_approx(passed, 'FD_HESS(scale = 1) ' // label, hs%vals, eh, ${TOL2[k]}$_${k}$)
        g = grad_s_${d}$_${k}$(s, 0.5_${k}$)
        g2 = grad_h_${d}$_${k}$(s, FD_STEP_CEN_2OSYM_${k}$*max(s%norm(), 0.5_${k}$))
        call check_approx(passed, 'FD_GRAD(scale) = FD_GRAD(rel max(|s|, scale)) ' // label, g%vals, g2%vals, 0.0_${k}$)
        jc = jac_s_${d}$_${k}$(s, 0.5_${k}$)
        jc2 = jac_h_${d}$_${k}$(s, FD_STEP_CEN_JAC_${k}$*max(s%norm(), 0.5_${k}$))
        call check_approx(passed, 'FD_JAC(scale) = FD_JAC(rel max(|s|, scale)) ' // label, &
                          reshape(jc%vals, [${n*n}$]), reshape(jc2%vals, [${n*n}$]), 0.0_${k}$)
        hs = hess_s_${d}$_${k}$(s, 0.5_${k}$)
        hs2 = hess_h_${d}$_${k}$(s, FD_STEP_CEN2_${k}$*max(s%norm(), 0.5_${k}$))
        call check_approx(passed, 'FD_HESS(scale) = FD_HESS(rel max(|s|, scale)) ' // label, hs%vals, hs2%vals, 0.0_${k}$)
    end subroutine check_${d}$_${k}$
#:endfor
#:endfor

    subroutine check_tiny_dp(v)
        !! At a tiny non-zero argument the default step is the historical one, max(|x| rel, min)
        !! with the literals of the original code (D-016.4 only changed the zero argument): the
        !! macros with the default step give the same bits as with that explicit step.
        real(dp), intent(in) :: v(6)
            !! Components of the 2Osym argument (also used for the scalar and the 2O argument).
        type(ten_3D2Osym_dp) :: s, g1, g2
        type(ten_3D2O_dp) :: t, t1, t2
        type(ten_3D4O2sym_dp) :: j1, j2
        type(ten_3D4O3sym_dp) :: e1, e2

        s%vals = v
        t%vals = [v, v(1:3)]
        call check_approx(passed, 'FD_DERIV tiny: historical step', d1_dp(v(1)), &
                          d1_h_dp(v(1), max(abs(v(1)*1.0e-7_dp), 1.0e-40_dp)), 0.0_dp)
        t1 = grad2o_3D_dp(t)
        t2 = grad2o_h_3D_dp(t, max(abs(t%norm()*1.0e-7_dp), 1.0e-40_dp))
        call check_approx(passed, 'FD_GRAD(2O) tiny: historical step', t1%vals, t2%vals, 0.0_dp)
        g1 = grad_3D_dp(s)
        g2 = grad_h_3D_dp(s, max(abs(s%norm()*1.0e-6_dp), 1.0e-40_dp))
        call check_approx(passed, 'FD_GRAD tiny: historical step', g1%vals, g2%vals, 0.0_dp)
        j1 = jac_3D_dp(s)
        j2 = jac_h_3D_dp(s, max(abs(s%norm()*1.0e-4_dp), 1.0e-35_dp))
        call check_approx(passed, 'FD_JAC tiny: historical step', j1%vals, j2%vals, 0.0_dp)
        e1 = hess_3D_dp(s)
        e2 = hess_h_3D_dp(s, max(abs(s%norm()*1.0e-4_dp), 1.0e-40_dp))
        call check_approx(passed, 'FD_HESS tiny: historical step', e1%vals, e2%vals, 0.0_dp)
    end subroutine check_tiny_dp

end program test_math_fd_macros
