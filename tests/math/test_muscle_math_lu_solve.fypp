#:include "muscle_common.fypp"
#!
#! Tolerances (eps = epsilon of the kind under test: 1.19e-7 sp, 2.22e-16 dp). References are
#! computed in dp from the inputs converted exactly (muscle_test_helpers).
#!
#! - Normwise backward error eta = |b - A x|_inf / (|A|_inf |x|_inf + |b|_inf) <= C_BACKWARD n eps.
#!   LU with partial pivoting is backward stable: |b - A x| <= gamma_3n |L| |U| |x| (Higham, Thm
#!   9.4), i.e. eta <~ 3 n rho eps with the growth factor rho (<= 2^(n-1), in practice ~ 1-3 for
#!   n <= 9). C_BACKWARD = 10 (rho <= 3.3).
#! - Forward error |x - x_ref|_inf / |x_ref|_inf <= C_FORWARD n kappa eps, kappa = kappa_inf(A):
#!   forward error <= kappa eta, plus the error of the dp reference itself (kappa eps_dp, which only
#!   matters for dp), so C_FORWARD = 2 C_BACKWARD = 20.
#! - Returned KAPPA against the dp reference |A| |inv_ref(A)|: relative error <= C_FORWARD n kappa
#!   eps (the computed inverse has a relative error ~ kappa eta).
#! - Host solvers of muscle_math_linsolvers on the same systems, every kind (gauss_solve_<k>,
#!   mklsolve_<k> = sgesv/dgesv): Gaussian elimination with partial pivoting, unblocked or
#!   blocked, has the same backward-error bound as above, so the same forward-error tolerance
#!   C_FORWARD n kappa eps applies; x_lu against x_gauss: 2 C_FORWARD n kappa eps (both errors).
#! - gauss_seidel_<k> on diagonally dominant systems (diagonal n + 1 + u, off-diagonal |u| < 1, so
#!   the iteration matrix has inf-norm <= (n-1)/n): stopping tolerance on |b - A x|_2
#!   tol = C_BACKWARD n eps (|A|_inf |x_ref|_inf + |b|_inf), the residual floor of a computed x
#!   times C_BACKWARD; then |x - x_ref|_inf <= |inv(A)|_inf |r|_inf <= |inv(A)|_inf tol, checked
#!   with a factor 2 for the dp reference and the rounding of the last sweep.
#! Measured (300 systems per n = 1..9, gfortran Debug): max eta / (n eps) = 0.26 sp / 0.37 dp,
#! max forward error / (n kappa eps) = 0.43 sp / 0.99 dp, max KAPPA error / (n kappa^2 eps) =
#! 0.42 sp / 0.50 dp (printed by the test): margins >= 20.
#! Random matrices: entries uniform in (-1, 1), kept when kappa_inf < KAPPA_MAX = 1e3 (the range
#! of the tensor matrices and Newton systems, D-013).
#:set C_BACKWARD = 10
#:set C_FORWARD = 20
#:set KAPPA_MAX = '1.0e3'
#:set N_RANDOM = 300
#:set GS_MAXIT = 1000
#:set STOP_BASE = {'dp': 0, 'sp': 10}

module test_lu_solve_kernels
    !! Kernel-style callers of the solver: `pure`, `@:DEVICE()`, fixed sizes, no LAPACK.
    use muscle_kinds, only : sp, dp
    use muscle_math_lu_solve, only : LU6SOLVE, lu_solve
    implicit none
    private
    public :: kernel_solve6, kernel_solve

    interface kernel_solve6
        module procedure ${', '.join('kernel_solve6_' + k for k in REAL_KINDS)}$
    end interface kernel_solve6

    interface kernel_solve
        module procedure ${', '.join('kernel_solve_' + k for k in REAL_KINDS)}$
    end interface kernel_solve

contains

    #:for k in REAL_KINDS
    pure subroutine kernel_solve6_${k}$(a, b, x, ok)
        !! 6x6 `real(${k}$)` solve through the size-specific generic, as a kernel would do it.
        @:DEVICE()
        real(${k}$), intent(in) :: a(6,6)
            !! Matrix.
        real(${k}$), intent(in) :: b(6)
            !! Right-hand side.
        real(${k}$), intent(out) :: x(6)
            !! Solution.
        logical, intent(out) :: ok
            !! Success flag.
        call LU6SOLVE(a, b, x, ok)
    end subroutine kernel_solve6_${k}$

    pure subroutine kernel_solve_${k}$(a, b, x, ok, kappa)
        !! `real(${k}$)` solve of any supported size through the assumed-shape front end.
        @:DEVICE()
        real(${k}$), intent(in) :: a(:,:)
            !! Matrix.
        real(${k}$), intent(in) :: b(:)
            !! Right-hand side.
        real(${k}$), intent(out) :: x(:)
            !! Solution.
        logical, intent(out) :: ok
            !! Success flag.
        real(${k}$), intent(out) :: kappa
            !! Condition number.
        call lu_solve(a, b, x, ok, kappa)
    end subroutine kernel_solve_${k}$

    #:endfor
end module test_lu_solve_kernels


program test_math_lu_solve
    !! Tests of `muscle_math_lu_solve` (LU<n>SOLVE, n = 2..9, and `lu_solve`, n = 1..9) for every
    !! real kind: random well-conditioned systems (backward and forward error, KAPPA), systems that
    !! need pivoting, singular and NaN systems (contract: OK_FLAG = .false., x = 0, KAPPA = huge),
    !! invalid shapes of `lu_solve`, a nearly singular system; and the host solvers of
    !! `muscle_math_linsolvers` (`gauss_solve`, `mklsolve`, `gauss_seidel`) against dp references,
    !! with their documented `info` on singular systems and zero diagonals.
    use, intrinsic :: ieee_exceptions, only : ieee_set_flag, ieee_all
    use muscle_test_helpers, only : record
    implicit none
    integer :: code

    code = 0
    #:for k in REAL_KINDS
    #:set b = STOP_BASE[k]
    call record(test_random_${k}$(), ${b + 1}$, 'random systems ${k}$', code)
    call record(test_pivoting_${k}$(), ${b + 2}$, 'pivoting ${k}$', code)
    call record(test_singular_${k}$(), ${b + 3}$, 'singular and invalid shapes ${k}$', code)
    call record(test_near_singular_${k}$(), ${b + 4}$, 'near singular ${k}$', code)
    call record(test_gauss_seidel_${k}$(), ${b + 5}$, 'gauss_seidel ${k}$', code)
    call record(test_host_status_${k}$(), ${b + 6}$, 'host solvers: pivoting and singular systems ${k}$', code)
    #:endfor
    ! The NaN cases raise the IEEE invalid flag on purpose; clear it so that the runtime does not
    ! report it as unexpected at STOP.
    call ieee_set_flag(ieee_all, .false.)
    if (code /= 0) stop code
    print *, "Passed!"

contains

    #:for k in REAL_KINDS
    logical function test_random_${k}$() result(passed)
        !! `real(${k}$)` random systems with kappa_inf < ${KAPPA_MAX}$, n = 1..9: backward error,
        !! forward error and KAPPA against dp references; the same x with and without KAPPA, from
        !! the specific routine and from the kernel callers; gauss_solve and mklsolve on the same systems.
        use muscle_kinds, only : ${', '.join(sorted({k, 'dp'}))}$
        use muscle_test_helpers, only : park_miller, rnd, inv_ref, norm_inf
        use muscle_test_utils, only : check_true
        use muscle_math_lu_solve, only : lu_solve, LU6SOLVE
        use test_lu_solve_kernels, only : kernel_solve6, kernel_solve
        use muscle_math_linsolvers, only : gauss_solve, mklsolve
        type(park_miller) :: rng
        real(${k}$), allocatable :: a(:,:), b(:), x(:), x2(:)
        real(dp), allocatable :: ad(:,:), bd(:), xref(:), ainv(:,:)
        real(${k}$) :: kappa, kappa2
        real(dp) :: eps, kref, eta, ferr, eta_max, ferr_max, kerr_max
        logical :: ok, ok2
        integer :: n, t, i, j, info, its
        character(len=64) :: label

        passed = .true.
        rng = park_miller(20261031)
        eps = real(epsilon(1.0_${k}$), dp)
        eta_max = 0.0_dp; ferr_max = 0.0_dp; kerr_max = 0.0_dp
        do n = 1, 9
            allocate(a(n,n), b(n), x(n), x2(n), ad(n,n), bd(n), xref(n), ainv(n,n))
            t = 0
            do while (t < ${N_RANDOM}$)
                do j = 1, n
                    do i = 1, n
                        a(i,j) = real(rnd(rng), ${k}$)
                    end do
                    b(j) = real(rnd(rng), ${k}$)
                end do
                ad = real(a, dp)
                bd = real(b, dp)
                ainv = inv_ref(ad)
                kref = norm_inf(ad) * norm_inf(ainv)
                if (.not. (kref < ${KAPPA_MAX}$_dp)) cycle
                t = t + 1
                xref = matmul(ainv, bd)
                write(label, '(a, i0, a, i0)') 'n = ', n, ', case ', t

                call lu_solve(a, b, x, ok, kappa)
                call check_true(passed, 'solved: ' // trim(label), ok)
                eta = maxval(abs(bd - matmul(ad, real(x, dp)))) &
                      / (norm_inf(ad) * maxval(abs(real(x, dp))) + maxval(abs(bd)))
                ferr = maxval(abs(real(x, dp) - xref)) / maxval(abs(xref))
                eta_max = max(eta_max, eta / (n * eps))
                ferr_max = max(ferr_max, ferr / (n * kref * eps))
                kerr_max = max(kerr_max, abs(real(kappa, dp) - kref) / kref / (n * kref * eps))
                call check_true(passed, 'backward error: ' // trim(label), &
                                eta <= ${C_BACKWARD}$ * n * eps)
                call check_true(passed, 'forward error: ' // trim(label), &
                                ferr <= ${C_FORWARD}$ * n * kref * eps)
                call check_true(passed, 'KAPPA: ' // trim(label), &
                                abs(real(kappa, dp) - kref) <= ${C_FORWARD}$ * n * kref * eps * kref)

                ! Same bits without KAPPA and through the kernel callers
                call lu_solve(a, b, x2, ok2)
                call check_true(passed, 'same x without KAPPA: ' // trim(label), ok2 .and. all(x2 == x))
                call kernel_solve(a, b, x2, ok2, kappa2)
                call check_true(passed, 'same x, KAPPA from kernel_solve: ' // trim(label), &
                                ok2 .and. all(x2 == x) .and. kappa2 == kappa)
                if (n == 6) then
                    call LU6SOLVE(a, b, x2, ok2)
                    call check_true(passed, 'same x from LU6SOLVE: ' // trim(label), ok2 .and. all(x2 == x))
                    call kernel_solve6(a, b, x2, ok2)
                    call check_true(passed, 'same x from kernel_solve6: ' // trim(label), &
                                    ok2 .and. all(x2 == x))
                end if

                ! Host solvers: gauss_solve (A and b intent(in))
                call gauss_solve(a, b, x2, info)
                call check_true(passed, 'gauss_solve info: ' // trim(label), info == 0)
                call check_true(passed, 'gauss_solve forward error: ' // trim(label), &
                                maxval(abs(real(x2, dp) - xref)) <= ${C_FORWARD}$ * n * kref * eps * maxval(abs(xref)))
                call check_true(passed, 'agrees with gauss_solve: ' // trim(label), &
                                maxval(abs(real(x - x2, dp))) <= 2 * ${C_FORWARD}$ * n * kref * eps &
                                                                 * maxval(abs(real(x2, dp))))
                ! mklsolve (?gesv of the linked LAPACK; tol and maxit unused)
                call mklsolve(a, b, x2, 0.0_${k}$, 1, its, info)
                call check_true(passed, 'mklsolve info, its: ' // trim(label), info == 0 .and. its == 1)
                call check_true(passed, 'mklsolve forward error: ' // trim(label), &
                                maxval(abs(real(x2, dp) - xref)) <= ${C_FORWARD}$ * n * kref * eps * maxval(abs(xref)))
            end do
            deallocate(a, b, x, x2, ad, bd, xref, ainv)
        end do
        print '(a, 3(a, es9.2))', ' ${k}$ random: max eta/(n eps) =', '', eta_max, &
            ', max ferr/(n kappa eps) =', ferr_max, ', max KAPPA err/(n kappa^2 eps) =', kerr_max
    end function test_random_${k}$

    logical function test_pivoting_${k}$() result(passed)
        !! `real(${k}$)` systems that cannot be solved without row interchanges: exact zero leading
        !! pivots (permuted triangular matrices, exact solution) and the classic tiny-pivot 2x2.
        use muscle_kinds, only : ${k}$
        use muscle_test_utils, only : check_true
        use muscle_math_lu_solve, only : lu_solve, LU2SOLVE, LU4SOLVE
        real(${k}$) :: a2(2,2), b2(2), x2(2), a4(4,4), b4(4), x4(4), tiny_pivot, kappa
        logical :: ok

        passed = .true.
        ! Anti-diagonal (reversal) of an upper-triangular matrix with integer entries: every
        ! leading pivot is 0 without interchanges; the result is exact (integer arithmetic).
        a4 = reshape([ 0.0_${k}$, 0.0_${k}$, 0.0_${k}$, 2.0_${k}$, &
                       0.0_${k}$, 0.0_${k}$, 4.0_${k}$, 1.0_${k}$, &
                       0.0_${k}$, 1.0_${k}$, 2.0_${k}$, 3.0_${k}$, &
                       1.0_${k}$, 3.0_${k}$, 1.0_${k}$, 2.0_${k}$ ], [4, 4])
        ! x = (1, 2, -1, 3): b = A x
        b4 = matmul(a4, [1.0_${k}$, 2.0_${k}$, -1.0_${k}$, 3.0_${k}$])
        call LU4SOLVE(a4, b4, x4, ok, kappa)
        call check_true(passed, 'zero leading pivots: solved', ok)
        call check_true(passed, 'zero leading pivots: exact solution', &
                        all(x4 == [1.0_${k}$, 2.0_${k}$, -1.0_${k}$, 3.0_${k}$]))
        call check_true(passed, 'zero leading pivots: finite KAPPA', kappa > 1.0_${k}$ .and. kappa < 1.0e3_${k}$)

        ! [[t, 1], [1, 1]] x = [1, 2], t << eps: x = (1/(1-t), (1-2t)/(1-t)) ~ (1, 1). Without
        ! pivoting x1 = (1 - x2)/t is 0 (catastrophic cancellation).
        tiny_pivot = 1.0e-20_${k}$
        a2 = reshape([tiny_pivot, 1.0_${k}$, 1.0_${k}$, 1.0_${k}$], [2, 2])
        b2 = [1.0_${k}$, 2.0_${k}$]
        call LU2SOLVE(a2, b2, x2, ok)
        call check_true(passed, 'tiny pivot: solved', ok)
        call check_true(passed, 'tiny pivot: x = (1, 1)', all(x2 == [1.0_${k}$, 1.0_${k}$]))

        ! Same through lu_solve
        call lu_solve(a2, b2, x2, ok)
        call check_true(passed, 'tiny pivot (lu_solve): x = (1, 1)', ok .and. all(x2 == [1.0_${k}$, 1.0_${k}$]))
    end function test_pivoting_${k}$

    logical function test_gauss_seidel_${k}$() result(passed)
        !! `gauss_seidel_${k}$` on diagonally dominant `real(${k}$)` systems, n = 1..9, from x = 0,
        !! against the dp reference (bound |inv(A)|_inf tol, see the tolerances above).
        use muscle_kinds, only : ${', '.join(sorted({k, 'dp'}))}$
        use muscle_test_helpers, only : park_miller, rnd, inv_ref, norm_inf
        use muscle_test_utils, only : check_true
        use muscle_math_linsolvers, only : gauss_seidel
        type(park_miller) :: rng
        real(${k}$), allocatable :: a(:,:), b(:), x(:)
        real(dp), allocatable :: ad(:,:), bd(:), xref(:), ainv(:,:)
        real(dp) :: eps, tol
        integer :: n, t, i, j, its, info
        character(len=64) :: label

        passed = .true.
        rng = park_miller(1112026)
        eps = real(epsilon(1.0_${k}$), dp)
        do n = 1, 9
            allocate(a(n,n), b(n), x(n), ad(n,n), bd(n), xref(n), ainv(n,n))
            do t = 1, 50
                do j = 1, n
                    do i = 1, n
                        a(i,j) = real(rnd(rng), ${k}$)
                    end do
                    a(j,j) = a(j,j) + real(n + 1, ${k}$)
                    b(j) = real(rnd(rng), ${k}$)
                end do
                ad = real(a, dp)
                bd = real(b, dp)
                ainv = inv_ref(ad)
                xref = matmul(ainv, bd)
                tol = ${C_BACKWARD}$ * n * eps * (norm_inf(ad) * maxval(abs(xref)) + maxval(abs(bd)))
                x = 0.0_${k}$
                call gauss_seidel(a, b, x, real(tol, ${k}$), ${GS_MAXIT}$, its, info)
                write(label, '(a, i0, a, i0)') 'n = ', n, ', case ', t
                call check_true(passed, 'gauss_seidel converged: ' // trim(label), info == 0)
                call check_true(passed, 'gauss_seidel error: ' // trim(label), &
                                maxval(abs(real(x, dp) - xref)) <= 2 * norm_inf(ainv) * tol)
            end do
            deallocate(a, b, x, ad, bd, xref, ainv)
        end do
    end function test_gauss_seidel_${k}$

    logical function test_host_status_${k}$() result(passed)
        !! Host solvers of `muscle_math_linsolvers` in `real(${k}$)`, exact cases:
        !! - `gauss_solve` needs row interchanges when the leading pivot is 0 with every entry of
        !!   the column below 1 in magnitude (entries 2^-p: elimination and solution exact);
        !! - `gauss_solve` reports `info = 1` (documented: singular, zero pivot) for an exactly zero
        !!   column at every elimination step k < n and for an exactly zero last pivot (a duplicated
        !!   or proportional row of small integers: exact elimination), and `info = 0` with the exact
        !!   solution when the largest pivot of a column is exactly 1 (identity, permutation);
        !! - `gauss_seidel` reports `info = 2` (documented: zero diagonal) for an exactly zero
        !!   diagonal entry and converges in one sweep (`its = 1`) on a diagonal system with unit
        !!   diagonal.
        use muscle_kinds, only : ${k}$
        use muscle_test_utils, only : check_true
        use muscle_math_linsolvers, only : gauss_solve, gauss_seidel
        real(${k}$) :: a2(2,2), b2(2), x2(2), a3(3,3), b3(3), x3(3), xe(3)
        integer :: info, its, c, n
        character(len=64) :: label

        passed = .true.
        ! [[0, 1/2], [1/4, 1/8]] x = b, x = (2, -4): the first pivot needs an interchange with an
        ! entry 1/4 < 1 (without it the factor is 1/4 / 0)
        a2 = reshape([0.0_${k}$, 0.25_${k}$, 0.5_${k}$, 0.125_${k}$], [2, 2])
        b2 = matmul(a2, [2.0_${k}$, -4.0_${k}$])
        call gauss_solve(a2, b2, x2, info)
        call check_true(passed, 'gauss_solve, small zero leading pivot: info = 0', info == 0)
        call check_true(passed, 'gauss_solve, small zero leading pivot: exact x', &
                        all(x2 == [2.0_${k}$, -4.0_${k}$]))
        ! 3x3 with entries 2^-p and zero leading pivots: anti-triangular, x = (1, -2, 4)
        a3 = reshape([0.0_${k}$, 0.0_${k}$, 0.5_${k}$, &
                      0.0_${k}$, 0.25_${k}$, 0.125_${k}$, &
                      0.5_${k}$, 0.0625_${k}$, 0.25_${k}$], [3, 3])
        xe = [1.0_${k}$, -2.0_${k}$, 4.0_${k}$]
        b3 = matmul(a3, xe)
        call gauss_solve(a3, b3, x3, info)
        call check_true(passed, 'gauss_solve, small anti-triangular: info = 0', info == 0)
        call check_true(passed, 'gauss_solve, small anti-triangular: exact x', all(x3 == xe))

        ! Largest pivot exactly 1: identity and a permutation, exact solution
        a3 = 0.0_${k}$
        a3(1,1) = 1.0_${k}$
        a3(2,2) = 1.0_${k}$
        a3(3,3) = 1.0_${k}$
        b3 = [3.0_${k}$, -1.0_${k}$, 2.0_${k}$]
        call gauss_solve(a3, b3, x3, info)
        call check_true(passed, 'gauss_solve, identity: info = 0, x = b', info == 0 .and. all(x3 == b3))
        a3 = 0.0_${k}$
        a3(1,3) = 1.0_${k}$
        a3(2,1) = 1.0_${k}$
        a3(3,2) = 1.0_${k}$
        call gauss_solve(a3, b3, x3, info)
        call check_true(passed, 'gauss_solve, permutation: info = 0, exact x', &
                        info == 0 .and. all(x3 == [-1.0_${k}$, 2.0_${k}$, 3.0_${k}$]))

        ! Zero column c = 1, 2 (zero pivot at an elimination step) and 3 (zero last pivot)
        do c = 1, 3
            a3 = reshape([2.0_${k}$, 1.0_${k}$, -1.0_${k}$, &
                          1.0_${k}$, 3.0_${k}$, 1.0_${k}$, &
                          -1.0_${k}$, 1.0_${k}$, 4.0_${k}$], [3, 3])
            a3(:, c) = 0.0_${k}$
            b3 = [1.0_${k}$, 2.0_${k}$, 3.0_${k}$]
            call gauss_solve(a3, b3, x3, info)
            write(label, '(a, i0)') 'gauss_solve, zero column ', c
            call check_true(passed, trim(label) // ': info = 1', info == 1)
        end do
        ! Zero last pivot of an exact elimination: proportional rows (2x2) and a duplicated row (3x3)
        a2 = reshape([1.0_${k}$, 2.0_${k}$, 2.0_${k}$, 4.0_${k}$], [2, 2])
        b2 = [1.0_${k}$, 1.0_${k}$]
        call gauss_solve(a2, b2, x2, info)
        call check_true(passed, 'gauss_solve, proportional rows: info = 1', info == 1)
        a3 = reshape([2.0_${k}$, 1.0_${k}$, 2.0_${k}$, &
                      1.0_${k}$, 3.0_${k}$, 1.0_${k}$, &
                      -1.0_${k}$, 1.0_${k}$, -1.0_${k}$], [3, 3])
        call gauss_solve(a3, b3, x3, info)
        call check_true(passed, 'gauss_solve, duplicated row: info = 1', info == 1)

        ! gauss_seidel: zero diagonal entry at every position (an otherwise regular system)
        do n = 1, 3
            a3 = reshape([2.0_${k}$, 1.0_${k}$, 0.0_${k}$, &
                          1.0_${k}$, 2.0_${k}$, 1.0_${k}$, &
                          0.0_${k}$, 1.0_${k}$, 2.0_${k}$], [3, 3])
            a3(n, n) = 0.0_${k}$
            b3 = [1.0_${k}$, 2.0_${k}$, 3.0_${k}$]
            x3 = 0.0_${k}$
            call gauss_seidel(a3, b3, x3, 1.0e-3_${k}$, 50, its, info)
            write(label, '(a, i0)') 'gauss_seidel, zero diagonal at ', n
            call check_true(passed, trim(label) // ': info = 2', info == 2)
        end do
        ! Unit diagonal, no coupling: exact after one sweep
        a3 = 0.0_${k}$
        a3(1,1) = 1.0_${k}$
        a3(2,2) = 1.0_${k}$
        a3(3,3) = 1.0_${k}$
        b3 = [3.0_${k}$, -1.0_${k}$, 2.0_${k}$]
        x3 = 0.0_${k}$
        call gauss_seidel(a3, b3, x3, 1.0e-3_${k}$, 50, its, info)
        call check_true(passed, 'gauss_seidel, identity: info = 0, its = 1, x = b', &
                        info == 0 .and. its == 1 .and. all(x3 == b3))
    end function test_host_status_${k}$

    logical function test_near_singular_${k}$() result(passed)
        !! Nearly singular `real(${k}$)` system [[1, 1], [1, 1 + d]] x = [2, 2 + d], d = ${'2^-20' if k == 'sp' else '2^-40'}$:
        !! kappa_inf = (2 + d)^2 / d ~ ${'4.2e6' if k == 'sp' else '4.4e12'}$. Every operation of the elimination is
        !! exact (d is a power of 2), so OK_FLAG = .true., x = (1, 1) exactly and KAPPA is the exact
        !! value up to the rounding of its final products (relative 4 eps).
        use muscle_kinds, only : ${k}$
        use muscle_test_utils, only : check_true
        use muscle_math_lu_solve, only : LU2SOLVE
        real(${k}$) :: a(2,2), b(2), x(2), d, kappa, kexact
        logical :: ok

        passed = .true.
        d = 2.0_${k}$**(${-20 if k == 'sp' else -40}$)
        a = reshape([1.0_${k}$, 1.0_${k}$, 1.0_${k}$, 1.0_${k}$ + d], [2, 2])
        b = [2.0_${k}$, 2.0_${k}$ + d]
        kexact = (2.0_${k}$ + d)**2 / d
        call LU2SOLVE(a, b, x, ok, kappa)
        call check_true(passed, 'near singular: solved', ok)
        call check_true(passed, 'near singular: x = (1, 1)', all(x == [1.0_${k}$, 1.0_${k}$]))
        call check_true(passed, 'near singular: KAPPA large and finite', &
                        kappa > ${'1.0e6' if k == 'sp' else '1.0e12'}$_${k}$ .and. kappa < huge(1.0_${k}$))
        call check_true(passed, 'near singular: KAPPA exact', &
                        abs(kappa - kexact) <= 4.0_${k}$ * epsilon(1.0_${k}$) * kexact)
    end function test_near_singular_${k}$

    logical function test_singular_${k}$() result(passed)
        !! `real(${k}$)` singular systems (zero matrix, zero column at every position, NaN and +-Inf at every
        !! position, duplicated integer row) give OK_FLAG = .false., x = 0 and KAPPA = huge, n = 1..9; unsupported sizes
        !! and inconsistent shapes of `lu_solve` give the same.
        use, intrinsic :: ieee_arithmetic, only : ieee_value, ieee_positive_inf
        use muscle_kinds, only : ${k}$
        use muscle_test_helpers, only : park_miller, rnd
        use muscle_test_utils, only : check_true
        use muscle_math_lu_solve, only : lu_solve, LU_SOLVE_MAX_N
        use muscle_math_fp, only : QUIET_NAN_${k}$
        type(park_miller) :: rng
        real(${k}$), allocatable :: a(:,:), b(:), x(:)
        real(${k}$) :: kappa
        logical :: ok
        integer :: n, c, i, j, r
        character(len=64) :: label

        passed = .true.
        rng = park_miller(31102026)
        do n = 1, LU_SOLVE_MAX_N
            allocate(a(n,n), b(n), x(n))
            do j = 1, n
                b(j) = real(rnd(rng), ${k}$)
            end do
            ! Zero matrix
            a = 0.0_${k}$
            x = -1.0_${k}$
            call lu_solve(a, b, x, ok, kappa)
            write(label, '(a, i0)') 'zero matrix, n = ', n
            call check_true(passed, trim(label), .not. ok .and. all(x == 0.0_${k}$) &
                            .and. kappa == huge(1.0_${k}$))
            ! Zero column c (exactly zero pivot at step c at the latest)
            do c = 1, n
                do j = 1, n
                    do i = 1, n
                        a(i,j) = real(rnd(rng), ${k}$)
                    end do
                end do
                a(:,c) = 0.0_${k}$
                x = -1.0_${k}$
                call lu_solve(a, b, x, ok, kappa)
                write(label, '(a, i0, a, i0)') 'zero column ', c, ', n = ', n
                call check_true(passed, trim(label), .not. ok .and. all(x == 0.0_${k}$) &
                                .and. kappa == huge(1.0_${k}$))
            end do
            ! NaN at every position: it reaches a pivot (0 * NaN = NaN spreads it down its column),
            ! so the system is reported singular. Raises IEEE invalid (cleared by the program).
            do c = 1, n*n
                do j = 1, n
                    do i = 1, n
                        a(i,j) = real(rnd(rng), ${k}$) + merge(real(n, ${k}$), 0.0_${k}$, i == j)
                    end do
                end do
                a(mod(c - 1, n) + 1, (c - 1) / n + 1) = QUIET_NAN_${k}$()
                x = -1.0_${k}$
                call lu_solve(a, b, x, ok, kappa)
                write(label, '(a, i0, a, i0)') 'NaN at ', c, ', n = ', n
                call check_true(passed, trim(label), .not. ok .and. all(x == 0.0_${k}$) &
                                .and. kappa == huge(1.0_${k}$))
            end do
            ! +Inf and -Inf at every position (D-034): an infinite entry reaches a pivot as Inf or NaN
            ! (Inf - Inf, 0 * Inf), so the system is reported invalid like a singular one.
            do c = 1, 2*n*n
                do j = 1, n
                    do i = 1, n
                        a(i,j) = real(rnd(rng), ${k}$) + merge(real(n, ${k}$), 0.0_${k}$, i == j)
                    end do
                end do
                a(mod(c - 1, n) + 1, mod((c - 1) / n, n) + 1) = merge(1.0_${k}$, -1.0_${k}$, c <= n*n) &
                                                              * ieee_value(1.0_${k}$, ieee_positive_inf)
                x = -1.0_${k}$
                call lu_solve(a, b, x, ok, kappa)
                write(label, '(a, i0, a, i0)') 'Inf at ', c, ', n = ', n
                call check_true(passed, trim(label), .not. ok .and. all(x == 0.0_${k}$) &
                                .and. kappa == huge(1.0_${k}$))
            end do
            ! Identity with +-Inf off the diagonal (coverage of exactly zero multipliers; the code before D-034
            ! passes it too): above the diagonal the Inf reaches a pivot as 0 * Inf = NaN, below it the Inf is a
            ! pivot and leaves an exactly zero one
            do c = 1, 2*n*n
                i = mod(c - 1, n) + 1
                j = mod((c - 1) / n, n) + 1
                if (i == j) cycle
                a = 0.0_${k}$
                do r = 1, n
                    a(r,r) = 1.0_${k}$
                end do
                a(i,j) = merge(1.0_${k}$, -1.0_${k}$, c <= n*n) * ieee_value(1.0_${k}$, ieee_positive_inf)
                x = -1.0_${k}$
                call lu_solve(a, b, x, ok, kappa)
                write(label, '(a, i0, a, i0, a, i0)') 'identity with Inf at ', i, ',', j, ', n = ', n
                call check_true(passed, trim(label), .not. ok .and. all(x == 0.0_${k}$) &
                                .and. kappa == huge(1.0_${k}$))
            end do
            ! Duplicated row of small integers: the elimination gives an exactly zero row
            if (n >= 2) then
                do j = 1, n
                    do i = 1, n
                        a(i,j) = real(nint(4.0_${k}$ * real(rnd(rng), ${k}$)), ${k}$) + merge(9.0_${k}$, 0.0_${k}$, i == j)
                    end do
                end do
                a(n,:) = a(1,:)
                x = -1.0_${k}$
                call lu_solve(a, b, x, ok)
                write(label, '(a, i0)') 'duplicated row, n = ', n
                call check_true(passed, trim(label), .not. ok .and. all(x == 0.0_${k}$))
            end if
            deallocate(a, b, x)
        end do

        ! Unsupported size and inconsistent shapes
        n = LU_SOLVE_MAX_N + 1
        allocate(a(n,n), b(n), x(n))
        a = 0.0_${k}$
        do i = 1, n
            a(i,i) = 1.0_${k}$
        end do
        b = 1.0_${k}$
        x = -1.0_${k}$
        call lu_solve(a, b, x, ok, kappa)
        call check_true(passed, 'unsupported size', .not. ok .and. all(x == 0.0_${k}$) .and. kappa == huge(1.0_${k}$))
        x = -1.0_${k}$
        call lu_solve(a(1:3,1:4), b(1:3), x(1:3), ok)
        call check_true(passed, 'non-square A', .not. ok .and. all(x(1:3) == 0.0_${k}$))
        x = -1.0_${k}$
        call lu_solve(a(1:3,1:3), b(1:4), x(1:3), ok)
        call check_true(passed, 'b of the wrong size', .not. ok .and. all(x(1:3) == 0.0_${k}$))
        deallocate(a, b, x)
    end function test_singular_${k}$

    #:endfor
end program test_math_lu_solve
