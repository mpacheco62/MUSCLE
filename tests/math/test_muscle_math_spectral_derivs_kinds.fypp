#:include "muscle_common.fypp"
#!
#! Spectral routines (eigenvals, spectral_decomposition, dEigenvalues_dTensor,
#! d2Eigenvalues_dTensor2, spectral_gradient, spectral_hessian) in every kind against independent
#! double precision references, at stress scales far from 1 (1e-3 ... 2.1e5) and with distinct,
#! nearly repeated, exactly repeated (double and triple) eigenvalues, randomly rotated (D-016.6).
#!
#! References (dp) are computed from the input actually passed (the tensor of kind k converted
#! exactly to dp): eigenpairs by cyclic Jacobi, H_a = v_a (x) v_a, the eigenvalue Hessian
#! d2 lam_a/dS2 : dS = sum_(b /= a) 2 (v_a.dS.v_b)/(lam_a - lam_b) sym(v_a (x) v_b), and for
#! phi = tr(S^3): dphi/dS = 3 S^2, d2phi/dS2 : dS = 3 (S dS + dS S).
#! Where the eigenvalue derivatives do not exist (repeated roots) the routines return their
#! documented regularization: the singular roots of dEigenvalues_dTensor share the remaining
#! projector ((I - v_g (x) v_g)/2, or I/3), those of d2Eigenvalues_dTensor2 get -1/2 of the regular
#! Hessian (or 0). The regime of each root is predicted from the reference eigenvalues with the
#! relative thresholds of D-016.6 (EPS_TOL, EPS_TOL_SECOND relative to max lam^2): distinct if
#! D_rel = |(lam_a - lam_b)(lam_a - lam_c)|/max lam^2 > 3 T, singular if < T/3, otherwise not
#! checked individually (counted and printed). Invariant checks hold in every regime:
#! sum_a H_a = I, H_a : S = lam_a, |H_a| <= 1, sum_a d2 lam_a = 0, d2 lam_a : S = 0 (lam_a is
#! homogeneous of degree 1).
#!
#! Errors are normalized by eps = epsilon(1.0_k) and, where the problem itself is ill-conditioned,
#! by the amplification of the relative eigenvalue gap g (min |lam_a - lam_b|/max|lam|): eigenvector
#! and first-derivative errors grow like eps/g, eigenvalue-Hessian errors like eps/g^2 (measured:
#! err*g/eps reached 3.7e3 at g = 1e-4 in dp, err*g^2/eps <= 12 everywhere). Clustered roots
#! (|lam_a - lam_b| <= 0.05 max|lam|) are compared through their cluster projector, normalized by
#! the separation sep between clusters. Each check is err * amplification / eps <= C.
#! Measured maxima of err*amp/eps over 300 rotations per (scale, case), both kinds (gfortran
#! Debug), and chosen C (about 10x; 8x for the Hessians):
#!   eigenvals 53 (dp, double root) -> 500; V L V^T 6.2 -> 60; V^T V 5 -> 50; cluster projectors 37
#!   -> 400; resolved projectors 6.5 -> 60; dEig distinct 7 -> 70, singular 2.5 -> 30, sum 3.5 -> 40,
#!   H:S 54 -> 500, |H| - 1 3.4 -> 40; d2Eig distinct 12 -> 100, singular 6 -> 60, sum 12 -> 100,
#!   Hess:S 11 -> 100; spectral_gradient 8.3 -> 80; spectral_hessian 7.5 -> 80.
#! The test fails with the historical absolute thresholds (D-016.6 mutation, checked once): |H_a| up
#! to 5.8 (sp) and 15 (dp) at scales 1e3 / 2.1e5 with repeated roots, H_a = I/3 for distinct roots
#! at scale 1e-3, Hessians off by up to 1e33 eps.
#:set CHECKS = [ &
    & ('eigenvals vs Jacobi                   |dlam|/s', 500), &
    & ('decomposition V L V^T = S             /s', 60), &
    & ('decomposition V^T V = I', 50), &
    & ('cluster projectors vs Jacobi          *sep', 400), &
    & ('eigenvector projectors (resolved)     *gap', 60), &
    & ('dEig distinct: H_a = v_a(x)v_a        *gap', 70), &
    & ('dEig singular: cluster average        *sep', 30), &
    & ('dEig sum_a H_a = I                    *gap', 40), &
    & ('dEig H_a : S = lam_a                  /s *gap', 500), &
    & ('d2Eig distinct: analytic Hessian      *gap^2', 100), &
    & ('d2Eig singular: -1/2 regular or 0     *sep', 60), &
    & ('d2Eig sum_a = 0                       *gap^2', 100), &
    & ('d2Eig Hessian_a : S = 0               *gap^2', 100), &
    & ('spectral_gradient = 3 S^2', 80), &
    & ('spectral_hessian : dS = 3(S dS+dS S)  *gap', 80), &
    & ('dEig |H_a| - 1 <= 0 (projector norm)  *gap', 40)]
#! Thresholds of muscle_math_spectral_derivs (D-016.6, relative), used only to predict the regime
#:set EPS_TOL = {'sp': '1.0e-5', 'dp': '1.0e-11'}
#:set EPS_TOL_SECOND = {'sp': '2.0e-3', 'dp': '1.0e-6'}
#:set REPEATED_TOL = {'sp': '1.0e-4', 'dp': '1.0e-9'}

program test_math_spectral_kinds
    !! Spectral routines of `muscle_math_eigen` / `muscle_math_spectral_derivs` in every kind,
    !! at several stress scales and eigenvalue multiplicities, against dp references.
    use muscle_kinds, only : sp, dp
    use muscle_tensors
    use muscle_math_eigen, only : eigenvals, spectral_decomposition
    use muscle_math_spectral_derivs, only : dEigenvalues_dTensor, d2Eigenvalues_dTensor2, spectral_gradient, &
        spectral_hessian
    use muscle_test_utils, only : check_true
    use muscle_test_helpers, only : park_miller, rnd, rotation_ref, eye, record
    implicit none

    integer, parameter :: NCHK = ${len(CHECKS)}$
    character(len=48), parameter :: CHK_NAME(NCHK) = [character(len=48) :: &
        ${', &\n        '.join("'" + c[0] + "'" for c in CHECKS)}$]
    real(dp), parameter :: CHK_TOL(NCHK) = [${', '.join('{}.0_dp'.format(c[1]) for c in CHECKS)}$]
    real(dp), parameter :: SCALES(5) = [1.0e-3_dp, 1.0_dp, 10.0_dp, 1.0e3_dp, 2.1e5_dp]
    integer, parameter :: NCASE = 10, NROT = 20
    real(dp) :: worst(NCHK)
    character(len=64) :: worst_at(NCHK)
    integer :: n_ambiguous
    integer :: code

    code = 0
    #:for i, k in enumerate(REAL_KINDS)
    call record(test_scales_${k}$(), ${i + 1}$, 'spectral routines at several scales ${k}$', code)
    call record(test_zero_${k}$(), ${i + 11}$, 'spectral routines at the zero tensor ${k}$', code)
    #:endfor
    if (code /= 0) stop code

contains

    pure function mat_of(v) result(m)
        !! Symmetric matrix of a tensorial Voigt vector (11, 22, 33, 12, 23, 13).
        real(dp), intent(in) :: v(6)
        real(dp) :: m(3,3)
        m = reshape([v(1), v(4), v(6), v(4), v(2), v(5), v(6), v(5), v(3)], [3, 3])
    end function mat_of

    pure function voigt_of(m) result(v)
        !! Tensorial Voigt vector of the symmetric part of a matrix.
        real(dp), intent(in) :: m(3,3)
        real(dp) :: v(6)
        v = [m(1,1), m(2,2), m(3,3), 0.5_dp*(m(1,2) + m(2,1)), 0.5_dp*(m(2,3) + m(3,2)), &
             0.5_dp*(m(1,3) + m(3,1))]
    end function voigt_of

    pure function outer(x, y) result(m)
        !! x (x) y.
        real(dp), intent(in) :: x(3), y(3)
        real(dp) :: m(3,3)
        integer :: j
        do j = 1, 3
            m(:, j) = x*y(j)
        end do
    end function outer

    pure function vddot(x, y) result(r)
        !! x : y of two tensorial Voigt vectors (shear terms counted twice).
        real(dp), intent(in) :: x(6), y(6)
        real(dp) :: r
        r = sum(x(1:3)*y(1:3)) + 2.0_dp*sum(x(4:6)*y(4:6))
    end function vddot

    subroutine jacobi_ref(a_in, lam, v)
        !! Eigenpairs of a symmetric 3x3 dp matrix by cyclic Jacobi rotations (Numerical Recipes,
        !! Sec. 11.1), eigenvalues in descending order: an algorithm independent of the closed forms
        !! under test, accurate to a few eps |A| also for repeated eigenvalues.
        real(dp), intent(in) :: a_in(3,3)
        real(dp), intent(out) :: lam(3), v(3,3)
        real(dp) :: a(3,3), theta, t, c, s, x, y, tmp(3)
        integer :: sweep, p, q, i, j
        a = a_in
        v = eye(3)
        do sweep = 1, 30
            if (a(1,2)**2 + a(1,3)**2 + a(2,3)**2 <= tiny(1.0_dp)) exit
            do p = 1, 2
                do q = p + 1, 3
                    ! Off-diagonal terms below 1e-6 eps |A| change no eigenvalue by more than that
                    if (abs(a(p,q)) <= 1.0e-6_dp*epsilon(1.0_dp)*(abs(a(p,p)) + abs(a(q,q)))) then
                        a(p,q) = 0.0_dp
                        a(q,p) = 0.0_dp
                        cycle
                    end if
                    theta = (a(q,q) - a(p,p))/(2.0_dp*a(p,q))
                    t = sign(1.0_dp, theta)/(abs(theta) + sqrt(theta*theta + 1.0_dp))
                    c = 1.0_dp/sqrt(t*t + 1.0_dp)
                    s = t*c
                    do i = 1, 3
                        x = a(i,p)
                        y = a(i,q)
                        a(i,p) = c*x - s*y
                        a(i,q) = s*x + c*y
                    end do
                    do i = 1, 3
                        x = a(p,i)
                        y = a(q,i)
                        a(p,i) = c*x - s*y
                        a(q,i) = s*x + c*y
                    end do
                    do i = 1, 3
                        x = v(i,p)
                        y = v(i,q)
                        v(i,p) = c*x - s*y
                        v(i,q) = s*x + c*y
                    end do
                end do
            end do
        end do
        lam = [a(1,1), a(2,2), a(3,3)]
        do i = 1, 2
            j = maxloc(lam(i:3), 1) + i - 1
            if (j /= i) then
                x = lam(i)
                lam(i) = lam(j)
                lam(j) = x
                tmp = v(:, i)
                v(:, i) = v(:, j)
                v(:, j) = tmp
            end if
        end do
    end subroutine jacobi_ref

    subroutine track(ic, err, label)
        !! Keeps the worst normalized error of check `ic` and where it happened.
        integer, intent(in) :: ic
        real(dp), intent(in) :: err
        character(len=*), intent(in) :: label
        if (err > worst(ic) .or. err /= err) then
            worst(ic) = err
            worst_at(ic) = label
        end if
    end subroutine track

    pure function hessian_ref(lr, vr, a, dsm) result(act)
        !! sum_(b /= a) 2 (v_a.dS.v_b)/(lam_a - lam_b) sym(v_a (x) v_b), as a Voigt vector.
        real(dp), intent(in) :: lr(3), vr(3,3), dsm(3,3)
        integer, intent(in) :: a
        real(dp) :: act(6)
        integer :: b
        act = 0.0_dp
        do b = 1, 3
            if (b == a) cycle
            act = act + 2.0_dp*dot_product(vr(:, a), matmul(dsm, vr(:, b)))/(lr(a) - lr(b)) &
                  *voigt_of(outer(vr(:, a), vr(:, b)))
        end do
    end function hessian_ref

    function report(passed_in, kind_name) result(passed)
        !! Prints the table of worst normalized errors and checks them against `CHK_TOL`.
        logical, intent(in) :: passed_in
        character(len=*), intent(in) :: kind_name
        logical :: passed
        integer :: ic
        passed = passed_in
        print '(a)', ' Spectral routines, ' // kind_name // ': worst err*amplification/eps (tolerance) [where]'
        do ic = 1, NCHK
            print '(3x, a, es10.2, " (", f6.0, ")  [", a, "]")', CHK_NAME(ic), worst(ic), CHK_TOL(ic), &
                trim(worst_at(ic))
            call check_true(passed, kind_name // ': ' // trim(CHK_NAME(ic)) // ' at ' // trim(worst_at(ic)), &
                            worst(ic) <= CHK_TOL(ic))
        end do
        print '(3x, a, i0)', 'roots in the ambiguous band of a threshold (not checked individually): ', &
            n_ambiguous
    end function report

    #:for k in REAL_KINDS
    #:set T2 = tname('3D2Osym', k)
    #:set T4 = tname('3D4O3sym', k)

    function test_scales_${k}$() result(passed)
        !! All routines in `real(${k}$)` over scales x cases x random rotations.
        logical :: passed
        real(dp), parameter :: EPS = real(epsilon(1.0_${k}$), dp)
        real(dp), parameter :: T_FIRST = ${EPS_TOL[k]}$_dp, T_SECOND = ${EPS_TOL_SECOND[k]}$_dp
        real(dp), parameter :: T_REP = ${REPEATED_TOL[k]}$_dp
        real(dp) :: shapes(3, NCASE), q(3,3), sd(3,3), am(3,3), dsm(3,3), lr(3), vr(3,3)
        real(dp) :: s, ld(3), vd(3,3), hd(6,3), proj(3,3), proj_ref(3,3), gap(3), drel(3), sep
        real(dp) :: ref(6,3), act(6,3), hscale, g1, g2, gall, err, dsv(6), ev(6), hmax
        character(len=14) :: cname(NCASE)
        character(len=64) :: lab
        integer :: cl(3), regime(3), isc, ic, ir, a, b, nsing, good
        type(park_miller) :: rng
        type(${T2}$) :: t, ds, h(3), grad, ht
        type(${T4}$) :: hess(3), shess
        real(${k}$) :: lam_e(3), lam(3), v(3,3)

        passed = .true.
        worst = 0.0_dp
        worst_at = ''
        n_ambiguous = 0
        hmax = 0.0_dp
        rng = park_miller(20261031)

        shapes(:, 1) = [1.0_dp, 0.3_dp, -0.7_dp]
        cname(1) = 'distinct'
        shapes(:, 2) = [1.0_dp, 0.0_dp, -1.0_dp]
        cname(2) = 'pure shear'
        shapes(:, 3) = [1.0_dp, 1.0_dp - 1.0e-2_dp, -0.5_dp]
        cname(3) = 'near 1e-2'
        shapes(:, 4) = [0.6_dp, -0.8_dp + 1.0e-4_dp, -0.8_dp]
        cname(4) = 'near 1e-4'
        shapes(:, 5) = [1.0_dp, 1.0_dp - 10.0_dp*EPS, -0.5_dp]
        cname(5) = 'near 10 eps'
        shapes(:, 6) = [1.0_dp, 1.0_dp, -0.5_dp]
        cname(6) = 'double top'
        shapes(:, 7) = [0.4_dp, -1.0_dp, -1.0_dp]
        cname(7) = 'double bottom'
        shapes(:, 8) = [1.0_dp, 0.0_dp, 0.0_dp]
        cname(8) = 'uniaxial'
        shapes(:, 9) = [1.0_dp, 1.0_dp, 1.0_dp]
        cname(9) = 'triple'
        shapes(:, 10) = [-1.0_dp, -1.0_dp, -1.0_dp]
        cname(10) = 'triple neg'

        do isc = 1, size(SCALES)
        do ic = 1, NCASE
        do ir = 1, NROT
            write(lab, '(a, " s=", es7.1, " rot ", i0)') trim(cname(ic)), SCALES(isc), ir
            q = rotation_ref(rng)
            sd = SCALES(isc)*matmul(q, matmul(reshape([shapes(1, ic), 0.0_dp, 0.0_dp, 0.0_dp, &
                 shapes(2, ic), 0.0_dp, 0.0_dp, 0.0_dp, shapes(3, ic)], [3, 3]), transpose(q)))
            if (ic >= 9) then
                ! Triple root as a kind-k computation produces it: s I plus noise of the size of
                ! the rounding of kind k (rotating s I in dp instead leaves off-diagonal terms
                ! ~eps_dp s, the case of test_math_spectral_tiny_shear)
                do a = 1, 6
                    ev(a) = rnd(rng)
                end do
                sd = sd + SCALES(isc)*EPS*mat_of(ev)
            end if
            t%vals = real(voigt_of(sd), ${k}$)
            am = mat_of(real(t%vals, dp))
            do a = 1, 6
                dsv(a) = rnd(rng)
            end do
            ds%vals = real(dsv, ${k}$)
            dsv = real(ds%vals, dp)
            dsm = mat_of(dsv)
            call jacobi_ref(am, lr, vr)
            s = maxval(abs(lr))

            ! Relative gaps, clusters (|lam_a - lam_b| <= 0.05 s) and their separation
            do a = 1, 3
                gap(a) = huge(1.0_dp)
                do b = 1, 3
                    if (b /= a) gap(a) = min(gap(a), abs(lr(a) - lr(b))/s)
                end do
            end do
            cl = [1, 2, 3]
            if (abs(lr(1) - lr(2)) <= 0.05_dp*s) cl(2) = cl(1)
            if (abs(lr(2) - lr(3)) <= 0.05_dp*s) cl(3) = cl(2)
            sep = 1.0_dp
            do a = 1, 3
                do b = 1, 3
                    if (cl(a) /= cl(b)) sep = min(sep, abs(lr(a) - lr(b))/s)
                end do
            end do
            gall = min(1.0_dp, minval(gap))

            ! eigenvals
            lam_e = eigenvals(t)
            call track(1, maxval(abs(real(lam_e, dp) - lr))/s/EPS, lab)

            ! spectral_decomposition
            call spectral_decomposition(t, lam, v)
            ld = real(lam, dp)
            vd = real(v, dp)
            call check_true(passed, '${k}$ decomposition: descending order ' // lab, &
                            lam(1) >= lam(2) .and. lam(2) >= lam(3))
            call track(2, maxval(abs(matmul(vd, matmul(reshape([ld(1), 0.0_dp, 0.0_dp, 0.0_dp, ld(2), &
                       0.0_dp, 0.0_dp, 0.0_dp, ld(3)], [3, 3]), transpose(vd))) - am))/s/EPS, lab)
            call track(3, maxval(abs(matmul(transpose(vd), vd) - eye(3)))/EPS, lab)
            do a = 1, 3
                proj = 0.0_dp
                proj_ref = 0.0_dp
                do b = 1, 3
                    if (cl(b) /= cl(a)) cycle
                    proj = proj + outer(vd(:, b), vd(:, b))
                    proj_ref = proj_ref + outer(vr(:, b), vr(:, b))
                end do
                call track(4, maxval(abs(proj - proj_ref))*sep/EPS, lab)
                if (gap(a) > 1.0e3_dp*EPS) then
                    call track(5, maxval(abs(outer(vd(:, a), vd(:, a)) - outer(vr(:, a), vr(:, a)))) &
                               *min(gap(a), 1.0_dp)/EPS, lab)
                end if
            end do

            ! dEigenvalues_dTensor: regime of each root, then distinct / singular / invariants
            h = dEigenvalues_dTensor(t, lam_e)
            do a = 1, 3
                hd(:, a) = real(h(a)%vals, dp)
            end do
            do a = 1, 3
                drel(a) = abs((lr(a) - lr(mod(a, 3) + 1))*(lr(a) - lr(mod(a + 1, 3) + 1)))/maxval(lr**2)
            end do
            call regimes(drel, T_FIRST, regime, nsing, good)
            g1 = 1.0_dp
            do a = 1, 3
                if (regime(a) == 1) g1 = min(g1, gap(a))
            end do
            do a = 1, 3
                if (regime(a) == 1) then
                    call track(6, maxval(abs(hd(:, a) - voigt_of(outer(vr(:, a), vr(:, a))))) &
                               *min(gap(a), 1.0_dp)/EPS, lab)
                else if (regime(a) == 2) then
                    if (nsing == 2) then
                        ev = 0.5_dp*voigt_of(eye(3) - outer(vr(:, good), vr(:, good)))
                    else
                        ev = voigt_of(eye(3))/3.0_dp
                    end if
                    call track(7, maxval(abs(hd(:, a) - ev))*sep/EPS, lab)
                end if
                hmax = max(hmax, sqrt(vddot(hd(:, a), hd(:, a))))
                call track(16, max(0.0_dp, sqrt(vddot(hd(:, a), hd(:, a))) - 1.0_dp)*g1/EPS, lab)
                call track(9, abs(vddot(hd(:, a), voigt_of(am)) - lr(a))/s*g1/EPS, lab)
            end do
            if (nsing == 1) call check_true(passed, '${k}$ dEig: a single root predicted singular ' // lab, .false.)
            call track(8, maxval(abs(hd(:, 1) + hd(:, 2) + hd(:, 3) - voigt_of(eye(3))))*g1/EPS, lab)

            ! d2Eigenvalues_dTensor2, through its action on dS
            hess = d2Eigenvalues_dTensor2(t, lam_e, h)
            do a = 1, 3
                ht = hess(a) .ddot. ds
                act(:, a) = real(ht%vals, dp)
                drel(a) = abs((lr(a) - lr(mod(a, 3) + 1))*(lr(a) - lr(mod(a + 1, 3) + 1)))/maxval(lr**2)
            end do
            call regimes(drel, T_SECOND, regime, nsing, good)
            ref = 0.0_dp
            hscale = 1.0_dp/s
            g2 = 1.0_dp
            do a = 1, 3
                if (regime(a) /= 2) then
                    ref(:, a) = hessian_ref(lr, vr, a, dsm)
                    hscale = max(hscale, maxval(abs(ref(:, a))))
                end if
                if (regime(a) == 1) g2 = min(g2, gap(a))
            end do
            do a = 1, 3
                if (regime(a) == 1) then
                    call track(10, maxval(abs(act(:, a) - ref(:, a)))/hscale*min(gap(a), 1.0_dp)**2/EPS, lab)
                else if (regime(a) == 2) then
                    ev = 0.0_dp
                    if (nsing == 2) ev = -0.5_dp*ref(:, good)
                    call track(11, maxval(abs(act(:, a) - ev))/hscale*sep/EPS, lab)
                end if
                ht = hess(a) .ddot. t
                err = maxval(abs(real(ht%vals, dp)))
                call track(13, err/(hscale/maxval(abs(dsv))*s)*g2**2/EPS, lab)
            end do
            if (nsing == 1) call check_true(passed, '${k}$ d2Eig: a single root predicted singular ' // lab, .false.)
            call track(12, maxval(abs(act(:, 1) + act(:, 2) + act(:, 3)))/hscale*g2**2/EPS, lab)

            ! spectral_gradient and spectral_hessian of phi = tr(S^3)
            grad = spectral_gradient(v, 3.0_${k}$*lam**2)
            call track(14, maxval(abs(real(grad%vals, dp) - voigt_of(3.0_dp*matmul(am, am))))/(3.0_dp*s**2)/EPS, lab)
            shess = spectral_hessian(lam, v, 3.0_${k}$*lam**2, reshape([6.0_${k}$*lam(1), 0.0_${k}$, 0.0_${k}$, &
                    0.0_${k}$, 6.0_${k}$*lam(2), 0.0_${k}$, 0.0_${k}$, 0.0_${k}$, 6.0_${k}$*lam(3)], [3, 3]))
            ev = voigt_of(3.0_dp*(matmul(am, dsm) + matmul(dsm, am)))
            ht = shess .ddot. ds
            call track(15, maxval(abs(real(ht%vals, dp) - ev))/(6.0_dp*s*maxval(abs(dsv))) &
                       *max(gall, T_REP)/EPS, lab)
        end do
        end do
        end do
        passed = report(passed, '${k}$')
        print '(3x, a, es10.3)', 'largest |H_a| (Frobenius) of dEigenvalues_dTensor: ', hmax
    end function test_scales_${k}$

    function test_zero_${k}$() result(passed)
        !! Zero tensor in `real(${k}$)`: every root singular, isotropic results without NaN.
        logical :: passed
        type(${T2}$) :: t, h(3), grad
        type(${T4}$) :: hess(3), shess
        real(${k}$) :: lam_e(3), lam(3), v(3,3)
        integer :: a

        passed = .true.
        t%vals = 0.0_${k}$
        lam_e = eigenvals(t)
        call check_true(passed, '${k}$ zero: eigenvals = 0', all(lam_e == 0.0_${k}$))
        call spectral_decomposition(t, lam, v)
        call check_true(passed, '${k}$ zero: decomposition lam = 0', all(lam == 0.0_${k}$))
        call check_true(passed, '${k}$ zero: decomposition V orthonormal', &
                        all(abs(real(matmul(transpose(v), v), dp) - eye(3)) <= 0.0_dp))
        h = dEigenvalues_dTensor(t, lam_e)
        hess = d2Eigenvalues_dTensor2(t, lam_e, h)
        do a = 1, 3
            call check_true(passed, '${k}$ zero: H_a = I/3', &
                            all(abs(real(h(a)%vals, dp) - voigt_of(eye(3))/3.0_dp) <= real(epsilon(1.0_${k}$), dp)))
            call check_true(passed, '${k}$ zero: d2 lam_a = 0', all(hess(a)%vals == 0.0_${k}$))
        end do
        grad = spectral_gradient(v, [0.0_${k}$, 0.0_${k}$, 0.0_${k}$])
        call check_true(passed, '${k}$ zero: spectral_gradient = 0', all(grad%vals == 0.0_${k}$))
        shess = spectral_hessian(lam, v, [0.0_${k}$, 0.0_${k}$, 0.0_${k}$], reshape([(1.0_${k}$, a = 1, 9)], [3, 3]))
        call check_true(passed, '${k}$ zero: spectral_hessian finite', all(abs(shess%vals) < huge(1.0_${k}$)))
    end function test_zero_${k}$
    #:endfor

    subroutine regimes(drel, thr, regime, nsing, good)
        !! Predicted branch of each root: 1 distinct (drel > 3 thr), 2 singular (drel < thr/3),
        !! 0 ambiguous (counted in n_ambiguous). `good` is a distinct root when nsing = 2.
        real(dp), intent(in) :: drel(3), thr
        integer, intent(out) :: regime(3), nsing, good
        integer :: a
        nsing = 0
        good = 0
        do a = 1, 3
            if (drel(a) > 3.0_dp*thr) then
                regime(a) = 1
                good = a
            else if (drel(a) < thr/3.0_dp) then
                regime(a) = 2
                nsing = nsing + 1
            else
                regime(a) = 0
                n_ambiguous = n_ambiguous + 1
            end if
        end do
        ! A pair with one root in the band: its partner's expected value is not known either
        if (nsing == 2 .and. good == 0) then
            where (regime == 2) regime = 0
            n_ambiguous = n_ambiguous + 2
            nsing = 0
        end if
    end subroutine regimes

end program test_math_spectral_kinds
