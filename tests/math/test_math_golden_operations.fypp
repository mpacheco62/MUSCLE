#:include "muscle_common.fypp"
#:include "muscle_fd.fypp"

module math_golden_operations_funcs
    !! Deterministic test functions and inputs of the golden test of `muscle_math_operations`
    !! (module procedures, not internal ones).
    use muscle_kinds, only : dp
    use muscle_tensors, only : ten_3D2Osym
    use muscle_test_helpers, only : park_miller, rotation_ref
    implicit none
    private

    public :: hsym_1, hsym_2, hsym_0, rotated

    real(dp), parameter :: W6(6) = [0.9_dp, -0.7_dp, 0.5_dp, 1.3_dp, -1.1_dp, 0.8_dp]
        !! Weights of the linear form of `hsym_1`.

contains

    pure function hsym_1(t) result(res)
        !! exp(0.3 w . t) + t11 t22 t33 + t12 t23 t13 + weighted squares of a symmetric tensor.
        type(ten_3D2Osym), intent(in) :: t
            !! Argument.
        real(dp) :: res
            !! Value.
        integer :: i
        res = exp(0.3_dp*sum(W6*t%vals)) + t%vals(1)*t%vals(2)*t%vals(3) + t%vals(4)*t%vals(5)*t%vals(6)
        do i = 1, 6
            res = res + 0.25_dp*i*t%vals(i)**2
        end do
    end function hsym_1

    pure function hsym_2(t) result(res)
        !! sqrt(1 + J2) + 0.1 I1^3 + sin(t12 + 2 t23 - t13) of a symmetric tensor.
        type(ten_3D2Osym), intent(in) :: t
            !! Argument.
        real(dp) :: res
            !! Value.
        real(dp) :: j2, i1
        i1 = t%vals(1) + t%vals(2) + t%vals(3)
        j2 = ((t%vals(1) - t%vals(2))**2 + (t%vals(2) - t%vals(3))**2 + (t%vals(3) - t%vals(1))**2)/6.0_dp &
            + t%vals(4)**2 + t%vals(5)**2 + t%vals(6)**2
        res = sqrt(1.0_dp + j2) + 0.1_dp*i1**3 + sin(t%vals(4) + 2.0_dp*t%vals(5) - t%vals(6))
    end function hsym_2

    pure function hsym_0(t) result(res)
        !! sin(t12 + 2 t23 - t13) + t11 t22 + t33^2, which vanishes at the zero tensor.
        type(ten_3D2Osym), intent(in) :: t
            !! Argument.
        real(dp) :: res
            !! Value.
        res = sin(t%vals(4) + 2.0_dp*t%vals(5) - t%vals(6)) + t%vals(1)*t%vals(2) + t%vals(3)**2
    end function hsym_0

    function rotated(lam, rng) result(t)
        !! Symmetric tensor Q diag(lam) Q^T with a pseudo-random rotation Q (eigenvalues lam up
        !! to rounding), storage (11, 22, 33, 12, 23, 13).
        real(dp), intent(in) :: lam(3)
            !! Eigenvalues.
        type(park_miller), intent(inout) :: rng
            !! Generator.
        type(ten_3D2Osym) :: t
            !! Tensor.
        real(dp) :: q(3,3), m(3,3)
        integer :: i, j
        q = rotation_ref(rng)
        do j = 1, 3
            do i = 1, 3
                m(i, j) = q(i,1)*lam(1)*q(j,1) + q(i,2)*lam(2)*q(j,2) + q(i,3)*lam(3)*q(j,3)
            end do
        end do
        t%vals = [m(1,1), m(2,2), m(3,3), m(1,2), m(2,3), m(1,3)]
    end function rotated

end module math_golden_operations_funcs

program test_math_golden_operations
    !! Golden test of `muscle_math_operations` (double precision): `eigenvals` of symmetric 3x3
    !! tensors (distinct, double and triple eigenvalues, the "middle eigenvalue = mean" branch,
    !! exact and rotated cases) and the central gradient of a scalar function of a ten_3D2Osym of
    !! the former `derivative_escalar_tensor3x3sym` (generic `derivative`, removed with the
    !! `procedure(...)` API, D-018.18b), now `FD_GRAD` of `include/muscle_fd.fypp` with its step
    !! `rel = FD_STEP_CEN`; the keys keep the former names. The forward differences of a 3x3
    !! matrix (`derivative_escalar_tensor3x3`, `..._3x3sym2`) have no kernel equivalent: their
    !! records were removed (header of the reference). Results are compared bit for bit with
    !! `tests/reference/math/math_operations_dp.txt`, captured from the original code
    !! (`tests/reference/math/regenerate.sh`); compiled with -fno-inline (D-016.9).
    use muscle_kinds, only : dp
    use muscle_tensors, only : ten_3D2Osym
    use muscle_math_operations, only : eigenvals
    use muscle_test_helpers, only : park_miller, rnd
    use muscle_test_golden, only : golden_init, golden_check, golden_finish
    use math_golden_operations_funcs
    implicit none

    integer, parameter :: NRANDOM = 6
    real(dp), parameter :: MAGNITUDE(NRANDOM) = [1.0_dp, 0.05_dp, 3.0_dp, 250.0_dp, 1.0e-3_dp, 1.0_dp]
    type(park_miller) :: rng
    type(ten_3D2Osym) :: s, g
    real(dp) :: m(3,3)
    character(len=16) :: c
    integer :: icase, i, j

    call golden_init('math/math_operations_dp.txt')
    rng = park_miller(31102026)

    ! eigenvals: random tensors (distinct eigenvalues)
    do icase = 1, NRANDOM
        write(c, '(" | case ", i0)') icase
        do i = 1, 6
            s%vals(i) = MAGNITUDE(icase)*rnd(rng)
        end do
        call eig('random', c, s)
    end do
    ! eigenvals: exact special tensors
    call eig('diag distinct', ' | case 1', sym(3.0_dp, -1.0_dp, 0.5_dp, 0.0_dp, 0.0_dp, 0.0_dp))
    call eig('double exact', ' | case 1', sym(2.0_dp, 2.0_dp, 3.0_dp, 1.0_dp, 0.0_dp, 0.0_dp))
    call eig('double exact', ' | case 2', sym(3.0_dp, 3.0_dp, -1.0_dp, 0.0_dp, 0.0_dp, 0.0_dp))
    call eig('double exact', ' | case 3', sym(-1.0_dp, 3.0_dp, 3.0_dp, 0.0_dp, 0.0_dp, 0.0_dp))
    call eig('triple exact', ' | case 1', sym(2.5_dp, 2.5_dp, 2.5_dp, 0.0_dp, 0.0_dp, 0.0_dp))
    call eig('triple exact', ' | case 2', sym(0.0_dp, 0.0_dp, 0.0_dp, 0.0_dp, 0.0_dp, 0.0_dp))
    call eig('triple near', ' | case 1', sym(2.5_dp, 2.5_dp + 1.0e-12_dp, 2.5_dp, 0.0_dp, 1.0e-12_dp, 0.0_dp))
    call eig('triple near, above threshold', ' | case 1', &
             sym(2.5_dp, 2.5_dp + 1.0e-9_dp, 2.5_dp, 0.0_dp, 1.0e-9_dp, 0.0_dp))
    call eig('middle near mean', ' | case 1', sym(5.0_dp, 3.0_dp + 1.0e-11_dp, 1.0_dp, 0.0_dp, 0.0_dp, 0.0_dp))
    call eig('middle near mean', ' | case 2', sym(5.0_dp, 3.0_dp + 1.0e-8_dp, 1.0_dp, 0.0_dp, 0.0_dp, 0.0_dp))
    call eig('middle = mean', ' | case 1', sym(0.0_dp, 0.0_dp, 0.0_dp, 1.0_dp, 0.0_dp, 0.0_dp))
    call eig('middle = mean', ' | case 2', sym(5.0_dp, 3.0_dp, 1.0_dp, 0.0_dp, 0.0_dp, 0.0_dp))
    ! eigenvals: rotated tensors with prescribed eigenvalues
    call eig('rotated distinct', ' | case 1', rotated([4.0_dp, 1.5_dp, -2.0_dp], rng))
    call eig('rotated double', ' | case 1', rotated([4.0_dp, 4.0_dp, -2.0_dp], rng))
    call eig('rotated double', ' | case 2', rotated([4.0_dp, -2.0_dp, -2.0_dp], rng))
    call eig('rotated triple', ' | case 1', rotated([-7.0_dp, -7.0_dp, -7.0_dp], rng))
    call eig('rotated middle = mean', ' | case 1', rotated([3.0_dp, 1.0_dp, -1.0_dp], rng))

    ! Central gradient of a scalar function of a ten_3D2Osym (former derivative_escalar_tensor3x3sym)
    do icase = 1, 4
        write(c, '(" | case ", i0)') icase
        do i = 1, 6
            s%vals(i) = MAGNITUDE(icase)*rnd(rng)
        end do
        call golden_check('input ten_3D2Osym' // trim(c), s%vals)
#:for f in ['hsym_1', 'hsym_2']
        @:FD_GRAD(g, ${f}$({x}), s, dp, 3D, rel=FD_STEP_CEN)
        call golden_check('derivative(${f}$, ten_3D2Osym)' // trim(c), g%vals)
#:endfor
        ! Former 3x3 matrix input (its records were removed): still drawn, so that the inputs of
        ! the next cases do not change
        do j = 1, 3
            do i = 1, 3
                m(i, j) = MAGNITUDE(icase)*rnd(rng)
            end do
        end do
    end do
    ! Zero argument: the step is FD_STEP_ZERO (D-016.4)
    s%vals = 0.0_dp
#:for f in ['hsym_0', 'hsym_2']
    @:FD_GRAD(g, ${f}$({x}), s, dp, 3D, rel=FD_STEP_CEN, indent=4)
    call golden_check('derivative(${f}$, zero)', g%vals)
#:endfor
    call golden_finish()

contains

    function sym(t11, t22, t33, t12, t23, t13) result(t)
        !! Symmetric tensor from its components.
        real(dp), intent(in) :: t11, t22, t33, t12, t23, t13
            !! Components.
        type(ten_3D2Osym) :: t
            !! Tensor.
        t%vals = [t11, t22, t33, t12, t23, t13]
    end function sym

    subroutine eig(name, c, t)
        !! Records the input and the eigenvalues of `t`.
        character(len=*), intent(in) :: name
            !! Name of the case family.
        character(len=*), intent(in) :: c
            !! Case suffix.
        type(ten_3D2Osym), intent(in) :: t
            !! Tensor.
        call golden_check('input eigenvals ' // name // trim(c), t%vals)
        call golden_check('eigenvals ' // name // trim(c), eigenvals(t))
    end subroutine eig

end program test_math_golden_operations
