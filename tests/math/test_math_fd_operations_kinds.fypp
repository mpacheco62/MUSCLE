#:include "muscle_common.fypp"
#!
#! Host-only finite differences of muscle_math_operations (D-016.3) in every kind:
#! derivative_escalar_tensor3x3 (forward, 3x3 matrix), derivative_escalar_tensor3x3sym2 (forward,
#! symmetric pair perturbed together) and derivative_escalar_tensor3x3sym (central FD_GRAD on a
#! ten_3D2Osym, also through the generic `derivative`), against analytical derivatives at a generic
#! argument of order 1 and at the zero argument (D-016.4). The `derivative`/`derivative2O` of
#! muscle_math_derivatives are covered by test_math_fd_macros.
#!
#! Expected values: for f(X) with gradient g_ij = df/dX_ij, derivative_escalar_tensor3x3 gives g;
#! ..._3x3sym2 gives (g_ij + g_ji)/2 (the direction (e_ij + e_ji)/2); ..._3x3sym gives df/ds_p for a
#! normal component and df/ds_p / 2 for a stored shear component (tensorial Voigt, perturbed by h/2).
#!
#! Tolerances (relative to the largest component, |f| <~ 6, |f''| <~ 3 at the test points):
#! - Forward differences, absolute step h = FD_STEP_FWD (sp 3e-4, dp 1e-8): truncation h |f''|/2
#!   plus rounding 2 eps |f|/h: sp ~5e-4 + 5e-3, dp ~2e-8 + 3e-7. Measured max 1.6e-3 (sp) and
#!   5.2e-8 (dp); tolerance 1e-2 (sp), 1e-6 (dp).
#! - Central differences (FD_GRAD, rel = FD_STEP_CEN: sp 5e-3, dp 1e-7, h = rel at the zero
#!   argument): as in test_math_fd_macros, tolerance 1e-3 (sp), 1e-7 (dp); measured max 4.1e-5 (sp),
#!   2.8e-9 (dp).
#:set TOL_FWD = {'sp': '1.0e-2', 'dp': '1.0e-6'}
#:set TOL_CEN = {'sp': '1.0e-3', 'dp': '1.0e-7'}
#:set STOP_BASE = {'sp': 10, 'dp': 0}

module test_fd_operations_funcs
    !! Test functions of a 3x3 matrix and of a `ten_3D2Osym_<k>`, with analytical gradients.
    use muscle_kinds, only : sp, dp
    use muscle_tensor_2osym, only : ${', '.join(tname('3D2Osym', k) for k in REAL_KINDS)}$
    implicit none
    private
#:for k in REAL_KINDS
    public :: fm_${k}$, gm_${k}$, fs_${k}$, gs_${k}$
#:endfor

contains
#:for k in REAL_KINDS

    pure function wm_${k}$() result(w)
        !! Weights of the quadratic terms (non-symmetric on purpose).
        real(${k}$) :: w(3,3)
        w = reshape([0.6_${k}$, 0.9_${k}$, 1.1_${k}$, 0.7_${k}$, 1.3_${k}$, 0.8_${k}$, 0.5_${k}$, 1.2_${k}$, &
                     0.4_${k}$], [3, 3])
    end function wm_${k}$

    pure function cm_${k}$() result(c)
        !! Weights of the exponential term (non-symmetric on purpose).
        real(${k}$) :: c(3,3)
        c = reshape([0.9_${k}$, -0.7_${k}$, 0.5_${k}$, 1.3_${k}$, -1.1_${k}$, 0.8_${k}$, -0.4_${k}$, 0.6_${k}$, &
                     1.0_${k}$], [3, 3])
    end function cm_${k}$

    pure function fm_${k}$(x)
        !! f(X) = sum_ij w_ij X_ij^2 + exp(0.3 sum_ij c_ij X_ij), `real(${k}$)`.
        real(${k}$), intent(in), dimension(3,3) :: x
        real(${k}$) :: fm_${k}$
        fm_${k}$ = sum(wm_${k}$()*x**2) + exp(0.3_${k}$*sum(cm_${k}$()*x))
    end function fm_${k}$

    pure function gm_${k}$(x) result(g)
        !! Analytical gradient df/dX_ij of `fm_${k}$`.
        real(${k}$), intent(in) :: x(3,3)
        real(${k}$) :: g(3,3)
        g = 2.0_${k}$*wm_${k}$()*x + 0.3_${k}$*cm_${k}$()*exp(0.3_${k}$*sum(cm_${k}$()*x))
    end function gm_${k}$

    pure function fs_${k}$(s)
        !! f(s) = sum_p a_p s_p^2 + exp(0.3 w . s) of the stored components of a `${tname('3D2Osym', k)}$`.
        type(${tname('3D2Osym', k)}$), intent(in) :: s
        real(${k}$) :: fs_${k}$
        fs_${k}$ = sum(aw_${k}$()*s%vals**2) + exp(0.3_${k}$*sum(ww_${k}$()*s%vals))
    end function fs_${k}$

    pure function gs_${k}$(s) result(g)
        !! Analytical df/ds_p of `fs_${k}$`.
        type(${tname('3D2Osym', k)}$), intent(in) :: s
        real(${k}$) :: g(6)
        g = 2.0_${k}$*aw_${k}$()*s%vals + 0.3_${k}$*ww_${k}$()*exp(0.3_${k}$*sum(ww_${k}$()*s%vals))
    end function gs_${k}$

    pure function aw_${k}$() result(a)
        !! Quadratic weights per stored component.
        real(${k}$) :: a(6)
        a = [0.6_${k}$, 0.9_${k}$, 1.1_${k}$, 0.7_${k}$, 1.3_${k}$, 0.8_${k}$]
    end function aw_${k}$

    pure function ww_${k}$() result(w)
        !! Exponential weights per stored component.
        real(${k}$) :: w(6)
        w = [0.9_${k}$, -0.7_${k}$, 0.5_${k}$, 1.3_${k}$, -1.1_${k}$, 0.8_${k}$]
    end function ww_${k}$
#:endfor

end module test_fd_operations_funcs

program test_math_fd_operations_kinds
    !! `derivative_escalar_tensor3x3*` of `muscle_math_operations` in every kind against analytical
    !! gradients, at a generic and at the zero argument.
    use muscle_kinds, only : sp, dp
    use muscle_tensor_2osym, only : ${', '.join(tname('3D2Osym', k) for k in REAL_KINDS)}$
    use muscle_math_operations, only : derivative, derivative_escalar_tensor3x3, &
        derivative_escalar_tensor3x3sym, derivative_escalar_tensor3x3sym2
    use muscle_test_utils, only : check_approx
    use muscle_test_helpers, only : record
    use test_fd_operations_funcs
    implicit none

    integer :: code

    code = 0
#:for k in REAL_KINDS
    call record(test_matrix_${k}$(reshape([0.7_${k}$, -0.4_${k}$, 0.9_${k}$, 0.3_${k}$, -0.6_${k}$, 0.5_${k}$, &
                0.2_${k}$, 0.8_${k}$, -0.3_${k}$], [3, 3]), 'generic'), ${STOP_BASE[k] + 1}$, &
                'derivative_escalar_tensor3x3[sym2] ${k}$ generic', code)
    call record(test_matrix_${k}$(spread(spread(0.0_${k}$, 1, 3), 1, 3), 'zero'), ${STOP_BASE[k] + 2}$, &
                'derivative_escalar_tensor3x3[sym2] ${k}$ zero', code)
    call record(test_sym_${k}$([0.7_${k}$, -0.4_${k}$, 0.9_${k}$, 0.3_${k}$, -0.6_${k}$, 0.5_${k}$], 'generic'), &
                ${STOP_BASE[k] + 3}$, 'derivative_escalar_tensor3x3sym ${k}$ generic', code)
    call record(test_sym_${k}$(spread(0.0_${k}$, 1, 6), 'zero'), ${STOP_BASE[k] + 4}$, &
                'derivative_escalar_tensor3x3sym ${k}$ zero', code)
#:endfor
    if (code /= 0) stop code

contains
#:for k in REAL_KINDS

    function test_matrix_${k}$(x, label) result(passed)
        !! Forward differences of `fm_${k}$` on a 3x3 `real(${k}$)` matrix.
        real(${k}$), intent(in) :: x(3,3)
        character(len=*), intent(in) :: label
        logical :: passed
        real(${k}$) :: g(3,3)
        passed = .true.
        g = gm_${k}$(x)
        call check_approx(passed, 'derivative_escalar_tensor3x3 ${k}$ ' // label, &
                          derivative_escalar_tensor3x3(fm_${k}$, x), g, ${TOL_FWD[k]}$_${k}$)
        call check_approx(passed, 'derivative_escalar_tensor3x3sym2 ${k}$ ' // label, &
                          derivative_escalar_tensor3x3sym2(fm_${k}$, x), 0.5_${k}$*(g + transpose(g)), &
                          ${TOL_FWD[k]}$_${k}$)
    end function test_matrix_${k}$

    function test_sym_${k}$(v, label) result(passed)
        !! Central differences of `fs_${k}$` on a `${tname('3D2Osym', k)}$` (specific and generic names).
        real(${k}$), intent(in) :: v(6)
        character(len=*), intent(in) :: label
        logical :: passed
        type(${tname('3D2Osym', k)}$) :: s, d
        real(${k}$) :: ex(6)
        passed = .true.
        s%vals = v
        ex = gs_${k}$(s)*[1.0_${k}$, 1.0_${k}$, 1.0_${k}$, 0.5_${k}$, 0.5_${k}$, 0.5_${k}$]
        d = derivative_escalar_tensor3x3sym(fs_${k}$, s)
        call check_approx(passed, 'derivative_escalar_tensor3x3sym ${k}$ ' // label, d%vals, ex, ${TOL_CEN[k]}$_${k}$)
        d = derivative(fs_${k}$, s)
        call check_approx(passed, 'derivative (3x3sym) ${k}$ ' // label, d%vals, ex, ${TOL_CEN[k]}$_${k}$)
    end function test_sym_${k}$
#:endfor

end program test_math_fd_operations_kinds
