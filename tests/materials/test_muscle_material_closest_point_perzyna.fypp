#:include "muscle_common.fypp"
#:include "muscle_fd.fypp"
#:include "mat_sequence_common.fypp"
#! Materials of the test registry (tools/fypp/muscle_materials.py) solved by closest_point_perzyna: each one needs
#! at least one entry in CASES, with parameter set names of case_params.py.
#:set SOLVER = 'closest_point_perzyna'
#:set MATS = solver_materials(SOLVER)

program test_mat_closest_point_perzyna
    !! Declared materials with the closest point return mapping for overstress viscoplasticity (Phase 7,
    !! D-018): the point kernel `mat_update` of the materials of the test registry against every reference
    !! record of the OO solver (tests/reference/solvers/closest_point_perzyna_dp.txt, D-018.3/D-018.12a
    !! applied), with the checks of mat_sequence_common.fypp.
    !! Reduced reference (plan R, R6): only the cases with a case number keep their reference records, those
    !! that detect the mutations of the solver the unit tests cannot (tests/mutations/solvers.toml);
    !! the other cases (case number 0) keep their strain sequences for the checks of
    !! mat_sequence_common.fypp.
    !! Case 6 (Chaboche n = 0.5, Drucker-Prager) is kept: its steps go through the backtracking line
    !! search, and its sequence detects the changes of the line search and its merit function (only the
    !! iteration path changes, which has no independent truth).
    $:MAT_TEST_USES(MATS)
    implicit none

    $:MAT_TEST_DECLS()
    ! Tolerances relative to the largest component (measured maxima of the cases in brackets,
    ! gfortran 15.2 Debug; margin 4-18x)
    real(sp), parameter :: TOL_SP_STRESS = 2.0e-5_sp
        !! sp vs dp, stress [3.5e-6].
    real(sp), parameter :: TOL_SP_STRAIN_P = 5.0e-5_sp
        !! sp vs dp, plastic strain [8.8e-6].
    real(sp), parameter :: TOL_SP_EP = 5.0e-5_sp
        !! sp vs dp, equivalent plastic strain [8.7e-6].
    real(sp), parameter :: TOL_SP_TANGENT = 2.0e-5_sp
        !! sp vs dp, analytic tangent [2.9e-6].
    real(sp), parameter :: TOL_SP_FD = 5.0e-4_sp
        !! sp analytic tangent vs finite differences [1.2e-4].
    real(dp), parameter :: TOL_DP_FD = 1.0e-6_dp
        !! dp analytic tangent vs finite differences [5.6e-8].
    type(solver_case), parameter :: CASES(*) = [ &
        solver_case(0, 'pz_vm_bilinear', 'steel', 'per1', 'bilinear', 'vonmises', 200, 1.0e-2_dp, 9.09e-4_dp), &
        solver_case(0, 'pz_cha_vm_swift', 'steel', 'cha1', 'swift', 'vonmises', 200, 1.0e-2_dp, 5.71e-4_dp), &
        solver_case(0, 'pz_hill48_vocemod', 'steel', 'per2', 'vocemod', 'hill48-2', 200, 1.0e-3_dp, 1.23e-3_dp), &
        solver_case(0, 'pz_cha_hill48_bilinear', 'steel', 'cha2', 'bilinear', 'hill48-3', 200, 1.0e-1_dp, 1.18e-3_dp), &
        solver_case(0, 'pz_dp_ludwik', 'steel', 'per3', 'ludwik', 'dp-1', 200, 1.0e-3_dp, 9.05e-4_dp), &
        solver_case(6, 'pz_cha_dp_swift', 'steel', 'cha3', 'swift', 'dp-2', 200, 1.0e-1_dp, 3.64e-4_dp, &
            fd_tol=0.3_dp), &
        solver_case(0, 'pz_cpb06_swift', 'steel', 'per1', 'swift', 'cpb06-2', 200, 1.0e-2_dp, 5.71e-4_dp), &
        solver_case(0, 'pz_cha_cpb06_vocemod', 'steel', 'cha1', 'vocemod', 'cpb06-3', 200, 1.0e-2_dp, 1.18e-3_dp), &
        solver_case(0, 'pz_cpb06ex2_bilinear', 'steel', 'per1', 'bilinear', 'cpb06ex2-1', 200, 1.0e-2_dp, 8.94e-4_dp), &
        solver_case(0, 'pz_cha_cpb06ex2_bilinear', 'steel', 'cha1', 'bilinear', 'cpb06ex2-3', 200, 1.0e-2_dp, &
            9.13e-4_dp), &
        solver_case(0, 'pz_yld2004_swift', 'steel', 'per1', 'swift', 'yld2004-2', 200, 1.0e-2_dp, 5.63e-4_dp), &
        solver_case(0, 'pz_cha_yld2004_ludwik', 'steel', 'cha1', 'ludwik', 'yld2004-4', 200, 1.0e-2_dp, 9.21e-4_dp), &
        solver_case(0, 'pz_maxwell_vm_bilinear', 'maxwell', 'per1', 'bilinear', 'vonmises', 200, 1.0e-2_dp, 1.27e-2_dp), &
        solver_case(0, 'pz_kelvin_cha_hill48_swift', 'kelvin', 'cha1', 'swift', 'hill48-2', 200, 1.0e-1_dp, 6.55e-3_dp), &
        solver_case(0, 'pz_vm_swift', 'lin1000', 'per1', 'swift_small', 'vonmises', 200, 1.0_dp, 3.80e-2_dp), &
        solver_case(0, 'pz_cpb06_ludwik', 'steel', 'per1', 'ludwik', 'cpb06-4', 2, 1.0e-2_dp, 9.16e-4_dp), &
        solver_case(0, 'pz_hill48_swift', 'steel', 'per1', 'swift', 'hill48-2', 200, 1.0e-2_dp, 5.68e-4_dp)]
        !! Cases of the historical test_perzyna_golden (case number of the reference records, 0 for none; material, reference
        !! names, Newton limit, time step, A_Y). Case 6 (Chaboche n = 0.5, infinite slope at the threshold): steps 3 and 4 do not
        !! converge in 200 iterations and step 5 starts from their last iterate; there the analytic
        !! tangent differs from finite differences by 0.24 of the largest component (also the OO
        !! numerical tangent of the reference, `tangent_num`), hence fd_tol.

    $:MAT_TEST_MAIN('test_mat_closest_point_perzyna', 'solvers/closest_point_perzyna_dp.txt', MATS, 'cha3')

contains
    $:MAT_TEST_PROCS(SOLVER, MATS, 'perzyna', reference_tangent='always', zero_stress=False, &
        & tangent_num='after')

end program test_mat_closest_point_perzyna
