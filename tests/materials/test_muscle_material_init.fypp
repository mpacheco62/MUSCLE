#:include "muscle_common.fypp"
#! Every material of the test registry; sample inputs of each model from props_samples.py
#:set MATS = muscle_meta.load_materials()
#:set SAMPLES = muscle_meta.load_python_file('props_samples.py', base=_THIS_FILE_)
#:set sample = lambda p, m: SAMPLES.sample_inputs(muscle_meta, p, m)
#! Fortran literal of a sample value in kind k (an integer input as an integer)
#:set lit = lambda v, k, t='real': (str(int(float(v))) if t == 'integer' else v + '_' + k)
#! Value of parameter q of the array: the sample value of its input (its branch for an input per
#! branch), or a solver setting of `settings`
#:set prop_value = lambda MAT, q, k, settings: SAMPLES.prop_literal(muscle_meta, MAT, q, k, settings)
#! Settings of the solver given in the array (both must be > 0)
#:set GIVEN = {'tol': '3.0e-5', 'iter_nw': '37.0'}
#! Invalid values of every input with a domain checked by mat_init_<name> (ModelInput.domain)
#:set BAD = {'tol': ['0.0', '-1.0e-6'], 'iter_nw': ['0.0', '-2.0'], 'young': ['0.0', '-1.0'], &
    &        'poisson': ['0.5', '-1.0', '0.7'], 'hardening_mode': ['0.0', '4.0', '-1.0']}
#! User contract (D-018.17e), written out: the parameter array of one material per kind of input
#! (initializer coefficients, a law with a temperature, Maxwell branch pairs, a kinematics)
#:set CONTRACT = { &
    & 'cp_yld2004_vocemod': ['elas young', 'elas poisson'] &
    &     + ['yield cp' + ij for ij in ('12', '13', '21', '23', '31', '32', '44', '55', '66')] &
    &     + ['yield cpp' + ij for ij in ('12', '13', '21', '23', '31', '32', '44', '55', '66')] &
    &     + ['yield a', 'hard Sy', 'hard k', 'hard q', 'hard n', ' tol', ' iter_nw'], &
    & 'tm_jcfull_vm_vocemod': ['elas young', 'elas poisson', 'vp C', 'vp epdmax', 'vp m', 'vp Troom', 'vp Tmelt', &
    &     'vp T_current', 'hard Sy', 'hard k', 'hard q', 'hard n', ' tol', ' iter_nw'], &
    & 'cp_maxwell_vm_bilinear': ['visco bulk', 'visco shear_inf', 'visco shear(1)', 'visco tau(1)', &
    &     'visco shear(2)', 'visco tau(2)', 'hard y0', 'hard K', ' tol', ' iter_nw'], &
    & 'kin_tl_vm_bilinear': ['elas young', 'elas poisson', 'hard y0', 'hard K', ' tol', ' iter_nw']}
#:for name, expected in CONTRACT.items()
#:set got = ['{} {}{}'.format(q.component or '', q.name, '({})'.format(q.branch) if q.branch else '') &
    & for q in muscle_meta.material_props(muscle_meta.material(name))]
#:assert got == expected, 'parameter array of ' + name + ' changed: ' + str(got)
#:endfor

module test_mat_init_cases
    !! Material initializers from a flat parameter array, `mat_init_<name>` (D-018.17a, e), for every
    !! material of the test registry in every kind:
    !!
    !! - the parameter array in the order of `muscle_meta.material_props` (the order of the Markdown table of
    !!   `muscle_meta.py props <name>`, tests/tools/test_muscle_material_props.py) gives the public
    !!   components of the models (bit for bit) and the solver settings `tol` and `iter_nw`; the order of
    !!   one material per kind of input is written out (`CONTRACT`, the user contract);
    !! - the material behaves bit for bit as the one built by hand with the same inputs (the initializers of
    !!   the models called with keywords, the components set by name): point API on a plastic step;
    !! - fewer than `MAT_<NAME>_NPROPS` values give `STATUS_INVALID_PARAMETER`, extra values are ignored;
    !!   an invalid input of an initializer with validation (Maxwell: tau <= 0) gives its status, and so does
    !!   a value outside the domain checked by `mat_init_<name>` (`tol`, `iter_nw` <= 0, Young modulus,
    !!   Poisson ratio, Drucker-Prager hardening mode, the Johnson-Cook rate factor on the floor
    !!   C |ln(epmin/epdmax)| < 1).
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_status, only : STATUS_OK, STATUS_INVALID_PARAMETER
    use muscle_visco_laws, only : ${', '.join('visco_coefs_' + k for k in REAL_KINDS)}$
    use muscle_elasticity_linear, only : elas_linear_init
    use muscle_visco_maxwell, only : visco_maxwell_init
    use muscle_visco_kelvin, only : visco_kelvin_init
    use muscle_yield_druckerprager, only : yield_druckerprager_init
    use muscle_yield_cpb06, only : yield_cpb06_init
    use muscle_yield_cpb06ex2, only : yield_cpb06ex2_init
    use muscle_yield_yld2004, only : yield_yld2004_init
#:for MAT in MATS
#:set mat_kinds = ', '.join(muscle_meta.material_type(MAT.name, k) for k in REAL_KINDS)
    use ${muscle_meta.material_module(MAT.name)}$, only : mat_init_${MAT.name}$, muscle_point_${MAT.name}$, &
        ${muscle_meta.material_nprops(MAT.name)}$, ${muscle_meta.material_nstate(MAT.name)}$, &
        ${'mat_step, ' if muscle_meta.material_visco(MAT) else ''}$${mat_kinds}$
#:endfor
    use muscle_test_utils, only : check_true
    implicit none
    private
    public :: run_all

    logical, public :: passed = .true.
        !! Accumulated result of every check.

contains

    subroutine run_all()
        !! Every material in every kind.
#:for k in REAL_KINDS
#:for MAT in MATS
        call run_${MAT.name}$_${k}$()
#:endfor
#:endfor
    end subroutine run_all
#:for k in REAL_KINDS

    elemental logical function same_${k}$(a, b)
        !! Same value, or both NaN (the sign and payload of a NaN depend on the order of the operands).
        real(${k}$), intent(in) :: a, b

        same_${k}$ = a == b .or. (a /= a .and. b /= b)
    end function same_${k}$
#:for MAT in MATS
#:set PROPS = muscle_meta.material_props(MAT)
#:set NP = muscle_meta.material_nprops(MAT.name)
#:set NS = muscle_meta.material_nstate(MAT.name)
#:set MAT_T = muscle_meta.material_type(MAT.name, k)
#:set VISCO = muscle_meta.material_visco(MAT)
#:set FIN = not muscle_meta.material_strain_input(MAT)
#:set L = MAT.name + ' (' + k + ')'
#:set CO = 'coefs, ' if VISCO else ''

    subroutine run_${MAT.name}$_${k}$()
        !! Initializer of `${MAT.name}$` from a parameter array, `real(${k}$)`.
        type(${MAT_T}$) :: mat, ref
        real(${k}$) :: props(${NP}$ + 1)
        real(${k}$) :: hp(${NS}$), hr(${NS}$), sp_(6), sr(6), hn(${NS}$)
        real(${k}$) :: a
        integer :: st, stp, str, itp, itr
#:if FIN
        real(${k}$) :: f0(9), f1(9)
#:else
        real(${k}$) :: strain(6)
#:endif
#:if VISCO
        type(visco_coefs_${k}$) :: coefs
#:endif

#:for q in PROPS
        props(${q.index}$) = ${prop_value(MAT, q, k, GIVEN)}$
#:endfor
        props(${NP}$ + 1) = -99.0_${k}$
        call mat_init_${MAT.name}$(mat, props(1:${NP}$), st)
        call check_true(passed, '${L}$: init status', st == STATUS_OK)
        call mat_init_${MAT.name}$(mat, props, st)
        call check_true(passed, '${L}$: init status (extra value)', st == STATUS_OK)
        ! Public components and settings, bit for bit the values of the array at their positions
        call check_true(passed, '${L}$: components at the positions of the table', .true. &
#:for q in PROPS
#:if q.component is None
#:set init_value = 'nint(props(' + str(q.index) + '))' if q.type == 'integer' else 'props(' + str(q.index) + ')'
            .and. mat%${q.name}$ == ${init_value}$ &
#:elif muscle_meta.model_init(q.component, getattr(MAT, muscle_meta.MATERIAL_FIELDS[q.component])) is None
            .and. mat%${q.component}$%${q.name}$ == props(${q.index}$) &
#:endif
#:endfor
            )

        ! Reference built by hand from the same inputs, by name
#:for p, m in muscle_meta.material_components(MAT)
#:set S = sample(p, m)
#:set init = muscle_meta.model_init(p, m)
#:if init
        call ${p}$_${m}$_init(ref%${p}$, &
#:for n, i in enumerate(init.inputs)
#:set v = S[i.name]
#:set init_row = ('[' + ', '.join(x + '_' + k for x in v) + ']') if i.shape else lit(v, k, i.type)
            ${i.name}$=${init_row}$${', &' if n < len(init.inputs) - 1 or init.status else ')'}$
#:endfor
#:if init.status
            status=st)
        call check_true(passed, '${L}$: reference init', st == STATUS_OK)
#:endif
#:else
#:for i in muscle_meta.model_inputs(p, m)
        ref%${p}$%${i.name}$ = ${lit(S[i.name], k)}$
#:endfor
#:endif
#:endfor
        ref%tol = 3.0e-5_${k}$
        ref%iter_nw = 37

        ! Same behaviour: a plastic step from the zero state
        hn = 0.0_${k}$
#:if FIN
        f0 = [1.0_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$, 1.0_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$, 1.0_${k}$]
        f1 = f0 + [8.0e-3_${k}$, 1.0e-3_${k}$, 0.0_${k}$, 3.0e-3_${k}$, -2.4e-3_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$, &
            -2.4e-3_${k}$]
        call muscle_point_${MAT.name}$(mat, f0, f1, 0.01_${k}$, hn, hp, sp_, stp, itp)
        call muscle_point_${MAT.name}$(ref, f0, f1, 0.01_${k}$, hn, hr, sr, str, itr)
#:else
        strain = 3.0e-3_${k}$*[1.0_${k}$, -0.3_${k}$, -0.3_${k}$, 0.2_${k}$, 0.05_${k}$, 0.1_${k}$]
#:if VISCO
        call mat_step(mat, 0.01_${k}$, coefs, st)
        call check_true(passed, '${L}$: mat_step', st == STATUS_OK)
#:endif
        call muscle_point_${MAT.name}$(mat, strain, 0.01_${k}$, ${CO}$hn, hp, sp_, stp, itp)
#:if VISCO
        call mat_step(ref, 0.01_${k}$, coefs, st)
#:endif
        call muscle_point_${MAT.name}$(ref, strain, 0.01_${k}$, ${CO}$hn, hr, sr, str, itr)
#:endif
        call check_true(passed, '${L}$: same behaviour as the material built by hand', all(same_${k}$(hp, hr)) &
            .and. all(same_${k}$(sp_, sr)) .and. stp == str .and. itp == itr .and. any(sr /= 0.0_${k}$))

#:if MAT.name == 'tm_jcfull_vm_vocemod'
        ! Contract written out: the temperature of Johnson-Cook is parameter 8
        call check_true(passed, '${L}$: T_current is props(8)', mat%vp%T_current == props(8) &
            .and. mat%vp%T_current == 700.0_${k}$)
#:endif

        ! Too short an array
        call mat_init_${MAT.name}$(mat, props(1:${NP}$ - 1), st)
        call check_true(passed, '${L}$: short array', st == STATUS_INVALID_PARAMETER)
#:for q in PROPS
#:if q.domain
#:assert q.name in BAD, 'no invalid values for the domain of ' + q.name
#:for bad in BAD[q.name]

        ! ${q.name}$ = ${bad}$ outside its domain
        a = props(${q.index}$)
        props(${q.index}$) = ${bad}$_${k}$
        call mat_init_${MAT.name}$(mat, props, st)
        call check_true(passed, '${L}$: invalid ${q.name}$ = ${bad}$', st == STATUS_INVALID_PARAMETER)
        props(${q.index}$) = a
#:endfor
#:endif
#:endfor
#:if MAT.vp == 'jc'
#:set JC = {q.name: q for q in PROPS if q.component == 'vp'}
#:assert len(muscle_meta.material_domain_checks(MAT, k)) == 1

        ! Johnson-Cook rate factor on the floor (D-018.19c): C |ln(epmin/epdmax)| < 1, at 0.99 and 1.01 of
        ! the limit (also with epmin > epdmax: the absolute value)
        a = props(${JC['C'].index}$)
        props(${JC['C'].index}$) = 0.99_${k}$/abs(log(props(${JC['epmin'].index}$)/props(${JC['epdmax'].index}$)))
        call mat_init_${MAT.name}$(mat, props, st)
        call check_true(passed, '${L}$: Johnson-Cook C |ln(epmin/epdmax)| = 0.99', st == STATUS_OK)
        props(${JC['C'].index}$) = 1.01_${k}$/abs(log(props(${JC['epmin'].index}$)/props(${JC['epdmax'].index}$)))
        call mat_init_${MAT.name}$(mat, props, st)
        call check_true(passed, '${L}$: Johnson-Cook C |ln(epmin/epdmax)| = 1.01', st == STATUS_INVALID_PARAMETER)
        props(${JC['C'].index}$) = 1.01_${k}$/log(10.0_${k}$)
        props(${JC['epmin'].index}$) = 10.0_${k}$*props(${JC['epdmax'].index}$)
        call mat_init_${MAT.name}$(mat, props, st)
        call check_true(passed, '${L}$: Johnson-Cook epmin > epdmax, C ln(epmin/epdmax) = 1.01', &
            st == STATUS_INVALID_PARAMETER)
        props(${JC['C'].index}$) = a
        props(${JC['epmin'].index}$) = ${prop_value(MAT, JC['epmin'], k, GIVEN)}$
#:endif
#:if MAT.visco == 'maxwell' and MAT.visco_branches > 0
#:set TAU = [q for q in PROPS if q.name == 'tau'][0]

        ! Invalid input of the Maxwell initializer (tau <= 0)
        props(${TAU.index}$) = -1.0_${k}$
        call mat_init_${MAT.name}$(mat, props, st)
        call check_true(passed, '${L}$: Maxwell tau <= 0', st == STATUS_INVALID_PARAMETER)
#:endif
    end subroutine run_${MAT.name}$_${k}$
#:endfor
#:endfor

end module test_mat_init_cases

program test_mat_init
    !! Material initializers from a parameter array: see module `test_mat_init_cases`.
    use test_mat_init_cases, only : run_all, passed
    implicit none

    call run_all()
    if (.not. passed) then
        print '(a)', ' FAIL: test_mat_init'
        stop 1
    end if
    print '(a)', ' PASS: test_mat_init'
end program test_mat_init
