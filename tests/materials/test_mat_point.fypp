#:include "muscle_common.fypp"
#! Materials under test (test registry, tools/fypp/muscle_materials.py): (name, input, parameters) as in
#! test_mat_batch.fypp: one material per solver, two frozen Maxwell materials, finite strain (F) and
#! corotational kinematics. Only the materials with a strain input have mat_rotate_hsv_<name>.
#:set MATS = [ &
    & ('cp_vm_swift', 'eps', ''), &
    & ('cp2_vm_bilinear', 'eps', ''), &
    & ('cut_vm_bilinear', 'eps', ''), &
    & ('pz_vm_bilinear', 'eps', 'os'), &
    & ('tm_jc_vm_swift', 'eps', 'jc'), &
    & ('cp_maxwell_vm_bilinear', 'eps', 'maxwell'), &
    & ('tm_maxwell_jc_vm_bilinear', 'eps', 'maxwell_jc'), &
    & ('kin_tl_vm_bilinear', 'F', ''), &
    & ('kin_ul_hill48_bilinear', 'F', 'hill48'), &
    & ('kin_cr_vm_bilinear', 'eps', '')]
#:set is_visco = lambda extra: extra.startswith('maxwell')

module test_mat_point_cases
    !! Generic API of the declared materials for FE codes (D-018.17b, c), in every kind:
    !!
    !! - point API `muscle_point_<name>` (flat arrays) **bit for bit** equal to `mat_unpack_<name>`,
    !!   `mat_update` and `mat_pack_<name>` over three load steps (elastic and plastic), with and
    !!   without `ddsdde` (an absent `ddsdde` changes nothing else);
    !! - `mat_rotate_hsv_<name>` (materials with a strain input): rotating with R and then with R^T
    !!   gives the history array back (relative `TOL_APPROX_<k>`), the plastic strain and, with a
    !!   viscoelastic elasticity, every 6-component tensor of the viscoelastic state, equal R A R^T of
    !!   the 3x3 matrices (`matmul`), and the equivalent plastic strain untouched (bit for bit).
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$, ${', '.join('TOL_APPROX_' + k for k in REAL_KINDS)}$
    use muscle_status, only : STATUS_OK
    use muscle_tensors, only : ${', '.join(tname('3D2Osym', k) + ', ' + tname('3D2O', k) + ', ' + tname('3D4O2sym', k) for k in REAL_KINDS)}$
    use muscle_elasticity_linear, only : elas_linear_init
    use muscle_visco_maxwell, only : visco_maxwell_init
    use muscle_plastic_state, only : ${', '.join('plastic_state_' + k for k in REAL_KINDS)}$
    use muscle_visco_laws, only : ${', '.join('visco_coefs_' + k for k in REAL_KINDS)}$
#:for m, x, extra in MATS
    use muscle_mat_${m}$, only : mat_update, ${'mat_step, ' if is_visco(extra) else ''}$mat_pack_${m}$, mat_unpack_${m}$, &
        muscle_point_${m}$, ${'mat_rotate_hsv_' + m + ', ' if x == 'eps' else ''}$MAT_${m.upper()}$_NSTATE, &
        ${', '.join('mat_' + m + '_' + k for k in REAL_KINDS)}$${''.join(', mat_state_' + m + '_' + k for k in REAL_KINDS) if is_visco(extra) else ''}$
#:endfor
    use muscle_test_utils, only : check_true, check_approx
    implicit none
    private
    public :: run_all

    logical, public :: passed = .true.
        !! Accumulated result of every check.

contains

    subroutine run_all()
        !! Every material in every kind.
#:for k in REAL_KINDS
#:for m, x, extra in MATS
        call run_${m}$_${k}$()
#:endfor
#:endfor
    end subroutine run_all
#:for k in REAL_KINDS

    pure function voigt_matrix_${k}$(v) result(a)
        !! 3x3 symmetric matrix of a tensorial Voigt vector (xx, yy, zz, xy, yz, xz).
        real(${k}$), intent(in) :: v(6)
        real(${k}$) :: a(3, 3)

        a = reshape([v(1), v(4), v(6), v(4), v(2), v(5), v(6), v(5), v(3)], [3, 3])
    end function voigt_matrix_${k}$

    pure function matrix_voigt_${k}$(a) result(v)
        !! Tensorial Voigt vector of a (symmetric) 3x3 matrix.
        real(${k}$), intent(in) :: a(3, 3)
        real(${k}$) :: v(6)

        v = [a(1, 1), a(2, 2), a(3, 3), a(1, 2), a(2, 3), a(1, 3)]
    end function matrix_voigt_${k}$

    pure function rotation_${k}$() result(r)
        !! A rotation of 0.7 rad about the axis (1, 2, 2)/3 (Rodrigues formula).
        real(${k}$) :: r(3, 3)
        real(${k}$) :: n(3), w(3, 3), th
        integer :: i

        th = 0.7_${k}$
        n = [1.0_${k}$, 2.0_${k}$, 2.0_${k}$]/3.0_${k}$
        w = reshape([0.0_${k}$, n(3), -n(2), -n(3), 0.0_${k}$, n(1), n(2), -n(1), 0.0_${k}$], [3, 3])
        r = sin(th)*w + (1.0_${k}$ - cos(th))*matmul(w, w)
        do i = 1, 3
            r(i, i) = r(i, i) + 1.0_${k}$
        end do
    end function rotation_${k}$
#:for m, x, extra in MATS
#:set NS = 'MAT_' + m.upper() + '_NSTATE'
#:set ST = 'mat_state_' + m + '_' + k if is_visco(extra) else 'plastic_state_' + k
#:set L = m + ' (' + k + ')'
#:set XA = 'x0(i, :), x1(i, :)' if x == 'F' else 'x0(i, :)'
#:set CO = 'coefs, ' if is_visco(extra) else ''

    subroutine run_${m}$_${k}$()
        !! Point API${' and history rotation' if x == 'eps' else ''}$ of `${m}$`, `real(${k}$)`.
        integer, parameter :: N = 41
        real(${k}$), parameter :: DT = 0.01_${k}$
        type(mat_${m}$_${k}$) :: mat
        real(${k}$) :: hn(N, ${NS}$), hr(N, ${NS}$), hsv(${NS}$), hp(${NS}$), hq(${NS}$)
        real(${k}$) :: sr(6), sp_(6), sq(6), tr(6, 6), tp(6, 6), a
        integer :: str, itr, stp, itp, stq, itq, i, step
        logical :: plastic, same
        type(${ST}$) :: sn, snp1
        type(${tname('3D2Osym', k)}$) :: stress
        type(${tname('3D4O2sym', k)}$) :: tang
#:if x == 'F'
        real(${k}$) :: x0(N, 9), x1(N, 9)
        type(${tname('3D2O', k)}$) :: fa, fb
#:else
        real(${k}$) :: x0(N, 6), r(3, 3), rot(${NS}$), back(${NS}$)
        type(${tname('3D2Osym', k)}$) :: strain
        integer :: j
#:endif
#:if is_visco(extra)
        type(visco_coefs_${k}$) :: coefs
        integer :: st
#:endif

#:if is_visco(extra)
        call visco_maxwell_init(mat%visco, bulk=150000.0_${k}$, shear_inf=50000.0_${k}$, &
            shear=[20000.0_${k}$, 10000.0_${k}$], tau=[0.05_${k}$, 1.0_${k}$], status=st)
        call check_true(passed, '${L}$: Maxwell init', st == STATUS_OK)
#:else
        call elas_linear_init(mat%elas, young=210000.0_${k}$, poisson=0.3_${k}$)
#:endif
#:if 'swift' in m
        mat%hard%k = 500.0_${k}$
        mat%hard%e0 = 1.0e-3_${k}$
        mat%hard%n = 0.2_${k}$
#:else
        mat%hard%y0 = 200.0_${k}$
        mat%hard%K = 1000.0_${k}$
#:endif
#:if extra == 'os'
        mat%os%eta = 1.0e-2_${k}$
        mat%os%n = 1.0_${k}$
#:endif
#:if extra in ('jc', 'maxwell_jc')
        mat%vp%C = 0.014_${k}$
        mat%vp%epdmax = 1.0_${k}$
#:endif
#:if extra == 'hill48'
        mat%yield%f = 0.25_${k}$
        mat%yield%g = 0.4_${k}$
        mat%yield%h = 0.6_${k}$
        mat%yield%l = 1.3_${k}$
        mat%yield%m = 1.7_${k}$
        mat%yield%n = 1.45_${k}$
#:endif
        hn = 0.0_${k}$
        plastic = .false.
        same = .true.
        do step = 1, 3
            do i = 1, N
                a = real(i, ${k}$)/real(N, ${k}$)*4.0e-3_${k}$*real(step, ${k}$)
#:if x == 'F'
                fa%vals = [1.0_${k}$ + 0.8_${k}$*a*real(step - 1, ${k}$)/real(step, ${k}$), 0.1_${k}$*a, 0.0_${k}$, &
                    0.3_${k}$*a, 1.0_${k}$ - 0.3_${k}$*a, 0.2_${k}$*a, 0.0_${k}$, 0.0_${k}$, 1.0_${k}$ - 0.3_${k}$*a]
                fb = fa
                fb%vals(1) = 1.0_${k}$ + a
                x0(i, :) = fa%vals
                x1(i, :) = fb%vals
#:else
                x0(i, :) = a*[1.0_${k}$, -0.3_${k}$, -0.3_${k}$, 0.2_${k}$, 0.05_${k}$, 0.1_${k}$]
#:endif
            end do
#:if is_visco(extra)
            call mat_step(mat, DT, coefs, st)
            call check_true(passed, '${L}$: mat_step', st == STATUS_OK)
#:endif
            do i = 1, N
                ! Reference: the point kernel through the history array
                hsv = hn(i, :)
                call mat_unpack_${m}$(hsv, sn)
#:if x == 'F'
                fa%vals = x0(i, :)
                fb%vals = x1(i, :)
                call mat_update(mat, fa, fb, DT, sn, snp1, stress, tang, str, itr)
#:else
                strain%vals = x0(i, :)
                call mat_update(mat, strain, DT, ${CO}$sn, snp1, stress, tang, str, itr)
#:endif
                call mat_pack_${m}$(snp1, hsv)
                hr(i, :) = hsv
                sr = stress%vals
                tr = tang%vals
                ! Point API, with and without tangent
                call muscle_point_${m}$(mat, ${XA}$, DT, ${CO}$hn(i, :), hp, sp_, stp, itp, tp)
                call muscle_point_${m}$(mat, ${XA}$, DT, ${CO}$hn(i, :), hq, sq, stq, itq)
                same = same .and. all(hp == hr(i, :)) .and. all(sp_ == sr) .and. all(tp == tr) .and. stp == str &
                    .and. itp == itr .and. all(hq == hr(i, :)) .and. all(sq == sr) .and. stq == str .and. itq == itr
                plastic = plastic .or. itr > 0
            end do
            hn = hr
        end do
        call check_true(passed, '${L}$: point API == point kernel (with and without ddsdde)', same)
        call check_true(passed, '${L}$: the sequence has plastic points', plastic)
#:if x == 'eps'

        ! History rotation: R then R^T is the identity; each tensor equals R A R^T; ep untouched
        r = rotation_${k}$()
        do i = 21, N, 5
            rot = hn(i, :)
            call mat_rotate_hsv_${m}$(rot, r)
            back = rot
            call mat_rotate_hsv_${m}$(back, transpose(r))
            call check_approx(passed, '${L}$: rotate R then R^T', back, hn(i, :), TOL_APPROX_${k}$)
            call check_true(passed, '${L}$: rotation keeps ep', rot(7) == hn(i, 7))
            ! Tensors at hsv(1:6) and, with a viscoelastic elasticity, hsv(8 + 6 i : 13 + 6 i), i >= 0
            do j = 1, ${NS}$ - 5
                if (j /= 1 .and. (j < 8 .or. mod(j - 8, 6) /= 0)) cycle
                call check_approx(passed, '${L}$: rotated tensor == R A R^T', rot(j:j + 5), &
                    matrix_voigt_${k}$(matmul(r, matmul(voigt_matrix_${k}$(hn(i, j:j + 5)), transpose(r)))), &
                    TOL_APPROX_${k}$)
            end do
        end do
        call check_true(passed, '${L}$: rotated plastic strain is nonzero', any(hn(N, 1:6) /= 0.0_${k}$))
#:endif
    end subroutine run_${m}$_${k}$
#:endfor
#:endfor

end module test_mat_point_cases

program test_mat_point
    !! Generic API of the declared materials for FE codes: see module `test_mat_point_cases`.
    use test_mat_point_cases, only : run_all, passed
    implicit none

    call run_all()
    if (.not. passed) then
        print '(a)', ' FAIL: test_mat_point'
        stop 1
    end if
    print '(a)', ' PASS: test_mat_point'
end program test_mat_point
