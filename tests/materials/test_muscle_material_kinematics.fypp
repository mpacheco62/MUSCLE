#:include "muscle_common.fypp"
#! Finite strain materials of the test registry (tools/fypp/muscle_materials.py, Material.kin), D-018.15
#:set KMATS = [m for m in muscle_meta.load_materials() if m.kin is not None]
#! Materials with von Mises (the F -> I and uniaxial oracles) and with a logarithmic strain measure
#:set VM = [m for m in KMATS if m.yield_ == 'vonmises' and not muscle_meta.MATERIAL_SOLVERS[m.solver].dt]
#! The F -> I check against the closest point small strain material: same solver (closest_point_2 may
#! converge to another solution with the soft hardening of the check, D-018.10c)
#:set NEAR_I = [m for m in VM if m.solver == 'closest_point']
#:set LOGS = ('material_logarithmic', 'spatial_logarithmic', 'corotational')
#:set REF = [m for m in KMATS if m.kin == 'small_strain' and m.yield_ == 'vonmises'][0]
#! Materials whose kernel takes F (the others: the strain rotated by the FE code, corotational)
#:set is_f = lambda m: m.kin not in muscle_meta.KINEMATICS_FE_ROTATED
#! Time step of a material (1e-2 for a rate-dependent return mapping, else 0: not used)
#:set dt_of = lambda m, k: ('1.0e-2_' if muscle_meta.MATERIAL_SOLVERS[m.solver].dt else '0.0_') + k
#! Overstress / viscoplastic parameters (reference sets per1 and jc2 of tests/materials/case_params.py)
#:set RATE_PARAMS = {'os': ['%os%eta = 1.0e-2_{k}', '%os%n = 1.0_{k}'], 'vp': ['%vp%C = 0.014_{k}', '%vp%epdmax = 1.0_{k}']}
#:set G2 = lambda k: tname('3D2O', k)
#:set S2 = lambda k: tname('3D2Osym', k)
#:set C4 = lambda k: tname('3D4O2sym', k)

program test_mat_kinematics
    !! Finite strain declared materials (Phase 7 step 6, D-018.15): the point kernel
    !! `mat_update(mat, F_n, F_np1, dt, ...)` of every material of the test registry with a kinematics
    !! (`mat_update(mat, strain, dt, ...)` with the strain rotated by the FE code for the corotational
    !! one: its oracles rotate the inputs),
    !! in every kind, against physical oracles (there is no historical composition of a return mapping
    !! with a kinematics; the former dp regression reference was deleted in plan R: these oracles and the unit
    !! tests of the kinematics detect every mutation it detected, tests/mutations/mat_kin.toml):
    !!
    !! - tangent: the spatial tangent (with `kin_geometric_tangent` for `tangent_rate` none) against
    !!   central finite differences of \( J\boldsymbol\sigma/J_{n+1} \) for
    !!   \( \delta\mathbf{F} = \delta\boldsymbol\varepsilon\,\mathbf{F}_{n+1} \) (Jaumann rate of the
    !!   Kirchhoff stress), at every converged step of a loading / unloading sequence up to ~10 %
    !!   strain with rotation;
    !! - objectivity: the sequence \( \mathbf{Q}\mathbf{F} \) (rigid rotation, every step) gives
    !!   \( \mathbf{Q}\boldsymbol\sigma\mathbf{Q}^T \), the rotated tangent and the same equivalent
    !!   plastic strain (every strain measure, also with an anisotropic yield criterion, D-018.15f);
    !! - F -> I: with von Mises, a single plastic step at \( \mathbf{F} = \mathbf{I} + \eta\mathbf{G} \)
    !!   agrees with the small strain kinematics within \( O(\eta) \);
    !! - near F = I (D-018.19a, dp, the materials that take F): elastic steps at strains of 1e-8 to 1e-6 (uniaxial, with two
    !!   repeated stretches; pure shear; a general F with rotation): \( \boldsymbol\sigma \) agrees with
    !!   the small strain \( \mathbb{C}:\boldsymbol\varepsilon \) to first order in the strain, and the
    !!   tangent with central finite differences of step 1/10 of the strain;
    !! - uniaxial isochoric tension \( \mathbf{F} = \operatorname{diag}(\lambda, \lambda^{-1/2}, \lambda^{-1/2}) \)
    !!   with a logarithmic strain and von Mises with bilinear hardening: the closed form
    !!   \( \sigma_{11} - \sigma_{22} = \sigma_y + K\epsilon_p \), \( \epsilon_p = \max(0, (3G\ln\lambda - \sigma_y)/(3G + K)) \);
    !! - invalid deformation (the finite strain materials that take F): \( \det\mathbf{F}_{n+1} \le 0 \) gives
    !!   `STATUS_INVALID_DEFORMATION`, zero iterations and a zero stress and tangent (outputs filled with
    !!   garbage before the call).
    use, intrinsic :: ieee_arithmetic, only : ieee_is_finite
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_status, only : STATUS_OK, STATUS_INVALID_DEFORMATION
    use muscle_tensors, only : ${', '.join(G2(k) + ', ' + S2(k) + ', ' + C4(k) for k in REAL_KINDS)}$, &
        operator(.transform.)
    use muscle_plastic_state, only : ${', '.join('plastic_state_' + k for k in REAL_KINDS)}$
    use muscle_elas_linear, only : elas_linear_init
    use muscle_kin_laws, only : kin_update, kin_geometric_tangent, ${', '.join('kin_state_' + k for k in REAL_KINDS)}$
    #:for m in KMATS
    use ${muscle_meta.material_module(m.name)}$, only : mat_update, &
        ${', '.join(muscle_meta.material_type(m.name, k) for k in REAL_KINDS)}$
    #:endfor
    use muscle_test_utils, only : check_approx, check_true
    implicit none

    integer, parameter :: NSEQ = 10
        !! Steps of the loading / unloading sequence.
    real(dp), parameter :: SEQ(NSEQ) = [0.5e-3_dp, 1.5e-3_dp, 5.0e-3_dp, 1.0e-2_dp, 2.0e-2_dp, 3.5e-2_dp, 5.0e-2_dp, &
        7.0e-2_dp, 0.1_dp, 8.0e-2_dp]
        !! Load factor of each step (F = I + a G): elastic, first yield, plastic loading up to ~10 %
        !! strain in increments of at most 3e-2 (the sp Perzyna return mapping does not converge with
        !! an increment of 4e-2, ~40 yield strains: beyond D-018.12a), unloading.
    real(dp), parameter :: GMAT(3, 3) = reshape([1.0_dp, 0.3_dp, -0.2_dp, -0.1_dp, -0.4_dp, 0.25_dp, 0.15_dp, &
        -0.35_dp, -0.3_dp], [3, 3])
        !! Displacement gradient direction G (non symmetric: stretch and rotation).
    real(dp), parameter :: AXIS(3) = [1.0_dp, 2.0_dp, -0.5_dp], ANGLE = 0.7_dp
        !! Rigid rotation Q of the objectivity check (axis, angle in radians).
    ! Finite difference step and tolerances relative to the largest component (x3-20 the measured
    ! maxima, gfortran 15.2 Debug)
#! sp step 1e-4: 1e-3 (~eps^(1/3)) crosses the yield surface in the steps at ~4e-4 strain (FD
#! tangent off by more than 2e-2 there)
    #:set FD_H = {'sp': '1.0e-4', 'dp': '1.0e-6'}
#! Measured maxima: FD dp 2.0e-6, sp 3.4e-3 (sp step 1e-4: rounding of the stress differences);
#! objectivity dp 2.2e-8 (D-017.14b: the dp polar decomposition near C = I), sp 8.4e-4; uniaxial dp
#! 7.4e-10 (dp eigenvalues near C = I), sp 1.9e-4 (rounding of C - I at 5e-4 strain)
    #:set TOL_FD = {'sp': '2.0e-2', 'dp': '1.0e-5'}
#! Near F = I (dp, D-018.19a), strain amplitudes eta of SMALL_ETA: |sigma - C:eps| <= SMALL_SIG eta |C:eps|
#! [measured 6.9 eta: first order in eta plus the rounding of C, ~eps/eta] and the tangent vs finite
#! differences of step eta/10 [measured 3.6e-7]; with the former closed form ln C lost its deviatoric
#! part below ~3e-6 (|sigma - C:eps| ~ |C:eps| in shear)
    #:set SMALL_ETA = ['1.0e-8_dp', '1.0e-7_dp', '1.0e-6_dp']
    #:set SMALL_SIG = '25.0_dp'
    #:set SMALL_FD = '5.0e-6_dp'
    #:set TOL_OBJ = {'sp': '5.0e-3', 'dp': '1.0e-7'}
    #:set TOL_UNI = {'sp': '1.0e-3', 'dp': '5.0e-9'}
    #:for k in REAL_KINDS
    real(${k}$), parameter :: FD_H_${k}$ = ${FD_H[k]}$_${k}$
        !! Relative step of the finite differences, `real(${k}$)`.
    real(${k}$), parameter :: TOL_FD_${k}$ = ${TOL_FD[k]}$_${k}$
        !! Tangent vs finite differences, `real(${k}$)`.
    real(${k}$), parameter :: TOL_OBJ_${k}$ = ${TOL_OBJ[k]}$_${k}$
        !! Objectivity, `real(${k}$)`.
    real(${k}$), parameter :: TOL_UNI_${k}$ = ${TOL_UNI[k]}$_${k}$
        !! Uniaxial closed form, `real(${k}$)`.
    #:endfor
    logical :: passed

    passed = .true.
    #:for k in REAL_KINDS
    #:for m in KMATS
    call sequence_${m.name}$_${k}$()
    #:endfor
    #:for m in VM
    #:if m in NEAR_I and m.kin != 'small_strain' and is_f(m)
    call near_identity_${m.name}$_${k}$()
    #:endif
    #:if m.kin in LOGS
    call uniaxial_${m.name}$_${k}$()
    #:endif
    #:endfor
    #:for m in KMATS
    #:if is_f(m) and m.kin != 'small_strain'
    call invalid_${m.name}$_${k}$()
    #:endif
    #:endfor
    #:endfor
    #:for m in KMATS
    #:if is_f(m) and m.kin != 'small_strain' and 'dp' in REAL_KINDS
    call near_zero_${m.name}$()
    #:endif
    #:endfor
    if (.not. passed) then
        print '(a)', ' FAIL: test_mat_kinematics (oracles)'
        stop 5
    end if

contains
    #:for k in REAL_KINDS

    pure function rotation_${k}$() result(q)
        !! Rigid rotation Q (Rodrigues formula), `real(${k}$)`.
        real(${k}$) :: q(3, 3)
        real(${k}$) :: n(3), w(3, 3)
        integer :: i

        n = real(AXIS/norm2(AXIS), ${k}$)
        w = reshape([0.0_${k}$, n(3), -n(2), -n(3), 0.0_${k}$, n(1), n(2), -n(1), 0.0_${k}$], [3, 3])
        q = sin(real(ANGLE, ${k}$))*w + (1.0_${k}$ - cos(real(ANGLE, ${k}$)))*matmul(w, w)
        do i = 1, 3
            q(i, i) = q(i, i) + 1.0_${k}$
        end do
    end function rotation_${k}$

    pure function ten2_${k}$(m) result(t)
        !! 3x3 matrix as a `${G2(k)}$`.
        real(${k}$), intent(in) :: m(3, 3)
        type(${G2(k)}$) :: t
        t%vals = reshape(m, [9])
    end function ten2_${k}$

    subroutine fd_tangent_${k}$(label, tangent, tau, j, tol)
        !! Spatial tangent against the central finite differences of the Kirchhoff stress over J for
        !! dF = de F (`tau`: J sigma of the perturbed F_np1).
        character(len=*), intent(in) :: label
        type(${C4(k)}$), intent(in) :: tangent
        real(${k}$), intent(in) :: tau(6, 6, 2)
            !! J sigma at F + h E_c F (:, c, 1) and F - h E_c F (:, c, 2).
        real(${k}$), intent(in) :: j
            !! J of F_np1.
        real(${k}$), intent(in) :: tol
        real(${k}$) :: num(6, 6)
        num = (tau(:, :, 1) - tau(:, :, 2))/(2.0_${k}$*FD_H_${k}$*j)
        call check_approx(passed, label // ' tangent vs FD (${k}$)', tangent%vals, num, tol)
    end subroutine fd_tangent_${k}$

    pure function unit_${k}$(c) result(e)
        !! Symmetric unit perturbation of Voigt component c (1/2 on both shear entries).
        integer, intent(in) :: c
        real(${k}$) :: e(3, 3)
        integer, parameter :: I_OF(6) = [1, 2, 3, 1, 2, 1], J_OF(6) = [1, 2, 3, 2, 3, 3]
        e = 0.0_${k}$
        if (c <= 3) then
            e(c, c) = 1.0_${k}$
        else
            e(I_OF(c), J_OF(c)) = 0.5_${k}$
            e(J_OF(c), I_OF(c)) = 0.5_${k}$
        end if
    end function unit_${k}$

    pure real(${k}$) function det3_${k}$(m)
        !! Determinant of a 3x3 matrix.
        real(${k}$), intent(in) :: m(3, 3)
        det3_${k}$ = m(1, 1)*(m(2, 2)*m(3, 3) - m(3, 2)*m(2, 3)) - m(1, 2)*(m(2, 1)*m(3, 3) - m(3, 1)*m(2, 3)) &
            + m(1, 3)*(m(2, 1)*m(3, 2) - m(3, 1)*m(2, 2))
    end function det3_${k}$
    #:for m in KMATS
    #:set MT = muscle_meta.material_type(m.name, k)

    subroutine make_${m.name}$_${k}$(mat, soft)
        !! Material `${m.name}$`: E = 210000, nu = 0.3, bilinear hardening (sigma_y = 200, K = 1000, or
        !! with `soft` sigma_y = 2, K = 100: yield strain ~1e-5)${', Hill (1948) hill48-2' if m.yield_ == 'hill48' else ''}$.
        type(${MT}$), intent(out) :: mat
        logical, intent(in) :: soft
        integer :: status
        call elas_linear_init(mat%elas, young=210000.0_${k}$, poisson=0.3_${k}$, status=status)
        call check_true(passed, '${m.name}$ elastic init (${k}$)', status == STATUS_OK)
        mat%hard%y0 = merge(2.0_${k}$, 200.0_${k}$, soft)
        mat%hard%K = merge(100.0_${k}$, 1000.0_${k}$, soft)
        #:for fam in ('os', 'vp')
        #:if getattr(m, fam)
        #:for st in RATE_PARAMS[fam]
        mat${st.format(k=k)}$
        #:endfor
        #:endif
        #:endfor
        #:if m.yield_ == 'hill48'
        mat%yield%f = 0.25_${k}$
        mat%yield%g = 0.4_${k}$
        mat%yield%h = 0.6_${k}$
        mat%yield%l = 1.3_${k}$
        mat%yield%m = 1.7_${k}$
        mat%yield%n = 1.45_${k}$
        #:endif
    end subroutine make_${m.name}$_${k}$

    #:if is_f(m)
    #:set SS = m.kin == 'small_strain'
    subroutine sequence_${m.name}$_${k}$()
        !! Loading / unloading sequence of `${m.name}$` (`real(${k}$)`): FD tangent at every converged
        #:if SS
        !! step (small strain: of sigma for dF = de, the strain increment).
        #:else
        !! step, the same sequence rotated by Q (objectivity).
        #:endif
        type(${MT}$) :: mat
        type(plastic_state_${k}$) :: sn, snp1, qn, qnp1, sp_tmp
        type(${G2(k)}$) :: f_n, f_np1, q_n, q_np1, qt, fp
        type(${S2(k)}$) :: stress, sp_stress
        type(${C4(k)}$) :: tangent, sp_tan
        #:if not SS
        type(${S2(k)}$) :: qstress
        type(${C4(k)}$) :: qtangent
        integer :: qstatus, qiters
        #:endif
        #:if m.tangent_rate == 'none'
        type(${C4(k)}$) :: geo
        type(kin_state_${k}$) :: ks
        #:endif
        real(${k}$) :: q(3, 3), tau(6, 6, 2), id(3, 3), e(3, 3)
        integer :: is, status, iters, c, side, st2, it2
        character(len=64) :: key

        call make_${m.name}$_${k}$(mat, .false.)
        q = rotation_${k}$()
        qt = ten2_${k}$(q)
        id = 0.0_${k}$
        id(1, 1) = 1.0_${k}$
        id(2, 2) = 1.0_${k}$
        id(3, 3) = 1.0_${k}$
        f_n = ten2_${k}$(id)
        q_n = qt
        do is = 1, NSEQ
            write(key, '(a, i0)') 'mat_kinematics | ${m.name}$ | step ', is
            f_np1 = ten2_${k}$(id + real(SEQ(is)*GMAT, ${k}$))
            q_np1 = ten2_${k}$(matmul(q, id + real(SEQ(is)*GMAT, ${k}$)))
            call mat_update(mat, f_n, f_np1, ${dt_of(m, k)}$, sn, snp1, stress, tangent, status, iters)
            call check_true(passed, trim(key) // ' converged (${k}$)', status == STATUS_OK)
            #:if m.tangent_rate == 'none'
            call kin_update(mat%kin, f_np1, ks, st2)
            geo = kin_geometric_tangent(mat%kin, ks, stress)
            tangent%vals = tangent%vals + geo%vals
            #:endif
            ! Tangent vs finite differences of J sigma (Jaumann rate of the Kirchhoff stress)
            do c = 1, 6
                e = unit_${k}$(c)
                do side = 1, 2
                    #:if SS
                    fp = ten2_${k}$(reshape(f_np1%vals, [3, 3]) + merge(1.0_${k}$, -1.0_${k}$, side == 1)*FD_H_${k}$*e)
                    call mat_update(mat, f_n, fp, ${dt_of(m, k)}$, sn, sp_tmp, sp_stress, sp_tan, st2, it2)
                    tau(:, c, side) = sp_stress%vals
                    #:else
                    fp = ten2_${k}$(matmul(id + merge(1.0_${k}$, -1.0_${k}$, side == 1)*FD_H_${k}$*e, &
                        reshape(f_np1%vals, [3, 3])))
                    call mat_update(mat, f_n, fp, ${dt_of(m, k)}$, sn, sp_tmp, sp_stress, sp_tan, st2, it2)
                    tau(:, c, side) = det3_${k}$(reshape(fp%vals, [3, 3]))*sp_stress%vals
                    #:endif
                end do
            end do
            call fd_tangent_${k}$(trim(key), tangent, tau, &
                ${'1.0_' + k if SS else 'det3_' + k + '(reshape(f_np1%vals, [3, 3]))'}$, TOL_FD_${k}$)
            #:if not SS
            ! Objectivity: the rotated sequence
            call mat_update(mat, q_n, q_np1, ${dt_of(m, k)}$, qn, qnp1, qstress, qtangent, qstatus, qiters)
            #:if m.tangent_rate == 'none'
            call kin_update(mat%kin, q_np1, ks, st2)
            geo = kin_geometric_tangent(mat%kin, ks, qstress)
            qtangent%vals = qtangent%vals + geo%vals
            #:endif
            call check_true(passed, trim(key) // ' rotated: status (${k}$)', qstatus == status)
            sp_stress = qt .transform. stress
            sp_tan = qt .transform. tangent
            call check_approx(passed, trim(key) // ' rotated: stress (${k}$)', qstress%vals, sp_stress%vals, &
                TOL_OBJ_${k}$)
            call check_approx(passed, trim(key) // ' rotated: tangent (${k}$)', qtangent%vals, sp_tan%vals, &
                TOL_OBJ_${k}$)
            call check_approx(passed, trim(key) // ' rotated: ep (${k}$)', [qnp1%strain_pf], [snp1%strain_pf], &
                TOL_OBJ_${k}$)
            #:endif
            sn = snp1
            qn = qnp1
            f_n = f_np1
            q_n = q_np1
        end do
        call check_true(passed, '${m.name}$ yields (${k}$)', sn%strain_pf > 0.0_${k}$)
    end subroutine sequence_${m.name}$_${k}$
    #:elif not is_f(m)
    subroutine sequence_${m.name}$_${k}$()
        !! Strain sequence of the corotational material `${m.name}$` (`real(${k}$)`; the strain given in
        !! the corotational frame, D-018.15f): the tangent against the central finite differences of
        !! J sigma, J = exp(tr eps); rotating the inputs (strain, plastic strain) by Q gives the rotated
        !! stress and tangent (isotropic material).
        type(${MT}$) :: mat
        type(plastic_state_${k}$) :: sn, snp1, qn, qnp1, sp_tmp
        type(${S2(k)}$) :: strain, qstrain, sp_strain, stress, qstress, sp_stress
        type(${C4(k)}$) :: tangent, qtangent, sp_tan
        type(${G2(k)}$) :: qt
        real(${k}$) :: tau(6, 6, 2), num(6, 6), gs(3, 3)
        integer :: is, status, qstatus, iters, qiters, c, side, st2, it2
        character(len=64) :: key

        call make_${m.name}$_${k}$(mat, .false.)
        qt = ten2_${k}$(rotation_${k}$())
        gs = 0.5_${k}$*real(GMAT + transpose(GMAT), ${k}$)
        do is = 1, NSEQ
            write(key, '(a, i0)') 'mat_kinematics | ${m.name}$ | step ', is
            strain%vals = real(SEQ(is), ${k}$)*[gs(1, 1), gs(2, 2), gs(3, 3), gs(1, 2), gs(2, 3), gs(1, 3)]
            call mat_update(mat, strain, 0.0_${k}$, sn, snp1, stress, tangent, status, iters)
            call check_true(passed, trim(key) // ' converged (${k}$)', status == STATUS_OK)
            do c = 1, 6
                do side = 1, 2
                    sp_strain = strain
                    sp_strain%vals(c) = sp_strain%vals(c) + merge(1.0_${k}$, -1.0_${k}$, side == 1)*FD_H_${k}$* &
                        merge(1.0_${k}$, 0.5_${k}$, c <= 3)
                    call mat_update(mat, sp_strain, 0.0_${k}$, sn, sp_tmp, sp_stress, sp_tan, st2, it2)
                    tau(:, c, side) = exp(sp_strain%vals(1) + sp_strain%vals(2) + sp_strain%vals(3))*sp_stress%vals
                end do
            end do
            num = (tau(:, :, 1) - tau(:, :, 2))/(2.0_${k}$*FD_H_${k}$*exp(strain%vals(1) + strain%vals(2) + strain%vals(3)))
            call check_approx(passed, trim(key) // ' tangent vs FD (${k}$)', tangent%vals, num, TOL_FD_${k}$)
            ! Rotated inputs: the strain and the converged plastic strain
            qstrain = qt .transform. strain
            qn%strain_p = qt .transform. sn%strain_p
            qn%strain_pf = sn%strain_pf
            call mat_update(mat, qstrain, 0.0_${k}$, qn, qnp1, qstress, qtangent, qstatus, qiters)
            call check_true(passed, trim(key) // ' rotated: status (${k}$)', qstatus == status)
            sp_stress = qt .transform. stress
            sp_tan = qt .transform. tangent
            call check_approx(passed, trim(key) // ' rotated: stress (${k}$)', qstress%vals, sp_stress%vals, &
                TOL_OBJ_${k}$)
            call check_approx(passed, trim(key) // ' rotated: tangent (${k}$)', qtangent%vals, sp_tan%vals, &
                TOL_OBJ_${k}$)
            call check_approx(passed, trim(key) // ' rotated: ep (${k}$)', [qnp1%strain_pf], [snp1%strain_pf], &
                TOL_OBJ_${k}$)
            sn = snp1
        end do
        call check_true(passed, '${m.name}$ yields (${k}$)', sn%strain_pf > 0.0_${k}$)
    end subroutine sequence_${m.name}$_${k}$
    #:endif
    #:if m in NEAR_I and m.kin != 'small_strain' and is_f(m)

    subroutine near_identity_${m.name}$_${k}$()
        !! F -> I: one plastic step of `${m.name}$` at F = I + eta G agrees with the small strain
        !! kinematics (`${REF.name}$`) within O(eta) (soft hardening: yield strain ~1e-5).
        type(${MT}$) :: mat
        type(${muscle_meta.material_type(REF.name, k)}$) :: ref
        type(plastic_state_${k}$) :: sn, snp1, rnp1
        type(${G2(k)}$) :: f_n, f_np1
        type(${S2(k)}$) :: stress, rstress
        type(${C4(k)}$) :: tangent, rtangent
        real(${k}$) :: id(3, 3), eta, err, scale, errs(2)
        integer :: status, iters, i

        call make_${m.name}$_${k}$(mat, .true.)
        call make_${REF.name}$_${k}$(ref, .true.)
        id = 0.0_${k}$
        do i = 1, 3
            id(i, i) = 1.0_${k}$
        end do
        f_n = ten2_${k}$(id)
        do i = 1, 2
            ! sp: larger eta, above the rounding of the strain measures (~1e-7 absolute)
            eta = merge(${'1.0e-2' if k == 'sp' else '1.0e-3'}$_${k}$, ${'1.0e-3' if k == 'sp' else '1.0e-4'}$_${k}$, i == 1)
            f_np1 = ten2_${k}$(id + eta*real(GMAT, ${k}$))
            call mat_update(mat, f_n, f_np1, 0.0_${k}$, sn, snp1, stress, tangent, status, iters)
            call mat_update(ref, f_n, f_np1, 0.0_${k}$, sn, rnp1, rstress, rtangent, status, iters)
            scale = maxval(abs(rstress%vals))
            err = maxval(abs(stress%vals - rstress%vals))/scale
            call check_true(passed, '${m.name}$ F -> I: plastic (${k}$)', iters > 0)
            call check_true(passed, '${m.name}$ F -> I: |sigma - sigma_small| <= 10 eta |sigma| (${k}$)', &
                err <= 10.0_${k}$*eta)
            errs(i) = err
        end do
        ! First order in eta: the error divides by ~10 with eta [measured 9.2-12.1 in dp]
        call check_true(passed, '${m.name}$ F -> I: first order in eta (${k}$)', &
            errs(1)/errs(2) > 5.0_${k}$ .and. errs(1)/errs(2) < 20.0_${k}$)
    end subroutine near_identity_${m.name}$_${k}$
    #:endif
    #:if m in VM and m.kin in LOGS

    subroutine uniaxial_${m.name}$_${k}$()
        !! Isochoric uniaxial tension of `${m.name}$` against the closed form (logarithmic strain, von
        !! Mises, bilinear hardening; proportional path).
        type(${MT}$) :: mat
        type(plastic_state_${k}$) :: sn, snp1
        type(${G2(k)}$) :: f_n, f_np1
        type(${S2(k)}$) :: stress, expected
        #:if not is_f(m)
        type(${S2(k)}$) :: strain
        #:endif
        type(${C4(k)}$) :: tangent
        real(${k}$), parameter :: LAMBDAS(4) = [1.0005_${k}$, 1.01_${k}$, 1.05_${k}$, 1.2_${k}$]
        real(${k}$) :: g, ep, qeq, id(3, 3), fm(3, 3)
        integer :: status, iters, i

        call make_${m.name}$_${k}$(mat, .false.)
        g = 210000.0_${k}$/(2.0_${k}$*1.3_${k}$)
        id = 0.0_${k}$
        do i = 1, 3
            id(i, i) = 1.0_${k}$
        end do
        f_n = ten2_${k}$(id)
        do i = 1, size(LAMBDAS)
            fm = 0.0_${k}$
            fm(1, 1) = LAMBDAS(i)
            fm(2, 2) = 1.0_${k}$/sqrt(LAMBDAS(i))
            fm(3, 3) = fm(2, 2)
            f_np1 = ten2_${k}$(fm)
            #:if is_f(m)
            call mat_update(mat, f_n, f_np1, 0.0_${k}$, sn, snp1, stress, tangent, status, iters)
            #:else
            ! Corotational: the logarithmic strain in the (unrotated) corotational frame
            strain%vals = [log(LAMBDAS(i)), -0.5_${k}$*log(LAMBDAS(i)), -0.5_${k}$*log(LAMBDAS(i)), 0.0_${k}$, &
                0.0_${k}$, 0.0_${k}$]
            call mat_update(mat, strain, 0.0_${k}$, sn, snp1, stress, tangent, status, iters)
            #:endif
            ep = max(0.0_${k}$, (3.0_${k}$*g*log(LAMBDAS(i)) - 200.0_${k}$)/(3.0_${k}$*g + 1000.0_${k}$))
            qeq = merge(200.0_${k}$ + 1000.0_${k}$*ep, 3.0_${k}$*g*log(LAMBDAS(i)), ep > 0.0_${k}$)
            expected%vals = [2.0_${k}$*qeq/3.0_${k}$, -qeq/3.0_${k}$, -qeq/3.0_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$]
            call check_approx(passed, '${m.name}$ uniaxial stress (${k}$)', stress%vals, expected%vals, TOL_UNI_${k}$)
            call check_approx(passed, '${m.name}$ uniaxial ep (${k}$)', [snp1%strain_pf], [ep], TOL_UNI_${k}$)
            call check_true(passed, '${m.name}$ uniaxial finite tangent (${k}$)', all(ieee_is_finite(tangent%vals)))
            sn = snp1
            f_n = f_np1
        end do
    end subroutine uniaxial_${m.name}$_${k}$
    #:endif
    #:if is_f(m) and m.kin != 'small_strain'

    subroutine invalid_${m.name}$_${k}$()
        !! `${m.name}$` with an inadmissible F_np1 (`real(${k}$)`): a reflection diag(-1, 1, 1) and a singular
        !! diag(1, 1, 0) give STATUS_INVALID_DEFORMATION, iters = 0 and a zero stress and tangent.
        type(${MT}$) :: mat
        type(plastic_state_${k}$) :: sn, snp1
        type(${G2(k)}$) :: f_n, f_np1
        type(${S2(k)}$) :: stress
        type(${C4(k)}$) :: tangent
        real(${k}$) :: id(3, 3), fm(3, 3)
        integer :: status, iters, i, ic

        call make_${m.name}$_${k}$(mat, .false.)
        id = 0.0_${k}$
        do i = 1, 3
            id(i, i) = 1.0_${k}$
        end do
        f_n = ten2_${k}$(id)
        do ic = 1, 2
            fm = id
            if (ic == 1) then
                fm(1, 1) = -1.0_${k}$
            else
                fm(3, 3) = 0.0_${k}$
            end if
            f_np1 = ten2_${k}$(fm)
            stress%vals = 7.0_${k}$
            tangent%vals = 7.0_${k}$
            iters = -1
            call mat_update(mat, f_n, f_np1, ${dt_of(m, k)}$, sn, snp1, stress, tangent, status, iters)
            call check_true(passed, '${m.name}$ det F <= 0: STATUS_INVALID_DEFORMATION (${k}$)', &
                status == STATUS_INVALID_DEFORMATION)
            call check_true(passed, '${m.name}$ det F <= 0: iters = 0 (${k}$)', iters == 0)
            call check_true(passed, '${m.name}$ det F <= 0: zero stress (${k}$)', all(stress%vals == 0.0_${k}$))
            call check_true(passed, '${m.name}$ det F <= 0: zero tangent (${k}$)', all(tangent%vals == 0.0_${k}$))
        end do
    end subroutine invalid_${m.name}$_${k}$
    #:endif
    #:endfor
    #:endfor
    #:if 'dp' in REAL_KINDS
    #:for m in KMATS
    #:if is_f(m) and m.kin != 'small_strain'
    #:set MT = muscle_meta.material_type(m.name, 'dp')

    subroutine near_zero_${m.name}$()
        !! Elastic steps of `${m.name}$` near F = I (`real(dp)`, D-018.19a: the logarithmic strains and R
        !! of nearly repeated eigenvalues): the stress against the small strain linear elastic stress
        !! (first order in the strain amplitude) and the tangent against central finite differences of
        !! J sigma for dF = h E_c F, h a tenth of the amplitude.
        type(${MT}$) :: mat
        type(plastic_state_dp) :: sn, snp1
        type(${G2('dp')}$) :: f_n, f_np1, fp
        type(${S2('dp')}$) :: stress, sp_stress
        type(${C4('dp')}$) :: tangent, sp_tan
        #:if m.tangent_rate == 'none'
        type(${C4('dp')}$) :: geo
        type(kin_state_dp) :: ks
        #:endif
        real(dp), parameter :: ETAS(${len(SMALL_ETA)}$) = [${', '.join(SMALL_ETA)}$]
        real(dp), parameter :: YOUNG = 210000.0_dp, NU = 0.3_dp
        real(dp) :: id(3, 3), g(3, 3), eps(3, 3), sig_lin(6), tau(6, 6, 2), num(6, 6), lam, mu, eta, h
        integer :: ishape, ie, c, side, status, iters, st2, it2
        character(len=80) :: label

        call make_${m.name}$_dp(mat, .false.)
        lam = YOUNG*NU/((1.0_dp + NU)*(1.0_dp - 2.0_dp*NU))
        mu = YOUNG/(2.0_dp*(1.0_dp + NU))
        id = 0.0_dp
        id(1, 1) = 1.0_dp
        id(2, 2) = 1.0_dp
        id(3, 3) = 1.0_dp
        f_n = ten2_dp(id)
        do ishape = 1, 3
            ! Uniaxial (two repeated stretches), pure shear, general (stretch and rotation)
            select case (ishape)
            case (1)
                g = 0.0_dp
                g(1, 1) = 1.0_dp
            case (2)
                g = 0.0_dp
                g(1, 2) = 1.0_dp
                g(2, 1) = 1.0_dp
            case default
                g = GMAT
            end select
            do ie = 1, size(ETAS)
                eta = ETAS(ie)
                write(label, '(a, i0, a, es8.1)') '${m.name}$ near F = I: shape ', ishape, ', eta ', eta
                f_np1 = ten2_dp(id + eta*g)
                call mat_update(mat, f_n, f_np1, ${dt_of(m, 'dp')}$, sn, snp1, stress, tangent, status, iters)
                call check_true(passed, trim(label) // ': elastic', status == STATUS_OK .and. iters == 0)
                #:if m.tangent_rate == 'none'
                call kin_update(mat%kin, f_np1, ks, st2)
                geo = kin_geometric_tangent(mat%kin, ks, stress)
                tangent%vals = tangent%vals + geo%vals
                #:endif
                eps = 0.5_dp*eta*(g + transpose(g))
                sig_lin = 2.0_dp*mu*[eps(1, 1), eps(2, 2), eps(3, 3), eps(1, 2), eps(2, 3), eps(1, 3)]
                sig_lin(1:3) = sig_lin(1:3) + lam*(eps(1, 1) + eps(2, 2) + eps(3, 3))
                call check_true(passed, trim(label) // ': |sigma - C:eps| <= ${SMALL_SIG}$ eta |C:eps|', &
                    maxval(abs(stress%vals - sig_lin)) <= ${SMALL_SIG}$*eta*maxval(abs(sig_lin)))
                h = 0.1_dp*eta
                do c = 1, 6
                    do side = 1, 2
                        fp = ten2_dp(matmul(id + merge(1.0_dp, -1.0_dp, side == 1)*h*unit_dp(c), &
                            reshape(f_np1%vals, [3, 3])))
                        call mat_update(mat, f_n, fp, ${dt_of(m, 'dp')}$, sn, snp1, sp_stress, sp_tan, st2, it2)
                        tau(:, c, side) = det3_dp(reshape(fp%vals, [3, 3]))*sp_stress%vals
                    end do
                end do
                num = (tau(:, :, 1) - tau(:, :, 2))/(2.0_dp*h*det3_dp(reshape(f_np1%vals, [3, 3])))
                call check_approx(passed, trim(label) // ': tangent vs FD', tangent%vals, num, ${SMALL_FD}$)
            end do
        end do
    end subroutine near_zero_${m.name}$
    #:endif
    #:endfor
    #:endif

end program test_mat_kinematics
