#:include "muscle_common.fypp"
#! Materials under test (test registry, tools/fypp/muscle_materials.py): (name, input, parameters)
#!   input: 'F' = deformation gradients F_n, F_np1; 'eps' = strain (also the corotational kinematics)
#!   parameters: 'os' Perzyna overstress, 'jc' Johnson-Cook rate law, 'maxwell' frozen Maxwell
#!   elasticity (+ 'maxwell_jc' with the rate law), 'hill48' anisotropic yield; linear elasticity otherwise
#:set MATS = [ &
    & ('cp_vm_swift', 'eps', ''), &
    & ('cp2_vm_bilinear', 'eps', ''), &
    & ('cut_vm_bilinear', 'eps', ''), &
    & ('pz_vm_bilinear', 'eps', 'os'), &
    & ('tm_jc_vm_swift', 'eps', 'jc'), &
    & ('cp_maxwell_vm_bilinear', 'eps', 'maxwell'), &
    & ('tm_maxwell_jc_vm_bilinear', 'eps', 'maxwell_jc'), &
    & ('kin_ss_vm_bilinear', 'F', ''), &
    & ('kin_tl_vm_bilinear', 'F', ''), &
    & ('kin_ul_vm_bilinear', 'F', ''), &
    & ('kin_ul_hill48_bilinear', 'F', 'hill48'), &
    & ('kin_cr_vm_bilinear', 'eps', '')]
#:set is_visco = lambda extra: extra.startswith('maxwell')

module test_mat_batch_cases
    !! Batch API of the declared materials (D-008.2, D-018.7, D-018.14d): `muscle_update_<name>` over
    !! SoA arrays against the point kernel called point by point (`mat_unpack_<name>`, `mat_update`,
    !! `mat_pack_<name>`), **bit for bit**, in every kind, for one material of every solver
    !! (closest point, closest point 2, cutting plane, Perzyna, time-dependent closest point), two
    !! materials with a frozen Maxwell elasticity and every kinematics (small strain, total and
    !! updated Lagrangian, updated Lagrangian with Hill 1948, corotational):
    !!
    !! - three load steps (the state of each step is the converged state of the previous one), with
    !!   elastic and plastic points;
    !! - with and without `ddsdde`, with and without the index list `idx` (the rows not in `idx` of
    !!   every output are not touched);
    !! - with 1 and 4 OpenMP threads (same bits as the point loop in both);
    !! - viscoelastic materials: a time step rejected by `mat_step` (dt < 0) gives its status to every
    !!   point to compute (all points, or those of `idx`), iterations 0, and nothing else is written.
    !!
    !! With MUSCLE_GPU the arrays and the material are mapped before the batch calls (`target enter
    !! data`, the contract of the batch API) and copied back after each one; if the target regions run
    !! on a device, the real outputs of each point (row) are compared within `TOL_DEVICE_<k>` relative to
    !! the row instead of bit for bit (statuses, iterations and untouched rows stay exact).
    use omp_lib, only : omp_set_num_threads, omp_get_max_threads
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_status, only : STATUS_OK
    use muscle_tensors, only : ${', '.join(tname('3D2Osym', k) + ', ' + tname('3D2O', k) + ', ' + tname('3D4O2sym', k) for k in REAL_KINDS)}$
    use muscle_elasticity_linear, only : elas_linear_init
    use muscle_visco_maxwell, only : visco_maxwell_init
    use muscle_plastic_state, only : ${', '.join('plastic_state_' + k for k in REAL_KINDS)}$
    use muscle_visco_laws, only : ${', '.join('visco_coefs_' + k for k in REAL_KINDS)}$
#:for m, x, extra in MATS
    use muscle_mat_${m}$, only : mat_update, ${'mat_step, ' if is_visco(extra) else ''}$mat_pack_${m}$, mat_unpack_${m}$, &
        muscle_update_${m}$, MAT_${m.upper()}$_NSTATE, ${', '.join('mat_' + m + '_' + k for k in REAL_KINDS)}$${''.join(', mat_state_' + m + '_' + k for k in REAL_KINDS) if is_visco(extra) else ''}$
#:endfor
    use muscle_test_utils, only : check_true, target_on_device, ${', '.join('TOL_DEVICE_' + k for k in REAL_KINDS)}$
    implicit none
    private
    public :: run_all

    logical, public :: passed = .true.
        !! Accumulated result of every check.
    logical :: device = .false.
        !! The batch target regions run on a device (set by run_all).

contains

    subroutine run_all()
        !! Every material in every kind.
        device = target_on_device()
        print '(a, l1)', ' batch target regions on a device: ', device
#:for k in REAL_KINDS
#:for m, x, extra in MATS
        call run_${m}$_${k}$()
#:endfor
#:endfor
    end subroutine run_all
#:for k in REAL_KINDS
#:for m, x, extra in MATS
#:set NS = 'MAT_' + m.upper() + '_NSTATE'
#:set ST = 'mat_state_' + m + '_' + k if is_visco(extra) else 'plastic_state_' + k
#:set XB = 'x0, x1' if x == 'F' else 'x0'
#:set L = m + ' (' + k + ')'

    subroutine run_${m}$_${k}$()
        !! Batch API of `${m}$` against its point kernel, `real(${k}$)`.
        integer, parameter :: N = 301
        integer, parameter :: NIDX = 100
        real(${k}$), parameter :: DT = 0.01_${k}$
        real(${k}$), parameter :: BAD = -7.0_${k}$
            ! Sentinel of the outputs before each batch call
        type(mat_${m}$_${k}$) :: mat
        real(${k}$) :: hn(N, ${NS}$), hr(N, ${NS}$), hb(N, ${NS}$)
        real(${k}$) :: sr(N, 6), sb(N, 6), tr(N, 6, 6), tb(N, 6, 6), hsv(${NS}$), a
        integer :: str(N), stb(N), itr(N), itb(N), idx(NIDX), i, step, nth
        logical :: plastic
        type(${ST}$) :: sn, snp1
        type(${tname('3D2Osym', k)}$) :: stress
        type(${tname('3D4O2sym', k)}$) :: tang
#:if x == 'F'
        real(${k}$) :: x0(N, 9), x1(N, 9)
        type(${tname('3D2O', k)}$) :: fa, fb
#:else
        real(${k}$) :: x0(N, 6)
        type(${tname('3D2Osym', k)}$) :: strain
#:endif
        integer :: st
#:if is_visco(extra)
        type(visco_coefs_${k}$) :: coefs
#:endif

#:if is_visco(extra)
        call visco_maxwell_init(mat%visco, bulk=150000.0_${k}$, shear_inf=50000.0_${k}$, &
            shear=[20000.0_${k}$, 10000.0_${k}$], tau=[0.05_${k}$, 1.0_${k}$], status=st)
        call check_true(passed, '${L}$: Maxwell init', st == STATUS_OK)
#:else
        call elas_linear_init(mat%elas, young=210000.0_${k}$, poisson=0.3_${k}$, status=st)
        call check_true(passed, '${L}$: elastic init', st == STATUS_OK)
#:endif
#:if 'swift' in m
        mat%hard%k = 500.0_${k}$
        mat%hard%e0 = 1.0e-3_${k}$
        mat%hard%n = 0.2_${k}$
#:else
        mat%hard%y0 = 200.0_${k}$
        mat%hard%K = 1000.0_${k}$
#:endif
#:if extra == 'os'
        mat%os%eta = 1.0e-2_${k}$
        mat%os%n = 1.0_${k}$
#:endif
#:if extra in ('jc', 'maxwell_jc')
        mat%vp%C = 0.014_${k}$
        mat%vp%epdmax = 1.0_${k}$
#:endif
#:if extra == 'hill48'
        mat%yield%f = 0.25_${k}$
        mat%yield%g = 0.4_${k}$
        mat%yield%h = 0.6_${k}$
        mat%yield%l = 1.3_${k}$
        mat%yield%m = 1.7_${k}$
        mat%yield%n = 1.45_${k}$
#:endif
        ! Every third point, in decreasing order (the last point is in the list, the first is not)
        do i = 1, NIDX
            idx(i) = N + 1 - 3*i
        end do
        hn = 0.0_${k}$
        plastic = .false.
#:if defined('MUSCLE_GPU')
        !$omp target enter data map(to: mat)
#:endif
        do step = 1, 3
            ! Inputs: from 0 up to 4e-3*step along a fixed direction (elastic and plastic points)
            do i = 1, N
                a = real(i, ${k}$)/real(N, ${k}$)*4.0e-3_${k}$*real(step, ${k}$)
#:if x == 'F'
                fa%vals = [1.0_${k}$ + 0.8_${k}$*a*real(step - 1, ${k}$)/real(step, ${k}$), 0.1_${k}$*a, 0.0_${k}$, &
                    0.3_${k}$*a, 1.0_${k}$ - 0.3_${k}$*a, 0.2_${k}$*a, 0.0_${k}$, 0.0_${k}$, 1.0_${k}$ - 0.3_${k}$*a]
                fb = fa
                fb%vals(1) = 1.0_${k}$ + a
                x0(i, :) = fa%vals
                x1(i, :) = fb%vals
#:else
                x0(i, :) = a*[1.0_${k}$, -0.3_${k}$, -0.3_${k}$, 0.2_${k}$, 0.05_${k}$, 0.1_${k}$]
#:endif
            end do

            ! Reference: the point kernel point by point through the history array
#:if is_visco(extra)
            call mat_step(mat, DT, coefs, st)
            call check_true(passed, '${L}$: mat_step', st == STATUS_OK)
#:endif
            do i = 1, N
                hsv = hn(i, :)
                call mat_unpack_${m}$(hsv, sn)
#:if x == 'F'
                fa%vals = x0(i, :)
                fb%vals = x1(i, :)
                call mat_update(mat, fa, fb, DT, sn, snp1, stress, tang, str(i), itr(i))
#:elif is_visco(extra)
                strain%vals = x0(i, :)
                call mat_update(mat, strain, DT, coefs, sn, snp1, stress, tang, str(i), itr(i))
#:else
                strain%vals = x0(i, :)
                call mat_update(mat, strain, DT, sn, snp1, stress, tang, str(i), itr(i))
#:endif
                call mat_pack_${m}$(snp1, hsv)
                hr(i, :) = hsv
                sr(i, :) = stress%vals
                tr(i, :, :) = tang%vals
            end do
            plastic = plastic .or. any(itr > 0)
#:if defined('MUSCLE_GPU')
            !$omp target enter data map(to: ${XB}$, hn, idx) map(alloc: hb, sb, tb, stb, itb)
#:endif

            do nth = 1, 4, 3
                call omp_set_num_threads(nth)
                call check_true(passed, '${L}$: OpenMP threads', omp_get_max_threads() == nth)
                ! Every point, with tangent
                call reset()
                call muscle_update_${m}$(mat, ${XB}$, DT, hn, hb, sb, stb, itb, ddsdde=tb)
                call fetch()
                call check_true(passed, '${L}$: batch with tangent == point loop', &
                    same(hb, hr) .and. same(sb, sr) .and. same(reshape(tb, [N, 36]), reshape(tr, [N, 36])) &
                    .and. all(stb == str) .and. all(itb == itr))
                ! Every point, without tangent (ddsdde not touched)
                call reset()
                call muscle_update_${m}$(mat, ${XB}$, DT, hn, hb, sb, stb, itb)
                call fetch()
                call check_true(passed, '${L}$: batch without tangent == point loop', &
                    same(hb, hr) .and. same(sb, sr) .and. all(stb == str) .and. all(itb == itr) .and. all(tb == BAD))
                ! Index list, with and without tangent
                call reset()
                call muscle_update_${m}$(mat, ${XB}$, DT, hn, hb, sb, stb, itb, tb, idx)
                call fetch()
                call check_idx(.true.)
                call reset()
                call muscle_update_${m}$(mat, ${XB}$, DT, hn, hb, sb, stb, itb, idx=idx)
                call fetch()
                call check_idx(.false.)
            end do
#:if defined('MUSCLE_GPU')
            !$omp target exit data map(delete: ${XB}$, hn, idx, hb, sb, tb, stb, itb)
#:endif
            hn = hr
        end do
        call check_true(passed, '${L}$: the sequence has plastic points', plastic)
#:if is_visco(extra)

        ! Rejected time step: its status for the points to compute, iterations 0, nothing else written
        call mat_step(mat, -DT, coefs, st)
        call check_true(passed, '${L}$: dt < 0 rejected by mat_step', st /= STATUS_OK)
#:if defined('MUSCLE_GPU')
        !$omp target enter data map(to: x0, hn, idx) map(alloc: hb, sb, tb, stb, itb)
#:endif
        call reset()
        call muscle_update_${m}$(mat, x0, -DT, hn, hb, sb, stb, itb, ddsdde=tb)
        call fetch()
        call check_true(passed, '${L}$: step error, every point', all(stb == st) .and. all(itb == 0) &
            .and. all(hb == BAD) .and. all(sb == BAD) .and. all(tb == BAD))
        call reset()
        call muscle_update_${m}$(mat, x0, -DT, hn, hb, sb, stb, itb, idx=idx)
        call fetch()
        call check_true(passed, '${L}$: step error, index list', all(stb(idx) == st) .and. all(itb(idx) == 0) &
            .and. count(stb == -7) == N - NIDX .and. count(itb == -7) == N - NIDX &
            .and. all(hb == BAD) .and. all(sb == BAD) .and. all(tb == BAD))
#:if defined('MUSCLE_GPU')
        !$omp target exit data map(delete: x0, hn, idx, hb, sb, tb, stb, itb)
#:endif
#:endif
#:if defined('MUSCLE_GPU')
        !$omp target exit data map(delete: mat)
#:endif

    contains

        subroutine reset()
            !! Fills every output with the sentinel.
            hb = BAD
            sb = BAD
            tb = BAD
            stb = -7
            itb = -7
#:if defined('MUSCLE_GPU')
            !$omp target update to(hb, sb, tb, stb, itb)
#:endif
        end subroutine reset

        subroutine fetch()
            !! Copies the outputs of a batch call back from the device (nothing without MUSCLE_GPU).
#:if defined('MUSCLE_GPU')
            !$omp target update from(hb, sb, tb, stb, itb)
#:endif
        end subroutine fetch

        pure logical function same(a, b)
            !! Batch output `a` equals the point loop `b`: bit for bit, or on a device every row (point)
            !! within `TOL_DEVICE_${k}$` relative to its largest component.
            real(${k}$), intent(in) :: a(:, :)
                !! Batch output.
            real(${k}$), intent(in) :: b(:, :)
                !! Point loop.
            integer :: j

            if (.not. device) then
                same = all(a == b)
                return
            end if
            same = .true.
            do j = 1, size(a, 1)
                same = same .and. same_row(a(j, :), b(j, :))
            end do
        end function same

        pure logical function same_row(a, b)
            !! One row of `same`.
            real(${k}$), intent(in) :: a(:)
                !! Batch output.
            real(${k}$), intent(in) :: b(:)
                !! Point loop.
            if (device) then
                same_row = all(abs(a - b) <= TOL_DEVICE_${k}$*max(maxval(abs(a)), maxval(abs(b)), tiny(1.0_${k}$)))
            else
                same_row = all(a == b)
            end if
        end function same_row

        subroutine check_idx(tan)
            !! The rows of `idx` equal the reference (and the tangent if `tan`), the others untouched.
            logical, intent(in) :: tan
                !! The batch computed the tangent.
            logical :: sel(N), good
            integer :: j

            sel = .false.
            sel(idx) = .true.
            good = .true.
            do j = 1, N
                if (sel(j)) then
                    good = good .and. same_row(hb(j, :), hr(j, :)) .and. same_row(sb(j, :), sr(j, :)) &
                        .and. stb(j) == str(j) .and. itb(j) == itr(j)
                    if (tan) then
                        good = good .and. same_row(reshape(tb(j, :, :), [36]), reshape(tr(j, :, :), [36]))
                    else
                        good = good .and. all(tb(j, :, :) == BAD)
                    end if
                else
                    good = good .and. all(hb(j, :) == BAD) .and. all(sb(j, :) == BAD) .and. stb(j) == -7 &
                        .and. itb(j) == -7 .and. all(tb(j, :, :) == BAD)
                end if
            end do
            call check_true(passed, trim('${L}$: batch with index list' // merge(' and tangent', '            ', tan)), good)
        end subroutine check_idx
    end subroutine run_${m}$_${k}$
#:endfor
#:endfor

end module test_mat_batch_cases

program test_mat_batch
    !! Batch API of the declared materials: see module `test_mat_batch_cases`.
    use test_mat_batch_cases, only : run_all, passed
    implicit none

    call run_all()
    if (.not. passed) then
        print '(a)', ' FAIL: test_mat_batch'
        stop 1
    end if
    print '(a)', ' PASS: test_mat_batch'
end program test_mat_batch
