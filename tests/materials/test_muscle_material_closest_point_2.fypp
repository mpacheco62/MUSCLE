#:include "muscle_common.fypp"
#:include "muscle_fd.fypp"
#:include "mat_sequence_common.fypp"
#! Materials of the test registry (tools/fypp/muscle_materials.py) solved by closest_point_2: each one needs
#! at least one entry in CASES, with parameter set names of case_params.py.
#:set SOLVER = 'closest_point_2'
#:set MATS = solver_materials(SOLVER)

program test_mat_closest_point_2
    !! Declared materials with the monolithic closest point return mapping (Phase 7, D-018): the point
    !! kernel `mat_update` of the materials of the test registry along the strain sequences of the
    !! historical reference test, with the checks of mat_sequence_common.fypp (the kernel tangent against
    !! finite differences). Rate independent: the time step of the cases is 0 (not used).
    !! No reference records (plan R, R6): the mutations of the solver that the historical reference
    !! records detected are detected by the unit tests (test_muscle_material_return_mapping.fypp and the others of
    !! tests/mutations/solvers.toml); the cases keep their strain sequences for the checks of
    !! mat_sequence_common.fypp (sp against dp, the tangent against finite differences, the coverage of
    !! the registry).
    $:MAT_TEST_USES(MATS)
    implicit none

    $:MAT_TEST_DECLS()
    ! Tolerances relative to the largest component (measured maxima of the cases in brackets,
    ! gfortran 15.2 Debug; margin 3-20x)
    real(sp), parameter :: TOL_SP_STRESS = 5.0e-5_sp
        !! sp vs dp, stress [8.1e-6]: the sp Newton tolerance (1e-5 sigma_y).
    real(sp), parameter :: TOL_SP_STRAIN_P = 1.0e-4_sp
        !! sp vs dp, plastic strain [2.5e-5]: the rounding of a difference of strains near the yield strain.
    real(sp), parameter :: TOL_SP_EP = 1.0e-4_sp
        !! sp vs dp, equivalent plastic strain [2.5e-5].
    real(sp), parameter :: TOL_SP_TANGENT = 2.0e-5_sp
        !! sp vs dp, analytic tangent [5.2e-6].
    real(sp), parameter :: TOL_SP_FD = 5.0e-4_sp
        !! sp analytic tangent vs finite differences [1.2e-4]: truncation of the sp step and the Newton
        !! tolerance of the perturbed solutions.
    real(dp), parameter :: TOL_DP_FD = 1.0e-6_dp
        !! dp analytic tangent vs finite differences [4.4e-8].
    type(solver_case), parameter :: CASES(*) = [ &
        solver_case(0, 'cp2_vm_swift', 'lin1000', '', 'swift_small', 'vonmises', 200, 0.0_dp, 3.80e-2_dp), &
        solver_case(0, 'cp2_vm_bilinear', 'steel', '', 'bilinear', 'vonmises', 200, 0.0_dp, 9.09e-4_dp), &
        solver_case(0, 'cp2_hill48_swift', 'steel', '', 'swift', 'hill48-2', 200, 0.0_dp, 5.68e-4_dp), &
        solver_case(0, 'cp2_cpb06_vocemod', 'steel', '', 'vocemod', 'cpb06-2', 200, 0.0_dp, 1.23e-3_dp), &
        solver_case(0, 'cp2_dp_ludwik', 'steel', '', 'ludwik', 'dp-1', 200, 0.0_dp, 9.05e-4_dp), &
        solver_case(0, 'cp2_yld2004_swift', 'steel', '', 'swift', 'yld2004-2', 200, 0.0_dp, 5.63e-4_dp), &
        solver_case(0, 'cp2_maxwell_vm_bilinear', 'maxwell', '', 'bilinear', 'vonmises', 200, 0.1_dp, 1.56e-2_dp), &
        solver_case(0, 'cp2_cpb06_ludwik', 'steel', '', 'ludwik', 'cpb06-4', 2, 0.0_dp, 9.16e-4_dp), &
        solver_case(0, 'cp2_cpb06ex2_swift', 'steel', '', 'swift', 'cpb06ex2-1', 200, 0.0_dp, 5.61e-4_dp)]
        !! Cases of the historical test_cp2_golden (case number 0, material, parameter set names, Newton limit,
        !! time step, A_Y).

    $:MAT_TEST_MAIN('test_mat_closest_point_2', None, MATS)

contains
    $:MAT_TEST_PROCS(SOLVER, MATS, 'closest_point_2', reference_tangent=None, zero_stress=True)

end program test_mat_closest_point_2
