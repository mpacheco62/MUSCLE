#:include "muscle_common.fypp"
#:include "muscle_fd.fypp"
#:include "mat_golden_common.fypp"
#! Anisotropic mixed steps: (Perzyna material, rate independent reference, parameter set of the criterion)
#:set MIXED = [('pz_hill48_swift', 'cp_hill48_swift', 'hill48-r'), ('pz_cpb06_swift', 'cp_cpb06_swift', 'cpb06-2'), &
    & ('pz_yld2004_swift', 'cp_yld2004_swift', 'yld2004-2')]
#:set MATS = ['pz_vm_swift', 'pz_vm_bilinear', 'pz_cha_vm_swift'] + [m for mm in MIXED for m in mm[:2]]

program test_mat_perzyna_checks
    !! Physical checks of the Perzyna closest point kernel (D-018.18g), ported from the historical OO
    !! tests test_muscle_solver_closest_point_perzyna{,_vonmises,_hill48,_cpb06,_yld2004}.f90, in every
    !! kind (dp with the tolerances of the OO tests; sp with its own, measured maxima in brackets,
    !! gfortran 15.2 Debug). The flow rule of the Perzyna law: dlambda = dt g(q, ep), g = (q/sigma_y -
    !! 1)^n/eta.
    !!
    !! - von Mises, Swift hardening (E = 1000): a plastic step keeps a positive overstress and satisfies
    !!   the flow rule, with the analytic tangent against finite differences; eta -> 0 recovers the
    !!   rate independent consistency f -> 0; an elastic step gives the elastic stress and tangent;
    !!   iter_nw = 1 does not converge;
    !! - von Mises, perfect plasticity (E = 210000, y0 = 300): the stress relaxation at a fixed strain
    !!   over steps of growing dt follows the exact implicit Euler recurrence q_{n+1} = y0 + (q_n -
    !!   y0)/(1 + 3 G dt/(eta y0)); loading, elastic unloading and reloading at two rates (the sum of the
    !!   multiplier increments is ep; a faster load keeps a higher stress and accumulates less plastic
    !!   strain), with a discarded trial attempt after every step that leaves the history untouched
    !!   (the FE rollback: the next step runs from the same `hsv_n`); exponents 0.5 and 10 with a 1 %
    !!   trial overstress;
    !! - Hill (1948), CPB06 and Yld2004-18p with Swift hardening (the OO tests used bilinear hardening
    !!   y0 = 50, H = 100; Swift gives the same checks with the materials of the registry), a step with
    !!   all six strain components: associated flow and flow rule residuals, positive overstress, the
    !!   tangent, and the static limit (eta = 1e-5) against the rate independent closest point;
    !! - Chaboche overstress (k = 80, n = 2.3) with von Mises and Swift hardening, a step with all six
    !!   strain components: flow rule and associated flow residuals and the tangent (from
    !!   test_muscle_vp_chaboche.f90).
    !!
    !! Not ported (no kernel equivalent): the joint/separate evaluation of Yld2004 (a class extension
    !! that selects `yield_joint_evaluation` at run time) and the re-initialisation with other dynamic
    !! types.
    $:MAT_TEST_USES(MATS)
    use muscle_tensors, only : operator(-), operator(.ddot.), assignment(=)
    use muscle_elasticity_laws, only : elas_stress, elas_dstress_dstrain
    use muscle_yield_criteria, only : yield_stress_eq, yield_dstress_eq
    use muscle_hard_laws, only : hard_stress
    use muscle_vp_overstress_laws, only : os_flow_rate
    use muscle_mat_pz_vm_bilinear, only : muscle_point_pz_vm_bilinear
    use muscle_test_utils, only : check_scaled
    implicit none

    $:MAT_TEST_DECLS()
    real(dp), parameter :: TOL_FLOW_dp = 1.0e-8_dp
        !! Flow rule of the uniaxial step, absolute (OO test).
    real(sp), parameter :: TOL_FLOW_sp = 1.0e-9_sp
        !! Flow rule of the uniaxial step, absolute, sp [1.5e-10].
    real(dp), parameter :: TOL_TAN_dp = 1.0e-7_dp
        !! Analytic tangent against finite differences (OO tests).
    real(sp), parameter :: TOL_TAN_sp = 1.0e-4_sp
        !! Analytic tangent against finite differences, sp [1.9e-5].
    real(dp), parameter :: TOL_LIMIT_F_dp = 1.0e-5_dp
        !! |f|/sigma_y with eta = 1e-6 (OO test).
    real(sp), parameter :: TOL_LIMIT_F_sp = 1.0e-6_sp
        !! |f|/sigma_y with eta = 1e-6, sp [7.8e-8].
    real(dp), parameter :: TOL_ELASTIC_dp = 1.0e-8_dp
        !! Elastic stress and tangent (OO test).
    real(sp), parameter :: TOL_ELASTIC_sp = 1.0e-6_sp
        !! Elastic stress and tangent, sp [0].
    real(dp), parameter :: TOL_Q_dp = 1.0e-10_dp
        !! Exact discrete relaxation (OO test; measured 2.6e-16).
    real(sp), parameter :: TOL_Q_sp = 1.0e-6_sp
        !! Exact discrete relaxation, sp [1.6e-7].
    real(dp), parameter :: TOL_SUM_dp = 1.0e-14_dp
        !! Sum of the multiplier increments, absolute (OO test; measured 8.7e-18).
    real(sp), parameter :: TOL_SUM_sp = 3.0e-8_sp
        !! Sum of the multiplier increments, absolute, sp [3.7e-9].
    real(dp), parameter :: TOL_EXP_FLOW_dp = 1.0e-11_dp
        !! Flow rule of the extreme exponents, absolute (OO test; measured 5.2e-16).
    real(dp), parameter :: TOL_EXP_TAN_dp(2) = [1.0e-6_dp, 2.0e-5_dp]
        !! Tangent of the exponents 0.5 and 10 (OO test: the finite difference truncation).
    real(dp), parameter :: TOL_RES_dp = 1.0e-9_dp
        !! Flow residuals of the anisotropic steps, absolute (OO tests).
    real(sp), parameter :: TOL_RES_sp = 1.0e-5_sp
        !! Flow residuals of the anisotropic steps, absolute, sp [1.2e-6].
    real(dp), parameter :: TOL_CHA_dp = 1.0e-8_dp
        !! Chaboche flow rule and associated flow residuals, absolute (OO test; measured 2.6e-13).
    real(sp), parameter :: TOL_CHA_sp = 5.0e-7_sp
        !! Chaboche flow rule and associated flow residuals, absolute, sp [7.4e-8].
    real(dp), parameter :: TOL_STATIC_dp = 1.0e-5_dp
        !! Static limit against the rate independent closest point (OO tests).
    real(sp), parameter :: TOL_STATIC_sp = 5.0e-6_sp
        !! Static limit, sp [6.5e-7].

    passed = .true.
#:for k in REAL_KINDS
    call uniaxial_${k}$()
    call rate_independent_limit_${k}$()
    call elastic_${k}$()
    call not_converged_${k}$()
    call exact_relaxation_${k}$()
    call rates_unload_reload_${k}$()
#:if k == 'dp'
    ! Not in sp: with a 1 % overstress the sp Newton tolerance (1e-5 sigma_y) is 1e-3 of the overstress,
    ! amplified n times by the power law (flow rule 3e-3 relative, tangent 6e-2 against finite
    ! differences at n = 10)
    call extreme_exponents_${k}$()
#:endif
#:for m, ref, yld in MIXED
    call mixed_${m}$_${k}$('${yld}$')
#:endfor
    call chaboche_mixed_${k}$()
#:endfor
    if (.not. passed) then
        print '(a)', ' FAIL: test_mat_perzyna_checks'
        stop 1
    end if

contains
$:MAT_CASE_PROCS(MATS, fd_check=['pz_vm_swift', 'pz_vm_bilinear:dp', 'pz_cha_vm_swift'] + [mm[0] for mm in MIXED])
#:for k in REAL_KINDS
#:set S2 = tname('3D2Osym', k)
#:set S4 = tname('3D4O2sym', k)
#:set VM = muscle_meta.material_type('pz_vm_swift', k)
#:set PP = muscle_meta.material_type('pz_vm_bilinear', k)
#:set ST = state_t('pz_vm_swift', k)

    subroutine make_vm_${k}$(mat, eta, n)
        !! pz_vm_swift: E = 1000, nu = 0.3, Swift k = 100, e0 = 1e-4, n = 0.1 and the Perzyna law
        !! (eta, n), `real(${k}$)`.
        type(${VM}$), intent(out) :: mat
            !! Material.
        real(${k}$), intent(in) :: eta, n
            !! Viscosity and exponent of the Perzyna law.

        call make_pz_vm_swift_${k}$(golden_case(0, 'pz_vm_swift', 'lin1000', 'per1', 'swift_small', 'vonmises', 200, &
            0.0_dp, 0.0_dp), mat)
        mat%os%eta = eta
        mat%os%n = n
    end subroutine make_vm_${k}$

    pure real(${k}$) function flow_rate_vm_${k}$(mat, q, ep) result(g)
        !! Plastic multiplier rate of pz_vm_swift at the equivalent stress q, `real(${k}$)`.
        type(${VM}$), intent(in) :: mat
            !! Material.
        real(${k}$), intent(in) :: q, ep
            !! Equivalent stress and plastic strain.

        g = os_flow_rate(mat%os, q, ep, hard_stress(mat%hard, ep))
    end function flow_rate_vm_${k}$

    subroutine uniaxial_${k}$()
        !! Plastic step (eta = 1, n = 2, dt = 0.1) from the virgin state: positive overstress, flow rule,
        !! analytic tangent, `real(${k}$)`.
        real(${k}$), parameter :: DT = 0.1_${k}$
        type(${VM}$) :: mat
        type(${ST}$) :: sn, snp1
        type(${S2}$) :: strain, stress
        type(${S4}$) :: tangent
        real(${k}$) :: q, ep
        integer :: status, iters

        call make_vm_${k}$(mat, 1.0_${k}$, 2.0_${k}$)
        sn = ${ST}$()
        strain%vals = [0.05_${k}$, -0.015_${k}$, -0.015_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$]
        call mat_update(mat, strain, DT, sn, snp1, stress, tangent, status, iters)
        call check_true(passed, 'perzyna uniaxial converged (${k}$)', status == STATUS_OK)
        q = yield_stress_eq(mat%yield, stress)
        ep = snp1%strain_pf
        call check_true(passed, 'perzyna uniaxial positive overstress (${k}$)', q > hard_stress(mat%hard, ep))
        call check_approx(passed, 'perzyna uniaxial flow rule (${k}$)', ep, DT*flow_rate_vm_${k}$(mat, q, ep), TOL_FLOW_${k}$)
        call fd_check_pz_vm_swift_${k}$('perzyna uniaxial', mat, strain, DT, sn, tangent, TOL_TAN_${k}$)
    end subroutine uniaxial_${k}$

    subroutine rate_independent_limit_${k}$()
        !! eta = 1e-6, n = 1, dt = 1: the rate independent consistency |f|/sigma_y -> 0, `real(${k}$)`.
        type(${VM}$) :: mat
        type(${ST}$) :: sn, snp1
        type(${S2}$) :: strain, stress
        type(${S4}$) :: tangent
        real(${k}$) :: sy
        integer :: status, iters

        call make_vm_${k}$(mat, 1.0e-6_${k}$, 1.0_${k}$)
        sn = ${ST}$()
        strain%vals = [0.05_${k}$, -0.015_${k}$, -0.015_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$]
        call mat_update(mat, strain, 1.0_${k}$, sn, snp1, stress, tangent, status, iters)
        call check_true(passed, 'perzyna eta -> 0 converged (${k}$)', status == STATUS_OK)
        sy = hard_stress(mat%hard, snp1%strain_pf)
        call check_scaled(passed, 'perzyna eta -> 0 consistency (${k}$)', yield_stress_eq(mat%yield, stress), sy, sy, &
            TOL_LIMIT_F_${k}$)
    end subroutine rate_independent_limit_${k}$

    subroutine elastic_${k}$()
        !! Elastic step: 0 iterations, elastic stress and tangent, `real(${k}$)`.
        type(${VM}$) :: mat
        type(${ST}$) :: sn, snp1
        type(${S2}$) :: strain, stress, expected
        type(${S4}$) :: tangent, elastic
        integer :: status, iters

        call make_vm_${k}$(mat, 1.0_${k}$, 2.0_${k}$)
        sn = ${ST}$()
        strain%vals = [1.0e-4_${k}$, -3.0e-5_${k}$, -3.0e-5_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$]
        call mat_update(mat, strain, 0.1_${k}$, sn, snp1, stress, tangent, status, iters)
        expected = elas_stress(mat%elas, strain)
        elastic = elas_dstress_dstrain(mat%elas, strain)
        call check_true(passed, 'perzyna elastic status (${k}$)', status == STATUS_OK .and. iters == 0)
        call check_approx(passed, 'perzyna elastic stress (${k}$)', stress%vals, expected%vals, TOL_ELASTIC_${k}$)
        call check_approx(passed, 'perzyna elastic tangent (${k}$)', tangent%vals, elastic%vals, TOL_ELASTIC_${k}$)
    end subroutine elastic_${k}$

    subroutine not_converged_${k}$()
        !! iter_nw = 1 on the plastic uniaxial step does not converge, `real(${k}$)`.
        type(${VM}$) :: mat
        type(${ST}$) :: sn, snp1
        type(${S2}$) :: strain, stress
        type(${S4}$) :: tangent
        integer :: status, iters

        call make_vm_${k}$(mat, 1.0_${k}$, 2.0_${k}$)
        mat%iter_nw = 1
        sn = ${ST}$()
        strain%vals = [0.05_${k}$, -0.015_${k}$, -0.015_${k}$, 0.0_${k}$, 0.0_${k}$, 0.0_${k}$]
        call mat_update(mat, strain, 0.1_${k}$, sn, snp1, stress, tangent, status, iters)
        call check_true(passed, 'perzyna iter_nw = 1 not converged (${k}$)', status == STATUS_NOT_CONVERGED)
    end subroutine not_converged_${k}$

    subroutine make_perfect_${k}$(mat, eta, n)
        !! pz_vm_bilinear: E = 210000, nu = 0.3, perfect plasticity y0 = 300 and the Perzyna law (eta, n),
        !! Newton tolerance 1e-13 in dp (OO tests; the default in sp), `real(${k}$)`.
        type(${PP}$), intent(out) :: mat
            !! Material.
        real(${k}$), intent(in) :: eta, n
            !! Viscosity and exponent of the Perzyna law.

        call make_pz_vm_bilinear_${k}$(golden_case(0, 'pz_vm_bilinear', 'steel', 'per1', 'bilinear', 'vonmises', 200, &
            0.0_dp, 0.0_dp), mat)
        mat%hard%y0 = 300.0_${k}$
        mat%hard%K = 0.0_${k}$
        mat%os%eta = eta
        mat%os%n = n
#:if k == 'dp'
        mat%tol = 1.0e-13_dp
#:endif
    end subroutine make_perfect_${k}$

    pure function relax_strain_${k}$() result(strain)
        !! Strain of the perfect plasticity cases (all six components).
        real(${k}$) :: strain(6)

        strain = [0.004_${k}$, -0.001_${k}$, -0.001_${k}$, 0.001_${k}$, -0.0007_${k}$, 0.0004_${k}$]
    end function relax_strain_${k}$

    subroutine exact_relaxation_${k}$()
        !! Relaxation at a fixed total strain: after a first step (dt = 0.001), four steps of dt = 0.0002 i
        !! follow q_{n+1} = 300 + (q_n - 300)/(1 + 3 G dt/300) (eta = 1, n = 1), `real(${k}$)`.
        type(${PP}$) :: mat
        type(${ST}$) :: sn, snp1
        type(${S2}$) :: strain, stress
        type(${S4}$) :: tangent
        real(${k}$) :: q, expected, previous, dt
        integer :: status, iters, i

        call make_perfect_${k}$(mat, 1.0_${k}$, 1.0_${k}$)
        sn = ${ST}$()
        strain%vals = relax_strain_${k}$()
        call mat_update(mat, strain, 0.001_${k}$, sn, snp1, stress, tangent, status, iters)
        call check_true(passed, 'perzyna initial relaxation state converged (${k}$)', status == STATUS_OK)
        previous = yield_stress_eq(mat%yield, stress)
        do i = 1, 4
            sn = snp1
            dt = 0.0002_${k}$*real(i, ${k}$)
            expected = 300.0_${k}$ + (previous - 300.0_${k}$)/(1.0_${k}$ + 3.0_${k}$*(210000.0_${k}$/2.6_${k}$)*dt/300.0_${k}$)
            call mat_update(mat, strain, dt, sn, snp1, stress, tangent, status, iters)
            call check_true(passed, 'perzyna relaxation step converged (${k}$)', status == STATUS_OK)
            q = yield_stress_eq(mat%yield, stress)
            call check_approx(passed, 'perzyna exact discrete relaxation (${k}$)', q, expected, TOL_Q_${k}$)
            previous = expected
        end do
    end subroutine exact_relaxation_${k}$

    subroutine rates_unload_reload_${k}$()
        !! Load (0.5, 1.0 times the direction), elastic unload (back to strain_p + 0.1 direction) and
        !! reload (2.0 times) at dt = 0.01 and 1e-5, through the history array; after every step a trial
        !! attempt (one more direction) is discarded, `real(${k}$)`.
        type(${PP}$) :: mat
        real(${k}$) :: hsv_n(${muscle_meta.material_nstate('pz_vm_bilinear')}$), hsv(size(hsv_n)), saved(size(hsv_n))
        real(${k}$) :: trial(size(hsv_n)), strain(6), direction(6), stress(6), totals(2), q(2), dt
        type(${S2}$) :: sig
        integer :: status, iters, rate, i

        call make_perfect_${k}$(mat, 1.0_${k}$, 1.0_${k}$)
        direction = relax_strain_${k}$()
        do rate = 1, 2
            dt = merge(0.01_${k}$, 1.0e-5_${k}$, rate == 1)
            hsv_n = 0.0_${k}$
            totals(rate) = 0.0_${k}$
            do i = 1, 4
                strain = (0.5_${k}$*real(i, ${k}$))*direction
                if (i == 3) strain = hsv_n(1:6) + 0.1_${k}$*direction
                saved = hsv_n
                call muscle_point_pz_vm_bilinear(mat, strain, dt, hsv_n, hsv, stress, status, iters)
                if (i == 3) then
                    call check_true(passed, 'perzyna elastic unload (${k}$)', status == STATUS_OK .and. iters == 0)
                else
                    call check_true(passed, 'perzyna load/reload converged (${k}$)', status == STATUS_OK .and. iters > 0)
                end if
                call check_true(passed, 'perzyna step keeps hsv_n (${k}$)', all(hsv_n == saved))
                sig%vals = stress
                totals(rate) = totals(rate) + dt*os_flow_rate(mat%os, yield_stress_eq(mat%yield, sig), hsv(7), &
                    hard_stress(mat%hard, hsv(7)))
                call check_approx(passed, 'perzyna sum of multiplier increments (${k}$)', hsv(7), totals(rate), &
                    TOL_SUM_${k}$)
                ! Commit, then a trial attempt that the FE program discards (rollback)
                hsv_n = hsv
                saved = hsv_n
                call muscle_point_pz_vm_bilinear(mat, strain + direction, dt, hsv_n, trial, stress, status, iters)
                call check_true(passed, 'perzyna discarded attempt keeps hsv_n (${k}$)', all(hsv_n == saved))
            end do
            q(rate) = yield_stress_eq(mat%yield, sig)
        end do
        call check_true(passed, 'perzyna faster load keeps a higher stress (${k}$)', q(2) > q(1))
        call check_true(passed, 'perzyna slower load accumulates more plastic strain (${k}$)', totals(1) > totals(2))
    end subroutine rates_unload_reload_${k}$
#:if k == 'dp'

    subroutine extreme_exponents_${k}$()
        !! A 1 % trial overstress with n = 0.5 (eta = 10, dt = 1e-4; infinite slope at the threshold) and
        !! n = 10 (eta = 1e-20, dt = 1e-3; flat slope): a small positive final overstress, the flow rule and
        !! the tangent, `real(${k}$)`.
        real(${k}$), parameter :: EXPONENTS(2) = [0.5_${k}$, 10.0_${k}$], ETAS(2) = [10.0_${k}$, 1.0e-20_${k}$]
        real(${k}$), parameter :: DTS(2) = [1.0e-4_${k}$, 1.0e-3_${k}$]
        type(${PP}$) :: mat
        type(${ST}$) :: sn, snp1
        type(${S2}$) :: strain, stress
        type(${S4}$) :: tangent
        real(${k}$) :: q, psi, dl
        integer :: status, iters, i

        do i = 1, 2
            call make_perfect_${k}$(mat, ETAS(i), EXPONENTS(i))
            strain%vals = relax_strain_${k}$()
            strain%vals = (303.0_${k}$/yield_stress_eq(mat%yield, elas_stress(mat%elas, strain)))*strain%vals
            sn = ${ST}$()
            call mat_update(mat, strain, DTS(i), sn, snp1, stress, tangent, status, iters)
            call check_true(passed, 'perzyna extreme exponent converged (${k}$)', status == STATUS_OK)
            q = yield_stress_eq(mat%yield, stress)
            psi = q/300.0_${k}$ - 1.0_${k}$
            call check_true(passed, 'perzyna extreme exponent small positive overstress (${k}$)', &
                psi > 0.0_${k}$ .and. psi < 0.01_${k}$)
            dl = snp1%strain_pf
            call check_approx(passed, 'perzyna extreme exponent flow rule (${k}$)', dl, &
                DTS(i)*os_flow_rate(mat%os, q, dl, hard_stress(mat%hard, dl)), TOL_EXP_FLOW_${k}$)
            call fd_check_pz_vm_bilinear_${k}$('perzyna extreme exponent', mat, strain, DTS(i), sn, tangent, &
                TOL_EXP_TAN_${k}$(i))
        end do
    end subroutine extreme_exponents_${k}$
#:endif
#:for m, ref, yld in MIXED

    subroutine mixed_${m}$_${k}$(yld)
        !! `${m}$` (Swift hardening, eta = 0.02, n = 1, dt = 0.1, Newton tolerance 1e-12 in dp), a step with
        !! all six strain components: flow residuals, positive overstress, tangent; static limit (eta =
        !! 1e-5, dt = 1, tolerance 1e-9 in dp) against `${ref}$`, `real(${k}$)`.
        character(len=*), intent(in) :: yld
            !! Parameter set of the criterion.
        type(${muscle_meta.material_type(m, k)}$) :: mat
        type(${muscle_meta.material_type(ref, k)}$) :: mat_ref
        type(${ST}$) :: sn, snp1, sref
        type(${S2}$) :: strain, stress, flow, residual, stress_ref
        type(${S4}$) :: tangent
        real(${k}$) :: q, dl
        integer :: status, iters

        call make_${m}$_${k}$(golden_case(0, '${m}$', 'lin1000', 'per1', 'swift_small', yld, 200, 0.0_dp, 0.0_dp), mat)
        mat%os%eta = 0.02_${k}$
        mat%os%n = 1.0_${k}$
#:if k == 'dp'
        mat%tol = 1.0e-12_dp
#:endif
        sn = ${ST}$()
        strain%vals = [0.09_${k}$, -0.025_${k}$, -0.015_${k}$, 0.025_${k}$, -0.015_${k}$, 0.01_${k}$]
        call mat_update(mat, strain, 0.1_${k}$, sn, snp1, stress, tangent, status, iters)
        call check_true(passed, '${m}$ mixed step converged (${k}$)', status == STATUS_OK)
        q = yield_stress_eq(mat%yield, stress)
        dl = snp1%strain_pf
        flow = yield_dstress_eq(mat%yield, stress)
        residual%vals = snp1%strain_p%vals - dl*flow%vals
        call check_approx(passed, '${m}$ flow tensor residual norm (${k}$)', sqrt(residual .ddot. residual), &
            0.0_${k}$, TOL_RES_${k}$)
        call check_approx(passed, '${m}$ multiplier balance (${k}$)', dl, &
            0.1_${k}$*os_flow_rate(mat%os, q, dl, hard_stress(mat%hard, dl)), TOL_RES_${k}$)
        call check_true(passed, '${m}$ positive overstress (${k}$)', q > hard_stress(mat%hard, dl))
        call fd_check_${m}$_${k}$('${m}$ mixed step', mat, strain, 0.1_${k}$, sn, tangent, TOL_TAN_${k}$)
        ! Static limit
        call make_${ref}$_${k}$(golden_case(0, '${ref}$', 'lin1000', '', 'swift_small', yld, 200, 0.0_dp, 0.0_dp), mat_ref)
        call mat_update(mat_ref, strain, 0.0_${k}$, sn, sref, stress_ref, tangent, status, iters)
        call check_true(passed, '${ref}$ static reference converged (${k}$)', status == STATUS_OK)
        mat%os%eta = 1.0e-5_${k}$
#:if k == 'dp'
        mat%tol = 1.0e-9_dp
#:endif
        call mat_update(mat, strain, 1.0_${k}$, sn, snp1, stress, tangent, status, iters)
        call check_true(passed, '${m}$ small viscosity converged (${k}$)', status == STATUS_OK)
        call check_approx(passed, '${m}$ static limit stress (${k}$)', stress%vals, stress_ref%vals, TOL_STATIC_${k}$)
        call check_approx(passed, '${m}$ static limit plastic strain (${k}$)', snp1%strain_p%vals, sref%strain_p%vals, &
            TOL_STATIC_${k}$)
        call check_approx(passed, '${m}$ static limit multiplier (${k}$)', snp1%strain_pf, sref%strain_pf, TOL_STATIC_${k}$)
    end subroutine mixed_${m}$_${k}$
#:endfor

    subroutine chaboche_mixed_${k}$()
        !! pz_cha_vm_swift (E = 1000, Swift k = 100, e0 = 1e-4, n = 0.1; Chaboche k = 80, n = 2.3; dt = 0.1),
        !! a step with all six strain components from the virgin state: flow rule p = dt g(q, p),
        !! associated flow strain_p = p dq/dsigma and the tangent, `real(${k}$)`.
        real(${k}$), parameter :: DT = 0.1_${k}$
        type(${muscle_meta.material_type('pz_cha_vm_swift', k)}$) :: mat
        type(${ST}$) :: sn, snp1
        type(${S2}$) :: strain, stress, flow, residual
        type(${S4}$) :: tangent
        real(${k}$) :: p, q
        integer :: status, iters

        call make_pz_cha_vm_swift_${k}$(golden_case(0, 'pz_cha_vm_swift', 'lin1000', 'cha1', 'swift_small', 'vonmises', &
            200, 0.0_dp, 0.0_dp), mat)
        sn = ${ST}$()
        strain%vals = [0.08_${k}$, -0.024_${k}$, -0.01_${k}$, 0.012_${k}$, -0.007_${k}$, 0.004_${k}$]
        call mat_update(mat, strain, DT, sn, snp1, stress, tangent, status, iters)
        call check_true(passed, 'chaboche mixed converged and plastic (${k}$)', status == STATUS_OK .and. &
            snp1%strain_pf > 0.0_${k}$)
        p = snp1%strain_pf
        q = yield_stress_eq(mat%yield, stress)
        call check_approx(passed, 'chaboche mixed flow rule (${k}$)', p, DT*os_flow_rate(mat%os, q, p, &
            hard_stress(mat%hard, p)), TOL_CHA_${k}$)
        flow = yield_dstress_eq(mat%yield, stress)
        residual%vals = p*flow%vals - snp1%strain_p%vals
        call check_approx(passed, 'chaboche mixed associated flow residual (${k}$)', sqrt(residual .ddot. residual), &
            0.0_${k}$, TOL_CHA_${k}$)
        call fd_check_pz_cha_vm_swift_${k}$('chaboche mixed', mat, strain, DT, sn, tangent, TOL_TAN_${k}$)
    end subroutine chaboche_mixed_${k}$
#:endfor

end program test_mat_perzyna_checks
