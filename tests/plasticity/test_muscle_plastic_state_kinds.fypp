#:include "muscle_common.fypp"
#!
#! Kernel state of plasticity (muscle_plastic_state) in every kind:
#! - defaults (zero state);
#! - a `pure`, `@:DEVICE()` point procedure (copy of the converged state, candidate update) against the
#!   same steps written in the test, bit for bit, with the converged state untouched. (The FE history
#!   array layout is that of each material: tests/materials/test_muscle_material_point.fypp.)

module test_plastic_state_point
    !! Point procedure (kernel) that uses the plastic state, for every kind.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_plastic_state, only : ${', '.join('plastic_state_' + k for k in REAL_KINDS)}$
    implicit none
    private
#:for k in REAL_KINDS
    public :: point_step_${k}$
#:endfor

contains
#:for k in REAL_KINDS

    pure subroutine point_step_${k}$(state_n, dep, state_np1)
        !! Copies the converged state to a candidate state and adds `dep` to its equivalent plastic
        !! strain, `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(plastic_state_${k}$), intent(in) :: state_n
            !! Converged state.
        real(${k}$), intent(in) :: dep
            !! Increment of the equivalent plastic strain.
        type(plastic_state_${k}$), intent(out) :: state_np1
            !! Candidate state.

        state_np1 = state_n
        state_np1%strain_pf = state_n%strain_pf + dep
    end subroutine point_step_${k}$
#:endfor

end module test_plastic_state_point


program test_plastic_state_kinds
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_plastic_state, only : ${', '.join('plastic_state_' + k for k in REAL_KINDS)}$
    use muscle_test_utils, only : check_true
    use test_plastic_state_point
    implicit none

    logical :: passed
    real(dp) :: ref(13)
    integer :: i

    passed = .true.
    ref = [(0.37_dp*i - 1.1_dp*sin(real(i, dp)), i = 1, 13)]
#:for k in REAL_KINDS
    call test_${k}$()
#:endfor

    if (.not. passed) stop 1
    print '(a)', ' test_plastic_state_kinds: PASSED'

contains
#:for k in REAL_KINDS

    subroutine test_${k}$()
        !! Defaults and the point procedure, `real(${k}$)`.
        type(plastic_state_${k}$) :: s0, s, out

        call check_true(passed, '${k}$ defaults', all(s0%stress%vals == 0.0_${k}$) .and. &
            all(s0%strain_p%vals == 0.0_${k}$) .and. s0%strain_pf == 0.0_${k}$)
        s%stress%vals = real(ref(1:6), ${k}$)
        s%strain_p%vals = real(ref(7:12), ${k}$)
        s%strain_pf = real(ref(13), ${k}$)
        call point_step_${k}$(s, 0.25_${k}$, out)
        call check_true(passed, '${k}$ point procedure', all(out%stress%vals == s%stress%vals) .and. &
            all(out%strain_p%vals == s%strain_p%vals) .and. out%strain_pf == s%strain_pf + 0.25_${k}$)
        call check_true(passed, '${k}$ converged state untouched', s%strain_pf == real(ref(13), ${k}$))
    end subroutine test_${k}$
#:endfor

end program test_plastic_state_kinds
