#:include "muscle_common.fypp"
#:include "muscle_fd.fypp"
#!
#! Kernel API of the hardening laws (D-017) in every kind: the free functions of the laws, called through the family
#! generics of muscle_hard_laws, against the analytical formulas (bilinear, Ludwik, Swift, modified
#! Voce; references evaluated in dp from the kind-k parameters, with exp/log instead of **); the
#! finite-difference derivatives of the test-only laws below (FD_DERIV, FD_DERIV2),
#! one-sided where ep - h < 0 (hardening domain ep >= 0); and a `pure`, `@:DEVICE()` point
#! procedure that calls them.
#! Tolerances of the finite differences (relative, measured x ~10): see FD_TOL below.
#! Estimated maximum over EPS_PTS (step h = rel max(|ep|, 1), D-017.5a; forward stencil below
#! ep = h): sp 2e-4 (first) and 1e-2 (FD_DERIV2, forward at ep < 2e-2); dp 4e-9 and 2.3e-7.
#:set FD_TOL = {'sp': {'d1': '1.0e-3', 'd2': '3.0e-2'}, 'dp': {'d1': '5.0e-8', 'd2': '2.0e-6'}}

#! Test-only laws (modified Voce, as muscle_hard_vocemod): fdvoce gives only stress (dstress_dep
#! by FD_DERIV, ddstress_ddep by FD_DERIV2 of stress); fdvoce1 gives stress and dstress_dep
#! (ddstress_ddep by FD_DERIV of dstress_dep), with a default k = 0; fdpow (Sy + k ep^1.5) is undefined for ep < 0: its default
#! derivative must stay finite at ep = 0 (one-sided stencil).

module muscle_hard_fdvoce
    !! Test law: modified Voce hardening, stress only.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    implicit none
    private

#:for k in REAL_KINDS
    public :: hard_fdvoce_${k}$
#:endfor
#:for k in REAL_KINDS
    public :: hard_stress_fdvoce_${k}$, hard_dstress_dep_fdvoce_${k}$, hard_ddstress_ddep_fdvoce_${k}$
#:endfor

#:for k in REAL_KINDS
    type :: hard_fdvoce_${k}$
        !! Parameters of the fdvoce model in `real(${k}$)`.
        real(${k}$) :: Sy
            !! Initial yield stress.
        real(${k}$) :: k = 0.0_${k}$
            !! Linear modulus.
        real(${k}$) :: q
            !! Saturation stress.
        real(${k}$) :: n
            !! Saturation rate.
    end type hard_fdvoce_${k}$

#:endfor
contains
#:for k in REAL_KINDS

    pure function hard_stress_fdvoce_${k}$(prm, ep) result(res)
        !! Flow stress \( \sigma_y(\epsilon_p) \) of the fdvoce model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(hard_fdvoce_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( \sigma_y \).
        res = prm%Sy + prm%k*ep + prm%q*(1.0_${k}$ - exp(-prm%n*ep))
    end function hard_stress_fdvoce_${k}$

    pure function hard_dstress_dep_fdvoce_${k}$(prm, ep) result(res)
        !! Hardening modulus \( d\sigma_y/d\epsilon_p \) of the fdvoce model in `real(${k}$)`,
        !! computed with central finite differences.
        implicit none
        @:DEVICE()
        type(hard_fdvoce_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( d\sigma_y/d\epsilon_p \).
        @:FD_DERIV(res, hard_stress_fdvoce_${k}$(prm, {x}), ep, ${k}$, scale=1.0_${k}$, lower=0.0_${k}$)
    end function hard_dstress_dep_fdvoce_${k}$

    pure function hard_ddstress_ddep_fdvoce_${k}$(prm, ep) result(res)
        !! Second derivative \( d^2\sigma_y/d\epsilon_p^2 \) of the fdvoce model in `real(${k}$)`,
        !! computed with central finite differences.
        implicit none
        @:DEVICE()
        type(hard_fdvoce_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( d^2\sigma_y/d\epsilon_p^2 \).
        @:FD_DERIV2(res, hard_stress_fdvoce_${k}$(prm, {x}), ep, ${k}$, scale=1.0_${k}$, lower=0.0_${k}$)
    end function hard_ddstress_ddep_fdvoce_${k}$
#:endfor

end module muscle_hard_fdvoce

module muscle_hard_fdvoce1
    !! Test law: modified Voce hardening, stress and analytical first derivative.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    implicit none
    private

#:for k in REAL_KINDS
    public :: hard_fdvoce1_${k}$
#:endfor
#:for k in REAL_KINDS
    public :: hard_stress_fdvoce1_${k}$, hard_dstress_dep_fdvoce1_${k}$, hard_ddstress_ddep_fdvoce1_${k}$
#:endfor

#:for k in REAL_KINDS
    type :: hard_fdvoce1_${k}$
        !! Parameters of the fdvoce1 model in `real(${k}$)`.
        real(${k}$) :: Sy
            !! Initial yield stress.
        real(${k}$) :: k = 0.0_${k}$
            !! Linear modulus.
        real(${k}$) :: q
            !! Saturation stress.
        real(${k}$) :: n
            !! Saturation rate.
    end type hard_fdvoce1_${k}$

#:endfor
contains
#:for k in REAL_KINDS

    pure function hard_stress_fdvoce1_${k}$(prm, ep) result(res)
        !! Flow stress \( \sigma_y(\epsilon_p) \) of the fdvoce1 model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(hard_fdvoce1_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( \sigma_y \).
        res = prm%Sy + prm%k*ep + prm%q*(1.0_${k}$ - exp(-prm%n*ep))
    end function hard_stress_fdvoce1_${k}$

    pure function hard_dstress_dep_fdvoce1_${k}$(prm, ep) result(res)
        !! Hardening modulus \( d\sigma_y/d\epsilon_p \) of the fdvoce1 model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(hard_fdvoce1_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( d\sigma_y/d\epsilon_p \).
        real(${k}$) :: e
        e = exp(-prm%n*ep)
        res = prm%k + prm%q*prm%n*e
    end function hard_dstress_dep_fdvoce1_${k}$

    pure function hard_ddstress_ddep_fdvoce1_${k}$(prm, ep) result(res)
        !! Second derivative \( d^2\sigma_y/d\epsilon_p^2 \) of the fdvoce1 model in `real(${k}$)`,
        !! computed with central finite differences.
        implicit none
        @:DEVICE()
        type(hard_fdvoce1_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( d^2\sigma_y/d\epsilon_p^2 \).
        @:FD_DERIV(res, hard_dstress_dep_fdvoce1_${k}$(prm, {x}), ep, ${k}$, scale=1.0_${k}$, lower=0.0_${k}$)
    end function hard_ddstress_ddep_fdvoce1_${k}$
#:endfor

end module muscle_hard_fdvoce1

module muscle_hard_fdpow
    !! Test law \( \sigma_y = S_y + k \epsilon_p^{3/2} \), undefined for \( \epsilon_p < 0 \).
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    implicit none
    private

#:for k in REAL_KINDS
    public :: hard_fdpow_${k}$
#:endfor
#:for k in REAL_KINDS
    public :: hard_stress_fdpow_${k}$, hard_dstress_dep_fdpow_${k}$, hard_ddstress_ddep_fdpow_${k}$
#:endfor

#:for k in REAL_KINDS
    type :: hard_fdpow_${k}$
        !! Parameters of the fdpow model in `real(${k}$)`.
        real(${k}$) :: Sy
            !! Initial yield stress.
        real(${k}$) :: k
            !! Coefficient.
    end type hard_fdpow_${k}$

#:endfor
contains
#:for k in REAL_KINDS

    pure function hard_stress_fdpow_${k}$(prm, ep) result(res)
        !! Flow stress \( \sigma_y(\epsilon_p) \) of the fdpow model in `real(${k}$)`.
        implicit none
        @:DEVICE()
        type(hard_fdpow_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( \sigma_y \).
        res = prm%Sy + prm%k*ep*sqrt(ep)
    end function hard_stress_fdpow_${k}$

    pure function hard_dstress_dep_fdpow_${k}$(prm, ep) result(res)
        !! Hardening modulus \( d\sigma_y/d\epsilon_p \) of the fdpow model in `real(${k}$)`,
        !! computed with central finite differences.
        implicit none
        @:DEVICE()
        type(hard_fdpow_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( d\sigma_y/d\epsilon_p \).
        @:FD_DERIV(res, hard_stress_fdpow_${k}$(prm, {x}), ep, ${k}$, scale=1.0_${k}$, lower=0.0_${k}$)
    end function hard_dstress_dep_fdpow_${k}$

    pure function hard_ddstress_ddep_fdpow_${k}$(prm, ep) result(res)
        !! Second derivative \( d^2\sigma_y/d\epsilon_p^2 \) of the fdpow model in `real(${k}$)`,
        !! computed with central finite differences.
        implicit none
        @:DEVICE()
        type(hard_fdpow_${k}$), intent(in) :: prm
            !! Parameters.
        real(${k}$), intent(in) :: ep
            !! Equivalent plastic strain \( \epsilon_p \ge 0 \).
        real(${k}$) :: res
            !! \( d^2\sigma_y/d\epsilon_p^2 \).
        @:FD_DERIV2(res, hard_stress_fdpow_${k}$(prm, {x}), ep, ${k}$, scale=1.0_${k}$, lower=0.0_${k}$)
    end function hard_ddstress_ddep_fdpow_${k}$
#:endfor

end module muscle_hard_fdpow

module test_hard_laws_point
    !! Point procedures (kernels) that call the hardening functions, for every kind.
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_hard_laws, only : hard_stress, hard_dstress_dep, hard_ddstress_ddep, ${kspecifics('hard_{0}_{1}', 'bilinear')}$
    use muscle_hard_fdvoce, only : ${kspecifics('hard_{0}_{1}', 'fdvoce')}$
    use muscle_hard_fdvoce, only : ${kspecifics('hard_stress_{0}_{1}', 'fdvoce')}$
    use muscle_hard_fdvoce, only : ${kspecifics('hard_dstress_dep_{0}_{1}', 'fdvoce')}$
    use muscle_hard_fdvoce, only : ${kspecifics('hard_ddstress_ddep_{0}_{1}', 'fdvoce')}$
    implicit none
    private

#:for k in REAL_KINDS
    public :: point_${k}$
#:endfor

contains
#:for k in REAL_KINDS

    pure subroutine point_${k}$(b, v, ep, out)
        !! Everything a return mapping point would call from a hardening law, in `real(${k}$)`:
        !! out = [stress, dstress_dep, ddstress_ddep] of the bilinear law `b` and of the test law `v`.
        @:DEVICE()
        type(hard_bilinear_${k}$), intent(in) :: b
        type(hard_fdvoce_${k}$), intent(in) :: v
        real(${k}$), intent(in) :: ep
        real(${k}$), intent(out) :: out(6)

        out(1) = hard_stress(b, ep)
        out(2) = hard_dstress_dep(b, ep)
        out(3) = hard_ddstress_ddep(b, ep)
        out(4) = hard_stress_fdvoce_${k}$(v, ep)
        out(5) = hard_dstress_dep_fdvoce_${k}$(v, ep)
        out(6) = hard_ddstress_ddep_fdvoce_${k}$(v, ep)
    end subroutine point_${k}$
#:endfor

end module test_hard_laws_point

program test_hard_laws_kinds
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_test_utils, only : check_approx, check_true
    use muscle_test_helpers, only : record
    implicit none

    real(dp), parameter :: EPS_PTS(7) = [0.0_dp, 1.0e-6_dp, 1.0e-3_dp, 1.0e-2_dp, 5.0e-2_dp, 0.2_dp, 1.0_dp]
        !! Equivalent plastic strains: zero, small but not zero (where a step relative to |ep| would
        !! collapse, D-017.5a), large.
    real(dp), parameter :: EPS_POS(9) = [1.0e-6_dp, 1.0e-4_dp, 1.0e-3_dp, 1.0e-2_dp, 5.0e-2_dp, 0.2_dp, &
                                         1.0_dp, 3.0_dp, 10.0_dp]
        !! Strictly positive equivalent plastic strains (power laws with n < 1).
    integer :: code

    code = 0
#:for i, k in enumerate(REAL_KINDS)
    call record(test_bilinear_${k}$(), ${10*i + 1}$, 'bilinear free functions ${k}$', code)
    call record(test_fd_${k}$(), ${10*i + 2}$, 'finite-difference derivatives of the contract ${k}$', code)
    call record(test_point_${k}$(), ${10*i + 3}$, 'pure point procedure ${k}$', code)
    call record(test_ludwik_${k}$(), ${10*i + 4}$, 'Ludwik free functions ${k}$', code)
    call record(test_swift_${k}$(), ${10*i + 5}$, 'Swift free functions ${k}$', code)
    call record(test_vocemod_${k}$(), ${10*i + 6}$, 'modified Voce free functions ${k}$', code)
#:endfor
    if (code /= 0) stop code
    print '(a)', ' Passed!'

contains
#:for k in REAL_KINDS

    function test_bilinear_${k}$() result(passed)
        !! Family generics on `hard_bilinear_${k}$` against \( y_0 + K \epsilon_p \), \( K \), 0.
        use muscle_hard_laws, only : hard_stress, hard_dstress_dep, hard_ddstress_ddep, hard_bilinear_${k}$
        logical :: passed
        real(${k}$), parameter :: Y0(4) = [250.0_${k}$, 355.0_${k}$, 70.0_${k}$, 480.0_${k}$]
        real(${k}$), parameter :: KH(4) = [1000.0_${k}$, 0.0_${k}$, 690.0_${k}$, -150.0_${k}$]
        type(hard_bilinear_${k}$) :: p
        real(${k}$) :: ep
        integer :: i, j

        passed = .true.
        do i = 1, size(Y0)
            p = hard_bilinear_${k}$(y0=Y0(i), K=KH(i))
            do j = 1, size(EPS_PTS)
                ep = real(EPS_PTS(j), ${k}$)
                call check_approx(passed, '${k}$ bilinear stress', hard_stress(p, ep), Y0(i) + KH(i)*ep)
                call check_approx(passed, '${k}$ bilinear dstress_dep', hard_dstress_dep(p, ep), KH(i), 0.0_${k}$)
                call check_approx(passed, '${k}$ bilinear ddstress_ddep', hard_ddstress_ddep(p, ep), 0.0_${k}$, 0.0_${k}$)
            end do
        end do
    end function test_bilinear_${k}$

    function test_fd_${k}$() result(passed)
        !! Generated derivatives of the test laws (modified Voce) against the analytical ones:
        !! \( k + q n e^{-n \epsilon_p} \) and \( -q n^2 e^{-n \epsilon_p} \).
        use muscle_hard_fdvoce, only : hard_fdvoce_${k}$, hard_dstress_dep_fdvoce_${k}$, &
            hard_ddstress_ddep_fdvoce_${k}$
        use muscle_hard_fdvoce1, only : hard_fdvoce1_${k}$, hard_ddstress_ddep_fdvoce1_${k}$
        use muscle_hard_fdpow, only : hard_fdpow_${k}$, hard_dstress_dep_fdpow_${k}$
        logical :: passed
        real(${k}$), parameter :: SY = 250.0_${k}$, K = 100.0_${k}$, Q = 150.0_${k}$, N = 5.0_${k}$
        real(${k}$), parameter :: TOL1 = ${FD_TOL[k]['d1']}$_${k}$, TOL2 = ${FD_TOL[k]['d2']}$_${k}$
        type(hard_fdvoce_${k}$) :: v
        type(hard_fdvoce1_${k}$) :: v1
        type(hard_fdpow_${k}$) :: w
        real(${k}$) :: ep, e, d
        integer :: j

        passed = .true.
        v = hard_fdvoce_${k}$(Sy=SY, k=K, q=Q, n=N)
        v1 = hard_fdvoce1_${k}$(Sy=SY, k=K, q=Q, n=N)
        do j = 1, size(EPS_PTS)
            ep = real(EPS_PTS(j), ${k}$)
            e = exp(-N*ep)
            call check_approx(passed, '${k}$ FD_DERIV of stress', hard_dstress_dep_fdvoce_${k}$(v, ep), &
                              K + Q*N*e, TOL1)
            call check_approx(passed, '${k}$ FD_DERIV2 of stress', hard_ddstress_ddep_fdvoce_${k}$(v, ep), &
                              -Q*N*N*e, TOL2)
            call check_approx(passed, '${k}$ FD_DERIV of dstress_dep', hard_ddstress_ddep_fdvoce1_${k}$(v1, ep), &
                              -Q*N*N*e, TOL1)
        end do
        ! Law undefined for ep < 0: the default derivative never evaluates it there
        w = hard_fdpow_${k}$(Sy=SY, k=K)
        do j = 1, size(EPS_PTS)
            ep = real(EPS_PTS(j), ${k}$)
            d = hard_dstress_dep_fdpow_${k}$(w, ep)
            call check_approx(passed, '${k}$ one-sided FD_DERIV is finite at ep >= 0', d, d, 0.0_${k}$)
            if (ep >= 0.2_${k}$) call check_approx(passed, '${k}$ FD_DERIV of k ep^1.5', d, 1.5_${k}$*K*sqrt(ep), TOL1)
        end do
    end function test_fd_${k}$

    function test_point_${k}$() result(passed)
        !! The pure point procedure gives the same bits as the direct calls.
        use muscle_hard_laws, only : hard_stress, hard_dstress_dep, hard_ddstress_ddep, hard_bilinear_${k}$
        use muscle_hard_fdvoce, only : hard_fdvoce_${k}$, hard_stress_fdvoce_${k}$, &
            hard_dstress_dep_fdvoce_${k}$, hard_ddstress_ddep_fdvoce_${k}$
        use test_hard_laws_point, only : point_${k}$
        logical :: passed
        type(hard_bilinear_${k}$) :: b
        type(hard_fdvoce_${k}$) :: v
        real(${k}$) :: ep, out(6)
        integer :: j

        passed = .true.
        b = hard_bilinear_${k}$(y0=250.0_${k}$, K=1000.0_${k}$)
        v = hard_fdvoce_${k}$(Sy=250.0_${k}$, k=100.0_${k}$, q=150.0_${k}$, n=5.0_${k}$)
        do j = 1, size(EPS_PTS)
            ep = real(EPS_PTS(j), ${k}$)
            call point_${k}$(b, v, ep, out)
            call check_approx(passed, '${k}$ point = direct calls', out, [hard_stress(b, ep), hard_dstress_dep(b, ep), &
                hard_ddstress_ddep(b, ep), hard_stress_fdvoce_${k}$(v, ep), hard_dstress_dep_fdvoce_${k}$(v, ep), &
                hard_ddstress_ddep_fdvoce_${k}$(v, ep)], 0.0_${k}$)
        end do
    end function test_point_${k}$

    function test_ludwik_${k}$() result(passed)
        !! Family generics on `hard_ludwik_${k}$` against \( \sigma_0 + K \epsilon_p^n \) and the
        !! derivatives of the regularized law, at \( \epsilon_p + \delta \) (`LUDWIK_EP_OFFSET_${k}$`,
#:if k == 'sp'
        !! 1e-10 in every kind); sp also against the exact derivatives where the offset vanishes in rounding (ep >= 2e-3);
#:else
        !! 1e-10 in every kind);
#:endif
        !! finite derivatives at ep = 0 (including n = 1).
        use muscle_hard_laws, only : hard_stress, hard_dstress_dep, hard_ddstress_ddep, hard_ludwik_${k}$
        use muscle_hard_ludwik, only : LUDWIK_EP_OFFSET_${k}$
        logical :: passed
        real(${k}$), parameter :: S0(4) = [250.0_${k}$, 180.0_${k}$, 300.0_${k}$, 200.0_${k}$]
        real(${k}$), parameter :: KH(4) = [500.0_${k}$, 920.0_${k}$, 400.0_${k}$, 1000.0_${k}$]
        real(${k}$), parameter :: NH(4) = [0.2_${k}$, 0.45_${k}$, 1.5_${k}$, 1.0_${k}$]
        type(hard_ludwik_${k}$) :: p
        real(dp) :: s0d, kd, nd, epd, ed
        real(${k}$) :: ep, d1, d2
        integer :: i, j

        passed = .true.
        do i = 1, size(S0)
            p = hard_ludwik_${k}$(sigma0=S0(i), k=KH(i), n=NH(i))
            s0d = real(S0(i), dp)
            kd = real(KH(i), dp)
            nd = real(NH(i), dp)
            do j = 1, size(EPS_POS)
                ep = real(EPS_POS(j), ${k}$)
                epd = real(ep, dp)
                ed = epd + real(LUDWIK_EP_OFFSET_${k}$, dp)
                call check_approx(passed, '${k}$ Ludwik stress', hard_stress(p, ep), &
                                  real(s0d + kd*exp(nd*log(epd)), ${k}$))
                call check_approx(passed, '${k}$ Ludwik dstress_dep', hard_dstress_dep(p, ep), &
                                  real(kd*nd*exp((nd - 1.0_dp)*log(ed)), ${k}$))
                call check_approx(passed, '${k}$ Ludwik ddstress_ddep', hard_ddstress_ddep(p, ep), &
                                  real(kd*nd*(nd - 1.0_dp)*exp((nd - 2.0_dp)*log(ed)), ${k}$))
#:if k == 'sp'
                if (ep >= 2.0e-3_sp) then
                    call check_approx(passed, 'sp Ludwik exact dstress_dep', hard_dstress_dep(p, ep), &
                                      real(kd*nd*exp((nd - 1.0_dp)*log(epd)), sp))
                    call check_approx(passed, 'sp Ludwik exact ddstress_ddep', hard_ddstress_ddep(p, ep), &
                                      real(kd*nd*(nd - 1.0_dp)*exp((nd - 2.0_dp)*log(epd)), sp))
                end if
#:endif
            end do
            ! Regularized derivatives: finite at ep = 0 (singular there without the offset if n < 1)
            d1 = hard_dstress_dep(p, 0.0_${k}$)
            d2 = hard_ddstress_ddep(p, 0.0_${k}$)
            call check_true(passed, '${k}$ Ludwik finite derivatives at ep = 0', &
                            abs(d1) <= huge(d1) .and. abs(d2) <= huge(d2))
            call check_approx(passed, '${k}$ Ludwik stress at ep = 0', hard_stress(p, 0.0_${k}$), S0(i), 0.0_${k}$)
        end do
    end function test_ludwik_${k}$

    function test_swift_${k}$() result(passed)
        !! Family generics on `hard_swift_${k}$` (e0 > 0) against \( K (\epsilon_0 + \epsilon_p)^n \)
        !! and its exact derivatives, including ep = 0.
        use muscle_hard_laws, only : hard_stress, hard_dstress_dep, hard_ddstress_ddep, hard_swift_${k}$
        logical :: passed
        real(${k}$), parameter :: KH(3) = [500.0_${k}$, 100.0_${k}$, 750.0_${k}$]
        real(${k}$), parameter :: E0(3) = [0.01_${k}$, 1.0e-4_${k}$, 0.002_${k}$]
        real(${k}$), parameter :: NH(3) = [0.2_${k}$, 0.1_${k}$, 0.35_${k}$]
        type(hard_swift_${k}$) :: p
        real(dp) :: kd, nd, ed
        real(${k}$) :: ep
        integer :: i, j

        passed = .true.
        do i = 1, size(KH)
            p = hard_swift_${k}$(k=KH(i), e0=E0(i), n=NH(i))
            kd = real(KH(i), dp)
            nd = real(NH(i), dp)
            do j = 0, size(EPS_POS)
                ep = 0.0_${k}$
                if (j > 0) ep = real(EPS_POS(j), ${k}$)
                ed = real(E0(i), dp) + real(ep, dp)
                call check_approx(passed, '${k}$ Swift stress', hard_stress(p, ep), &
                                  real(kd*exp(nd*log(ed)), ${k}$))
                call check_approx(passed, '${k}$ Swift dstress_dep', hard_dstress_dep(p, ep), &
                                  real(kd*nd*exp((nd - 1.0_dp)*log(ed)), ${k}$))
                call check_approx(passed, '${k}$ Swift ddstress_ddep', hard_ddstress_ddep(p, ep), &
                                  real(kd*nd*(nd - 1.0_dp)*exp((nd - 2.0_dp)*log(ed)), ${k}$))
            end do
        end do
    end function test_swift_${k}$

    function test_vocemod_${k}$() result(passed)
        !! Family generics on `hard_vocemod_${k}$` against
        !! \( \sigma_{y0} + k \epsilon_p + q (1 - e^{-n \epsilon_p}) \) and its derivatives, including ep = 0.
        use muscle_hard_laws, only : hard_stress, hard_dstress_dep, hard_ddstress_ddep, hard_vocemod_${k}$
        logical :: passed
        real(${k}$), parameter :: SY(3) = [200.0_${k}$, 154.6_${k}$, 250.0_${k}$]
        real(${k}$), parameter :: KH(3) = [500.0_${k}$, 345.8_${k}$, 0.0_${k}$]
        real(${k}$), parameter :: Q(3) = [150.0_${k}$, 122.1_${k}$, 80.0_${k}$]
        real(${k}$), parameter :: NH(3) = [20.0_${k}$, 5.0_${k}$, 12.5_${k}$]
        type(hard_vocemod_${k}$) :: p
        real(dp) :: syd, kd, qd, nd, epd, e
        real(${k}$) :: ep
        integer :: i, j

        passed = .true.
        do i = 1, size(SY)
            p = hard_vocemod_${k}$(Sy=SY(i), k=KH(i), q=Q(i), n=NH(i))
            syd = real(SY(i), dp)
            kd = real(KH(i), dp)
            qd = real(Q(i), dp)
            nd = real(NH(i), dp)
            do j = 0, size(EPS_POS)
                ep = 0.0_${k}$
                if (j > 0) ep = real(EPS_POS(j), ${k}$)
                epd = real(ep, dp)
                e = exp(-nd*epd)
                call check_approx(passed, '${k}$ Voce stress', hard_stress(p, ep), real(syd + kd*epd + qd - qd*e, ${k}$))
                call check_approx(passed, '${k}$ Voce dstress_dep', hard_dstress_dep(p, ep), real(kd + qd*nd*e, ${k}$))
                call check_approx(passed, '${k}$ Voce ddstress_ddep', hard_ddstress_ddep(p, ep), real(-qd*nd*nd*e, ${k}$))
            end do
        end do
    end function test_vocemod_${k}$
#:endfor

end program test_hard_laws_kinds
