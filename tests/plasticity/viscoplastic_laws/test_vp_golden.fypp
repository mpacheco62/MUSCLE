#!
#! Values of a viscoplastic law `v` on the grid (ep, epd) of vp_grid: `flow(:)` = vp_flow_stress and
#! `d(:, it)` = vp_dstress_dep at DT_VALUES(it). `comp`: the law composes the hardening values sy(:)
#! and dsy(:) on the grid (D-017.6b).
#:def VP_VALUES(v, comp)
#:set c1 = ', sy(i_)' if comp else ''
#:set c2 = ', sy(i_), dsy(i_)' if comp else ''
        do i_ = 1, size(ep)
            flow(i_) = vp_flow_stress(${v}$, ep(i_), epd(i_)${c1}$)
            do it_ = 1, size(DT_VALUES)
                d(i_, it_) = vp_dstress_dep(${v}$, ep(i_), epd(i_), DT_VALUES(it_)${c2}$)
            end do
        end do
#:enddef
#! Values of an overstress law `o` on the grid (ep, sigma_eq) of os_grid with the hardening values
#! sy(:), dsy(:): `g(:, 1:3)` = os_flow_rate, os_dflow_dsigma, os_dflow_dep.
#:def OS_VALUES(o)
        do i_ = 1, size(ep)
            g(i_, 1) = os_flow_rate(${o}$, sig(i_), ep(i_), sy(i_))
            g(i_, 2) = os_dflow_dsigma(${o}$, sig(i_), ep(i_), sy(i_))
            g(i_, 3) = os_dflow_dep(${o}$, sig(i_), ep(i_), sy(i_), dsy(i_))
        end do
#:enddef

module vp_golden_cases
    !! Cases of the golden test of the viscoplastic laws: grids, hardening values of the composed laws
    !! and the records of every family function evaluated by the program through the kernel API
    !! (`vp_flow_stress`, `vp_dstress_dep`; `os_flow_rate`, `os_dflow_dsigma`, `os_dflow_dep`).
    use muscle_kinds, only : dp
    use muscle_hard_laws, only : hard_stress, hard_dstress_dep, hard_bilinear_dp, hard_swift_dp, &
        hard_vocemod_dp
    use muscle_test_golden, only : golden_check
    implicit none
    private

    public :: vp_grid, os_grid, hard_values, vp_record, os_record, DT_VALUES, HNAME

    real(dp), parameter :: EP_SWEEP(10) = [0.0_dp, 1.0e-10_dp, 1.0e-7_dp, 1.0e-5_dp, 1.0e-3_dp, &
        1.0e-2_dp, 5.0e-2_dp, 0.2_dp, 1.0_dp, 5.0_dp]
        !! Equivalent plastic strains: zero (first increment), around the 1e-10 and 1e-7 floors of
        !! NNL and VA, small, intermediate and large.
    real(dp), parameter :: EPD_SWEEP(17) = [-1.0e-3_dp, 0.0_dp, 1.0e-12_dp, 1.0e-10_dp, 1.0e-9_dp, &
        1.0e-7_dp, 1.0e-6_dp, 1.0e-5_dp, 1.0e-4_dp, 1.0e-3_dp, 1.0e-2_dp, 0.1_dp, 1.0_dp, 10.0_dp, &
        1.0e2_dp, 1.0e3_dp, 1.0e4_dp]
        !! Equivalent plastic strain rates (1/s): negative and zero (first increment), the 1e-12,
        !! 1e-7 and 1e-6 floors of the laws, quasi-static to dynamic rates. Each law adds its own
        !! thresholds (reference/limit rates).
    real(dp), parameter :: SIG_FACTORS(11) = [0.0_dp, 0.5_dp, 0.999_dp, 1.0_dp, 1.0_dp + 1.0e-9_dp, &
        1.001_dp, 1.01_dp, 1.1_dp, 1.5_dp, 2.0_dp, 5.0_dp]
        !! Equivalent stress as a multiple of the static yield stress Y(ep): elastic, exactly at
        !! the threshold, just above it and well above it.
    real(dp), parameter :: DT_VALUES(2) = [1.0e-3_dp, 1.0_dp]
        !! Time steps of `dstress_dep` (two values separate d/dep from d/depd).
    character(len=*), parameter :: HNAME(3) = [character(len=8) :: 'bilinear', 'swift', 'vocemod']
        !! Composed hardening laws (static yield stress Y(ep), MPa).

contains

    subroutine hard_values(ih, ep, sy, dsy)
        !! Values `hard_stress` and `hard_dstress_dep` of the composed hardening law `ih` (1 bilinear,
        !! 2 swift, 3 vocemod) at the strains `ep`.
        integer, intent(in) :: ih
            !! Hardening law.
        real(dp), intent(in) :: ep(:)
            !! Equivalent plastic strains.
        real(dp), allocatable, intent(out) :: sy(:), dsy(:)
            !! Static yield stress and hardening modulus.
        type(hard_bilinear_dp), parameter :: BIL = hard_bilinear_dp(y0=250.0_dp, K=1000.0_dp)
        type(hard_swift_dp), parameter :: SWI = hard_swift_dp(k=500.0_dp, e0=1.0e-3_dp, n=0.2_dp)
        type(hard_vocemod_dp), parameter :: VOC = hard_vocemod_dp(Sy=272.075784_dp, k=0.04230655_dp, &
            q=297.603923_dp, n=1.48375781_dp)
        integer :: i

        allocate(sy(size(ep)), dsy(size(ep)))
        do i = 1, size(ep)
            select case (ih)
            case (1)
                sy(i) = hard_stress(BIL, ep(i))
                dsy(i) = hard_dstress_dep(BIL, ep(i))
            case (2)
                sy(i) = hard_stress(SWI, ep(i))
                dsy(i) = hard_dstress_dep(SWI, ep(i))
            case default
                sy(i) = hard_stress(VOC, ep(i))
                dsy(i) = hard_dstress_dep(VOC, ep(i))
            end select
        end do
    end subroutine hard_values

    subroutine vp_grid(key, epd_extra, ep_g, epd_g)
        !! Grid EP_SWEEP x [EPD_SWEEP, epd_extra] (ep fastest) of a viscoplastic law, and its
        !! golden records.
        character(len=*), intent(in) :: key
            !! Key prefix (law, parameter set, hardening law).
        real(dp), intent(in) :: epd_extra(:)
            !! Law-specific rates (thresholds).
        real(dp), allocatable, intent(out) :: ep_g(:), epd_g(:)
            !! Grid.
        real(dp), allocatable :: epd(:)
        integer :: i, j, n

        epd = [EPD_SWEEP, epd_extra]
        n = size(EP_SWEEP)*size(epd)
        allocate(ep_g(n), epd_g(n))
        do j = 1, size(epd)
            do i = 1, size(EP_SWEEP)
                ep_g(i + (j - 1)*size(EP_SWEEP)) = EP_SWEEP(i)
                epd_g(i + (j - 1)*size(EP_SWEEP)) = epd(j)
            end do
        end do
        call golden_check(key // ' | ep', ep_g)
        call golden_check(key // ' | epd', epd_g)
    end subroutine vp_grid

    subroutine vp_record(key, flow, d)
        !! Golden records of `flow_stress` and of `dstress_dep` at every DT_VALUES.
        character(len=*), intent(in) :: key
            !! Key prefix (law, parameter set, hardening law).
        real(dp), intent(in) :: flow(:), d(:, :)
            !! `vp_flow_stress` and `vp_dstress_dep(..., DT_VALUES(it))` on the grid.
        character(len=16) :: dts
        integer :: it

        call golden_check(key // ' | flow_stress', flow)
        do it = 1, size(DT_VALUES)
            write(dts, '(es8.1)') DT_VALUES(it)
            call golden_check(key // ' | dstress_dep dt=' // trim(adjustl(dts)), d(:, it))
        end do
    end subroutine vp_record

    subroutine os_grid(key, ih, ep_g, sig_g)
        !! Grid EP_SWEEP x SIG_FACTORS*Y(ep) (ep fastest) of an overstress law composed with the
        !! hardening law `ih`, and its golden records.
        character(len=*), intent(in) :: key
            !! Key prefix (law, parameter set, hardening law).
        integer, intent(in) :: ih
            !! Composed hardening law (hard_values).
        real(dp), allocatable, intent(out) :: ep_g(:), sig_g(:)
            !! Grid.
        real(dp), allocatable :: y(:), dy(:)
        integer :: i, j, n

        call hard_values(ih, EP_SWEEP, y, dy)
        n = size(EP_SWEEP)*size(SIG_FACTORS)
        allocate(ep_g(n), sig_g(n))
        do j = 1, size(SIG_FACTORS)
            do i = 1, size(EP_SWEEP)
                ep_g(i + (j - 1)*size(EP_SWEEP)) = EP_SWEEP(i)
                sig_g(i + (j - 1)*size(EP_SWEEP)) = SIG_FACTORS(j)*y(i)
            end do
        end do
        call golden_check(key // ' | ep', ep_g)
        call golden_check(key // ' | sigma_eq', sig_g)
    end subroutine os_grid

    subroutine os_record(key, g)
        !! Golden records of `flow_rate`, `dflow_dsigma` and `dflow_dep`.
        character(len=*), intent(in) :: key
            !! Key prefix (law, parameter set, hardening law).
        real(dp), intent(in) :: g(:, :)
            !! The three functions on the grid (columns).

        call golden_check(key // ' | flow_rate', g(:, 1))
        call golden_check(key // ' | dflow_dsigma', g(:, 2))
        call golden_check(key // ' | dflow_dep', g(:, 3))
    end subroutine os_record

end module vp_golden_cases

program test_vp_golden
    !! Golden (characterization) test of the viscoplastic laws in double precision, bit for bit
    !! against tests/reference/plasticity/viscoplastic_laws/vp_laws_dp.txt, captured from the
    !! original OO code (regenerate.sh there) and reproduced by the kernel API (D-018.18f): the
    !! parameter types of `muscle_vp_laws`/`muscle_vp_overstress_laws` and the family generics, with
    !! the values of the composed hardening laws evaluated by `hard_stress`/`hard_dstress_dep`
    !! (D-017.6b). Includes ep = 0 and epd = 0 (first plastic increment, whose numeric derivatives
    !! changed in Phase 5, D-016.4). The records of the inherited numeric defaults of the OO bases
    !! were removed with them (D-018.8).
    !!
    !! Exit codes: 1-4 from `golden_finish` (muscle_test_golden).
    use muscle_kinds, only : dp
    use muscle_vp_laws, only : vp_flow_stress, vp_dstress_dep, vp_jc_dp, vp_jcfull_dp, vp_mrk_dp, &
        vp_rk_dp, vp_nnl_dp, vp_va_dp
    use muscle_vp_overstress_laws, only : os_flow_rate, os_dflow_dsigma, os_dflow_dep, os_perzyna_dp, &
        os_chaboche_dp
    use muscle_test_golden, only : golden_init, golden_check, golden_finish
    use vp_golden_cases, only : vp_grid, os_grid, hard_values, vp_record, os_record, DT_VALUES, HNAME
    implicit none

    real(dp), parameter :: JCP(3, 3) = reshape([ &
        0.00946101_dp, 0.32_dp, 1.0e-7_dp, &   ! fit of test_muscle_vp_models, default epmin
        0.014_dp, 1.0_dp, 1.0e-7_dp, &         ! classic JC steel, reference rate 1/s
        0.05_dp, 1.0e-3_dp, 1.0e-5_dp], [3, 3])  ! strong rate sensitivity, larger floor
        !! JC: C, epdmax (reference rate), epmin (rate floor).
    real(dp), parameter :: JCFP(6, 6) = reshape([ &
        0.014_dp, 1.0_dp, 1.03_dp, 293.15_dp, 1793.0_dp, 293.15_dp, &  ! T = Troom: Tstar = 0
        0.014_dp, 1.0_dp, 1.03_dp, 293.15_dp, 1793.0_dp, 700.0_dp, &   ! intermediate Tstar
        0.014_dp, 1.0_dp, 1.03_dp, 293.15_dp, 1793.0_dp, 2000.0_dp, &  ! T > Tmelt: Tstar = 1
        0.022_dp, 1.0e-3_dp, 0.8_dp, 293.15_dp, 1356.0_dp, 200.0_dp, & ! T < Troom: Tstar = 0
        0.014_dp, 1.0_dp, 0.0_dp, 293.15_dp, 1793.0_dp, 700.0_dp, &    ! m = 0 branch
        0.014_dp, 1.0_dp, 1.0_dp, 293.15_dp, 200.0_dp, 700.0_dp], [6, 6])  ! Tmelt < Troom
        !! JC full: C, epdmax, m, Troom, Tmelt, T_current.

    type(vp_jc_dp) :: jc
    type(vp_jcfull_dp) :: jcf
    type(vp_mrk_dp) :: mrk
    type(vp_rk_dp) :: rk
    type(vp_nnl_dp) :: nnl
    type(vp_va_dp) :: va
    type(os_perzyna_dp) :: per
    type(os_chaboche_dp) :: cha
    real(dp), allocatable :: ep(:), epd(:), sig(:), sy(:), dsy(:), flow(:), d(:, :), g(:, :)
    character(len=64) :: key
    integer :: i, ih, i_, it_

    call golden_init('plasticity/viscoplastic_laws/vp_laws_dp.txt')

    ! ---- Johnson-Cook (rate factor only), composed with each hardening law.
    do i = 1, size(JCP, 2)
        jc = vp_jc_dp(C=JCP(1, i), epdmax=JCP(2, i))
        if (i == 3) jc%epmin = JCP(3, i)
        write(key, '(a, i0)') 'jc | set ', i
        call golden_check(trim(key) // ' | constructor', [jc%C, jc%epdmax, jc%epmin])
        do ih = 1, 3
            call vp_grid(trim(key) // ' | ' // trim(HNAME(ih)), &
                [jc%epmin, jc%epmin*(1.0_dp + 1.0e-9_dp), jc%epdmax], ep, epd)
            call alloc_vp()
            call hard_values(ih, ep, sy, dsy)
            $:VP_VALUES('jc', True)
            call vp_record(trim(key) // ' | ' // trim(HNAME(ih)), flow, d)
        end do
    end do

    ! ---- Johnson-Cook full (rate and temperature; analytic dstress_dep since D-018.12b).
    do i = 1, size(JCFP, 2)
        jcf = vp_jcfull_dp(C=JCFP(1, i), epdmax=JCFP(2, i), m=JCFP(3, i), &
            Troom=JCFP(4, i), Tmelt=JCFP(5, i), T_current=JCFP(6, i))
        write(key, '(a, i0)') 'jcfull | set ', i
        call golden_check(trim(key) // ' | constructor', &
            [jcf%C, jcf%epdmax, jcf%m, jcf%Troom, jcf%Tmelt, jcf%T_current])
        do ih = 1, 3
            if (ih == 1 .and. i /= 2) cycle   ! bilinear only with the intermediate temperature
            if (ih == 3 .and. i /= 2) cycle
            call vp_grid(trim(key) // ' | ' // trim(HNAME(ih)), [jcf%epdmax, tiny(1.0_dp)], ep, epd)
            call alloc_vp()
            call hard_values(ih, ep, sy, dsy)
            $:VP_VALUES('jcf', True)
            call vp_record(trim(key) // ' | ' // trim(HNAME(ih)), flow, d)
        end do
    end do
    ! Default components.
    jcf = vp_jcfull_dp()
    call golden_check('jcfull | defaults | constructor', &
        [jcf%C, jcf%epdmax, jcf%m, jcf%Troom, jcf%Tmelt, jcf%T_current])
    call vp_grid('jcfull | defaults | swift', [real(dp) ::], ep, epd)
    call alloc_vp()
    call hard_values(2, ep, sy, dsy)
    $:VP_VALUES('jcf', True)
    call vp_record('jcfull | defaults | swift', flow, d)

    ! ---- Modified Rusinek-Klepaczko (own hardening).
    do i = 1, 2
        if (i == 1) then   ! fit of test_muscle_vp_models
            mrk = vp_mrk_dp(B01=100.020701_dp, B02=100.0_dp, epdmax=0.01_dp, &
                nu1=0.01439459_dp, nu2=0.14313556_dp, n0=3.95295384_dp, D2=5.6375e-12_dp, &
                epdmin=1.0e-5_dp, sig_u=253.772550_dp, chi1=9.1503e-4_dp, chi2=0.01942062_dp)
        else               ! dynamic range: epdmax = 1e4, rate-dependent n and saturation
            mrk = vp_mrk_dp(B01=200.0_dp, B02=150.0_dp, epdmax=1.0e4_dp, &
                nu1=0.05_dp, nu2=0.1_dp, n0=5.0_dp, D2=0.05_dp, &
                epdmin=1.0e-4_dp, sig_u=150.0_dp, chi1=0.05_dp, chi2=0.5_dp)
        end if
        write(key, '(a, i0)') 'mrk | set ', i
        call golden_check(trim(key) // ' | constructor', [mrk%B01, mrk%B02, mrk%epdmax, mrk%nu1, &
            mrk%nu2, mrk%n0, mrk%D2, mrk%epdmin, mrk%chi1, mrk%chi2, mrk%sig_u])
        call vp_grid(trim(key), [2.0e-12_dp, mrk%epdmin, 0.5_dp*mrk%epdmax, 0.99_dp*mrk%epdmax, &
            mrk%epdmax, 2.0_dp*mrk%epdmax], ep, epd)
        call alloc_vp()
        $:VP_VALUES('mrk', False)
        call vp_record(trim(key), flow, d)
    end do

    ! ---- Rusinek-Klepaczko (own hardening).
    do i = 1, 2
        if (i == 1) then   ! fit of test_muscle_vp_models
            rk = vp_rk_dp(B0=18.5805384_dp, epdmax=0.01_dp, nu=0.02014578_dp, &
                ep0=2.36959316_dp, n0=3.05066530_dp, D2=1.5302e-8_dp, D1=0.41425354_dp, &
                epdmin=1.0e-6_dp, sig0=1.1693e-5_dp, m=0.94914871_dp)
        else               ! steel-like: epdmax = 1e7, factor_n reaches 0 at epd = 1e15*epdmin
            rk = vp_rk_dp(B0=600.0_dp, epdmax=1.0e7_dp, nu=0.05_dp, &
                ep0=0.01_dp, n0=0.3_dp, D2=0.25_dp, D1=0.2_dp, &
                epdmin=1.0e-5_dp, sig0=200.0_dp, m=2.0_dp)
            rk%epmin = 1.0e-8_dp
        end if
        write(key, '(a, i0)') 'rk | set ', i
        call golden_check(trim(key) // ' | constructor', [rk%B0, rk%ep0, rk%n0, rk%D2, rk%D1, rk%nu, &
            rk%epdmin, rk%epdmax, rk%sig0, rk%m, rk%epmin, rk%epmax])
        call vp_grid(trim(key), [rk%epmin, rk%epdmin, 0.5_dp*rk%epdmax, 0.99_dp*rk%epdmax, &
            rk%epdmax, 2.0_dp*rk%epdmax], ep, epd)
        call alloc_vp()
        $:VP_VALUES('rk', False)
        call vp_record(trim(key), flow, d)
    end do

    ! ---- Nemat-Nasser-Li (own hardening).
    do i = 1, 2
        if (i == 1) then   ! fit of test_muscle_vp_models
            nnl = vp_nnl_dp(sig_a=334.776175_dp, sig_0=5.88318003_dp, KG0=0.21906996_dp, &
                n1=0.06301105_dp, epd0=0.01425422_dp, at=22.8752986_dp, &
                n0=0.97427303_dp, q=2.0_dp, p=0.6666667_dp)
        else               ! large epd0: X clamped to 0.999 at low rates
            nnl = vp_nnl_dp(sig_a=350.0_dp, sig_0=600.0_dp, KG0=0.04_dp, &
                n1=0.08_dp, epd0=1.0e8_dp, at=10.0_dp, n0=0.5_dp, q=1.5_dp, p=0.5_dp)
        end if
        write(key, '(a, i0)') 'nnl | set ', i
        call golden_check(trim(key) // ' | constructor', [nnl%sig_a, nnl%n1, nnl%sig_0, nnl%KG0, &
            nnl%epd0, nnl%at, nnl%n0, nnl%q, nnl%p, nnl%eps_log, nnl%eps_base])
        call vp_grid(trim(key), [nnl%epd0], ep, epd)
        call alloc_vp()
        $:VP_VALUES('nnl', False)
        call vp_record(trim(key), flow, d)
    end do

    ! ---- VA (own hardening).
    do i = 1, 3
        select case (i)
        case (1)   ! fit of test_muscle_vp_models
            va = vp_va_dp(B=374.525856_dp, B1=0.00331794_dp, B2=0.50280316_dp, &
                n=0.26412620_dp, m=0.03766668_dp, sig_u=195.233128_dp)
        case (2)   ! m = 0 branch (rate independent)
            va = vp_va_dp(B=374.525856_dp, B1=0.00331794_dp, B2=0.50280316_dp, &
                n=0.26412620_dp, m=0.0_dp, sig_u=195.233128_dp)
        case (3)
            va = vp_va_dp(B=500.0_dp, B1=0.02_dp, B2=0.1_dp, n=0.3_dp, m=5.0_dp, sig_u=100.0_dp)
        end select
        write(key, '(a, i0)') 'va | set ', i
        call golden_check(trim(key) // ' | constructor', [va%B, va%n, va%B1, va%B2, va%m, va%sig_u])
        call vp_grid(trim(key), [real(dp) ::], ep, epd)
        call alloc_vp()
        $:VP_VALUES('va', False)
        call vp_record(trim(key), flow, d)
    end do

    ! ---- Perzyna overstress, composed with each hardening law.
    do i = 1, 4
        select case (i)
        case (1)
            per = os_perzyna_dp(eta=1.0e-2_dp, n=1.0_dp)
        case (2)
            per = os_perzyna_dp(eta=1.0_dp, n=0.5_dp)   ! n < 1: infinite slope at the threshold
        case (3)
            per = os_perzyna_dp(eta=1.0e-4_dp, n=5.0_dp)
        case (4)
            per = os_perzyna_dp()                     ! defaults
        end select
        write(key, '(a, i0)') 'perzyna | set ', i
        call golden_check(trim(key) // ' | constructor', [per%eta, per%n])
        do ih = 1, 3
            if (i == 4 .and. ih /= 1) cycle
            call os_grid(trim(key) // ' | ' // trim(HNAME(ih)), ih, ep, sig)
            call alloc_os()
            call hard_values(ih, ep, sy, dsy)
            $:OS_VALUES('per')
            call os_record(trim(key) // ' | ' // trim(HNAME(ih)), g)
        end do
    end do

    ! ---- Chaboche overstress, composed with each hardening law.
    do i = 1, 4
        select case (i)
        case (1)
            cha = os_chaboche_dp(k=80.0_dp, n=2.3_dp)
        case (2)
            cha = os_chaboche_dp(k=50.0_dp, n=1.0_dp)
        case (3)
            cha = os_chaboche_dp(k=200.0_dp, n=0.5_dp)   ! n < 1: infinite slope at the threshold
        case (4)
            cha = os_chaboche_dp()                       ! defaults
        end select
        write(key, '(a, i0)') 'chaboche | set ', i
        call golden_check(trim(key) // ' | constructor', [cha%k, cha%n])
        do ih = 1, 3
            if (i == 4 .and. ih /= 1) cycle
            call os_grid(trim(key) // ' | ' // trim(HNAME(ih)), ih, ep, sig)
            call alloc_os()
            call hard_values(ih, ep, sy, dsy)
            $:OS_VALUES('cha')
            call os_record(trim(key) // ' | ' // trim(HNAME(ih)), g)
        end do
    end do

    call golden_finish()

contains

    subroutine alloc_vp()
        !! Results of a viscoplastic law on the current grid.
        if (allocated(flow)) deallocate(flow, d)
        allocate(flow(size(ep)), d(size(ep), size(DT_VALUES)))
    end subroutine alloc_vp

    subroutine alloc_os()
        !! Results of an overstress law on the current grid.
        if (allocated(g)) deallocate(g)
        allocate(g(size(ep), 3))
    end subroutine alloc_os

end program test_vp_golden
