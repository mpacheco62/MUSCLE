#:include "muscle_models_common.fypp"
#:set YIELD = model_family('yield').models

module yield_test_numeric
    !! Numeric derivatives of the equivalent stress of every registered yield criterion (dp, 3D), for
    !! the tests that compare the analytical derivatives against them: central differences of
    !! `yield_stress_eq` with the default steps of the finite-difference macros (FD_GRAD, FD_HESS of
    !! include/muscle_fd.fypp), the steps of the numeric procedures of the retired OO base.
    use muscle_kinds, only : dp
    use muscle_tensors, only : ten_3D2Osym, ten_3D4O3sym
    use muscle_yield_criteria, only : yield_stress_eq, ${', '.join('yield_' + m + '_dp' for m in YIELD)}$
    implicit none
    private

    public :: num_dstress_eq, num_ddstress_eq

    interface num_dstress_eq
        !! Central difference of the equivalent stress (gradient).
        module procedure ${', '.join('num_dstress_eq_' + m for m in YIELD)}$
    end interface num_dstress_eq

    interface num_ddstress_eq
        !! Central second difference of the equivalent stress (Hessian).
        module procedure ${', '.join('num_ddstress_eq_' + m for m in YIELD)}$
    end interface num_ddstress_eq

contains
#:for m in YIELD

    pure function num_dstress_eq_${m}$(prm, sigma) result(res)
        !! Gradient of the ${m}$ equivalent stress by central differences.
        type(yield_${m}$_dp), intent(in) :: prm
            !! Criterion.
        type(ten_3D2Osym), intent(in) :: sigma
            !! Stress.
        type(ten_3D2Osym) :: res
            !! Numeric gradient.
        @:FD_GRAD(res, yield_stress_eq(prm, {x}), sigma, dp, 3D)
    end function num_dstress_eq_${m}$

    pure function num_ddstress_eq_${m}$(prm, sigma) result(res)
        !! Hessian of the ${m}$ equivalent stress by central second differences.
        type(yield_${m}$_dp), intent(in) :: prm
            !! Criterion.
        type(ten_3D2Osym), intent(in) :: sigma
            !! Stress.
        type(ten_3D4O3sym) :: res
            !! Numeric Hessian.
        @:FD_HESS(res, yield_stress_eq(prm, {x}), sigma, dp, 3D)
    end function num_ddstress_eq_${m}$
#:endfor

end module yield_test_numeric
