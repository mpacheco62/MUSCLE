    & 'operator(.ddot.) (type(ten_3d2osym), type(iden_2o)) -> real(dp)', &
    & 'operator(.ddot.) (type(ten_3d2osym), type(iden_2os)) -> real(dp)', &
    & 'operator(.ddot.) (type(ten_3d2osym), type(iden_4o4ts)) -> type(ten_3d2osym)', &
    & 'operator(.ddot.) (type(ten_3d2osym), type(ten_3d2o)) -> real(dp)', &
    & 'operator(.ddot.) (type(ten_3d2osym), type(ten_3d4o2sym)) -> type(ten_3d2osym)', &
    & 'operator(.ddot.) (type(ten_3d2osym), type(ten_3d4o3sym)) -> type(ten_3d2osym)', &
    & 'operator(.ddot.) (type(ten_3d4o2sym), type(ten_3d2osym)) -> type(ten_3d2osym)', &
    & 'operator(.ddot.) (type(ten_3d4o3sym), type(ten_3d2osym)) -> type(ten_3d2osym)', &
    & 'operator(.ddot.) (type(ten_3d4o3sym), type(ten_3d4o3sym)) -> type(ten_3d4o2sym)', &
    & 'operator(.tdot.) (type(iden_2o), type(ten_2d2osym)) -> type(ten_2d4o2sym)', &
    & 'operator(.tdot.) (type(iden_2o), type(ten_3d2osym)) -> type(ten_3d4o2sym)', &
    & 'operator(.tdot.) (type(ten_2d2osym), type(iden_2o)) -> type(ten_2d4o2sym)', &
    & 'operator(.tdot.) (type(ten_2d2osym), type(ten_2d2osym)) -> type(ten_2d4o2sym)', &
    & 'operator(.tdot.) (type(ten_3d2osym), type(iden_2o)) -> type(ten_3d4o2sym)', &
    & 'operator(.tdot.) (type(ten_3d2osym), type(ten_3d2osym)) -> type(ten_3d4o2sym)', &
    & 'operator(.tdotsym.) (type(iden_2o), type(ten_2d2osym)) -> type(ten_2d4o3sym)', &
    & 'operator(.tdotsym.) (type(iden_2o), type(ten_3d2osym)) -> type(ten_3d4o3sym)', &
    & 'operator(.tdotsym.) (type(ten_2d2osym)) -> type(ten_2d4o3sym)', &
    & 'operator(.tdotsym.) (type(ten_2d2osym), type(iden_2o)) -> type(ten_2d4o3sym)', &
    & 'operator(.tdotsym.) (type(ten_2d2osym), type(ten_2d2osym)) -> type(ten_2d4o3sym)', &
    & 'operator(.tdotsym.) (type(ten_3d2osym)) -> type(ten_3d4o3sym)', &
    & 'operator(.tdotsym.) (type(ten_3d2osym), type(iden_2o)) -> type(ten_3d4o3sym)', &
    & 'operator(.tdotsym.) (type(ten_3d2osym), type(ten_3d2osym)) -> type(ten_3d4o3sym)', &
    & 'operator(.transform.) (type(ten_2d2o), type(ten_2d2osym)) -> type(ten_2d2osym)', &
    & 'operator(.transform.) (type(ten_2d2o), type(ten_2d4o2sym)) -> type(ten_2d4o2sym)', &
    & 'operator(.transform.) (type(ten_2d2o), type(ten_2d4o3sym)) -> type(ten_2d4o3sym)', &
    & 'operator(.transform.) (type(ten_3d2o), type(ten_3d2osym)) -> type(ten_3d2osym)', &
    & 'operator(.transform.) (type(ten_3d2o), type(ten_3d4o2sym)) -> type(ten_3d4o2sym)', &
    & 'operator(.transform.) (type(ten_3d2o), type(ten_3d4o3sym)) -> type(ten_3d4o3sym)', &
    & ]

#! ---- Signature parsing (format of tools/fypp/ops_signatures.py) ---------------------------
#:set sig_generic = lambda s: s.split(' (', 1)[0]
#:set sig_args = lambda s: [a[5:-1] for a in s.split(' (', 1)[1].split(' -> ')[0][:-1].split(', ')]
#:set sig_result = lambda s: (s.split(' -> ')[1] if ' -> ' in s else None)
#:set type_of = lambda t: (t[5:-1] if t.startswith('type(') else t)
#:set op_token = lambda g: g[len('operator('):-1]
#:set is_tensor = lambda t: t.startswith('ten_')
#:set is_scaled_iden = lambda t: t.startswith('iden_') and t.endswith('s')
#:set seed_of = lambda s: 1 + (sum([(i + 1)*ord(c) for i, c in enumerate(s)]) * 7919) % 2147483000
#:set SIGNATURES = [s for s in ALL_SIGNATURES if sig_generic(s) in GOLDEN_GENERICS]
#:set RESULT_TYPES = sorted(set([type_of(sig_result(s)) for s in SIGNATURES if sig_result(s)] &
    & + [sig_args(s)[0] for s in SIGNATURES if sig_result(s) is None]))
#:set EMIT_TYPES = [t for t in RESULT_TYPES if t != 'real(dp)']

module ops_golden_driver_${GOLDEN_NAME}$
    !! Bookkeeping of the golden operator test: deterministic operands and the golden records, read,
    !! checked and written by `muscle_test_golden` (tolerance `GOLDEN_TOL_ALGEBRA`, D-021).
    use, intrinsic :: iso_fortran_env, only : int64
    use muscle_kinds, only : dp
    use muscle_test_helpers, only : park_miller, rnd
    use muscle_test_golden, only : golden_init, golden_check, golden_finish
    implicit none
    private

    public :: NCASES, driver_init, driver_finish, record_values, draw, scalar, case_rng

    integer, parameter :: NCASES = 3
        !! Cases per signature.
    real(dp), parameter :: MAGNITUDE(NCASES) = [1.0_dp, 250.0_dp, 0.03_dp]
        !! Magnitude of the tensor components of each case.
    real(dp), parameter :: SCALAR_SIGN(NCASES) = [1.0_dp, -1.0_dp, 1.0_dp]
        !! Sign of the identity scalars of each case.

contains

    subroutine driver_init(refname)
        !! Reads the reference `tensors/operators/<refname>` (or opens it for `--write FILE`).
        character(len=*), intent(in) :: refname
            !! File name of the reference, e.g. `ops_dyadic_dp.txt`.
        call golden_init('tensors/operators/' // refname)
    end subroutine driver_init

    subroutine record_values(sig, icase, x)
        !! Writes (regeneration) or checks (test) the values of one result: record
        !! `<signature> | case <c>`.
        character(len=*), intent(in) :: sig
            !! Signature of the evaluated operator.
        integer, intent(in) :: icase
            !! Case number.
        real(dp), intent(in) :: x(:)
            !! Stored values of the result (storage order of `vals`).
        character(len=128) :: key
        write(key, '(a, " | case ", i0)') sig, icase
        call golden_check(trim(key), x)
    end subroutine record_values

    subroutine driver_finish()
        !! Checks that every reference record was produced and stops with the first failure code.
        call golden_finish()
    end subroutine driver_finish

    function case_rng(seed, icase) result(rng)
        !! Generator of one (signature, case): independent of the order in which signatures run.
        integer, intent(in) :: seed
            !! Seed of the signature.
        integer, intent(in) :: icase
            !! Case number.
        type(park_miller) :: rng
            !! Generator.
        rng%state = 1 + mod(int(seed, int64) + 104729_int64*icase, 2147483646_int64)
    end function case_rng

    function draw(n, rng, icase) result(v)
        !! `n` tensor components of the magnitude of case `icase`.
        integer, intent(in) :: n
            !! Number of components.
        type(park_miller), intent(inout) :: rng
            !! Generator.
        integer, intent(in) :: icase
            !! Case number.
        real(dp) :: v(n)
            !! Components.
        integer :: i
        do i = 1, n
            v(i) = MAGNITUDE(icase)*rnd(rng)
        end do
    end function draw

    function scalar(rng, icase) result(c)
        !! Non-trivial identity scalar of case `icase` (|c| in (0.5, 2.5) times the magnitude).
        type(park_miller), intent(inout) :: rng
            !! Generator.
        integer, intent(in) :: icase
            !! Case number.
        real(dp) :: c
            !! Scalar.
        c = SCALAR_SIGN(icase)*MAGNITUDE(icase)*(1.5_dp + rnd(rng))
    end function scalar

end module ops_golden_driver_${GOLDEN_NAME}$

program test_ops_golden_${GOLDEN_NAME}$
    !! Golden test of the generics ${', '.join(GOLDEN_GENERICS)}$ (${len(SIGNATURES)}$ signatures).
    use muscle_kinds, only : dp
    use muscle_tensors
    use muscle_test_helpers, only : park_miller
    use ops_golden_driver_${GOLDEN_NAME}$
    implicit none
    integer :: icase

    character(len=*), parameter :: REFNAME = 'ops_${GOLDEN_NAME}$_dp.txt'
        !! Reference file.

    call driver_init(REFNAME)
    do icase = 1, NCASES
#:for n, s in enumerate(SIGNATURES)
        call sig_${n + 1}$(icase)
#:endfor
    end do
    call driver_finish()

contains

#:for t in EMIT_TYPES
    subroutine emit_${t}$(sig, icase, x)
        !! Records a `${t}$` result (the dummy type is exact: no conversion is possible).
        character(len=*), intent(in) :: sig
            !! Signature.
        integer, intent(in) :: icase
            !! Case number.
        type(${t}$), intent(in) :: x
            !! Result.
        call record_values(sig, icase, reshape(x%vals, [size(x%vals)]))
    end subroutine emit_${t}$

#:endfor
#:if 'real(dp)' in RESULT_TYPES
    subroutine emit_real_dp(sig, icase, x)
        !! Records a `real(dp)` result.
        character(len=*), intent(in) :: sig
            !! Signature.
        integer, intent(in) :: icase
            !! Case number.
        real(dp), intent(in) :: x
            !! Result.
        call record_values(sig, icase, [x])
    end subroutine emit_real_dp

#:endif
#:for n, s in enumerate(SIGNATURES)
#:set g = sig_generic(s)
#:set args = sig_args(s)
#:set res = sig_result(s)
#:set names = ['a', 'b'][:len(args)]
    subroutine sig_${n + 1}$(icase)
        !! ${s}$
        integer, intent(in) :: icase
            !! Case number.
        character(len=*), parameter :: SIG = &
            '${s}$'
        type(park_miller) :: rng
#:for v, t in zip(names, args)
        type(${t}$) :: ${v}$
#:endfor

        rng = case_rng(${seed_of(s)}$, icase)
#:for v, t in zip(names, args)
#:if is_tensor(t)
        ${v}$%vals = reshape(draw(size(${v}$%vals), rng, icase), shape(${v}$%vals))
#:elif is_scaled_iden(t)
        ${v}$%val = scalar(rng, icase)
#:endif
#:endfor
#:if res is None
        a = b
        call emit_${args[0]}$(SIG, icase, a)
#:else
#:set expr = (op_token(g) + ' a') if len(args) == 1 else ('a ' + op_token(g) + ' b')
#:set rt = type_of(res)
        call emit_${'real_dp' if rt == 'real(dp)' else rt}$(SIG, icase, ${expr}$)
#:endif
    end subroutine sig_${n + 1}$

#:endfor
end program test_ops_golden_${GOLDEN_NAME}$
