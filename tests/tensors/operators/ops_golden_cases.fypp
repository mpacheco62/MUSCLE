#! Golden (characterization) test of the operators between tensor types, double precision.
#!
#! Included by the six `test_ops_golden_<module>.fypp` templates, one per operator module of
#! `src/tensors/operators/`, after they set:
#!   GOLDEN_NAME      test name, e.g. 'addition_subtraction' (reference file
#!                    `tests/reference/tensors/operators/ops_<GOLDEN_NAME>_dp.txt`)
#!   GOLDEN_GENERICS  generics of that module, e.g. ['operator(+)', 'operator(-)']
#!
#! Every signature of `ALL_SIGNATURES` (a copy of `tools/fypp/ref/ops_signatures_dp.txt`, the
#! inventory of the historical double precision operators, D-015) whose generic is in
#! GOLDEN_GENERICS becomes one subroutine that builds deterministic operands and evaluates the
#! *generic* operator (never a specific name, so the test is valid before and after the FYPP
#! migration, which renames the specifics). The result is passed to an `emit_<type>` routine
#! whose dummy has exactly the result type of the signature, so a call that resolved to a
#! specific with another result type does not compile (no defined assignment in between). For
#! `assignment(=)` the left-hand side is pre-filled with random values, so components that the
#! assignment does not write are characterized too.
#!
#! Each signature runs NCASES cases (operands of magnitude ~1, ~250 and ~0.03; identity scalars
#! positive, negative, small). Every result is compared, within the tolerance of its category (D-021), with the reference
#! captured from the original code; on a mismatch the components outside the tolerance are printed
#! with their relative error (`MUSCLE_GOLDEN_STRICT=1`: bit for bit).
#!
#! Regeneration (only from code whose behaviour is the reference!):
#! `tests/reference/tensors/operators/regenerate.sh BUILD_DIR`, which runs each test executable
#! with `--write FILE`. The test itself (as run by ctest) never writes the reference.
#:include "muscle_common.fypp"

#! Inventory of the historical double precision signatures (copy of
#! tools/fypp/ref/ops_signatures_dp.txt; tests/tools/test_ops_golden_coverage.py checks the copy).
#:set ALL_SIGNATURES = [ &
    & 'assignment(=) (type(ten_2d2o), type(ten_2d2osym))', &
    & 'assignment(=) (type(ten_2d2osym), type(iden_2o))', &
    & 'assignment(=) (type(ten_2d2osym), type(iden_2os))', &
    & 'assignment(=) (type(ten_2d4o2sym), type(iden_4o4t))', &
    & 'assignment(=) (type(ten_2d4o2sym), type(iden_4o4ts))', &
    & 'assignment(=) (type(ten_2d4o2sym), type(ten_2d4o3sym))', &
    & 'assignment(=) (type(ten_2d4o3sym), type(iden_4o3ts))', &
    & 'assignment(=) (type(ten_2d4o3sym), type(iden_4o4ts))', &
    & 'assignment(=) (type(ten_3d2o), type(ten_3d2osym))', &
    & 'assignment(=) (type(ten_3d2osym), type(iden_2o))', &
    & 'assignment(=) (type(ten_3d2osym), type(iden_2os))', &
    & 'assignment(=) (type(ten_3d4o2sym), type(iden_4o4t))', &
    & 'assignment(=) (type(ten_3d4o2sym), type(iden_4o4ts))', &
    & 'assignment(=) (type(ten_3d4o2sym), type(ten_3d4o3sym))', &
    & 'assignment(=) (type(ten_3d4o3sym), type(iden_4o3ts))', &
    & 'assignment(=) (type(ten_3d4o3sym), type(iden_4o4ts))', &
    & 'operator(*) (type(iden_2o), type(ten_2d2o)) -> type(ten_2d2o)', &
    & 'operator(*) (type(iden_2o), type(ten_2d2osym)) -> type(ten_2d2osym)', &
    & 'operator(*) (type(iden_2o), type(ten_3d2o)) -> type(ten_3d2o)', &
