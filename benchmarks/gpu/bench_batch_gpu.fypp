#:include "muscle_common.fypp"
#! One material and kind per executable (fypp define BENCH_CASE = '<material>_<kind>', bench_cases.py), so
#! that each device image is small (D-019.5d).
#:set CASES = muscle_meta.load_python_file('bench_cases.py', base=_THIS_FILE_)
#:set SAMPLES = muscle_meta.load_python_file('../../tests/materials/props_samples.py', base=_THIS_FILE_)
#:set M, K = BENCH_CASE.rsplit('_', 1)
#:set REAL_KINDS = [K]
#:set k = K
#:set DT = dict(CASES.BENCH_MATERIALS)[M]
#:set MAT = muscle_meta.material(M)
#:assert muscle_meta.material_strain_input(MAT) and not muscle_meta.material_visco(MAT)
#:set PROPS = muscle_meta.material_props(MAT)
#:set NS = muscle_meta.material_nstate(M)
#:set MAT_T = muscle_meta.material_type(M, k)
#! Device memory: that of the default device with MUSCLE_GPU, host memory (the initial device) without it
#:set DEVNUM = 'omp_get_default_device()' if defined('MUSCLE_GPU') else 'omp_get_initial_device()'

program bench_batch_gpu
    !! Batch API of material `${M}$` (`real(${k}$)`) on N integration points, GPU against CPU (Phase 8,
    !! D-019): `muscle_update_${M}$_dev` with tangent on arrays of `omp_target_alloc`.
    !!
    !! - Build with MUSCLE_GPU: the arrays live on the default device; the kernel time excludes the
    !!   transfers. The device initialization (image load, JIT) and the first call are reported apart, and
    !!   the host <-> device transfers of the inputs (strain, history at t_n) and of the outputs (history at
    !!   t_n+1, stress, tangent, status, iterations) are timed with `omp_target_memcpy`.
    !! - CPU build: the same API runs the OpenMP `parallel do` of the batch on host memory, for every thread
    !!   count of `--threads` (default 1 and all), after one untimed warm-up call per thread count.
    !!
    !! Every configuration is run `--repeat` times and the minimum wall time is reported. One increment
    !! from the zero state to the strains f a_y D1 + 0.3 a_y sin(i) D2, f from 0 to 4 (elastic and plastic
    !! points). A sample of `--sample` points is checked against the point API on the host
    !! (`muscle_point_${M}$`): statuses exact, the real outputs within `TOL_DEVICE_${k}$`
    !! (`check_sample`; exit code 1 otherwise).
    !!
    !! Not a test (not in CTest): `-DMUSCLE_BUILD_BENCHMARKS=ON`, Release build; see benchmarks/README.md.
    !! The lines starting with `RESULT` are for scripts.
    use, intrinsic :: iso_c_binding, only : c_ptr, c_loc, c_f_pointer, c_size_t, c_int, c_associated
    use, intrinsic :: iso_fortran_env, only : output_unit, int64
    use omp_lib, only : omp_get_wtime, omp_get_max_threads, omp_set_num_threads, omp_target_alloc, &
        omp_target_free, omp_target_memcpy, omp_get_initial_device
    #:if defined('MUSCLE_GPU')
    use omp_lib, only : omp_get_default_device
    #:endif
    use muscle_kinds, only : ${k}$${'' if k == 'dp' else ', dp'}$
    use muscle_status, only : STATUS_OK
    use ${muscle_meta.material_module(M)}$, only : ${MAT_T}$, mat_init_${M}$, muscle_update_${M}$_dev, &
        muscle_point_${M}$, ${muscle_meta.material_nprops(M)}$, ${NS}$
    use muscle_test_utils, only : TOL_DEVICE_${k}$, target_on_device
    implicit none

    integer, parameter :: MAX_LIST = 16
        !! Maximum number of entries of a list option.
    real(${k}$), parameter :: DT = ${DT}$_${k}$
        !! Time step.
    real(${k}$), parameter :: A_Y = 200.0_${k}$/210000.0_${k}$
        !! Yield strain of the sample inputs (initial yield stress 200, Young modulus 210000).
    integer(c_size_t), parameter :: RB = storage_size(1.0_${k}$)/8
        !! Bytes of a real.
    integer(c_size_t), parameter :: IB = storage_size(1)/8
        !! Bytes of an integer.
    character(len=*), parameter :: CASE_NAME = '${M}$ ${k}$'
        !! Material and kind of the run.

    ! Options
    integer :: points(MAX_LIST) = 0
        !! Numbers of points.
    integer :: n_sizes = 0
        !! Entries of `points`.
    integer :: threads(MAX_LIST) = 0
        !! Thread counts (CPU build).
    integer :: n_threads = 0
        !! Entries of `threads`.
    integer :: n_repeat = 5
        !! Repetitions of each configuration.
    integer :: n_sample = 1000
        !! Points checked against the point API.

    type(${MAT_T}$) :: mat
    logical :: device
        !! The batch runs on a device.
    integer(c_int) :: dev, host
        !! Device of the memory of `omp_target_alloc`, initial (host) device.
    type(c_ptr) :: c_eps, c_hn, c_hb, c_sig, c_tan, c_st, c_it
        !! Device memory for the largest number of points.
    real(${k}$), pointer :: d_eps(:, :), d_hn(:, :), d_hb(:, :), d_sg(:, :), d_tn(:, :, :)
    integer, pointer :: d_st(:), d_it(:)
        !! Fortran views of the device memory for the current number of points.
    real(dp) :: t_init
        !! Device initialization (image load and JIT with MUSCLE_GPU).
    integer :: j, nmax, n_bad

    call parse_arguments()
    call make_material()
    host = omp_get_initial_device()
    dev = ${DEVNUM}$
    t_init = real(omp_get_wtime(), dp)
    device = target_on_device()
    #:if defined('MUSCLE_GPU')
    !$omp target enter data map(to: mat)
    #:endif
    t_init = real(omp_get_wtime(), dp) - t_init
    call print_header()

    nmax = maxval(points(1:n_sizes))
    c_eps = dev_alloc(RB*6*nmax)
    c_hn = dev_alloc(RB*${NS}$*nmax)
    c_hb = dev_alloc(RB*${NS}$*nmax)
    c_sig = dev_alloc(RB*6*nmax)
    c_tan = dev_alloc(RB*36*nmax)
    c_st = dev_alloc(IB*nmax)
    c_it = dev_alloc(IB*nmax)

    n_bad = 0
    do j = 1, n_sizes
        call run_size(points(j), j == 1)
    end do

    call omp_target_free(c_eps, dev)
    call omp_target_free(c_hn, dev)
    call omp_target_free(c_hb, dev)
    call omp_target_free(c_sig, dev)
    call omp_target_free(c_tan, dev)
    call omp_target_free(c_st, dev)
    call omp_target_free(c_it, dev)
    #:if defined('MUSCLE_GPU')
    !$omp target exit data map(delete: mat)
    #:endif
    if (n_bad > 0) then
        print '(a, i0, a)', ' ERROR: ', n_bad, ' sampled points differ from the point API on the host'
        stop 1
    end if
    print '(a)', ' All sampled points agree with the point API on the host.'

contains

    subroutine make_material()
        !! The material from its parameter array: the sample inputs of tests/materials/props_samples.py and
        !! the default solver settings of the type.
        type(${MAT_T}$) :: defaults
        real(${k}$) :: props(${muscle_meta.material_nprops(M)}$)
        integer :: st

        #:for q in PROPS
        #:if q.component is None
        props(${q.index}$) = real(defaults%${q.name}$, ${k}$)
        #:else
        props(${q.index}$) = ${SAMPLES.prop_literal(muscle_meta, MAT, q, k, {})}$
        #:endif
        #:endfor
        call mat_init_${M}$(mat, props, st)
        if (st /= STATUS_OK) then
            print '(a, i0)', ' ERROR: mat_init_${M}$ status ', st
            stop 1
        end if
    end subroutine make_material

    subroutine run_size(n, first)
        !! Every configuration for `n` points: transfers and kernel (MUSCLE_GPU) or thread counts (CPU), the
        !! check of the sample.
        integer, intent(in) :: n
            !! Number of points.
        logical, intent(in) :: first
            !! First batch call of the run (its time is reported apart with MUSCLE_GPU).
        real(${k}$), allocatable, target :: eps(:, :), hn(:, :), hb(:, :), sg(:, :), tn(:, :, :)
        integer, allocatable, target :: st(:), it(:)
        real(dp) :: t_h2d, t_d2h, t_min, t0
        real(${k}$) :: f
        real(${k}$) :: d1(6), d2(6)
        integer :: i, r
        #:if defined('MUSCLE_GPU')
        real(dp) :: t_first
        #:else
        integer :: c
        #:endif

        allocate(eps(n, 6), hn(n, ${NS}$), hb(n, ${NS}$), sg(n, 6), tn(n, 6, 6), st(n), it(n))
        d1 = [1.0_${k}$, -0.3_${k}$, -0.3_${k}$, 0.2_${k}$, 0.05_${k}$, 0.1_${k}$]
        d2 = [0.1_${k}$, 0.2_${k}$, -0.3_${k}$, 0.15_${k}$, -0.05_${k}$, 0.1_${k}$]
        do i = 1, n
            f = 4.0_${k}$*(real(i, ${k}$) - 0.5_${k}$)/real(n, ${k}$)
            eps(i, :) = f*A_Y*d1 + 0.3_${k}$*A_Y*sin(real(i, ${k}$))*d2
        end do
        hn = 0.0_${k}$
        call c_f_pointer(c_eps, d_eps, [n, 6])
        call c_f_pointer(c_hn, d_hn, [n, ${NS}$])
        call c_f_pointer(c_hb, d_hb, [n, ${NS}$])
        call c_f_pointer(c_sig, d_sg, [n, 6])
        call c_f_pointer(c_tan, d_tn, [n, 6, 6])
        call c_f_pointer(c_st, d_st, [n])
        call c_f_pointer(c_it, d_it, [n])

        ! Inputs to the device
        t_h2d = huge(1.0_dp)
        do r = 1, n_repeat
            t0 = real(omp_get_wtime(), dp)
            call copy(c_eps, dev, c_loc(eps), host, RB*size(eps))
            call copy(c_hn, dev, c_loc(hn), host, RB*size(hn))
            t_h2d = min(t_h2d, real(omp_get_wtime(), dp) - t0)
        end do

        #:if defined('MUSCLE_GPU')
        t0 = real(omp_get_wtime(), dp)
        call update()
        t_first = real(omp_get_wtime(), dp) - t0
        t_min = time_updates()
        call print_row(n, merge('gpu        ', 'host-fallbk', device), t_min, t_first)
        #:else
        do c = 1, n_threads
            call omp_set_num_threads(threads(c))
            call update()
            t_min = time_updates()
            call print_row(n, 'cpu-' // itoa(threads(c)), t_min, -1.0_dp)
        end do
        #:endif

        ! Outputs to the host
        t_d2h = huge(1.0_dp)
        do r = 1, n_repeat
            t0 = real(omp_get_wtime(), dp)
            call copy(c_loc(hb), host, c_hb, dev, RB*size(hb))
            call copy(c_loc(sg), host, c_sig, dev, RB*size(sg))
            call copy(c_loc(tn), host, c_tan, dev, RB*size(tn))
            call copy(c_loc(st), host, c_st, dev, IB*n)
            call copy(c_loc(it), host, c_it, dev, IB*n)
            t_d2h = min(t_d2h, real(omp_get_wtime(), dp) - t0)
        end do
        write(*, '(a, i9, a, es10.3, a, f7.2, a, es10.3, a, f7.2, a)') '   N =', n, ': host->device ', t_h2d, &
            ' s (', real(RB*(size(eps) + size(hn)), dp)/t_h2d/1.0e9_dp, ' GB/s), device->host ', t_d2h, ' s (', &
            real(RB*(size(hb) + size(sg) + size(tn)) + 2*IB*n, dp)/t_d2h/1.0e9_dp, ' GB/s)'
        write(*, '(a, i0, a, i0, a, i0)') '   points: elastic ', count(st == STATUS_OK .and. it == 0), &
            ', plastic ', count(st == STATUS_OK .and. it > 0), ', not converged ', count(st /= STATUS_OK)
        write(*, '(a, a, 1x, i0, 3(1x, es12.5))') 'TRANSFER ', CASE_NAME, n, t_h2d, t_d2h, t_init
        if (first) print '(a, es10.3, a)', '   device initialization (image load, JIT): ', t_init, ' s'
        call check_sample(n, eps, hn, hb, sg, tn, st, it)
        flush(output_unit)
    end subroutine run_size

    subroutine update()
        !! One batch call on the device arrays.
        call muscle_update_${M}$_dev(mat, d_eps, DT, d_hn, d_hb, d_sg, d_st, d_it, ddsdde=d_tn)
    end subroutine update

    function time_updates() result(t)
        !! Minimum time of `n_repeat` batch calls.
        real(dp) :: t
            !! Wall time (s).
        integer :: rr
        real(dp) :: s0

        t = huge(1.0_dp)
        do rr = 1, n_repeat
            s0 = real(omp_get_wtime(), dp)
            call update()
            t = min(t, real(omp_get_wtime(), dp) - s0)
        end do
    end function time_updates

    subroutine check_sample(n, eps, hn, hb, sg, tn, st, it)
        !! `n_sample` points spread over the batch against the point API on the host: statuses exact, the
        !! points with other iterations counted (a sp Newton iterate on the stopping tolerance may need one
        !! iteration more or less on the device: FMA, order of the sums); for the points that converge, the stress and the tangent
        !! within `TOL_DEVICE_${k}$` relative to their largest component, and the history within `TOL_DEVICE_${k}$` relative to the
        !! largest component of the history or of the strain of the point (the plastic increment of a
        !! barely plastic point comes from the small difference between the trial stress and the yield
        !! stress: its own relative error is amplified, not that relative to the strain).
        integer, intent(in) :: n
            !! Number of points.
        real(${k}$), intent(in) :: eps(n, 6), hn(n, ${NS}$), hb(n, ${NS}$), sg(n, 6), tn(n, 6, 6)
            !! Inputs and outputs of the batch.
        integer, intent(in) :: st(n), it(n)
            !! Statuses and iterations of the batch.
        real(${k}$) :: h(${NS}$), s(6), t(6, 6), e(3), err(3)
        integer :: j, i, sr, ir, bad, ns, other_iters

        bad = 0
        other_iters = 0
        err = 0.0_${k}$
        ns = min(n_sample, n)
        do j = 1, ns
            i = 1 + int(int(j - 1, int64)*(n - 1)/max(ns - 1, 1))
            call muscle_point_${M}$(mat, eps(i, :), DT, hn(i, :), h, s, sr, ir, t)
            if (sr /= st(i)) then
                bad = bad + 1
                if (bad <= 5) write(*, '(a, i0, 2(a, i0))') '   point ', i, ': status ', st(i), ' (host ', sr, ')'
                cycle
            end if
            if (ir /= it(i)) other_iters = other_iters + 1
            if (sr /= STATUS_OK) cycle
            e = [rel_err(hb(i, :), h, maxval(abs(eps(i, :)))), rel_err(sg(i, :), s, 0.0_${k}$), &
                rel_err(reshape(tn(i, :, :), [36]), reshape(t, [36]), 0.0_${k}$)]/epsilon(1.0_${k}$)
            err = max(err, e)
            if (any(e*epsilon(1.0_${k}$) > TOL_DEVICE_${k}$)) then
                bad = bad + 1
                if (bad <= 5) write(*, '(a, i0, a, i0, a, 3f9.2)') '   point ', i, ', iterations ', ir, &
                    ': error (eps) of the history, stress, tangent ', e
            end if
        end do
        write(*, '(a, i0, a, 3f7.2, 2(a, i0))') '   sample of ', ns, ' points vs host: max error (eps) of the history, ' &
            // 'stress, tangent ', err, ', other iterations ', other_iters, ', failures ', bad
        write(*, '(a, a, 1x, i0, 1x, i0, 3(1x, f0.2), 2(1x, i0))') 'CHECK ', CASE_NAME, n, ns, err, other_iters, bad
        n_bad = n_bad + bad
    end subroutine check_sample

    pure function rel_err(a, b, floor) result(e)
        !! Largest difference relative to the largest component of `a`, `b` and `floor`.
        real(${k}$), intent(in) :: a(:), b(:)
            !! Batch and reference.
        real(${k}$), intent(in) :: floor
            !! Lower bound of the scale.
        real(${k}$) :: e
            !! Relative error.
        e = maxval(abs(a - b))/max(maxval(abs(a)), maxval(abs(b)), floor, tiny(1.0_${k}$))
    end function rel_err

    subroutine print_row(n, config, t, t_first)
        !! One timing line (and its `RESULT` line).
        integer, intent(in) :: n
            !! Number of points.
        character(len=*), intent(in) :: config
            !! Configuration (`gpu`, `cpu-<threads>`).
        real(dp), intent(in) :: t
            !! Minimum time of a batch call (s).
        real(dp), intent(in) :: t_first
            !! First call (s), negative if not measured.
        write(*, '(a, i9, 2x, a12, a, es10.3, a, es10.3, a)') '   N =', n, config, ': ', t, ' s, ', real(n, dp)/t, &
            ' points/s'
        if (t_first >= 0.0_dp) print '(a, es10.3, a)', '   first call: ', t_first, ' s'
        write(*, '(a, a, 1x, i0, 1x, a, 2(1x, es12.5))') 'RESULT ', CASE_NAME, n, trim(config), t, t_first
    end subroutine print_row

    function itoa(i) result(s)
        !! Decimal text of `i`.
        integer, intent(in) :: i
            !! Value.
        character(len=:), allocatable :: s
        character(len=16) :: buf
        write(buf, '(i0)') i
        s = trim(buf)
    end function itoa

    function dev_alloc(nbytes) result(p)
        !! `nbytes` bytes of the memory of `dev` (stops if the allocation fails).
        integer(c_size_t), intent(in) :: nbytes
            !! Size.
        type(c_ptr) :: p
            !! Address.
        p = omp_target_alloc(nbytes, dev)
        if (.not. c_associated(p)) then
            print '(a)', ' ERROR: omp_target_alloc'
            stop 1
        end if
    end function dev_alloc

    subroutine copy(dst, dst_dev, src, src_dev, nbytes)
        !! `omp_target_memcpy` of `nbytes` bytes (stops on failure).
        type(c_ptr), intent(in) :: dst, src
            !! Destination and source addresses.
        integer(c_int), intent(in) :: dst_dev, src_dev
            !! Their devices.
        integer(c_size_t), intent(in) :: nbytes
            !! Size.
        if (omp_target_memcpy(dst, src, nbytes, 0_c_size_t, 0_c_size_t, dst_dev, src_dev) /= 0) then
            print '(a)', ' ERROR: omp_target_memcpy'
            stop 1
        end if
    end subroutine copy

    subroutine print_header()
        !! Configuration of the run.
        character(len=:), allocatable :: build_type

        build_type = MUSCLE_BUILD_TYPE
        print '(a)', ' MUSCLE benchmark: batch API GPU vs CPU, ' // CASE_NAME // ', dt = ${DT}$'
        #:if defined('MUSCLE_GPU')
        print '(a, l1)', '  batch on a device: ', device
        if (.not. device) print '(a)', '  WARNING: no device, the target regions run on the host (fallback)'
        #:else
        print '(a, i0)', '  CPU build, available threads: ', omp_get_max_threads()
        #:endif
        write(*, '(a, i0, a, i0)') '  repetitions (minimum time): ', n_repeat, ', checked points: ', n_sample
        print '(a)', '  build type: ' // trim(build_type)
        if (trim(build_type) /= 'Release') print '(a)', '  WARNING: not a Release build; timings are not representative.'
    end subroutine print_header

    subroutine parse_arguments()
        !! Command-line options (see `print_usage`).
        character(len=256) :: arg, val
        integer :: n_args, j, ios

        n_args = command_argument_count()
        j = 1
        do while (j <= n_args)
            call get_command_argument(j, arg)
            if (trim(arg) == '-h' .or. trim(arg) == '--help') then
                call print_usage()
                stop 0
            end if
            if (j == n_args) call usage_error('missing value of ' // trim(arg))
            call get_command_argument(j + 1, val)
            select case (trim(arg))
            case ('--points')
                call parse_list(val, points, n_sizes)
            case ('--threads')
                call parse_list(val, threads, n_threads)
            case ('--repeat')
                read(val, *, iostat=ios) n_repeat
                if (ios /= 0 .or. n_repeat < 1) call usage_error('invalid --repeat: ' // trim(val))
            case ('--sample')
                read(val, *, iostat=ios) n_sample
                if (ios /= 0 .or. n_sample < 1) call usage_error('invalid --sample: ' // trim(val))
            case default
                call usage_error('unknown option: ' // trim(arg))
            end select
            j = j + 2
        end do
        if (n_sizes == 0) then
            n_sizes = 3
            points(1:3) = [10000, 100000, 1000000]
        end if
        if (n_threads == 0) then
            threads(1) = 1
            n_threads = 1
            if (omp_get_max_threads() > 1) then
                threads(2) = omp_get_max_threads()
                n_threads = 2
            end if
        end if
    end subroutine parse_arguments

    subroutine parse_list(text, list, n)
        !! Comma-separated list of positive integers.
        character(len=*), intent(in) :: text
            !! List, e.g. `1,2,4`.
        integer, intent(out) :: list(:)
            !! Values.
        integer, intent(out) :: n
            !! Number of values.
        integer :: p0, p1, ios

        n = 0
        p0 = 1
        do while (p0 <= len_trim(text))
            p1 = index(text(p0:), ',')
            p1 = merge(len_trim(text) + 1, p0 + p1 - 1, p1 == 0)
            if (n == size(list)) call usage_error('too many values: ' // trim(text))
            n = n + 1
            read(text(p0:p1 - 1), *, iostat=ios) list(n)
            if (ios /= 0 .or. list(n) < 1) call usage_error('invalid list: ' // trim(text))
            p0 = p1 + 1
        end do
    end subroutine parse_list

    subroutine print_usage()
        !! Command-line help.
        print '(a)', 'Usage: bench_batch_gpu_${BENCH_CASE}$ [options]'
        print '(a)', '  --points a,b,...    numbers of points (default 10000,100000,1000000)'
        print '(a)', '  --threads a,b,...   thread counts of a CPU build (default 1 and all)'
        print '(a)', '  --repeat R          repetitions, minimum time reported (default 5)'
        print '(a)', '  --sample S          points checked against the point API on the host (default 1000)'
        print '(a)', '  -h, --help          this help'
    end subroutine print_usage

    subroutine usage_error(msg)
        !! Error, help and exit code 2.
        character(len=*), intent(in) :: msg
            !! Message.
        print '(a)', 'ERROR: ' // msg
        call print_usage()
        stop 2
    end subroutine usage_error

end program bench_batch_gpu
