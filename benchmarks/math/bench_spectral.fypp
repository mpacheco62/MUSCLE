! lint: host-only
#:include "muscle_common.fypp"
#! Plan C, phase F0 (docs/fypp/PLAN_ESPECTRAL.md): accuracy and cost of the spectral decompositions of today
#! (cur_yield = spectral_decomposition, cur_kin = eigenprojections, both of muscle_math_eigen, as of phase F0:
#! since D-032 both are K, so cur_kin is cur_yield plus the products v (x) v) and of the
#! candidates J, K and KJ (bench_spectral_candidates), in every kind.
#!
#! Accuracy: S = Q diag(lam) Q^T built in quad precision, rounded to the kind; the truth is the eigen-
#! decomposition of the rounded S in quad precision (cyclic Jacobi to quad rounding), so the errors are those of
#! the algorithm, not of the rounding of S. Families: stresses (scales 1e-3, 1, 2e5), stretches C = I + d/2 mu
#! (d = 1 ... 1e-11), extreme scales (dp 1e+-30, sp 1e+-18: floating-point flags only matter there); patterns mu:
#! distinct, middle = mean, triple, a pair at the top or at the bottom with relative gaps 1e-1 ... 1e-15 and 0;
#! three rotations (the identity: diagonal tensors). Measures, maxima over the cases (eps = epsilon(1.0_k),
#! |S| = max |lam|):
#! - e_lam = max |lam - lam_true| / (eps |S|);
#! - e_orth = max |V^T V - I| / eps and e_res = max |S V - V L| / (eps |S|) (candidates with eigenvectors);
#! - e_P = max over a of |P_a - P_a,true| gap_a / eps, gap_a the relative distance of lam_a to the other
#!   eigenvalues; the eigenvalues closer than 1e3 eps |S| form a cluster, whose summed projection is compared
#!   (times its gap to the rest);
#! - e_log (stretches): |ln C - ln C_true| / eps (absolute; ln C = sum ln lam_a P_a), and the largest error
#!   relative to the deviatoric part of ln C_true;
#! - flags: calls that raised overflow, invalid or division by zero.
#! Cost: ns per call over the cases (cycled), single thread; mean and largest number of Jacobi sweeps.
#:set FAM_SCALES = {'sp': ['1.0e-3', '1.0', '2.0e5'], 'dp': ['1.0e-3', '1.0', '2.0e5']}
#:set EXTREME = {'sp': ['1.0e-18', '1.0e18'], 'dp': ['1.0e-30', '1.0e30']}

module bench_spectral_truth
    !! Quad precision helpers: rotations, Jacobi to quad rounding.
    use, intrinsic :: iso_fortran_env, only : real128
    implicit none
    private
    integer, parameter, public :: qp = real128
    public :: rot_q, jacobi_q, mat_q

contains

    pure function rot_q(axis, deg) result(m)
        !! Rotation of `deg` degrees about `axis` (Rodrigues).
        real(qp), intent(in) :: axis(3), deg
        real(qp) :: m(3, 3)
        real(qp), parameter :: PI_Q = 3.14159265358979323846264338327950288_qp
        real(qp) :: n(3), c, s, t
        n = axis/sqrt(sum(axis**2))
        c = cos(deg*PI_Q/180.0_qp)
        s = sin(deg*PI_Q/180.0_qp)
        t = 1.0_qp - c
        m(1, :) = [t*n(1)*n(1) + c, t*n(1)*n(2) - s*n(3), t*n(1)*n(3) + s*n(2)]
        m(2, :) = [t*n(1)*n(2) + s*n(3), t*n(2)*n(2) + c, t*n(2)*n(3) - s*n(1)]
        m(3, :) = [t*n(1)*n(3) - s*n(2), t*n(2)*n(3) + s*n(1), t*n(3)*n(3) + c]
    end function rot_q

    pure function mat_q(v) result(m)
        !! Symmetric matrix of Voigt components (11, 22, 33, 12, 23, 13).
        real(qp), intent(in) :: v(6)
        real(qp) :: m(3, 3)
        m(1, :) = [v(1), v(4), v(6)]
        m(2, :) = [v(4), v(2), v(5)]
        m(3, :) = [v(6), v(5), v(3)]
    end function mat_q

    pure subroutine jacobi_q(m, lam, v)
        !! Eigenvalues (descending) and eigenvectors of a symmetric matrix, cyclic Jacobi to quad rounding.
        real(qp), intent(in) :: m(3, 3)
        real(qp), intent(out) :: lam(3), v(3, 3)
        real(qp) :: a(3, 3), rot(3, 3), theta, t, c, tl, tv(3)
        integer :: sweep, i, j, p, q
        integer, parameter :: P_OF(3) = [1, 1, 2], Q_OF(3) = [2, 3, 3]
        a = m
        v = 0.0_qp
        do i = 1, 3
            v(i, i) = 1.0_qp
        end do
        do sweep = 1, 40
            do i = 1, 3
                p = P_OF(i)
                q = Q_OF(i)
                if (a(p, q) == 0.0_qp) cycle
                theta = (a(q, q) - a(p, p))/(2.0_qp*a(p, q))
                t = sign(1.0_qp, theta)/(abs(theta) + sqrt(theta*theta + 1.0_qp))
                c = 1.0_qp/sqrt(t*t + 1.0_qp)
                rot = 0.0_qp
                rot(1, 1) = 1.0_qp
                rot(2, 2) = 1.0_qp
                rot(3, 3) = 1.0_qp
                rot(p, p) = c
                rot(q, q) = c
                rot(p, q) = t*c
                rot(q, p) = -t*c
                a = matmul(transpose(rot), matmul(a, rot))
                a(p, q) = 0.0_qp
                a(q, p) = 0.0_qp
                v = matmul(v, rot)
            end do
        end do
        do i = 1, 3
            lam(i) = a(i, i)
        end do
        do i = 1, 2
            do j = 1, 3 - i
                if (lam(j) < lam(j + 1)) then
                    tl = lam(j)
                    lam(j) = lam(j + 1)
                    lam(j + 1) = tl
                    tv = v(:, j)
                    v(:, j) = v(:, j + 1)
                    v(:, j + 1) = tv
                end if
            end do
        end do
    end subroutine jacobi_q

end module bench_spectral_truth


program bench_spectral
    use, intrinsic :: iso_fortran_env, only : int64
    use, intrinsic :: ieee_exceptions, only : ieee_set_flag, ieee_get_flag, ieee_all, ieee_overflow, &
        ieee_invalid, ieee_divide_by_zero
    use muscle_kinds, only : ${', '.join(REAL_KINDS)}$
    use muscle_tensors, only : ${', '.join(tname('3D2Osym', k) for k in REAL_KINDS)}$
    use muscle_tensor_2osym, only : to_matrix
    use muscle_math_eigen, only : spectral_decomposition, eigenprojections, eigenvals
    use bench_spectral_candidates
    use bench_spectral_truth
    implicit none

    integer, parameter :: NCAND = 8
    character(len=9), parameter :: CNAME(NCAND) = [character(len=9) :: 'cur_yield', 'cur_kin', 'J', 'K', 'KJ', 'Jf', 'Jnb', 'Js']
    real(qp), parameter :: GAPS(7) = [1.0e-1_qp, 1.0e-3_qp, 1.0e-6_qp, 1.0e-9_qp, 1.0e-12_qp, 1.0e-15_qp, 0.0_qp]
    real(qp), parameter :: DELTAS(5) = [1.0_qp, 1.0e-2_qp, 1.0e-5_qp, 1.0e-8_qp, 1.0e-11_qp]
    integer, parameter :: MAXCASE = 4000
    integer, parameter :: NRAND = 3000
        !! Random tensors: eigenvalues uniform in [-1, 1] (every other one a pure shear (1, 0, -1)), random rotations.

    print '(a)', '# Plan C, F0: spectral decompositions (bench_spectral, build type ' // MUSCLE_BUILD_TYPE // ')'
    #:for k in REAL_KINDS
    call run_${k}$()
    #:endfor

contains

    subroutine patterns(mus, labels, gapof, n)
        !! Eigenvalue patterns mu (|mu| <= 1) with a label and the pair gap (-1 if none).
        real(qp), intent(out) :: mus(3, 20), gapof(20)
        character(len=16), intent(out) :: labels(20)
        integer, intent(out) :: n
        integer :: ig
        mus(:, 1) = [1.0_qp, 0.3_qp, -0.8_qp]
        labels(1) = 'distinct'
        gapof(1) = -1.0_qp
        mus(:, 2) = [1.0_qp, 0.0_qp, -1.0_qp]
        labels(2) = 'middle=mean'
        gapof(2) = -1.0_qp
        mus(:, 3) = [1.0_qp, 1.0_qp, 1.0_qp]
        labels(3) = 'triple'
        gapof(3) = 0.0_qp
        n = 3
        do ig = 1, size(GAPS)
            mus(:, n + 1) = [1.0_qp, 1.0_qp - GAPS(ig), -1.0_qp]
            labels(n + 1) = 'pair_top'
            gapof(n + 1) = GAPS(ig)
            mus(:, n + 2) = [1.0_qp, -1.0_qp + GAPS(ig), -1.0_qp]
            labels(n + 2) = 'pair_bottom'
            gapof(n + 2) = GAPS(ig)
            n = n + 2
        end do
    end subroutine patterns

    function to_voigt_q(m) result(v)
        real(qp), intent(in) :: m(3, 3)
        real(qp) :: v(6)
        v = [m(1, 1), m(2, 2), m(3, 3), m(1, 2), m(2, 3), m(1, 3)]
    end function to_voigt_q

    subroutine measure(eps, sq, lt, vt, lam, p, v, has_v, is_c, e_lam, e_orth, e_res, e_p, e_log, e_logrel)
        !! Errors of one decomposition (lam, P, V) against the quad truth (lt, vt) of the rounded S (sq).
        real(qp), intent(in) :: eps, sq(3, 3), lt(3), vt(3, 3), lam(3), p(3, 3, 3), v(3, 3)
        logical, intent(in) :: has_v, is_c
        real(qp), intent(out) :: e_lam, e_orth, e_res, e_p, e_log, e_logrel
        real(qp), parameter :: G0F = 1.0e3_qp
        real(qp) :: nrm, pt(3, 3, 3), gap, gout, sc(3, 3), st(3, 3), id(3, 3), l(3, 3), ltm(3, 3), dev, tr
        logical :: inc(3)
        integer :: a, b, i

        nrm = maxval(abs(lt))
        id = 0.0_qp
        do i = 1, 3
            id(i, i) = 1.0_qp
            pt(:, :, i) = spread(vt(:, i), 2, 3)*spread(vt(:, i), 1, 3)
        end do
        e_lam = maxval(abs(lam - lt))/(eps*nrm)
        e_orth = -1.0_qp
        e_res = -1.0_qp
        if (has_v) then
            e_orth = maxval(abs(matmul(transpose(v), v) - id))/eps
            e_res = maxval(abs(matmul(sq, v) - v*spread(lam, 1, 3)))/(eps*nrm)
        end if
        e_p = 0.0_qp
        do a = 1, 3
            gap = huge(1.0_qp)
            do b = 1, 3
                if (b /= a) gap = min(gap, abs(lt(a) - lt(b))/nrm)
            end do
            if (gap > G0F*eps) then
                e_p = max(e_p, maxval(abs(p(:, :, a) - pt(:, :, a)))*gap/eps)
            else
                inc = abs(lt - lt(a))/nrm <= G0F*eps
                gout = 1.0_qp
                do b = 1, 3
                    if (.not. inc(b)) gout = min(gout, minval(abs(lt(b) - lt), mask=inc)/nrm)
                end do
                sc = 0.0_qp
                st = 0.0_qp
                do b = 1, 3
                    if (inc(b)) then
                        sc = sc + p(:, :, b)
                        st = st + pt(:, :, b)
                    end if
                end do
                e_p = max(e_p, maxval(abs(sc - st))*gout/eps)
            end if
        end do
        e_log = -1.0_qp
        e_logrel = -1.0_qp
        if (is_c .and. all(lam > 0.0_qp)) then
            l = 0.0_qp
            ltm = 0.0_qp
            do a = 1, 3
                l = l + log(lam(a))*p(:, :, a)
                ltm = ltm + log(lt(a))*pt(:, :, a)
            end do
            e_log = maxval(abs(l - ltm))/eps
            tr = (ltm(1, 1) + ltm(2, 2) + ltm(3, 3))/3.0_qp
            dev = maxval(abs(ltm - tr*id))
            if (dev > 1.0e3_qp*eps) e_logrel = maxval(abs(l - ltm))/dev
        end if
    end subroutine measure

    function flags_raised() result(raised)
        logical :: raised
        logical :: f(3)
        call ieee_get_flag(ieee_overflow, f(1))
        call ieee_get_flag(ieee_invalid, f(2))
        call ieee_get_flag(ieee_divide_by_zero, f(3))
        raised = any(f)
    end function flags_raised
    #:for k in REAL_KINDS
    #:set T2 = tname('3D2Osym', k)

    subroutine decompose_${k}$(ic, s, lam, p, v, nsweep)
        !! Decomposition `ic` of s in `real(${k}$)`, as quad values; projections v v^T (or those of eigenprojections).
        integer, intent(in) :: ic
        type(${T2}$), intent(in) :: s
        real(qp), intent(out) :: lam(3), p(3, 3, 3), v(3, 3)
        integer, intent(out) :: nsweep
        real(${k}$) :: lk(3), vk(3, 3)
        type(${T2}$) :: proj(3)
        integer :: a

        nsweep = 0
        vk = 0.0_${k}$
        select case (ic)
        case (1)
            call spectral_decomposition(s, lk, vk)
        case (2)
            call eigenprojections(s, lk, proj)
        case (3)
            call cand_jacobi_${k}$(s, lk, vk, nsweep)
        case (4)
            call cand_kopp_${k}$(s, lk, vk)
        case (5)
            call cand_kopp_jacobi_${k}$(s, lk, vk, nsweep)
        case (6)
            call cand_jacobi_fixed_${k}$(s, lk, vk)
        case (7)
            call cand_jacobi_nobranch_${k}$(s, lk, vk)
        case (8)
            call cand_jacobi_scalar_${k}$(s, lk, vk)
        end select
        lam = real(lk, qp)
        v = real(vk, qp)
        do a = 1, 3
            if (ic == 2) then
                p(:, :, a) = real(to_matrix(proj(a)), qp)
            else
                p(:, :, a) = spread(v(:, a), 2, 3)*spread(v(:, a), 1, 3)
            end if
        end do
    end subroutine decompose_${k}$

    subroutine run_${k}$()
        !! Accuracy and cost in `real(${k}$)`.
        real(qp), parameter :: SCALES(3) = [${', '.join(s + '_qp' for s in FAM_SCALES[k])}$]
        real(qp), parameter :: XSCALES(2) = [${', '.join(s + '_qp' for s in EXTREME[k])}$]
        real(qp) :: mus(3, 20), gapof(20), rots(3, 3, 3), lamq(3), sq(3, 3), lt(3), vt(3, 3), eps
        real(qp) :: lam(3), p(3, 3, 3), v(3, 3), e(6), worst(6, NCAND), byg(8, NCAND, 2), byfam(11, NCAND)
        character(len=16) :: labels(20)
        type(${T2}$), allocatable :: cases(:)
        type(${T2}$) :: s
        integer :: npat, ifam, ip, ir, ic, ncase, nflag(NCAND, 2), ns, sweeps(2, NCAND), nsw(NCAND), ig, ihist(0:7, NCAND)
        integer :: ird
        real(qp) :: rnd(5)
        integer(int64) :: seed
        logical :: is_c, extreme
        real(${k}$) :: lk(3), vk(3, 3), chk
        type(${T2}$) :: proj(3)
        integer(int64) :: t0, t1, rate
        integer :: rep, nrep, i
        real(qp) :: fam_scale

        eps = real(epsilon(1.0_${k}$), qp)
        call patterns(mus, labels, gapof, npat)
        rots(:, :, 1) = rot_q([0.0_qp, 0.0_qp, 1.0_qp], 0.0_qp)
        rots(:, :, 2) = rot_q([1.0_qp, -2.0_qp, 0.5_qp], 71.0_qp)
        rots(:, :, 3) = rot_q([2.0_qp, 1.0_qp, 3.0_qp], 23.0_qp)
        allocate(cases(MAXCASE))
        worst = -1.0_qp
        byg = -1.0_qp
        byfam = -1.0_qp
        nflag = 0
        sweeps = 0
        nsw = 0
        ihist = 0
        ncase = 0
        seed = 20261112_int64
        ! families: 1..3 stresses, 4..8 stretches, 9..10 extreme scales
        do ifam = 1, 10
            is_c = ifam >= 4 .and. ifam <= 8
            extreme = ifam >= 9
            do ip = 1, npat
                do ir = 1, 3
                    if (ifam <= 3) then
                        lamq = SCALES(ifam)*mus(:, ip)
                    else if (is_c) then
                        lamq = 1.0_qp + 0.5_qp*DELTAS(ifam - 3)*mus(:, ip)
                    else
                        fam_scale = XSCALES(ifam - 8)
                        lamq = fam_scale*mus(:, ip)
                    end if
                    sq = matmul(rots(:, :, ir), matmul(diag(lamq), transpose(rots(:, :, ir))))
                    s%vals = real(to_voigt_q(sq), ${k}$)
                    sq = mat_q(real(s%vals, qp))
                    call jacobi_q(sq, lt, vt)
                    if (maxval(abs(lt)) <= 0.0_qp) cycle
                    if (.not. extreme) then
                        ncase = ncase + 1
                        cases(ncase) = s
                    end if
                    do ic = 1, NCAND
                        call ieee_set_flag(ieee_all, .false.)
                        call decompose_${k}$(ic, s, lam, p, v, ns)
                        if (flags_raised()) then
                            nflag(ic, merge(2, 1, extreme)) = nflag(ic, merge(2, 1, extreme)) + 1
                            if (.not. extreme) print '(a, i0, 3a, es9.2, a, i0)', '<!-- FP flag: ' // trim(CNAME(ic)) // &
                                ' family ', ifam, ' ', trim(labels(ip)), ' gap', gapof(ip), ' rotation ', ir
                        end if
                        call ieee_set_flag(ieee_all, .false.)
                        if (ic == 3 .or. ic == 5) then
                            sweeps(1, ic) = sweeps(1, ic) + ns
                            sweeps(2, ic) = max(sweeps(2, ic), ns)
                            nsw(ic) = nsw(ic) + 1
                        end if
                        call measure(eps, sq, lt, vt, lam, p, v, ic /= 2, is_c, e(1), e(2), e(3), e(4), e(5), e(6))
                        byfam(ifam, ic) = max(byfam(ifam, ic), e(1), e(4))
                        if (extreme) cycle
                        worst(:, ic) = max(worst(:, ic), e)
                        ! e_P and e_log by pair gap (index 8: patterns without a pair gap)
                        ig = 8
                        if (gapof(ip) >= 0.0_qp .and. labels(ip) /= 'triple') ig = findloc(GAPS, gapof(ip), 1)
                        byg(ig, ic, 1) = max(byg(ig, ic, 1), e(4))
                        byg(ig, ic, 2) = max(byg(ig, ic, 2), e(5))
                    end do
                end do
            end do
        end do

        ! Random tensors (family 11, counted with the physical scales)
        do ird = 1, NRAND
            do i = 1, 5
                seed = mod(16807_int64*seed, 2147483647_int64)
                rnd(i) = real(seed, qp)/2147483647.0_qp
            end do
            if (mod(ird, 2) == 0) then
                lamq = [1.0_qp, 0.0_qp, -1.0_qp]
            else
                lamq = 2.0_qp*rnd(1:3) - 1.0_qp
            end if
            sq = rot_q([2.0_qp*rnd(1) - 1.0_qp, 2.0_qp*rnd(2) - 1.0_qp, rnd(3) + 0.1_qp], 360.0_qp*rnd(4))
            sq = matmul(sq, matmul(diag(lamq), transpose(sq)))
            s%vals = real(to_voigt_q(sq), ${k}$)
            sq = mat_q(real(s%vals, qp))
            call jacobi_q(sq, lt, vt)
            if (maxval(abs(lt)) <= 0.0_qp) cycle
            ncase = ncase + 1
            cases(ncase) = s
            do ic = 1, NCAND
                call ieee_set_flag(ieee_all, .false.)
                call decompose_${k}$(ic, s, lam, p, v, ns)
                if (flags_raised()) nflag(ic, 1) = nflag(ic, 1) + 1
                call ieee_set_flag(ieee_all, .false.)
                if (ic == 3 .or. ic == 5) then
                    sweeps(1, ic) = sweeps(1, ic) + ns
                    sweeps(2, ic) = max(sweeps(2, ic), ns)
                    nsw(ic) = nsw(ic) + 1
                    ihist(min(ns, 7), ic) = ihist(min(ns, 7), ic) + 1
                end if
                call measure(eps, sq, lt, vt, lam, p, v, ic /= 2, .false., e(1), e(2), e(3), e(4), e(5), e(6))
                worst(:, ic) = max(worst(:, ic), e)
                byfam(11, ic) = max(byfam(11, ic), e(1), e(4))
            end do
        end do

        print '(/, a)', '## real(${k}$)'
        print '(a, i0, a)', 'Accuracy over ', ncase, &
            ' cases of physical scale (stresses 1e-3 ... 2e5, stretches, random); -1: not applicable.'
        print '(a)', ''
        print '(a)', '| decomposition | e_lam | e_orth | e_res | e_P | e_log (abs/eps) | e_log (rel. to dev) | FP flags |'
        print '(a)', '|---|---|---|---|---|---|---|---|'
        do ic = 1, NCAND
            print '(a, 6(" | ", es9.2), " | ", i0, " |")', '| ' // trim(CNAME(ic)), worst(:, ic), nflag(ic, 1)
        end do
        print '(/, a)', 'max(e_lam, e_P) by family (scale of the stresses; d of the stretches C = I + d/2 mu; extreme scales):'
        print '(a)', ''
        print '(a)', '| decomposition | S 1e-3 | S 1 | S 2e5 | C d=1 | C 1e-2 | C 1e-5 | C 1e-8 | C 1e-11 | ' // &
            '${EXTREME[k][0]}$ | ${EXTREME[k][1]}$ | random | FP flags (extreme) |'
        print '(a)', '|---|---|---|---|---|---|---|---|---|---|---|---|---|'
        do ic = 1, NCAND
            print '(a, 11(" | ", es9.2), " | ", i0, " |")', '| ' // trim(CNAME(ic)), byfam(:, ic), nflag(ic, 2)
        end do
        print '(/, a)', 'Jacobi sweeps with rotations, random tensors (count of tensors per number of sweeps, 7: 7 or more):'
        print '(a)', ''
        print '(a)', '| decomposition | 0 | 1 | 2 | 3 | 4 | 5 | 6 | 7 |'
        print '(a)', '|---|---|---|---|---|---|---|---|---|'
        do ic = 3, 5, 2
            print '(a, 8(" | ", i0), " |")', '| ' // trim(CNAME(ic)), ihist(:, ic)
        end do
        print '(/, a)', 'e_P by pair gap (max over scales, rotations, top/bottom):'
        print '(a)', ''
        print '(a)', '| decomposition | 1e-1 | 1e-3 | 1e-6 | 1e-9 | 1e-12 | 1e-15 | 0 | no pair |'
        print '(a)', '|---|---|---|---|---|---|---|---|---|'
        do ic = 1, NCAND
            print '(a, 8(" | ", es9.2), " |")', '| ' // trim(CNAME(ic)), byg(:, ic, 1)
        end do
        print '(/, a)', 'e_log (abs/eps) by pair gap, stretches only:'
        print '(a)', ''
        print '(a)', '| decomposition | 1e-1 | 1e-3 | 1e-6 | 1e-9 | 1e-12 | 1e-15 | 0 | no pair |'
        print '(a)', '|---|---|---|---|---|---|---|---|---|'
        do ic = 1, NCAND
            print '(a, 8(" | ", es9.2), " |")', '| ' // trim(CNAME(ic)), byg(:, ic, 2)
        end do

        ! Cost
        nrep = max(1, 2000000/ncase)
        print '(/, a, i0, a)', 'Cost (', nrep*ncase, ' calls, one thread):'
        print '(a)', ''
        print '(a)', '| decomposition | ns/call | ratio to cur_yield | Jacobi sweeps mean / max |'
        print '(a)', '|---|---|---|---|'
        block
            real(qp) :: tns(0:NCAND)
            do ic = 0, NCAND
                chk = 0.0_${k}$
                call system_clock(t0, rate)
                do rep = 1, nrep
                    do i = 1, ncase
                        select case (ic)
                        case (0)
                            lk = eigenvals(cases(i))
                            chk = chk + lk(1)
                        case (1)
                            call spectral_decomposition(cases(i), lk, vk)
                            chk = chk + lk(1) + vk(1, 1)
                        case (2)
                            call eigenprojections(cases(i), lk, proj)
                            chk = chk + lk(1) + proj(1)%vals(1)
                        case (3)
                            call cand_jacobi_${k}$(cases(i), lk, vk)
                            chk = chk + lk(1) + vk(1, 1)
                        case (4)
                            call cand_kopp_${k}$(cases(i), lk, vk)
                            chk = chk + lk(1) + vk(1, 1)
                        case (5)
                            call cand_kopp_jacobi_${k}$(cases(i), lk, vk)
                            chk = chk + lk(1) + vk(1, 1)
                        case (6)
                            call cand_jacobi_fixed_${k}$(cases(i), lk, vk)
                            chk = chk + lk(1) + vk(1, 1)
                        case (7)
                            call cand_jacobi_nobranch_${k}$(cases(i), lk, vk)
                            chk = chk + lk(1) + vk(1, 1)
                        case (8)
                            call cand_jacobi_scalar_${k}$(cases(i), lk, vk)
                            chk = chk + lk(1) + vk(1, 1)
                        end select
                    end do
                end do
                call system_clock(t1)
                tns(ic) = real(t1 - t0, qp)/real(rate, qp)*1.0e9_qp/real(nrep*ncase, qp)
                if (chk /= chk) print '(a)', '(checksum NaN)'
            end do
            print '(a, f8.1, a)', '| eigenvals (values only) | ', tns(0), ' | - | - |'
            do ic = 1, NCAND
                if (nsw(ic) > 0) then
                    print '(a, f8.1, " | ", f6.2, " | ", f5.2, " / ", i0, " |")', '| ' // trim(CNAME(ic)) // ' | ', &
                        tns(ic), tns(ic)/tns(1), real(sweeps(1, ic), qp)/nsw(ic), sweeps(2, ic)
                else
                    print '(a, f8.1, " | ", f6.2, " | - |")', '| ' // trim(CNAME(ic)) // ' | ', tns(ic), tns(ic)/tns(1)
                end if
            end do
        end block
    end subroutine run_${k}$
    #:endfor

    pure function diag(x) result(m)
        real(qp), intent(in) :: x(3)
        real(qp) :: m(3, 3)
        m = 0.0_qp
        m(1, 1) = x(1)
        m(2, 2) = x(2)
        m(3, 3) = x(3)
    end function diag

end program bench_spectral
